@model IEnumerable<Domain.PremiumPackage>
@{
    ViewBag.Title = "Premium Packages";
}

@section Title {
    Premium Packages Management
}

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="card-title mb-0">All Premium Packages</h5>
                <a asp-action="Get" asp-route-id="0" class="btn btn-primary btn-sm">
                    <i class="fas fa-plus me-1"></i> Add New Package
                </a>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-bordered table-striped align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>#ID</th>
                                <th>Package Name</th>
                                <th>Price</th>
                                <th>Description</th>
                                <th>Status</th>
                                <th class="text-center">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Any())
                            {
                                foreach (var item in Model)
                                {
                                    <tr>
                                        <td>@item.Id</td>
                                        <td><strong>@item.PackageName</strong></td>
                                        <td>₹@item.Price.ToString("N2")</td>
                                        <td>@(string.IsNullOrEmpty(item.Description) ? "-" : item.Description)</td>
                                        <td>
                                            @if (item.IsActive)
                                            {
                                                <span class="badge bg-success">Active</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger">Inactive</span>
                                            }
                                        </td>
                                        <td class="text-center">
                                            <a asp-action="Get" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info me-1">
                                                <i class="fas fa-edit"></i> Edit
                                            </a>
                                            <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this package?');">
                                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                                    <i class="fas fa-trash"></i> Delete
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="6" class="text-center text-muted">No premium packages found. Click "Add New Package" to create one.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
