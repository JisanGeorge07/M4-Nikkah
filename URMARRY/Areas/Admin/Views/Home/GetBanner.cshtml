@model Application.Models.HomeBannerDto
@{
    ViewBag.Title = "Image Gallery";
}

@section Title
    {
    <a asp-action="GetAllBanner" class="btn btn-primary btn-xs">
        <i class="fas fa-arrow-left"></i>
    </a>
    Entry
}

<div class="row">
    <div class="col-12">
        <div class="card">

            <div class="card-body" id="ModalUser">
                @using (Html.BeginForm("PostBanner", "Home", FormMethod.Post, new { enctype = "multipart/form-data" }))
                {
                    <div class="modal-body row">
                        <input type="hidden" asp-for="@Model.Id">

                        <div class="mb-3 col-md-12">
                            <label class="col-form-label">Title</label>
                            <input type="text" class="form-control" asp-for="@Model.Title">
                        </div>

                        <div class="mb-3 col-md-12">
                            <label class="col-form-label">Body </label>
                            <textarea class="mceDescrEng" asp-for="@Model.Body"></textarea>
                        </div>

                        <div class="mb-3 col-md-12">
                            <label class="col-form-label">Image (1920 x 1080)</label>
                            @if (!string.IsNullOrEmpty(Model.ImagePath))
                            {
                                <br />
                                <img src="/@Model.ImagePath" width="150" alt="image-preview" />
                                <br />
                            }
                            <input type="hidden" asp-for="@Model.ImagePath">
                            <input type="file" class="form-control" id="Image" name="Image">
                            @*<label class="col-form-label">Image Alt</label>
                            <input type="text" class="form-control" asp-for="@Model.ImageAlt">*@
                        </div>

                        <div class="mb-3 col-md-6">
                            <label class="form-check-label">Enable Google Play Button</label>
                            <input asp-for="@Model.IsPlaystoreButtonEnabled" type="checkbox" class="form-check-input" />
                        </div>
                        
                        <div class="mb-3 col-md-6">
                            <label class="form-check-label">Enable App Store Button</label>
                            <input asp-for="@Model.IsAppstoreButtonEnabled" type="checkbox" class="form-check-input" />
                        </div>
                        <div class="mb-3 col-md-6">
                            <label class="col-form-label">Playstore Button Link</label>
                            <input type="text" class="form-control" asp-for="@Model.PlaystoreButtonLink">
                        </div>
                        <div class="mb-3 col-md-6">
                            <label class="col-form-label">Appstore Button Link</label>
                            <input type="text" class="form-control" asp-for="@Model.AppstoreButtonLink">
                        </div>

                        @if (Model.Id is > 0)
                        {
                            <div class="mb-3 col-md-12">
                                <label class="col-form-label">Display Order</label>
                                <input type="number" min="1" class="form-control" asp-for="@Model.DisplayOrder">
                            </div>
                        }

                        <div class="mb-3 col-md-12">
                            <label class="form-check-label">Enabled</label>
                            <input asp-for="@Model.IsActive" type="checkbox" class="form-check-input" />
                        </div>


                        <div class="btn-group">
                            @if (Model.Id is > 0)
                            {
                                <button asp-action="DeleteBanner" asp-route-id="@Model.Id"
                                        onclick="return confirm('Are you sure you want to delete this entity?')" class="btn btn-danger">
                                    Delete
                                </button>
                            }
                            <button type="submit" id="formsubmit" class="btn btn-primary">Save changes</button>
                        </div>

                    </div>
                }
            </div>
        </div>
    </div>
</div>