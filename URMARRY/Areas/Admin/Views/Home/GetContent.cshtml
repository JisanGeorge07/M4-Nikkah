@model Application.Models.HomeContentDto
@{
    ViewBag.Title = "Home Content";
}

@section Title
    {
    Home Content
}

<div class="row">
    <div class="col-12">
        <div class="card">

            <div class="card-body" id="ModalUser">
                @using (Html.BeginForm("PostContent", "Home", FormMethod.Post, new { enctype = "multipart/form-data" }))
                {
                    <div class="modal-body row">
                        <input type="hidden" asp-for="@Model.Id">

                        <div class="mb-3 col-md-12">
                            <label class="col-form-label">Tagline</label>
                            <input type="text" class="form-control" asp-for="@Model.Tagline">
                        </div>

                        <div class="mb-3 col-md-12">
                            <label class="col-form-label">Title 1</label>
                            <input type="text" class="form-control" asp-for="@Model.Title1">
                        </div>

                        <div class="mb-3 col-md-12">
                            <label class="col-form-label">Body 1</label>
                            <textarea class="mceDescrEng" asp-for="@Model.Body1"></textarea>
                        </div>

                        <div class="mb-3 col-md-12">
                            <label class="col-form-label">Title 2</label>
                            <input type="text" class="form-control" asp-for="@Model.Title2">
                        </div>

                        <div class="mb-3 col-md-12">
                            <label class="col-form-label">Body 2</label>
                            <textarea class="mceDescrEng" asp-for="@Model.Body2"></textarea>
                        </div>

                        <div class="mb-3 col-md-12">
                            <label class="col-form-label">Title 3</label>
                            <input type="text" class="form-control" asp-for="@Model.Title3">
                        </div>

                        <div class="mb-3 col-md-12">
                            <label class="col-form-label">Body 3</label>
                            <textarea class="mceDescrEng" asp-for="@Model.Body3"></textarea>
                        </div>

                        <div class="mb-3 col-md-12">
                            <label class="col-form-label">Listing Heading</label>
                            <input type="text" class="form-control" asp-for="@Model.ListTitle">
                        </div>

                        <div class="btn-group">
                            <button type="submit" id="formsubmit" class="btn btn-primary">Save changes</button>
                        </div>

                    </div>
                }
            </div>
        </div>
    </div>
</div>