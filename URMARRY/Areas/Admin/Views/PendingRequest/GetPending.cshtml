                            <input type="text" class="form-control" asp-for="@Model.PresentState">
                        </div>

                        <div class="mb-3 col-md-12">
                            <label class="col-form-label">Present Location Telephone Number</label>
                            <input type="text" class="form-control" asp-for="@Model.PresentDistrict">
                        </div>

                        <div class="mb-3 col-md-12">
                            <label class="col-form-label">Profile Image</label>
                            @if (!string.IsNullOrEmpty(enquiry.ImagePath))
                            {
                                <img src="@Html.Raw("/" + enquiry.ImagePath)" width="180">
                            }
                            else
                            {
                                <img src="@Url.Content(string.Equals(enquiry.Gender, "Female", StringComparison.OrdinalIgnoreCase) ? "/assets/images/default-user-women.png" : "/assets/images/default-user-men.png")" width="180">
                            }
