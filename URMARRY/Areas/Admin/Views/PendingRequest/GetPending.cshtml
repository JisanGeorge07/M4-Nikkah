</div>

@section Scripts{
                                <script>
                                function Delete(Id) {
            alertify.confirm('Delete', 'Are you sure , do you want to delete?', function () {
                 $.post('/admin/pending-enquiry/delete/' + Id).done(function (data) {
                     if (data) {
                         alertify.success("Deleted successfully");
                     } else
                        alertify.error("Data not found");

                });
            }
                , function () { alertify.error('User Canceld') });
        }
    </script>
                            }