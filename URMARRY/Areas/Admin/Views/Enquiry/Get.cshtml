@model URMARRY.Areas.Admin.Models.EnquiryViewModel
@{
    ViewBag.Title = "Enquiry";
    // Layout = "/Views/Shared/_Layout.cshtml";
    var enquiry = Model.Enquiry!;
    var MaritalStatuses = Model.MaritalStatuses!;
    var ProfileFor = Model.ProfileFor!;
    var Nationalities = Model.Nationalities!;
    var States = Model.States!;
    var Districts = Model.Districts!;
    var Cities = Model.Cities!;
    var BodyFeatures = Model.BodyFeatures!;
    var Professions = Model.Professions!;
    var MotherTongues = Model.MotherTongues!;
    var Communities = Model.Communities!;
    var Religiousnesses = Model.Religiousnesses!;
    var FinancialStatuses = Model.FinancialStatuses!;
    var ReligionCastes = Model.ReligionCastes!;
    var dateOfBirth = !string.IsNullOrEmpty(enquiry.DOB) ? enquiry.DOB : "01/01/1990";
    var str = dateOfBirth.Replace("-", "/").Split('/');
    var day = string.Empty;
    var month = string.Empty;
    var year = str[2];
    if(str[0].Length < 2)
    {
        day = "0" + str[0];
    }
    else
    {
        day = str[0];
    }
    if(str[1].Length < 2)
    {
        month = "0" + str[1];
    }
    else
    {
        month = str[1];
    }
    if (day.Length > 2)
    {
        var y = year;
        var d = day;
        day = y;
        year = d;
    }
    var dob = day + "/" + month + "/" + year;
    DateTime myDate = DateTime.ParseExact(dob, "dd/MM/yyyy", System.Globalization.CultureInfo.InvariantCulture);
}

