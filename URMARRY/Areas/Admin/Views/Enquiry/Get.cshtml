                            <div class="mb-3 col-md-12">
                                <div class="card bg-light border p-3">
                                    <h6 class="mb-2 fw-bold text-dark"><i class="fas fa-shield-alt text-primary me-2"></i>Photo Privacy Settings</h6>
                                    <p class="text-muted small mb-3">Controls who can view this member's profile image on the portal.</p>
                                    <div class="row g-3">
                                        <div class="col-md-4">
                                            <div class="form-check form-switch">
                                                <input asp-for="@Model.PhotoVisibleToAll" type="checkbox" class="form-check-input photo-privacy-toggle" id="PhotoVisibleToAll" />
                                                <label class="form-check-label fw-bold" for="PhotoVisibleToAll">Visible to all</label>
                                            </div>
                                            <small class="text-muted d-block ps-4">Visible to all registered members</small>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="form-check form-switch">
                                                <input asp-for="@Model.PhotoVisibleToPremium" type="checkbox" class="form-check-input photo-privacy-toggle" id="PhotoVisibleToPremium" />
                                                <label class="form-check-label fw-bold" for="PhotoVisibleToPremium">Visible to premium only</label>
                                            </div>
                                            <small class="text-muted d-block ps-4">Visible only to active premium members</small>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="form-check form-switch">
                                                <input asp-for="@Model.PhotoVisibleToAccepted" type="checkbox" class="form-check-input photo-privacy-toggle" id="PhotoVisibleToAccepted" />
                                                <label class="form-check-label fw-bold" for="PhotoVisibleToAccepted">Visible to accepted interest only</label>
                                            </div>
                                            <small class="text-muted d-block ps-4">Visible only when an interest request is accepted</small>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="mb-3 col-md-12">
                                <label class="col-form-label">About</label>
                                <textarea class="form-control" asp-for="@Model.About" cols="20" rows="3"></textarea>
                            </div>

                            <div class="mb-3 col-md-12">
                                <label class="form-check-label">Is Verified?</label>
                                <input asp-for="@Model.IsVerified" type="checkbox" class="form-check-input" />
                            </div>

                            @* <div class="mb-3 col-md-12">
                            <label class="form-check-label">Is Premium member?</label>
                            <input asp-for="@Model.IsPremiumMember" type="checkbox" class="form-check-input"/>
                        </div>*@

                            <div class="mb-3 col-md-12">
                                <label class="form-check-label">Is special request?</label>
                                <input asp-for="@Model.IsSpecialRequest" type="checkbox" class="form-check-input" />
                            </div>

                            <div class="mb-3 col-md-12">
                                <label class="form-check-label">Is Complete?</label>
                                <input asp-for="@Model.IsComplete" type="checkbox" class="form-check-input" />
                            </div>

                            <div class="mb-3 col-md-12">
                                <label class="form-check-label">Enabled</label>
                                <input asp-for="@Model.IsActive" type="checkbox" class="form-check-input" />
                            </div>

                            <div class="mb-3 col-md-12">
                                <label class="form-check-label">Registration Approved</label>
                                <input asp-for="@Model.IsVisible" type="checkbox" class="form-check-input" />
                            </div>

                            <div class="mb-3 col-md-12">
                                <label class="form-check-label">Show On Home Page</label>
                                <input asp-for="@Model.ShowOnHomePage" type="checkbox" class="form-check-input" />
                            </div>

                            <div class="btn-group">
                                @*<button asp-action="Delete" asp-route-id="@Model.Id"
                                    onclick="return confirm('Are you sure you want to delete this entity?')" class="btn btn-danger" type="button">
                                Delete
                            </button>*@
                                <button type="submit" id="formsubmit" class="btn btn-primary">Save changes</button>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
    <style>
        .select2-container {
            box-sizing: border-box;
            display: inline-block;
            margin: 0;
            width: 100% !important;
            position: relative;
            vertical-align: middle;
        }

        .select2-selection--single {
            height: 48px;
            /* Adjust based on design */
            padding-left: 5px;
            /* Space for the icon */
            display: flex;
            align-items: center;
        }

        .select2-selection__rendered {
            line-height: 48px;
            /* Match the input height */
        }

        .select2-selection__arrow {
            height: 48px;
            /* Adjust based on design */
        }

        .select2-container--default .select2-selection--single .select2-selection__placeholder {
            color: black;
        }


        .select2-container--default .select2-selection--single {
            background-color: #fff;
            border: 1px solid #ced4da;
            border-radius: 4px;
            height: 35.5px;
        }

        .select2-container--default .select2-selection--single .select2-selection__rendered {
            color: #444;
            line-height: 30px;
        }

        .select2-container--default .select2-selection--single .select2-selection__arrow {
            height: 26px;
            position: absolute;
            top: 12px;
            right: 1px;
            width: 20px;
        }

        .select2-container--default .select2-selection--single .select2-selection__arrow b {
            border-color: #888 transparent transparent transparent;
            border-style: solid;
            border-width: 5px 4px 0 4px;
            height: 0;
            left: 50%;
            margin-left: -20px;
            margin-top: -10px;
            position: absolute;
            top: 50%;
            width: 0;
        }
    </style>

    <script>
        $(document).ready(function () {
            // Select2 for CountryCode dropdowns
            $('#CountryCode').select2({ placeholder: 'Select Country Code', allowClear: true });
            $('#SecondaryCountryCode').select2({ placeholder: 'Select Country Code', allowClear: true });

            // Select2 for EducationType multi-select
            $('#EducationTypeSelect').select2({
                placeholder: 'Select Course(s)',
                allowClear: true,
                tags: true
            });

            $('#EducationTypeSelect').on('change', function () {
                var selected = $(this).val();
                var valStr = selected ? (Array.isArray(selected) ? selected.join(', ') : selected) : '';
                $('#EducationType').val(valStr);
            });

            // Photo Privacy Mutual Exclusion Logic
            $('#PhotoVisibleToAll').change(function () {
                if (this.checked) {
                    $('#PhotoVisibleToPremium').prop('checked', false);
                    $('#PhotoVisibleToAccepted').prop('checked', false);
                }
            });

            $('#PhotoVisibleToPremium, #PhotoVisibleToAccepted').change(function () {
                if (this.checked) {
                    $('#PhotoVisibleToAll').prop('checked', false);
                }
                if (!$('#PhotoVisibleToPremium').is(':checked') && !$('#PhotoVisibleToAccepted').is(':checked')) {
                    $('#PhotoVisibleToAll').prop('checked', true);
                }
            });

            // Select2 initialization for location & other fields
            $('#Country').select2({ placeholder: 'Country', allowClear: false });
            $('#State').select2({ placeholder: 'State', allowClear: false });
            $('#District').select2({ placeholder: 'District', allowClear: false });
            $('#Village').select2({ placeholder: 'City', allowClear: false });
            $('#PresentCountry').select2({ placeholder: 'PresentCountry', allowClear: false });

            // Location cascading with preservation of initial saved values
            var isInitialLoad = true;

            function updateLocationContainers(countryVal, stateVal) {
                if (countryVal === 'India') {
                    $('#stateContainer').show();
                    $('#districtContainer').show();
                    $('#State').prop('disabled', false);
                    if (stateVal === 'Kerala') {
                        $('#cityContainer').show();
                        $('#Village').prop('disabled', false);
                    } else {
                        $('#cityContainer').hide();
                        $('#Village').prop('disabled', true);
                    }
                } else {
                    $('#stateContainer').hide();
                    $('#districtContainer').hide();
                    $('#cityContainer').hide();
                    $('#State').prop('disabled', true);
                }
            }

            $('#Country').change(function () {
                updateLocationContainers($(this).val(), $('#State').val());
            });

            $('#State').change(function () {
                var stateName = $(this).val();
                updateLocationContainers($('#Country').val(), stateName);

                // Only repopulate district if user manually changed State (not on page load)
                if (!isInitialLoad) {
                    $('#District').empty().append('<option value="">Select District</option>');
                    $('#Village').empty().append('<option value="">Select City</option>');
                    if (stateName) {
                        $.ajax({
                            url: '/Home/GetDistrictsByStateName',
                            type: 'GET',
                            data: { stateName: stateName },
                            dataType: 'json',
                            success: function (response) {
                                if (response.success && response.message) {
                                    $.each(response.message, function (index, item) {
                                        $('#District').append('<option value="' + item.name + '">' + item.name + '</option>');
                                    });
                                }
                                $('#District').trigger('change.select2');
                            }
                        });
                    }
                }
            });

            $('#District').change(function () {
                var districtName = $(this).val();
                // Only repopulate village if user manually changed District (not on page load)
                if (!isInitialLoad) {
                    $('#Village').empty().append('<option value="">Select City</option>');
                    if (districtName) {
                        $.ajax({
                            url: '/Home/GetCityByDistictName',
                            type: 'GET',
                            data: { districtName: districtName },
                            dataType: 'json',
                            success: function (response) {
                                if (response.success && response.message) {
                                    $.each(response.message, function (index, item) {
                                        $('#Village').append('<option value="' + item.name + '">' + item.name + '</option>');
                                    });
                                }
                                $('#Village').trigger('change.select2');
                            }
                        });
                    }
                }
            });

            // Initial visibility setup without wiping pre-rendered selections
            updateLocationContainers($('#Country').val(), $('#State').val());
            isInitialLoad = false;

            // Physical challenge toggle
            $('#IsPhysicallyChallenged').change(function () {
                var selectedVal = $(this).val();
                if (selectedVal === 'true') {
                    $('#physicalChallengeDetailContainer').show();
                } else {
                    $('#physicalChallengeDetailContainer').hide();
                    $('#PhysicallyChallengedDetail').val('');
                }
            });

            // Marital status / children toggle
            $('#MaritalStatusId').change(function () {
                var selectedVal = $(this).val();
                if (selectedVal == '2' || selectedVal == '3' || selectedVal == '4' || selectedVal == '5' || selectedVal == '6') {
                    $('#childrenContainer').show();
                } else {
                    $('#childrenContainer').hide();
                    $('#NumberOfChildrens').val('0');
                }
            });
            $('#MaritalStatusId').trigger('change');
        });
    </script>