                                        var selectedCourses = !string.IsNullOrEmpty(enquiry.EducationType)
                                            ? enquiry.EducationType.Split(new[] { ',', ';' }, StringSplitOptions.RemoveEmptyEntries).Select(x => x.Trim()).ToList()
                                            : new List<string>();
                                        var allCourses = BodyFeatures.Where(x => x.Type == Application.Constants.BodyFeature.Course).ToList();
                                    }
                                    @foreach (var item in allCourses)
                                    {
                                        bool isSelected = selectedCourses.Contains(item.Title, StringComparer.OrdinalIgnoreCase);
                                        <option value="@item.Title" selected="@(isSelected ? "selected" : null)">@Html.Raw(item.Title)</option>
                                    }
                                    @foreach (var custom in selectedCourses)
                                    {
                                        if (!allCourses.Any(x => string.Equals(x.Title, custom, StringComparison.OrdinalIgnoreCase)))
                                        {
                                            <option value="@custom" selected="selected">@Html.Raw(custom)</option>
