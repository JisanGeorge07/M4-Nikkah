                                    <br />
                                    <img src="@Html.Raw("/" + enquiry.ImagePath)" width="180">
                                    <br />
                                }
                                else
                                {
                                    <br />
                                    <img src="@Url.Content(string.Equals(enquiry.Gender, "Female", StringComparison.OrdinalIgnoreCase) ? "/assets/images/default-user-women.png" : "/assets/images/default-user-men.png")"
