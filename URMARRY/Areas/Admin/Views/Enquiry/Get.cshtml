@model URMARRY.Areas.Admin.Models.EnquiryViewModel
@{
    ViewBag.Title = "Enquiry";
    // Layout = "/Views/Shared/_Layout.cshtml";
    var enquiry = Model.Enquiry!;
    var MaritalStatuses = Model.MaritalStatuses!;
    var ProfileFor = Model.ProfileFor!;
    var Nationalities = Model.Nationalities!;
    var States = Model.States!;
    var Districts = Model.Districts!;
    var Cities = Model.Cities!;
    var BodyFeatures = Model.BodyFeatures!;
    var Professions = Model.Professions!;
    var MotherTongues = Model.MotherTongues!;
    var Communities = Model.Communities!;
    var Religiousnesses = Model.Religiousnesses!;
    var FinancialStatuses = Model.FinancialStatuses!;
    var ReligionCastes = Model.ReligionCastes!;
    DateTime myDate = DateTime.Now.AddYears(-20);
    if (!string.IsNullOrWhiteSpace(enquiry.DOB))
    {
        string[] formats = { "dd/MM/yyyy", "yyyy-MM-dd", "dd-MM-yyyy", "MM/dd/yyyy", "yyyy/MM/dd", "d/M/yyyy", "d-M-yyyy" };
        if (!DateTime.TryParseExact(enquiry.DOB.Trim(), formats, System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out myDate))
        {
            DateTime.TryParse(enquiry.DOB, out myDate);
        }
    }

    var primaryCountryCode = !string.IsNullOrEmpty(enquiry.CountryCode) 
        ? Application.Helpers.CountryCodeHelper.GetCountryCode(enquiry.CountryCode) 
        : (!string.IsNullOrEmpty(enquiry.Country) ? Application.Helpers.CountryCodeHelper.GetCountryCode(enquiry.Country) : "+91");

    var secondaryCountryCode = !string.IsNullOrEmpty(enquiry.SecondaryCountryCode) 
        ? Application.Helpers.CountryCodeHelper.GetCountryCode(enquiry.SecondaryCountryCode) 
        : (!string.IsNullOrEmpty(enquiry.PresentCountry) ? Application.Helpers.CountryCodeHelper.GetCountryCode(enquiry.PresentCountry) : "+91");
}

@section Title
{
    <a asp-action="MemberList" asp-controller="Enquiry" asp- class="btn btn-primary btn-xs">
        <i class="fas fa-arrow-left"></i>
    </a>
    Enquiry
}

<div class="row">
    <div class="col-12">
        <div class="card">

            <div class="card-body" id="ModalUser">
