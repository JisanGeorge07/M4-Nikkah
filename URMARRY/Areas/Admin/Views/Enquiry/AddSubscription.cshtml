@model dynamic
@{
    ViewBag.Title = "Add Subscription";
}

@section Title
{
   Add Manual Subscription
}

<div class="row">
    <div class="col-md-6 offset-md-3">
        <div class="card">
            <div class="card-header">
                <h4 class="card-title">Add Manual Subscription</h4>
                <p class="card-title-desc">Enter the user details and payment information to manually upgrade a member.</p>
            </div>
            <div class="card-body">
                <form asp-action="AddManualSubscription" method="post">
                    <div asp-validation-summary="All" class="text-danger"></div>

                    <div class="mb-3">
                        <label class="form-label" for="regId">Registration ID</label>
                        <div class="input-group">
                            <input type="text" class="form-control" id="regId" name="regId" placeholder="Enter Registration ID (e.g. M4N...)" required>
                            <button class="btn btn-outline-secondary" type="button" id="btnFetchUser">Fetch Details</button>
                        </div>
                    </div>

                    <div id="userDetails" style="display:none;" class="alert alert-secondary mb-3">
                        <p class="mb-1"><strong>Name:</strong> <span id="lblUserName"></span></p>
                        <p class="mb-1"><strong>Phone:</strong> <span id="lblUserPhone"></span></p>
                        <p class="mb-0"><strong>Email:</strong> <span id="lblUserEmail"></span></p>
                    </div>

                    <div class="mb-3">
                        <label class="form-label" for="manualTxnId">Transaction ID / Reference <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="manualTxnId" name="txnId" placeholder="Enter Transaction Reference" required autocomplete="off">
                        <div id="txnIdFeedback" class="font-size-12 mt-1"></div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label" for="offlinePaymentType">Offline Payment Type</label>
                        <select class="form-control" id="offlinePaymentType" name="offlinePaymentType" required>
                            <option value="">-- Select Offline Payment Type --</option>
                            <option value="0">UPI Payment</option>
                            <option value="1">Bank Payment</option>
                            <option value="2">Cash Payment</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label" for="manualAmount">Amount Paid</label>
                        <input type="number" class="form-control" id="manualAmount" name="amount" placeholder="Enter Amount" required min="1" step="0.01">
                    </div>

                    <div class="mt-4">
                        <button type="submit" id="btnSubmitSubscription" class="btn btn-primary w-md">Save Subscription</button>
                        <a asp-action="GetAllTransaction" class="btn btn-secondary w-md ms-2">Back to List</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            var isTxnValid = false;
            var txnCheckTimeout = null;

            $('#btnFetchUser').click(function () {
                var regId = $('#regId').val();
                if (!regId) {
                    alert('Please enter Registration ID');
                    return;
                }

                $.get('/admin/enquiry/get-user-by-regid/' + encodeURIComponent(regId), function (data) {
                    if (data) {
                        $('#lblUserName').text(data.name);
                        $('#lblUserPhone').text(data.phone);
                        $('#lblUserEmail').text(data.email);
                        $('#userDetails').show();
                    } else {
                        alert('User not found with this Registration ID');
                        $('#userDetails').hide();
                    }
                });
            });

            function checkTxnAvailability() {
                var txnId = $('#manualTxnId').val().trim();
                var $feedback = $('#txnIdFeedback');
                var $input = $('#manualTxnId');

                if (!txnId) {
                    $feedback.html('').removeClass('text-success text-danger');
                    $input.removeClass('is-valid is-invalid');
                    isTxnValid = false;
                    return;
                }

                $feedback.html('<i class="fas fa-spinner fa-spin me-1"></i> Checking availability...').removeClass('text-success text-danger').addClass('text-muted');

                $.get('/admin/enquiry/check-txnid-availability', { txnId: txnId }, function (res) {
                    if (res && res.available) {
                        $feedback.html('<i class="fas fa-check-circle me-1"></i> ' + res.message).removeClass('text-muted text-danger').addClass('text-success');
                        $input.removeClass('is-invalid').addClass('is-valid');
                        isTxnValid = true;
                    } else {
                        $feedback.html('<i class="fas fa-times-circle me-1"></i> ' + (res ? res.message : 'Transaction ID is already in use.')).removeClass('text-muted text-success').addClass('text-danger');
                        $input.removeClass('is-valid').addClass('is-invalid');
                        isTxnValid = false;
                    }
                }).fail(function () {
                    $feedback.html('<i class="fas fa-exclamation-triangle me-1"></i> Error checking Transaction ID.').removeClass('text-muted text-success').addClass('text-danger');
                    isTxnValid = false;
                });
            }

            $('#manualTxnId').on('input paste', function () {
                clearTimeout(txnCheckTimeout);
                txnCheckTimeout = setTimeout(checkTxnAvailability, 400);
            });

            $('#manualTxnId').on('blur', function () {
                clearTimeout(txnCheckTimeout);
                checkTxnAvailability();
            });

            $('form[asp-action="AddManualSubscription"]').on('submit', function (e) {
                var txnId = $('#manualTxnId').val().trim();
                if (!txnId) {
                    alert('Please enter Transaction ID.');
                    $('#manualTxnId').focus();
                    e.preventDefault();
                    return false;
                }

                if ($('#manualTxnId').hasClass('is-invalid')) {
                    alert('This Transaction ID is already used. Please enter a unique Transaction ID.');
                    $('#manualTxnId').focus();
                    e.preventDefault();
                    return false;
                }
            });
        });
    </script>
}
