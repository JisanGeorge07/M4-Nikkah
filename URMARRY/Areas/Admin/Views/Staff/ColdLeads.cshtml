@{
    ViewBag.Title = "Assigned Cold Leads";
}

@section Title
{
    Assigned Cold Leads
}

<div class="row">
    <div class="col-12">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-light d-flex align-items-center justify-content-between flex-wrap gap-3 py-3 border-bottom-0">
                <h5 class="card-title mb-0"><i class="fas fa-headset me-2 text-primary"></i>Cold Lead Follow-ups</h5>

                <div class="d-flex align-items-center gap-2 flex-wrap ms-auto">
                    <select id="staffFilter" class="form-select form-select-sm" style="width: 200px; border-radius: 6px;">
                        <option value="">All Staff Leads</option>
                        @if (ViewBag.StaffList != null)
                        {
                            foreach (var staff in ViewBag.StaffList)
                            {
                                bool isSel = ViewBag.SelectedStaffId != null && (long)ViewBag.SelectedStaffId == (long)staff.Id;
                                if (isSel)
                                {
                                    <option value="@staff.Id" selected="selected">@staff.Name</option>
                                }
                                else
                                {
                                    <option value="@staff.Id">@staff.Name</option>
                                }
                            }
                        }
                    </select>

                    <select id="statusFilter" class="form-select form-select-sm" style="width: 180px; border-radius: 6px;">
                        <option value="">All Statuses</option>
                        <option value="0">Pending</option>
                        <option value="1">Partially Completed</option>
                        <option value="2">Completed</option>
                        <option value="3">Not Interested</option>
                    </select>
                </div>
            </div>

            <div class="card-body">
                <table id="staffColdLeadTable" class="table table-striped table-bordered dt-responsive nowrap w-100">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Name</th>
                            <th>Phone Number</th>
                            <th>Assigned Staff</th>
                            <th>Status</th>
                            <th>Remarks</th>
                            <th>Created Date</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Update Status Modal -->
<div class="modal fade" id="updateStatusModal" tabindex="-1" aria-labelledby="updateStatusModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="updateStatusModalLabel">Update Lead Status</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="updateStatusForm">
                <input type="hidden" id="leadId" name="id" />
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Lead Name:</label>
                        <p id="leadNameText" class="text-secondary mb-0"></p>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Phone Number:</label>
                        <p id="leadPhoneText" class="text-secondary mb-0"></p>
                    </div>
                    <div class="mb-3">
                        <label for="leadStatusSelect" class="form-label fw-bold">Update Status <span class="text-danger">*</span></label>
                        <select class="form-select" id="leadStatusSelect" name="status" required>
                            <option value="0">Pending</option>
                            <option value="1">Partially Completed</option>
                            <option value="2">Completed</option>
                            <option value="3">Not Interested</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="leadRemarksInput" class="form-label fw-bold">Remarks / Contact Notes</label>
                        <textarea class="form-control" id="leadRemarksInput" name="remarks" rows="3" placeholder="Add contact notes or updates..."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-success">Update Status</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            var table = $('#staffColdLeadTable').DataTable({
                processing: true,
                serverSide: true,
                ajax: {
                    url: '/admin/staff/cold-leads-data',
                    type: 'POST',
                    data: function (d) {
                        d.staffId = $('#staffFilter').val();
                        d.statusFilter = $('#statusFilter').val();
                    }
                },
                columns: [
                    { data: null, render: function (data, type, row, meta) { return meta.row + 1; } },
                    { data: 'name' },
                    { 
                        data: 'phoneNumber',
                        render: function(data) {
                            return '<a href="tel:' + data + '" class="text-decoration-none fw-semibold"><i class="fas fa-phone-alt text-success me-1"></i>' + data + '</a>';
                        }
                    },
                    { 
                        data: 'assignedStaffName', 
                        render: function (data) { 
                            return '<span class="badge bg-soft-primary text-primary font-size-12 px-2 py-1"><i class="fas fa-user me-1"></i>' + data + '</span>'; 
                        } 
                    },
                    {
                        data: 'status',
                        render: function (data, type, row) {
                            switch (data) {
                                case 0:
                                    return '<span class="badge bg-warning text-dark px-2 py-1">Pending</span>';
                                case 1:
                                    return '<span class="badge bg-info text-white px-2 py-1">Partially Completed</span>';
                                case 2:
                                    return '<span class="badge bg-success px-2 py-1">Completed</span>';
                                case 3:
                                    return '<span class="badge bg-danger px-2 py-1">Not Interested</span>';
                                default:
                                    return '<span class="badge bg-secondary px-2 py-1">Unknown</span>';
                            }
                        }
                    },
                    { data: 'remarks' },
                    { data: 'createdOn' },
                    {
                        data: null,
                        orderable: false,
                        render: function (data, type, row) {
                            return `
                                <button class="btn btn-sm btn-primary update-status-btn" data-lead='${JSON.stringify(row)}'>
                                    <i class="fas fa-sync-alt me-1"></i> Update Status
                                </button>
                            `;
                        }
                    }
                ]
            });

            $('#staffFilter, #statusFilter').change(function () {
                table.draw();
            });

            $(document).on('click', '.update-status-btn', function () {
                var lead = $(this).data('lead');
                $('#leadId').val(lead.id);
                $('#leadNameText').text(lead.name);
                $('#leadPhoneText').text(lead.phoneNumber);
                $('#leadStatusSelect').val(lead.status);
                $('#leadRemarksInput').val(lead.remarks);
                $('#updateStatusModal').modal('show');
            });

            $('#updateStatusForm').submit(function (e) {
                e.preventDefault();
                var $btn = $(this).find('button[type="submit"]');
                var originalHtml = $btn.html();
                $btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span> Updating...');

                $.ajax({
                    url: '/admin/staff/update-cold-lead-status',
                    type: 'POST',
                    data: $(this).serialize(),
                    success: function (res) {
                        if (res.success) {
                            Swal.fire('Updated!', res.message, 'success');
                            $('#updateStatusModal').modal('hide');
                            table.draw();
                        } else {
                            Swal.fire('Error', res.message, 'error');
                        }
                    },
                    error: function () {
                        Swal.fire('Error', 'Failed to update status.', 'error');
                    },
                    complete: function () {
                        $btn.prop('disabled', false).html(originalHtml);
                    }
                });
            });
        });
    </script>
}
