@{
    ViewBag.Title = "Admin Review Panel";
}

@section Title
{
    Admin Review Panel
}

<div class="row">
    <div class="col-12">
        <div class="card shadow-sm border-0">
            <!-- Header section with custom filters -->
            <div class="card-header bg-light d-flex align-items-center justify-content-between flex-wrap gap-3 py-3 border-bottom-0">
                <div class="d-flex align-items-center gap-2 flex-wrap w-100">
                    <!-- Search Field -->
                    <div class="form-group mb-0 position-relative" style="min-width: 200px;">
                        <input type="text" class="form-control form-control-sm" placeholder="Search By Name/ID/Phone"
                               id="searchInput" style="padding-right: 32px; border-radius: 6px;"/>
                        <i class="bi bi-search position-absolute text-muted" style="top: 50%; right: 10px; transform: translateY(-50%); pointer-events: none;"></i>
                    </div>

                    <!-- Staff Filter -->
                    <select id="staffFilter" class="form-select form-select-sm" style="width: 180px; border-radius: 6px;">
                        <option value="">All Staff</option>
                        @if (ViewBag.StaffList != null)
                        {
                            foreach (var staff in ViewBag.StaffList)
                            {
                                <option value="@staff.Id">@staff.Name</option>
                            }
                        }
                    </select>

                    <!-- Approval Status Filter -->
                    <select id="approvalStatusFilter" class="form-select form-select-sm" style="width: 180px; border-radius: 6px;">
                        <option value="">All Decisions</option>
                        <option value="0" selected>Pending Review</option>
                        <option value="1">Approved</option>
                        <option value="2">Rejected</option>
                    </select>
                </div>
            </div>
            
            <div class="card-body">
                <div class="table-responsive">
                    <table id="adminReviewTable" class="table table-hover table-striped w-100 align-middle">
                        <thead class="table-light text-uppercase font-size-12">
                            <tr>
                                <th width="12%">Profile ID</th>
                                <th width="15%">Customer</th>
                                <th width="15%">Assigned Staff</th>
                                <th width="15%">Follow-up Type</th>
                                <th width="15%">Reached End Status</th>
                                <th width="15%">Latest Remarks</th>
                                <th width="8%">Decision</th>
                                <th width="8%" class="text-center sorting_disabled">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Review Action Modal -->
<div class="modal fade" id="reviewActionModal" tabindex="-1" aria-labelledby="reviewActionModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 12px;">
            <div class="modal-header bg-primary text-white py-3 px-4" style="border-top-left-radius: 12px; border-top-right-radius: 12px;">
                <h5 class="modal-title fw-bold text-white" id="reviewActionModalLabel">
                    <i class="bi bi-shield-check me-2"></i> Review Follow-up Decision
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="reviewActionForm">
                <div class="modal-body p-4">
                    <input type="hidden" id="reviewFollowUpId" />
                    
                    <div class="mb-3">
                        <div class="card bg-light border-0 p-3" style="border-radius: 8px;">
                            <div class="row g-2">
                                <div class="col-6">
                                    <span class="text-muted font-size-11 text-uppercase fw-semibold d-block">Customer</span>
                                    <span id="reviewCustomerName" class="fw-bold text-dark"></span>
                                </div>
                                <div class="col-6">
                                    <span class="text-muted font-size-11 text-uppercase fw-semibold d-block">Profile ID</span>
                                    <span id="reviewRegisterNumber" class="fw-bold text-primary"></span>
                                </div>
                                <div class="col-6 mt-2">
                                    <span class="text-muted font-size-11 text-uppercase fw-semibold d-block">Type</span>
                                    <span id="reviewFollowUpType" class="badge bg-secondary"></span>
                                </div>
                                <div class="col-6 mt-2">
                                    <span class="text-muted font-size-11 text-uppercase fw-semibold d-block">End Status reached</span>
                                    <span id="reviewEndStatus" class="fw-bold text-danger"></span>
                                </div>
                                <div class="col-12 mt-2">
                                    <span class="text-muted font-size-11 text-uppercase fw-semibold d-block">Staff Remarks</span>
                                    <p id="reviewStaffRemarks" class="text-muted mb-0 font-size-13 style-italic"></p>
                                </div>
                                <div class="col-12 mt-2" id="reviewOfflinePaymentSection" style="display:none;">
                                    <span class="text-muted font-size-11 text-uppercase fw-semibold d-block">Offline Payment Details (Submitted by Staff)</span>
                                    <div class="p-2.5 mt-1 rounded border" style="background-color: #f0fdf4; border-color: #bbf7d0 !important;">
                                        <div class="row g-2 font-size-13">
                                            <div class="col-6">
                                                <span class="text-muted font-size-11 text-uppercase d-block">Transaction Reference</span>
                                                <span id="reviewTxnId" class="fw-bold text-dark font-monospace"></span>
                                            </div>
                                            <div class="col-6">
                                                <span class="text-muted font-size-11 text-uppercase d-block">Payment Type</span>
                                                <span id="reviewPaymentType" class="badge bg-success"></span>
                                            </div>
                                            <div class="col-12 mt-1">
                                                <span class="text-muted font-size-11 text-uppercase d-block">Amount</span>
                                                <span id="reviewAmount" class="fw-bold text-success font-size-14"></span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-12 mt-2" id="reviewDocSection" style="display:none;">
                                    <span class="text-muted font-size-11 text-uppercase fw-semibold d-block">Verification Document(s) & Staff Action</span>
                                    <div class="d-flex align-items-center flex-wrap gap-2 mt-1" id="reviewDocLinksContainer">
                                        <a id="btnAdminSeeDocument" href="#" target="_blank" class="btn btn-sm btn-info text-white" style="border-radius: 6px;"><i class="bi bi-file-earmark-medical me-1"></i> See Document</a>
                                    </div>
                                    <div class="mt-2">
                                        <span id="reviewDocCompleteBadge" class="badge"></span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3" id="reviewGradeSection" style="display:none;">
                        <label for="reviewVerificationGrade" class="form-label fw-semibold">Verification Grade (Female Profile) <span class="text-danger">*</span></label>
                        <select class="form-select" id="reviewVerificationGrade" style="border-radius: 6px;">
                            <option value="">-- Select Grade --</option>
                            <option value="A">Grade A</option>
                            <option value="B">Grade B</option>
                            <option value="C">Grade C</option>
                            <option value="D">Grade D</option>
                        </select>
                        <small class="text-muted font-size-12">Staff profile verification incentive will be calculated based on this selected grade.</small>
                    </div>

                    <div class="mb-3">
                        <label for="reviewAdminRemarks" class="form-label fw-semibold">Admin Remarks / Instructions <span class="text-danger">*</span></label>
                        <textarea class="form-control" id="reviewAdminRemarks" rows="3" required placeholder="Provide feedback or action instructions..." style="border-radius: 6px; resize: none;"></textarea>
                    </div>
                </div>
                <div class="modal-footer border-top px-4 py-3 bg-light d-flex justify-content-between" style="border-bottom-left-radius: 12px; border-bottom-right-radius: 12px;">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" style="border-radius: 6px;">Cancel</button>
                    <div class="d-flex gap-2">
                        <button type="button" id="btnReject" class="btn btn-danger d-flex align-items-center gap-1" style="border-radius: 6px;">
                            <i class="bi bi-x-circle"></i> Reject Decision
                        </button>
                        <button type="button" id="btnApprove" class="btn btn-success d-flex align-items-center gap-1" style="border-radius: 6px;">
                            <i class="bi bi-check-circle"></i> Approve Decision
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    $(document).ready(function () {
        var currentSelectedRow = null;

        var table = $('#adminReviewTable').DataTable({
            processing: true,
            serverSide: true,
            searching: false,
            ajax: {
                url: "/admin/staff/admin-review-panel-data",
                type: "POST",
                data: function (d) {
                    d.staffId = $('#staffFilter').val() || null;
                    d.approvalStatus = $('#approvalStatusFilter').val() !== "" ? parseInt($('#approvalStatusFilter').val()) : null;
                    d.searchName = $('#searchInput').val();
                }
            },
            columns: [
                {
                    data: "registerNumber",
                    render: function (data, type, row) {
                        if (!data || data === 'N/A') return '<span class="text-muted font-size-12">N/A</span>';
                        var profileId = row.profileId || row.id;
                        return '<a href="/admin/staff/profile/' + profileId + '" class="fw-semibold text-primary text-decoration-underline" title="View Full Profile Details">' + data + '</a>';
                    }
                },
                {
                    data: "customerName",
                    render: function (data, type, row) {
                        return data || 'N/A';
                    }
                },
                {
                    data: "staffName",
                    render: function (data, type, row) {
                        if (data && data !== "Unassigned") {
                            return '<span class="badge badge-soft-info font-size-11 px-2 py-1" style="background-color: rgba(23, 162, 184, 0.15); color: #17a2b8; border: 1px solid rgba(23, 162, 184, 0.25);"><i class="fas fa-user-circle me-1"></i> ' + data + '</span>';
                        }
                        return '<span class="text-muted font-size-12">Unassigned</span>';
                    }
                },
                {
                    data: "followUpType",
                    render: function (data, type, row) {
                        var badgeClass = "bg-secondary";
                        if (data === "ProfileVerification") badgeClass = "bg-info text-dark";
                        else if (data === "PremiumFollowUp") badgeClass = "bg-warning text-dark";
                        else if (data === "RenewalFollowUp") badgeClass = "bg-success text-white";
                        return '<span class="badge ' + badgeClass + '">' + data + '</span>';
                    }
                },
                {
                    data: "endStatus",
                    render: function (data, type, row) {
                        return '<span class="fw-semibold text-danger">' + (data || 'N/A') + '</span>';
                    }
                },
                {
                    data: "latestRemarks",
                    render: function (data, type, row) {
                        return data || 'N/A';
                    }
                },
                {
                    data: "approvalStatus",
                    render: function (data, type, row) {
                        if (data === "Approved") {
                            return '<span class="badge bg-success">Approved</span>';
                        } else if (data === "Rejected") {
                            return '<span class="badge bg-danger">Rejected</span>';
                        } else {
                            return '<span class="badge bg-warning text-dark">Pending Review</span>';
                        }
                    }
                },
                {
                    data: "id",
                    orderable: false,
                    className: "text-center",
                    render: function (data, type, row) {
                        if (row.approvalStatus === "Pending") {
                            return '<button class="btn btn-primary btn-sm btn-review px-3 py-1 d-flex align-items-center justify-content-center gap-1 mx-auto" data-id="' + data + '" style="border-radius: 6px; font-weight: 500;"><i class="bi bi-shield-lock"></i> Review</button>';
                        } else {
                            return '<button class="btn btn-secondary btn-sm btn-review px-3 py-1 d-flex align-items-center justify-content-center gap-1 mx-auto" data-id="' + data + '" style="border-radius: 6px; font-weight: 500;"><i class="bi bi-eye"></i> View</button>';
                        }
                    }
                }
            ],
            order: []
        });

        // Trigger table refresh on filter change
        $('#staffFilter, #approvalStatusFilter').change(function () {
            table.ajax.reload();
        });

        var typingTimer;
        $('#searchInput').on('keyup', function () {
            clearTimeout(typingTimer);
            typingTimer = setTimeout(function () {
                table.ajax.reload();
            }, 400);
        });

        var reviewModal = new bootstrap.Modal(document.getElementById('reviewActionModal'));

        // Handle Review button click
        $('#adminReviewTable').on('click', '.btn-review', function () {
            var rowData = table.row($(this).parents('tr')).data();
            currentSelectedRow = rowData;
            
            $('#reviewFollowUpId').val(rowData.id);
            $('#reviewCustomerName').text(rowData.customerName);
            var profileId = rowData.profileId || rowData.id;
            $('#reviewRegisterNumber').html('<a href="/admin/staff/profile/' + profileId + '" class="fw-bold text-primary text-decoration-underline" title="View Full Profile Details">' + (rowData.registerNumber || 'N/A') + '</a>');
            $('#reviewFollowUpType').text(rowData.followUpType);
            $('#reviewEndStatus').text(rowData.endStatus);
            $('#reviewStaffRemarks').text(rowData.latestRemarks);
            $('#reviewAdminRemarks').val('');

            var isProfileVerification = (rowData.followUpType === "ProfileVerification");
            var docsList = rowData.verificationDocuments || [];

            if (isProfileVerification && (docsList.length > 0 || rowData.verificationDocumentUrl)) {
                $('#reviewDocSection').show();
                var linksHtml = '';
                if (docsList.length > 0) {
                    docsList.forEach(function (doc, idx) {
                        var docLabel = doc.originalFileName || doc.documentType || ('Document ' + (idx + 1));
                        var docPath = doc.documentUrl.startsWith('/') ? doc.documentUrl : '/' + doc.documentUrl;
                        linksHtml += '<a href="' + docPath + '" target="_blank" class="btn btn-sm btn-info text-white font-size-12" style="border-radius: 6px;"><i class="bi bi-file-earmark-medical me-1"></i> ' + docLabel + '</a>';
                    });
                } else if (rowData.verificationDocumentUrl) {
                    var fullUrl = rowData.verificationDocumentUrl.startsWith('/') ? rowData.verificationDocumentUrl : '/' + rowData.verificationDocumentUrl;
                    linksHtml = '<a href="' + fullUrl + '" target="_blank" class="btn btn-sm btn-info text-white font-size-12" style="border-radius: 6px;"><i class="bi bi-file-earmark-medical me-1"></i> See Document</a>';
                }
                $('#reviewDocLinksContainer').html(linksHtml);

                if (rowData.documentVerificationComplete === true) {
                    $('#reviewDocCompleteBadge').attr('class', 'badge bg-success').text('Staff Action: Verify Complete');
                } else if (rowData.documentVerificationComplete === false) {
                    $('#reviewDocCompleteBadge').attr('class', 'badge bg-danger').text('Staff Action: Verify Reject');
                } else {
                    $('#reviewDocCompleteBadge').attr('class', 'badge bg-warning text-dark').text('Staff Action: Pending Review');
                }
            } else {
                $('#reviewDocSection').hide();
            }

            // Check if Offline payment details exist
            if (rowData.paymentMode === 'Offline' || rowData.transactionId || rowData.paymentAmount) {
                $('#reviewOfflinePaymentSection').show();
                $('#reviewTxnId').text(rowData.transactionId || 'N/A');
                $('#reviewPaymentType').text(rowData.offlinePaymentType || 'Offline');
                $('#reviewAmount').text(rowData.paymentAmount ? ('₹ ' + rowData.paymentAmount) : 'N/A');
            } else {
                $('#reviewOfflinePaymentSection').hide();
            }

            var isFemale = (rowData.gender && rowData.gender.toLowerCase() === "female");
            if (isProfileVerification && isFemale) {
                $('#reviewGradeSection').show();
                if (rowData.verificationGrade) {
                    $('#reviewVerificationGrade').val(rowData.verificationGrade);
                } else {
                    $('#reviewVerificationGrade').val('');
                }
                if (rowData.approvalStatus !== "Pending") {
                    $('#reviewVerificationGrade').prop('disabled', true);
                } else {
                    $('#reviewVerificationGrade').prop('disabled', false);
                }
            } else {
                $('#reviewGradeSection').hide();
                $('#reviewVerificationGrade').val('');
            }

            if (rowData.approvalStatus !== "Pending") {
                $('#btnApprove, #btnReject').hide();
                $('#reviewAdminRemarks').prop('disabled', true).val('Decision reached: ' + rowData.approvalStatus);
            } else {
                $('#btnApprove, #btnReject').show();
                $('#reviewAdminRemarks').prop('disabled', false);
            }

            reviewModal.show();
        });

        // Handle decision post (Standard)
        function postDecision(isApproved, extraParams) {
            var followUpId = parseInt($('#reviewFollowUpId').val());
            var remarks = $('#reviewAdminRemarks').val();

            if (!remarks || remarks.trim() === "") {
                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: 'Admin remarks are required to submit the decision.',
                    confirmButtonColor: '#d33'
                });
                return;
            }

            Swal.fire({
                title: isApproved ? 'Approving...' : 'Rejecting...',
                html: 'Please wait while we save your decision.',
                allowOutsideClick: false,
                didOpen: () => {
                    Swal.showLoading();
                }
            });

            var payload = {
                FollowUpId: followUpId,
                IsApproved: isApproved,
                Remarks: remarks
            };

            if (extraParams) {
                $.extend(payload, extraParams);
            }

            $.ajax({
                url: '/admin/staff/admin-review-action',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(payload),
                success: function (response) {
                    if (response.success) {
                        Swal.fire({
                            icon: 'success',
                            title: 'Saved!',
                            text: response.message,
                            confirmButtonColor: '#28a745',
                            timer: 2500
                        }).then(function () {
                            reviewModal.hide();
                            table.ajax.reload(null, false);
                            if (response.whatsappUrl) {
                                window.open(response.whatsappUrl, '_blank');
                            }
                        });
                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: 'Failed',
                            text: response.message,
                            confirmButtonColor: '#d33'
                        });
                    }
                },
                error: function (xhr, status, error) {
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: 'An error occurred on the server: ' + error,
                        confirmButtonColor: '#d33'
                    });
                }
            });
        }

        $('#btnApprove').click(function () {
            var isProfileVerification = currentSelectedRow && (currentSelectedRow.followUpType === "ProfileVerification");
            var isFemale = currentSelectedRow && currentSelectedRow.gender && (currentSelectedRow.gender.toLowerCase() === "female");
            var extraParams = {};

            if (isProfileVerification && isFemale) {
                var selectedGrade = $('#reviewVerificationGrade').val();
                if (!selectedGrade) {
                    Swal.fire({
                        icon: 'warning',
                        title: 'Select Verification Grade',
                        text: 'Please select a Verification Grade (Grade A, B, C, or D) for this female profile before approving.',
                        confirmButtonColor: '#3085d6'
                    });
                    return;
                }
                extraParams.VerificationGrade = selectedGrade;
            }

            postDecision(true, extraParams);
        });

        $('#btnReject').click(function () {
            postDecision(false);
        });
    });
</script>
}
