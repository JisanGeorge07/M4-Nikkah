@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <script>
        $(document).ready(function () {
            // ─── DataTables ────────────────────────────────────
            $('#comparisonTable').DataTable({
                responsive: true,
                ordering: true,
                pageLength: 25,
                dom: 'Bfrtip',
                buttons: ['copy', 'excel', 'print'],
                order: [[4, 'desc']]
            });

            $('#payrollTable').DataTable({
                responsive: true,
                ordering: true,
                pageLength: 25,
                dom: 'Bfrtip',
                buttons: [
                    {
                        extend: 'copy',
                        exportOptions: { columns: ':not(:first-child):not(:last-child)' }
                    },
                    {
                        extend: 'excel',
                        title: 'Staff Payroll Register',
                        exportOptions: { columns: ':not(:first-child):not(:last-child)' }
                    },
                    {
                        text: '<i class="fas fa-file-pdf me-1"></i> PDF',
                        className: 'btn btn-secondary btn-sm',
                        action: function () {
                            printTableAsPdf('payrollTable', 'Staff Payroll Register');
                        }
                    },
                    {
                        extend: 'print',
                        title: 'Staff Payroll Register',
                        exportOptions: { columns: ':not(:first-child):not(:last-child)' }
                    }
                ],
                columnDefs: [{ orderable: false, targets: [0, 11] }]
            });

            // ─── Print Table As PDF (opens print window) ─────
            function printTableAsPdf(tableId, title) {
                var $table = $('#' + tableId);
                var $clone = $table.clone();

                // Remove first column (checkbox) and last column (Actions)
                $clone.find('tr').each(function () {
                    $(this).find('th:first-child, td:first-child').remove();
                    $(this).find('th:last-child, td:last-child').remove();
                });

                $clone.find('input, button, .btn, select').remove();
                $clone.removeAttr('id');
                $clone.find('[id]').removeAttr('id');

                var printWin = window.open('', '_blank', 'width=1200,height=900');
                if (!printWin) {
                    Swal.fire('Blocked', 'Popup blocker prevented opening the PDF. Please allow popups for this site.', 'warning');
                    return;
                }

                var html = '<!DOCTYPE html><html><head><title>' + title + '</title>' +
                    '<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">' +
                    '<style>' +
                    'body { padding: 20px; font-family: "Segoe UI", sans-serif; background: #fff; color: #212529; }' +
                    '.header-title { color: #00662d; font-weight: 700; }' +
                    'table { font-size: 11px; }' +
                    'table thead th { background-color: #00662d !important; color: #fff !important; font-size: 10px; white-space: nowrap; padding: 6px 4px !important; }' +
                    'table td { padding: 6px 4px !important; white-space: nowrap; }' +
                    '.badge { font-size: 11px; padding: 4px 8px; border-radius: 4px; font-weight: 600; display: inline-block; }' +
                    '.bg-warning, .badge-soft-warning { background-color: #fff8e6 !important; color: #b78103 !important; border: 1px solid #ffe5b4; }' +
                    '.bg-success, .badge-soft-success { background-color: #e8f5e9 !important; color: #00662d !important; border: 1px solid #c8e6c9; }' +
                    '.bg-secondary, .badge-soft-secondary { background-color: #f1f3f5 !important; color: #495057 !important; border: 1px solid #dee2e6; }' +
                    '.bg-danger, .badge-soft-danger { background-color: #ffebee !important; color: #c62828 !important; border: 1px solid #ffcdd2; }' +
                    '.bg-info, .badge-soft-info { background-color: #e3f2fd !important; color: #1565c0 !important; border: 1px solid #bbdefb; }' +
                    '@@media print { body { padding: 10px; } }' +
                    '@@page { size: landscape; margin: 10mm; }' +
                    '</style></head><body>' +
                    '<div class="text-center mb-3">' +
                    '<h4 class="header-title">' + title + '</h4>' +
                    '<p class="text-muted mb-0" style="font-size:12px;">Generated on ' + new Date().toLocaleDateString('en-IN') + '</p>' +
                    '<hr></div>' +
                    '<div class="table-responsive">' + $clone[0].outerHTML + '</div>' +
                    '<div class="text-center mt-4 text-muted small">' +
                    '<em>M4 Nikah — System Generated Report. Use browser\'s "Save as PDF" to download.</em></div>' +
                    '<script>window.onload = function() { setTimeout(function() { window.print(); }, 500); };<\/script>' +
                    '</body></html>';

                printWin.document.write(html);
                printWin.document.close();
            }



            // ─── Charts ───────────────────────────────────────
            var staffNames = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.StaffRows.Select(r => r.StaffName).ToArray()));
            var convBoys = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.StaffRows.Select(r => r.PremiumConversionsBoys).ToArray()));
            var convGirls = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.StaffRows.Select(r => r.PremiumConversionsGirls).ToArray()));

            if (staffNames.length > 0) {
                // Conversion Chart
                new Chart(document.getElementById('conversionChart'), {
                    type: 'bar',
                    data: {
                        labels: staffNames,
                        datasets: [
                            {
                                label: 'Boys (Male)',
                                data: convBoys,
                                backgroundColor: 'rgba(85, 110, 230, 0.7)',
                                borderColor: 'rgba(85, 110, 230, 1)',
                                borderWidth: 1,
                                borderRadius: 4
                            },
                            {
                                label: 'Girls (Female)',
                                data: convGirls,
                                backgroundColor: 'rgba(244, 106, 106, 0.7)',
                                borderColor: 'rgba(244, 106, 106, 1)',
                                borderWidth: 1,
                                borderRadius: 4
                            }
                        ]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { legend: { position: 'top' } },
                        scales: { y: { beginAtZero: true, ticks: { stepSize: 1 } } }
                    }
                });

                // Collection Pie Chart
                new Chart(document.getElementById('collectionPieChart'), {
                    type: 'doughnut',
                    data: {
                        labels: ['Boys (Male)', 'Girls (Female)'],
                        datasets: [{
                            data: [@Model.OrgAggregates.TotalPremiumCollectionBoys, @Model.OrgAggregates.TotalPremiumCollectionGirls],
                            backgroundColor: ['rgba(85, 110, 230, 0.8)', 'rgba(244, 106, 106, 0.8)'],
                            borderWidth: 2
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { legend: { position: 'bottom' }, title: { display: true, text: 'Collection Split (Boys vs Girls)' } }
                    }
                });

                // Grade Donut
                new Chart(document.getElementById('gradeDonutChart'), {
                    type: 'doughnut',
                    data: {
                        labels: ['Grade A', 'Grade B', 'Grade C', 'Grade D'],
                        datasets: [{
                            data: [@Model.OrgAggregates.OrgVerificationGradeA, @Model.OrgAggregates.OrgVerificationGradeB, @Model.OrgAggregates.OrgVerificationGradeC, @Model.OrgAggregates.OrgVerificationGradeD],
                            backgroundColor: ['rgba(52,195,143,0.8)', 'rgba(85,110,230,0.8)', 'rgba(241,180,76,0.8)', 'rgba(244,106,106,0.8)'],
                            borderWidth: 2
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { legend: { position: 'bottom' }, title: { display: true, text: 'Verification Grade Distribution' } }
                    }
                });
            }

            // ─── Payroll Checkbox Logic ───────────────────────
            $('#selectAllPayroll').on('change', function () {
                var checked = $(this).prop('checked');
                $('.payroll-item-check:not(:disabled)').prop('checked', checked);
                updateBulkButtons();
            });

            $(document).on('change', '.payroll-item-check', function () {
                updateBulkButtons();
            });

            function updateBulkButtons() {
                var count = $('.payroll-item-check:checked').length;
                $('#btnBulkApprove, #btnBulkLock').prop('disabled', count === 0);
            }

            function getSelectedPayrollIds() {
                return $('.payroll-item-check:checked').map(function () { return parseInt($(this).val()); }).get();
            }

            // ─── Admin Incentive (Multi-Item) ─────────────────
            var currentSystemIncentive = 0;
            var currentAdminIncentiveTotal = 0;
            var currentItems = [];
            var incentiveModalChanged = false;

            function renderIncentiveItems(items) {
                currentItems = items || [];
                currentAdminIncentiveTotal = currentItems.reduce(function (sum, i) { return sum + i.amount; }, 0);
                var $container = $('#adminIncentiveItemsContainer');
                $container.empty();

                if (currentItems.length === 0) {
                    $('#adminIncentiveItemsList').hide();
                } else {
                    $('#adminIncentiveItemsList').show();
                    currentItems.forEach(function (item) {
                        var labelHtml = item.label ? '<span class="text-dark fw-medium font-size-13">' + $('<span>').text(item.label).html() + '</span>' : '<span class="text-muted font-size-12 fst-italic">No label</span>';
                        var row = '<div class="d-flex align-items-center justify-content-between py-2 px-3 mb-1" style="background:#f0fdf4; border-radius:6px; border:1px solid #dcfce7;">' +
                            '<div>' + labelHtml + '</div>' +
                            '<div class="d-flex align-items-center gap-2">' +
                            '<span class="fw-semibold text-success">+₹' + item.amount.toLocaleString('en-IN') + '</span>' +
                            '<button type="button" class="btn btn-outline-danger btn-sm px-1 py-0 btn-delete-incentive-item" data-item-id="' + item.id + '" title="Remove" style="font-size:11px; line-height:1.4;"><i class="fas fa-trash-alt"></i></button>' +
                            '</div></div>';
                        $container.append(row);
                    });
                }
                updateLiveIncentivePreview();
            }

            function updateLiveIncentivePreview() {
                var total = currentSystemIncentive + currentAdminIncentiveTotal;
                $('#modalIncentiveAdminTotal').text('+₹' + currentAdminIncentiveTotal.toLocaleString('en-IN'));
                $('#modalIncentiveLiveTotal').text('₹' + total.toLocaleString('en-IN'));
            }

            $(document).on('click', '.btn-edit-admin-incentive', function () {
                var payrollId = $(this).data('payroll-id');
                var staffName = $(this).data('staff-name');
                var basicSalary = parseFloat($(this).data('basic-salary')) || 0;
                var systemIncentive = parseFloat($(this).data('system-incentive')) || 0;
                var items = $(this).data('items') || [];
                var status = $(this).data('status');

                if (status === 'Locked') {
                    Swal.fire('Locked', 'This payroll is locked. Please reopen it first to modify incentives.', 'warning');
                    return;
                }

                incentiveModalChanged = false;
                currentSystemIncentive = systemIncentive;
                $('#modalIncentivePayrollId').val(payrollId);
                $('#modalIncentiveStaffName').text(staffName);
                $('#modalIncentiveBasicSalary').text('₹' + basicSalary.toLocaleString('en-IN'));
                $('#modalIncentiveSystemIncentive').text('+₹' + systemIncentive.toLocaleString('en-IN'));
                $('#modalAdminIncentiveInput').val('');
                $('#modalAdminIncentiveLabel').val('');

                renderIncentiveItems(items);
                new bootstrap.Modal('#adminIncentiveModal').show();
            });

            // Enter key to add incentive
            $('#modalAdminIncentiveInput, #modalAdminIncentiveLabel').on('keypress', function (e) {
                if (e.which === 13) {
                    e.preventDefault();
                    $('#btnAddAdminIncentive').click();
                }
            });

            // Reload page on modal close if any incentive was added or removed
            $('#adminIncentiveModal').on('hidden.bs.modal', function () {
                if (incentiveModalChanged) {
                    location.reload();
                }
            });

            // Add new incentive item
            $('#btnAddAdminIncentive').on('click', function () {
                var payrollId = parseInt($('#modalIncentivePayrollId').val());
                var amount = parseFloat($('#modalAdminIncentiveInput').val()) || 0;
                var label = $('#modalAdminIncentiveLabel').val().trim();

                if (amount <= 0) {
                    Swal.fire('Invalid', 'Please enter a valid amount greater than 0.', 'warning');
                    return;
                }

                var $btn = $(this);
                $btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i>');

                $.ajax({
                    url: '/admin/staff/cross-comparison/payroll/update-admin-incentive',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({
                        payrollId: payrollId,
                        amount: amount,
                        label: label || null
                    }),
                    success: function (res) {
                        if (res.success) {
                            incentiveModalChanged = true;
                            $('#modalAdminIncentiveInput').val('');
                            $('#modalAdminIncentiveLabel').val('');
                            renderIncentiveItems(res.items);
                            Swal.fire({ icon: 'success', title: 'Added!', text: res.message, timer: 1500, showConfirmButton: false });
                            var $triggerBtn = $('.btn-edit-admin-incentive[data-payroll-id="' + payrollId + '"]');
                            $triggerBtn.data('items', res.items);
                            $triggerBtn.data('admin-incentive', res.adminIncentive);
                        } else {
                            Swal.fire('Error', res.message || 'Failed to add incentive.', 'error');
                        }
                    },
                    error: function () {
                        Swal.fire('Error', 'Server error while adding incentive.', 'error');
                    },
                    complete: function () {
                        $btn.prop('disabled', false).html('<i class="fas fa-plus"></i>');
                    }
                });
            });

            // Delete incentive item
            $(document).on('click', '.btn-delete-incentive-item', function () {
                var itemId = $(this).data('item-id');
                var payrollId = parseInt($('#modalIncentivePayrollId').val());
                var $row = $(this).closest('div.d-flex');

                Swal.fire({
                    title: 'Remove this incentive?',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonText: 'Yes, Remove',
                    confirmButtonColor: '#dc3545',
                    cancelButtonText: 'Cancel'
                }).then(function (result) {
                    if (!result.isConfirmed) return;

                    $row.css('opacity', '0.5');
                    $.ajax({
                        url: '/admin/staff/cross-comparison/payroll/delete-admin-incentive-item',
                        type: 'POST',
                        contentType: 'application/json',
                        data: JSON.stringify({ itemId: itemId, payrollId: payrollId }),
                        success: function (res) {
                            if (res.success) {
                                incentiveModalChanged = true;
                                renderIncentiveItems(res.items);
                                var $triggerBtn = $('.btn-edit-admin-incentive[data-payroll-id="' + payrollId + '"]');
                                $triggerBtn.data('items', res.items);
                                $triggerBtn.data('admin-incentive', res.adminIncentive);
                            } else {
                                $row.css('opacity', '1');
                                Swal.fire('Error', res.message || 'Failed to remove incentive.', 'error');
                            }
                        },
                        error: function () {
                            $row.css('opacity', '1');
                            Swal.fire('Error', 'Server error while removing incentive.', 'error');
                        }
                    });
                });
            });

            // ─── Bulk Approve ─────────────────────────────────
            $('#btnBulkApprove').on('click', function () {
                var ids = getSelectedPayrollIds();
                if (ids.length === 0) return;
                Swal.fire({
                    title: 'Approve ' + ids.length + ' payroll(s)?',
                    text: 'This will set estimated payroll as approved amount.',
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonText: 'Yes, Approve',
                    confirmButtonColor: '#34c38f'
                }).then(function (result) {
                    if (result.isConfirmed) {
                        $.ajax({
                            url: '/admin/staff/cross-comparison/payroll/bulk-approve',
                            type: 'POST',
                            contentType: 'application/json',
                            data: JSON.stringify(ids),
                            success: function (res) {
                                Swal.fire('Done!', res.message, 'success').then(function () { location.reload(); });
                            },
                            error: function () { Swal.fire('Error', 'Failed to approve.', 'error'); }
                        });
                    }
                });
            });

            // ─── Bulk Lock ────────────────────────────────────
            $('#btnBulkLock').on('click', function () {
                var ids = getSelectedPayrollIds();
                if (ids.length === 0) return;
                Swal.fire({
                    title: 'Lock ' + ids.length + ' payroll(s)?',
                    text: 'Locked records cannot be edited without reopening.',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonText: 'Yes, Lock',
                    confirmButtonColor: '#343a40'
                }).then(function (result) {
                    if (result.isConfirmed) {
                        $.ajax({
                            url: '/admin/staff/cross-comparison/payroll/bulk-lock',
                            type: 'POST',
                            contentType: 'application/json',
                            data: JSON.stringify(ids),
                            success: function (res) {
                                Swal.fire('Done!', res.message, 'success').then(function () { location.reload(); });
                            },
                            error: function () { Swal.fire('Error', 'Failed to lock.', 'error'); }
                        });
                    }
                });
            });

            // ─── Reopen ───────────────────────────────────────
            $(document).on('click', '.btn-reopen', function () {
                $('#reopenPayrollId').val($(this).data('payroll-id'));
                $('#reopenStaffName').text($(this).data('staff-name'));
                $('#reopenReason').val('');
                new bootstrap.Modal('#reopenModal').show();
            });

            $('#btnConfirmReopen').on('click', function () {
                var reason = $('#reopenReason').val();
                if (!reason) { Swal.fire('Required', 'Please enter a reason.', 'warning'); return; }
                $.ajax({
                    url: '/admin/staff/cross-comparison/payroll/reopen',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({ payrollId: parseInt($('#reopenPayrollId').val()), reason: reason }),
                    success: function (res) {
                        bootstrap.Modal.getInstance(document.getElementById('reopenModal')).hide();
                        Swal.fire('Done!', res.message, 'success').then(function () { location.reload(); });
                    },
                    error: function () { Swal.fire('Error', 'Failed to reopen.', 'error'); }
                });
            });

            // ─── Audit Log ────────────────────────────────────
            $(document).on('click', '.btn-audit-log', function () {
                var payrollId = $(this).data('payroll-id');
                $('#auditStaffName').text($(this).data('staff-name'));
                $('#auditLogContent').html('<div class="text-center py-4"><div class="spinner-border text-primary"></div><p class="text-muted mt-2">Loading...</p></div>');
                new bootstrap.Modal('#auditLogModal').show();

                $.get('/admin/staff/cross-comparison/payroll/audit-log/' + payrollId, function (logs) {
                    if (!logs || logs.length === 0) {
                        $('#auditLogContent').html('<div class="text-center text-muted py-4"><i class="fas fa-info-circle fa-2x mb-2 d-block"></i>No audit log entries found.</div>');
                        return;
                    }
                    var html = '<div class="audit-timeline">';
                    logs.forEach(function (log) {
                        var date = new Date(log.performedOn).toLocaleString();
                        html += '<div class="audit-item">';
                        html += '<div class="fw-semibold">' + log.action + '</div>';
                        if (log.previousStatus) html += '<small class="text-muted">' + log.previousStatus + ' → ' + log.newStatus + '</small><br>';
                        if (log.previousAmount != null) html += '<small class="text-muted">Amount: ₹' + log.previousAmount + ' → ₹' + log.newAmount + '</small><br>';
                        html += '<small class="text-muted">By: ' + log.performedBy + ' | ' + date + '</small>';
                        if (log.reason) html += '<br><small class="text-info"><i class="fas fa-comment-alt me-1"></i>' + log.reason + '</small>';
                        html += '</div>';
                    });
                    html += '</div>';
                    $('#auditLogContent').html(html);
                });
            });

            // ─── Salary Slip PDF ──────────────────────────────
            $(document).on('click', '.btn-salary-slip', function () {
                var $btn = $(this);
                var payrollId = $btn.data('payroll-id');
                var staffName = $btn.data('staff-name') || 'Staff';
                var originalHtml = $btn.html();

                $btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin me-1"></i> Loading...');

                $.get('/admin/staff/cross-comparison/export/salary-slip/' + payrollId)
                    .done(function (data) {
                        if (!data) {
                            Swal.fire('Error', 'Could not retrieve salary slip data.', 'error');
                            return;
                        }

                        var fmt = function (val) {
                            var n = parseFloat(val) || 0;
                            return n.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                        };

                        var printWin = window.open('', '_blank', 'width=800,height=900');
                        if (!printWin) {
                            Swal.fire('Blocked', 'Popup blocker prevented opening the receipt. Please allow popups.', 'warning');
                            return;
                        }

                        var html = '<!DOCTYPE html><html><head>' +
                            '<title>Salary Slip - ' + (data.staffName || staffName) + '</title>' +
                            '<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">' +
                            '<style>' +
                            'body { padding: 40px; font-family: "Segoe UI", sans-serif; background: #fff; color: #212529; }' +
                            '.header-title { color: #00662d; font-weight: 700; }' +
                            '.table-custom th { background-color: #00662d !important; color: #fff !important; }' +
                            '@@page { size: portrait; margin: 15mm; }' +
                            '</style></head><body>' +
                            '<div class="text-center mb-4">' +
                            '<h2 class="header-title">M4 NIKAH — SALARY SLIP</h2>' +
                            '<p class="text-muted mb-0">' + (data.month || '') + ' ' + (data.year || '') + '</p><hr></div>' +
                            '<div class="row mb-4 fs-6">' +
                            '<div class="col-6"><strong>Staff Name:</strong> ' + (data.staffName || 'N/A') + '</div>' +
                            '<div class="col-6"><strong>Department:</strong> ' + (data.department || 'N/A') + '</div>' +
                            '<div class="col-6 mt-2"><strong>Designation:</strong> ' + (data.designation || 'N/A') + '</div>' +
                            '<div class="col-6 mt-2"><strong>Status:</strong> <span class="badge bg-success">' + (data.status || 'N/A') + '</span></div>' +
                            '</div>' +
                            '<table class="table table-bordered align-middle table-custom">' +
                            '<thead><tr><th>Salary Component</th><th class="text-end">Amount (₹)</th></tr></thead>' +
                            '<tbody>' +
                            '<tr><td>Basic Salary</td><td class="text-end">₹' + fmt(data.basicSalary) + '</td></tr>' +
                            '<tr><td>Premium Incentive (Boys)</td><td class="text-end">₹' + fmt(data.premiumIncentiveBoys) + '</td></tr>' +
                            '<tr><td>Premium Incentive (Girls)</td><td class="text-end">₹' + fmt(data.premiumIncentiveGirls) + '</td></tr>' +
                            '<tr><td>Verification Incentive</td><td class="text-end">₹' + fmt(data.verificationIncentive) + '</td></tr>' +
                            (data.dailyTargetIncentive > 0 ? '<tr><td>Daily Target Incentive</td><td class="text-end">₹' + fmt(data.dailyTargetIncentive) + '</td></tr>' : '');

                        // Render individual admin incentive items
                        if (data.adminIncentiveItems && data.adminIncentiveItems.length > 0) {
                            data.adminIncentiveItems.forEach(function (item) {
                                html += '<tr><td>Admin Incentive' + (item.label ? ' <small class="text-muted">(' + item.label + ')</small>' : '') + '</td><td class="text-end text-success">+₹' + fmt(item.amount) + '</td></tr>';
                            });
                        } else if (data.adminIncentive > 0) {
                            // Fallback for old payrolls without items
                            html += '<tr><td>Admin Given Incentive' + (data.adminIncentiveRemarks ? ' <small class="text-muted">(' + data.adminIncentiveRemarks + ')</small>' : '') + '</td><td class="text-end text-success">+₹' + fmt(data.adminIncentive) + '</td></tr>';
                        }

                        html +=
                            '<tr class="fw-bold table-light"><td>Total Incentive</td><td class="text-end text-success">₹' + fmt(data.totalIncentive) + '</td></tr>' +
                            '<tr class="text-danger"><td>(−) Leave Deduction</td><td class="text-end">₹' + fmt(data.leaveDeduction) + '</td></tr>' +
                            '<tr class="text-danger"><td>(−) Complaint Deduction</td><td class="text-end">₹' + fmt(data.complaintDeduction) + '</td></tr>' +
                            '<tr class="fw-bold table-light text-danger"><td>Total Deduction</td><td class="text-end">₹' + fmt(data.totalDeduction) + '</td></tr>' +
                            '<tr><td>Estimated Payroll</td><td class="text-end">₹' + fmt(data.estimatedPayroll) + '</td></tr>' +
                            '<tr class="fw-bold table-success fs-5"><td>Approved / Net Payable</td><td class="text-end text-success">₹' + fmt(data.netPayable) + '</td></tr>' +
                            '</tbody></table>' +
                            '<div class="text-center mt-5 text-muted small">' +
                            '<em>This is a computer-generated document. No signature required.</em></div>' +
                            '<script>window.onload = function() { setTimeout(function() { window.print(); }, 500); };<\/script>' +
                            '</body></html>';

                        printWin.document.write(html);
                        printWin.document.close();
                    })
                    .fail(function () {
                        Swal.fire('Error', 'Error fetching salary slip details.', 'error');
                    })
                    .always(function () {
                        $btn.prop('disabled', false).html(originalHtml);
                    });
            });

            // ─── Export Payroll Register (Excel via DataTables) ─
            $('#btnExportRegister').on('click', function () {
                $.get('/admin/staff/cross-comparison/export/payroll-register?year=@Model.FilterYear&month=@Model.FilterMonth', function (data) {
                    if (!data || data.length === 0) {
                        Swal.fire('Info', 'No payroll data found for selected period.', 'info');
                        return;
                    }
                    // Create CSV and trigger download
                    var headers = ['Staff Name', 'Department', 'Designation', 'Basic Salary', 'Admin Incentive', 'Total Incentive', 'Total Deduction', 'Estimated Payroll', 'Approved Payroll', 'Net Payable', 'Status'];
                    var csv = headers.join(',') + '\n';
                    data.forEach(function (row) {
                        csv += [
                            '"' + row.staffName + '"',
                            '"' + row.department + '"',
                            '"' + row.designation + '"',
                            row.basicSalary,
                            row.adminIncentive || 0,
                            row.totalIncentive,
                            row.totalDeduction,
                            row.estimatedPayroll,
                            row.approvedPayroll,
                            row.netPayable,
                            '"' + row.status + '"'
                        ].join(',') + '\n';
                    });
                    var blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
                    var link = document.createElement('a');
                    link.href = URL.createObjectURL(blob);
                    link.download = 'PayrollRegister_@(monthNames[Model.FilterMonth])_@(Model.FilterYear).csv';
                    link.click();
                });
            });

            // ─── Fix select defaults on page load ─────────────
            $('select[name="period"]').val('@Model.Period');
        });
    </script>
}
