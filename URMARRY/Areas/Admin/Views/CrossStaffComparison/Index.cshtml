@model URMARRY.Areas.Admin.Models.CrossStaffComparisonViewModel
@{
    ViewBag.Title = "Cross-Staff Comparison";
    var monthNames = new[] { "", "January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December" };
}

@section Title
{
    Cross-Staff Comparison
}

@section css {
    <style>
        /* ─── General ──────────────────────────────────────── */
        .nav-tabs .nav-link { font-weight: 600; color: #495057; border: none; border-bottom: 3px solid transparent; padding: 12px 20px; transition: all 0.3s; }
        .nav-tabs .nav-link.active { color: #556ee6; border-bottom-color: #556ee6; background: transparent; }
        .nav-tabs .nav-link:hover { color: #556ee6; }

        /* ─── Metric Cards ─────────────────────────────────── */
        .metric-card { border-radius: 12px; transition: transform 0.2s, box-shadow 0.2s; border: none; }
        .metric-card:hover { transform: translateY(-3px); box-shadow: 0 8px 20px rgba(0,0,0,0.08) !important; }
        .metric-icon { width: 48px; height: 48px; border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 20px; }

        /* ─── Badge Colors ─────────────────────────────────── */
        .badge-soft-secondary { background-color: rgba(116,120,141,0.18); color: #74788d; }
        .badge-soft-warning { background-color: rgba(241,180,76,0.18); color: #f1b44c; }
        .badge-soft-success { background-color: rgba(52,195,143,0.18); color: #34c38f; }
        .badge-soft-primary { background-color: rgba(85,110,230,0.18); color: #556ee6; }
        .badge-soft-dark { background-color: rgba(52,58,64,0.18); color: #343a40; }
        .badge-soft-danger { background-color: rgba(244,106,106,0.18); color: #f46a6a; }
        .badge-soft-info { background-color: rgba(80,165,241,0.18); color: #50a5f1; }

        /* ─── Rankings ─────────────────────────────────────── */
        .rank-card { border-radius: 10px; transition: all 0.2s; }
        .rank-card:hover { transform: translateX(4px); }
        .rank-badge { width: 36px; height: 36px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 16px; }
        .rank-1 { background: linear-gradient(135deg, #ffd700, #ffb300); color: #fff; box-shadow: 0 2px 8px rgba(255,179,0,0.3); }
        .rank-2 { background: linear-gradient(135deg, #c0c0c0, #a8a8a8); color: #fff; }
        .rank-3 { background: linear-gradient(135deg, #cd7f32, #b8722d); color: #fff; }
        .rank-default { background: #e9ecef; color: #495057; }

        /* ─── Filter Bar ───────────────────────────────────── */
        .filter-bar { background: #f8f9fa; border-radius: 10px; padding: 16px 20px; margin-bottom: 20px; }
        .filter-bar .form-select, .filter-bar .form-control { font-size: 13px; border-radius: 8px; }
        .filter-bar label { font-size: 12px; font-weight: 600; color: #6c757d; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 4px; }

        /* ─── DataTables Responsive ────────────────────────── */
        table.dataTable > tbody > tr.child ul.dtr-details {
            display: flex !important; flex-wrap: wrap !important; gap: 12px !important;
            list-style-type: none !important; margin: 0 !important; padding: 12px 15px !important;
        }
        table.dataTable > tbody > tr.child ul.dtr-details > li {
            border-bottom: none !important; padding: 8px 14px !important;
            background-color: #f8f9fa !important; border: 1px solid #e9ecef !important;
            border-radius: 8px !important; display: inline-flex !important;
            align-items: center !important; gap: 8px !important;
        }
        table.dataTable > tbody > tr.child span.dtr-title { font-weight: 600 !important; color: #495057 !important; }
        table.dataTable > tbody > tr.child span.dtr-data { color: #212529 !important; font-weight: 500 !important; }

        /* ─── Progress Bar ─────────────────────────────────── */
        .target-progress { height: 8px; border-radius: 4px; background: #e9ecef; overflow: hidden; }
        .target-progress-bar { height: 100%; border-radius: 4px; transition: width 0.6s ease; }

        /* ─── Payroll Checkbox ──────────────────────────────── */
        .payroll-check { width: 18px; height: 18px; cursor: pointer; }

        /* ─── Audit Log Modal ──────────────────────────────── */
        .audit-timeline { position: relative; padding-left: 30px; }
        .audit-timeline::before { content: ''; position: absolute; left: 12px; top: 0; bottom: 0; width: 2px; background: #e9ecef; }
        .audit-item { position: relative; padding: 12px 0; }
        .audit-item::before { content: ''; position: absolute; left: -22px; top: 16px; width: 10px; height: 10px; border-radius: 50%; background: #556ee6; border: 2px solid #fff; box-shadow: 0 0 0 2px #556ee6; }

        .chart-container { position: relative; height: 320px; }
    </style>
}

<!-- ═══════════════════════════════════════════════════════ -->
<!-- FILTER BAR                                              -->
<!-- ═══════════════════════════════════════════════════════ -->
<form id="filterForm" method="get" asp-action="Index" asp-controller="CrossStaffComparison">
    <div class="filter-bar shadow-sm">
        <div class="row g-2 align-items-end">
            <div class="col-md-2 col-sm-6">
                <label>Period</label>
                <select name="period" class="form-select" id="periodFilter">
                    <option value="Day" selected="@(Model.Period == "Day")">Day</option>
                    <option value="Week" selected="@(Model.Period == "Week")">Week</option>
                    <option value="Month" selected="@(Model.Period == "Month")">Month</option>
                    <option value="Year" selected="@(Model.Period == "Year")">Year</option>
                </select>
            </div>
            <div class="col-md-2 col-sm-6">
                <label>Department</label>
                <select name="department" class="form-select">
                    <option value="">All Departments</option>
                    @foreach (var dept in Model.Departments)
                    {
                        <option value="@dept" selected="@(Model.Department == dept)">@dept</option>
                    }
                </select>
            </div>
            <div class="col-md-1 col-sm-6">
                <label>Gender</label>
                <select name="gender" class="form-select">
                    <option value="">All</option>
                    <option value="Male" selected="@(Model.Gender == "Male")">Male</option>
                    <option value="Female" selected="@(Model.Gender == "Female")">Female</option>
                </select>
            </div>
            <div class="col-md-2 col-sm-6">
                <label>Premium Package</label>
                <select name="premiumPackageId" class="form-select">
                    <option value="">All Packages</option>
                    @foreach (var pkg in Model.PremiumPackages)
                    {
                        <option value="@pkg.Id" selected="@(Model.PremiumPackageId == pkg.Id)">@pkg.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-1 col-sm-6">
                <label>Grade</label>
                <select name="verificationGrade" class="form-select">
                    <option value="">All</option>
                    <option value="A" selected="@(Model.VerificationGrade == "A")">Grade A</option>
                    <option value="B" selected="@(Model.VerificationGrade == "B")">Grade B</option>
                    <option value="C" selected="@(Model.VerificationGrade == "C")">Grade C</option>
                    <option value="D" selected="@(Model.VerificationGrade == "D")">Grade D</option>
                </select>
            </div>
            <div class="col-md-1 col-sm-6">
                <label>Year</label>
                <select name="year" class="form-select">
                    @for (int y = DateTime.UtcNow.Year; y >= DateTime.UtcNow.Year - 3; y--)
                    {
                        <option value="@y" selected="@(Model.FilterYear == y)">@y</option>
                    }
                </select>
            </div>
            <div class="col-md-1 col-sm-6">
                <label>Month</label>
                <select name="month" class="form-select">
                    @for (int m = 1; m <= 12; m++)
                    {
                        <option value="@m" selected="@(Model.FilterMonth == m)">@monthNames[m].Substring(0, 3)</option>
                    }
                </select>
            </div>
            <div class="col-md-2 col-sm-6">
                <label>Salary Status</label>
                <select name="salaryStatus" class="form-select">
                    <option value="">All Status</option>
                    <option value="Draft" selected="@(Model.SalaryStatus == "Draft")">Draft</option>
                    <option value="UnderReview" selected="@(Model.SalaryStatus == "UnderReview")">Under Review</option>
                    <option value="Approved" selected="@(Model.SalaryStatus == "Approved")">Approved</option>
                    <option value="Paid" selected="@(Model.SalaryStatus == "Paid")">Paid</option>
                    <option value="Locked" selected="@(Model.SalaryStatus == "Locked")">Locked</option>
                    <option value="Reopened" selected="@(Model.SalaryStatus == "Reopened")">Reopened</option>
                </select>
            </div>
        </div>
        <div class="row mt-2">
            <div class="col-12 text-end">
                <button type="submit" class="btn btn-primary btn-sm px-4">
                    <i class="fas fa-filter me-1"></i> Apply Filters
                </button>
                <a asp-action="Index" asp-controller="CrossStaffComparison" class="btn btn-outline-secondary btn-sm px-3 ms-1">
                    <i class="fas fa-undo me-1"></i> Reset
                </a>
            </div>
        </div>
    </div>
</form>

<!-- ═══════════════════════════════════════════════════════ -->
<!-- TABS                                                     -->
<!-- ═══════════════════════════════════════════════════════ -->
<ul class="nav nav-tabs mt-2" id="crossStaffTabs" role="tablist">
    <li class="nav-item">
        <a class="nav-link active" id="comparison-tab" data-bs-toggle="tab" href="#comparisonPanel" role="tab">
            <i class="fas fa-chart-bar me-1"></i> Staff Comparison
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link" id="aggregates-tab" data-bs-toggle="tab" href="#aggregatesPanel" role="tab">
            <i class="fas fa-layer-group me-1"></i> Org-Wide Aggregates
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link" id="rankings-tab" data-bs-toggle="tab" href="#rankingsPanel" role="tab">
            <i class="fas fa-trophy me-1"></i> Rankings
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link" id="payroll-tab" data-bs-toggle="tab" href="#payrollPanel" role="tab">
            <i class="fas fa-money-check-alt me-1"></i> Payroll Control
        </a>
    </li>
</ul>

<div class="tab-content mt-3" id="crossStaffTabContent">

    <!-- ═════════════════════════════════════════════════════ -->
    <!-- TAB 1: STAFF COMPARISON TABLE & CHART                 -->
    <!-- ═════════════════════════════════════════════════════ -->
    <div class="tab-pane fade show active" id="comparisonPanel" role="tabpanel">

        <!-- Chart -->
        <div class="card shadow-sm mb-3">
            <div class="card-body">
                <h6 class="card-title mb-3"><i class="fas fa-chart-bar text-primary me-2"></i>Staff-wise Premium Conversions (Boys vs Girls)</h6>
                <div class="chart-container">
                    <canvas id="conversionChart"></canvas>
                </div>
            </div>
        </div>

        <!-- Table -->
        <div class="card shadow-sm">
            <div class="card-body">
                <h6 class="card-title mb-3"><i class="fas fa-table text-primary me-2"></i>Staff Comparison Table</h6>
                <div class="table-responsive">
                    <table id="comparisonTable" class="table table-hover table-bordered dt-responsive nowrap w-100" style="font-size: 13px;">
                        <thead class="table-light">
                            <tr>
                                <th>Staff</th>
                                <th>Dept</th>
                                <th>Conv (Boys)</th>
                                <th>Conv (Girls)</th>
                                <th>Total Conv</th>
                                <th>Collection (Boys)</th>
                                <th>Collection (Girls)</th>
                                <th>Total Collection</th>
                                <th>Target %</th>
                                <th>Grade A</th>
                                <th>Grade B</th>
                                <th>Grade C</th>
                                <th>Grade D</th>
                                <th>Total Verif.</th>
                                <th>Incentive</th>
                                <th>Leave Ded.</th>
                                <th>Complaint Ded.</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in Model.StaffRows)
                            {
                                <tr>
                                    <td>
                                        <span class="fw-semibold">@row.StaffName</span>
                                        @if (!row.IsActive)
                                        {
                                            <span class="badge badge-soft-danger ms-1" style="font-size:10px;">Inactive</span>
                                        }
                                    </td>
                                    <td>@(row.Department ?? "—")</td>
                                    <td class="text-center"><span class="badge badge-soft-primary">@row.PremiumConversionsBoys</span></td>
                                    <td class="text-center"><span class="badge badge-soft-danger">@row.PremiumConversionsGirls</span></td>
                                    <td class="text-center fw-bold">@row.TotalPremiumConversions</td>
                                    <td class="text-end">₹@row.PremiumCollectionBoys.ToString("N0")</td>
                                    <td class="text-end">₹@row.PremiumCollectionGirls.ToString("N0")</td>
                                    <td class="text-end fw-bold">₹@row.TotalPremiumCollection.ToString("N0")</td>
                                    <td>
                                        <div class="target-progress" title="@row.DailyTargetAchievementPercent%">
                                            <div class="target-progress-bar @(row.DailyTargetAchievementPercent >= 80 ? "bg-success" : row.DailyTargetAchievementPercent >= 50 ? "bg-warning" : "bg-danger")"
                                                 style="width: @row.DailyTargetAchievementPercent%"></div>
                                        </div>
                                        <small class="text-muted">@row.DailyTargetAchievementPercent%</small>
                                    </td>
                                    <td class="text-center">@row.VerificationGradeA</td>
                                    <td class="text-center">@row.VerificationGradeB</td>
                                    <td class="text-center">@row.VerificationGradeC</td>
                                    <td class="text-center">@row.VerificationGradeD</td>
                                    <td class="text-center fw-bold">@row.TotalVerifications</td>
                                    <td class="text-end text-success fw-semibold">₹@row.IncentivePayable.ToString("N0")</td>
                                    <td class="text-end text-danger">₹@row.LeaveDeductions.ToString("N0")</td>
                                    <td class="text-end text-danger">₹@row.ComplaintDeductions.ToString("N0")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- ═════════════════════════════════════════════════════ -->
    <!-- TAB 2: ORG-WIDE AGGREGATES                            -->
    <!-- ═════════════════════════════════════════════════════ -->
    <div class="tab-pane fade" id="aggregatesPanel" role="tabpanel">

        <!-- Summary Cards -->
        <div class="row g-3 mb-3">
            <div class="col-xl-3 col-md-6">
                <div class="card metric-card shadow-sm h-100">
                    <div class="card-body">
                        <div class="d-flex align-items-center">
                            <div class="metric-icon bg-soft-primary text-primary me-3"><i class="fas fa-rupee-sign"></i></div>
                            <div>
                                <p class="text-muted mb-1" style="font-size:12px;">Total Premium Collection</p>
                                <h5 class="mb-0">₹@Model.OrgAggregates.TotalPremiumCollection.ToString("N0")</h5>
                                <small>
                                    <span class="badge badge-soft-primary">Boys: ₹@Model.OrgAggregates.TotalPremiumCollectionBoys.ToString("N0")</span>
                                    <span class="badge badge-soft-danger ms-1">Girls: ₹@Model.OrgAggregates.TotalPremiumCollectionGirls.ToString("N0")</span>
                                </small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xl-3 col-md-6">
                <div class="card metric-card shadow-sm h-100">
                    <div class="card-body">
                        <div class="d-flex align-items-center">
                            <div class="metric-icon" style="background:rgba(52,195,143,0.1);color:#34c38f;"><i class="fas fa-gift"></i></div>
                            <div class="ms-3">
                                <p class="text-muted mb-1" style="font-size:12px;">Total Incentive Payable</p>
                                <h5 class="mb-0 text-success">₹@Model.OrgAggregates.TotalIncentivePayable.ToString("N0")</h5>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xl-3 col-md-6">
                <div class="card metric-card shadow-sm h-100">
                    <div class="card-body">
                        <div class="d-flex align-items-center">
                            <div class="metric-icon" style="background:rgba(241,180,76,0.1);color:#f1b44c;"><i class="fas fa-file-invoice-dollar"></i></div>
                            <div class="ms-3">
                                <p class="text-muted mb-1" style="font-size:12px;">Estimated vs Approved Payroll</p>
                                <h5 class="mb-0">₹@Model.OrgAggregates.TotalEstimatedPayroll.ToString("N0")</h5>
                                <small class="text-muted">Approved: <span class="fw-bold text-success">₹@Model.OrgAggregates.TotalApprovedPayroll.ToString("N0")</span></small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xl-3 col-md-6">
                <div class="card metric-card shadow-sm h-100">
                    <div class="card-body">
                        <div class="d-flex align-items-center">
                            <div class="metric-icon" style="background:rgba(80,165,241,0.1);color:#50a5f1;"><i class="fas fa-bullseye"></i></div>
                            <div class="ms-3">
                                <p class="text-muted mb-1" style="font-size:12px;">Daily Target Achievement</p>
                                <h5 class="mb-0">@Model.OrgAggregates.DailyTargetAchievementRate%</h5>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Grade-Wise Verification Report -->
        <div class="card shadow-sm">
            <div class="card-body">
                <h6 class="card-title mb-3"><i class="fas fa-shield-alt text-primary me-2"></i>Grade-Wise Verification Report (Org-Wide)</h6>
                <div class="row g-3">
                    <div class="col-md-3">
                        <div class="text-center p-3 rounded" style="background:rgba(52,195,143,0.08);">
                            <h3 class="text-success mb-1">@Model.OrgAggregates.OrgVerificationGradeA</h3>
                            <span class="badge badge-soft-success px-3">Grade A — DetailedVerify</span>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="text-center p-3 rounded" style="background:rgba(85,110,230,0.08);">
                            <h3 class="text-primary mb-1">@Model.OrgAggregates.OrgVerificationGradeB</h3>
                            <span class="badge badge-soft-primary px-3">Grade B — Verify</span>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="text-center p-3 rounded" style="background:rgba(241,180,76,0.08);">
                            <h3 class="text-warning mb-1">@Model.OrgAggregates.OrgVerificationGradeC</h3>
                            <span class="badge badge-soft-warning px-3">Grade C — Started</span>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="text-center p-3 rounded" style="background:rgba(244,106,106,0.08);">
                            <h3 class="text-danger mb-1">@Model.OrgAggregates.OrgVerificationGradeD</h3>
                            <span class="badge badge-soft-danger px-3">Grade D — Pending/Hold</span>
                        </div>
                    </div>
                </div>
                <div class="text-center mt-3">
                    <span class="text-muted">Total Verifications: <strong>@Model.OrgAggregates.OrgTotalVerifications</strong></span>
                </div>
            </div>
        </div>

        <!-- Org Comparison Chart -->
        <div class="card shadow-sm mt-3">
            <div class="card-body">
                <h6 class="card-title mb-3"><i class="fas fa-chart-pie text-primary me-2"></i>Collection Split & Verification Distribution</h6>
                <div class="row">
                    <div class="col-md-6">
                        <div class="chart-container" style="height:260px;">
                            <canvas id="collectionPieChart"></canvas>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="chart-container" style="height:260px;">
                            <canvas id="gradeDonutChart"></canvas>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ═════════════════════════════════════════════════════ -->
    <!-- TAB 3: RANKINGS                                       -->
    <!-- ═════════════════════════════════════════════════════ -->
    <div class="tab-pane fade" id="rankingsPanel" role="tabpanel">
        <div class="row g-3">
            <!-- Top Performers -->
            <div class="col-lg-6">
                <div class="card shadow-sm h-100">
                    <div class="card-header bg-transparent border-0 pb-0">
                        <h6 class="mb-0"><i class="fas fa-trophy text-warning me-2"></i>Top Performing Staff</h6>
                    </div>
                    <div class="card-body pt-2">
                        @if (Model.TopPerformers.Any())
                        {
                            @foreach (var tp in Model.TopPerformers)
                            {
                                <div class="d-flex align-items-center p-2 mb-2 rank-card border rounded">
                                    <div class="rank-badge @(tp.Rank == 1 ? "rank-1" : tp.Rank == 2 ? "rank-2" : tp.Rank == 3 ? "rank-3" : "rank-default") me-3">
                                        @tp.Rank
                                    </div>
                                    <div class="flex-grow-1">
                                        <h6 class="mb-0">@tp.StaffName</h6>
                                        <small class="text-muted">@(tp.Department ?? "—")</small>
                                    </div>
                                    <div class="text-end">
                                        <div class="fw-bold text-success">Score: @tp.PerformanceScore.ToString("N0")</div>
                                        <small class="text-muted">Conv: @tp.TotalConversions | ₹@tp.TotalCollection.ToString("N0") | Verif: @tp.TotalVerifications</small>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="text-center text-muted py-4">
                                <i class="fas fa-users fa-2x mb-2 d-block"></i>
                                No staff data available for the selected period.
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Low Performers -->
            <div class="col-lg-6">
                <div class="card shadow-sm h-100">
                    <div class="card-header bg-transparent border-0 pb-0">
                        <h6 class="mb-0"><i class="fas fa-exclamation-triangle text-danger me-2"></i>Low Performing Staff</h6>
                    </div>
                    <div class="card-body pt-2">
                        @if (Model.LowPerformers.Any())
                        {
                            @foreach (var lp in Model.LowPerformers)
                            {
                                <div class="d-flex align-items-center p-2 mb-2 rank-card border rounded">
                                    <div class="rank-badge rank-default me-3">@lp.Rank</div>
                                    <div class="flex-grow-1">
                                        <h6 class="mb-0">@lp.StaffName</h6>
                                        <small class="text-muted">@(lp.Department ?? "—")</small>
                                    </div>
                                    <div class="text-end">
                                        <div class="fw-bold text-danger">Score: @lp.PerformanceScore.ToString("N0")</div>
                                        <small class="text-muted">Conv: @lp.TotalConversions | ₹@lp.TotalCollection.ToString("N0") | Verif: @lp.TotalVerifications</small>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="text-center text-muted py-4">
                                <i class="fas fa-users fa-2x mb-2 d-block"></i>
                                No staff data available for the selected period.
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ═════════════════════════════════════════════════════ -->
    <!-- TAB 4: PAYROLL CONTROL PANEL                          -->
    <!-- ═════════════════════════════════════════════════════ -->
    <div class="tab-pane fade" id="payrollPanel" role="tabpanel">

        <!-- Bulk Action Toolbar -->
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <button type="button" class="btn btn-success btn-sm" id="btnBulkApprove" disabled>
                    <i class="fas fa-check-double me-1"></i> Bulk Approve
                </button>
                <button type="button" class="btn btn-dark btn-sm ms-1" id="btnBulkLock" disabled>
                    <i class="fas fa-lock me-1"></i> Bulk Lock
                </button>
            </div>
            <div>
                <button type="button" class="btn btn-outline-danger btn-sm" id="btnExportRegister">
                    <i class="fas fa-file-excel me-1"></i> Export Payroll Register (Excel)
                </button>
            </div>
        </div>

        <!-- Payroll Table -->
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="table-responsive">
                    <table id="payrollTable" class="table table-hover table-bordered dt-responsive nowrap w-100" style="font-size: 13px;">
                        <thead class="table-light">
                            <tr>
                                <th style="width:30px;">
                                    <input type="checkbox" class="payroll-check" id="selectAllPayroll">
                                </th>
                                <th>Staff</th>
                                <th>Dept</th>
                                <th>Period</th>
                                <th>Basic Salary</th>
                                <th>Admin Incentive</th>
                                <th>Total Incentive</th>
                                <th>Deduction</th>
                                <th>Estimated</th>
                                <th>Approved</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var pr in Model.PayrollRows)
                            {
                                <tr data-payroll-id="@pr.PayrollId">
                                    <td>
                                        <input type="checkbox" class="payroll-check payroll-item-check" value="@pr.PayrollId"
                                               @(pr.Status == "Locked" ? "disabled" : "")>
                                    </td>
                                    <td class="fw-semibold">@pr.StaffName</td>
                                    <td>@(pr.Department ?? "—")</td>
                                    <td>@monthNames[pr.Month] @pr.Year</td>
                                    <td class="text-end">₹@pr.BasicSalary.ToString("N0")</td>
                                    <td class="text-end">
                                        @if (pr.AdminIncentive > 0)
                                        {
                                            <span class="badge bg-soft-success text-success fw-bold font-size-12">+₹@pr.AdminIncentive.ToString("N0")</span>
                                            @if (!string.IsNullOrEmpty(pr.AdminIncentiveRemarks))
                                            {
                                                <i class="fas fa-info-circle text-muted ms-1" title="@pr.AdminIncentiveRemarks"></i>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted">₹0</span>
                                        }
                                    </td>
                                    <td class="text-end text-success">+₹@pr.TotalIncentive.ToString("N0")</td>
                                    <td class="text-end text-danger">-₹@pr.TotalDeduction.ToString("N0")</td>
                                    <td class="text-end fw-bold">₹@pr.EstimatedPayroll.ToString("N0")</td>
                                    <td class="text-end fw-bold text-primary">₹@pr.ApprovedPayroll.ToString("N0")</td>
                                    <td>
                                        <span class="badge @pr.StatusBadgeClass px-2 py-1">
                                            @(pr.Status == "UnderReview" ? "Under Review" : pr.Status)
                                        </span>
                                    </td>
                                    <td>
                                        <div class="btn-group btn-group-sm">
                                            <button type="button" class="btn btn-outline-success btn-sm btn-edit-admin-incentive"
                                                    data-payroll-id="@pr.PayrollId"
                                                    data-staff-name="@pr.StaffName"
                                                    data-basic-salary="@pr.BasicSalary"
                                                    data-system-incentive="@(pr.TotalIncentive - pr.AdminIncentive)"
                                                    data-admin-incentive="@pr.AdminIncentive"
                                                    data-items='@System.Text.Json.JsonSerializer.Serialize(pr.AdminIncentiveItems.Select(i => new { id = i.Id, amount = i.Amount, label = i.Label ?? "", createdOn = i.CreatedOn.ToString("dd MMM yyyy") }))'
                                                    data-status="@pr.Status"
                                                    title="Add / Edit Admin Incentive">
                                                <i class="fas fa-gift"></i>
                                            </button>
                                            @if (pr.Status == "Locked" || pr.Status == "Approved")
                                            {
                                                <button type="button" class="btn btn-outline-warning btn-sm btn-reopen"
                                                        data-payroll-id="@pr.PayrollId" data-staff-name="@pr.StaffName"
                                                        title="Reopen">
                                                    <i class="fas fa-lock-open"></i>
                                                </button>
                                            }
                                            <button type="button" class="btn btn-outline-info btn-sm btn-audit-log"
                                                    data-payroll-id="@pr.PayrollId" data-staff-name="@pr.StaffName"
                                                    title="Audit Log">
                                                    <i class="fas fa-history"></i>
                                            </button>
                                            <button type="button" class="btn btn-outline-primary btn-sm btn-salary-slip"
                                                    data-payroll-id="@pr.PayrollId" data-staff-name="@pr.StaffName"
                                                    title="Salary Slip (PDF)">
                                                <i class="fas fa-file-pdf"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ═══════════════════════════════════════════════════════ -->
<!-- ADMIN INCENTIVE MODAL                                   -->
<!-- ═══════════════════════════════════════════════════════ -->
<div class="modal fade" id="adminIncentiveModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 12px;">
            <div class="modal-header bg-success text-white py-3 px-4" style="border-top-left-radius: 12px; border-top-right-radius: 12px;">
                <h5 class="modal-title fw-bold text-white"><i class="fas fa-gift me-2"></i>Admin Given Incentive</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <p class="text-muted mb-3">Add incentive for: <strong id="modalIncentiveStaffName" class="text-dark"></strong></p>
                <input type="hidden" id="modalIncentivePayrollId">
                
                <div class="card bg-light border-0 mb-3" style="border-radius: 8px;">
                    <div class="card-body p-3 font-size-13">
                        <div class="d-flex justify-content-between mb-1">
                            <span class="text-muted">Basic Salary:</span>
                            <span class="fw-semibold" id="modalIncentiveBasicSalary">₹0</span>
                        </div>
                        <div class="d-flex justify-content-between mb-1">
                            <span class="text-muted">System Calculated Incentive:</span>
                            <span class="fw-semibold text-success" id="modalIncentiveSystemIncentive">+₹0</span>
                        </div>
                        <div class="d-flex justify-content-between mb-1">
                            <span class="text-muted">Admin Incentive Total:</span>
                            <span class="fw-semibold text-success" id="modalIncentiveAdminTotal">+₹0</span>
                        </div>
                        <div class="d-flex justify-content-between border-top pt-1 mt-1">
                            <span class="text-muted fw-bold">Live Total Incentive:</span>
                            <span class="fw-bold text-success" id="modalIncentiveLiveTotal">₹0</span>
                        </div>
                    </div>
                </div>

                <!-- Existing Incentive Items List -->
                <div id="adminIncentiveItemsList" class="mb-3" style="display:none;">
                    <label class="form-label fw-semibold">Added Incentives</label>
                    <div id="adminIncentiveItemsContainer" style="max-height: 200px; overflow-y: auto;"></div>
                </div>

                <!-- Add New Incentive -->
                <div class="card border border-dashed mb-0" style="border-radius: 8px;">
                    <div class="card-body p-3">
                        <div class="row g-2 align-items-end">
                            <div class="col-5">
                                <label for="modalAdminIncentiveInput" class="form-label fw-semibold font-size-12 mb-1">Amount (₹) <span class="text-danger">*</span></label>
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text bg-white">₹</span>
                                    <input type="number" class="form-control" id="modalAdminIncentiveInput" min="1" step="1" placeholder="e.g. 200">
                                </div>
                            </div>
                            <div class="col-5">
                                <label for="modalAdminIncentiveLabel" class="form-label fw-semibold font-size-12 mb-1">Label</label>
                                <input type="text" class="form-control form-control-sm" id="modalAdminIncentiveLabel" placeholder="e.g. Festival bonus" maxlength="100">
                            </div>
                            <div class="col-2">
                                <button type="button" class="btn btn-success btn-sm w-100" id="btnAddAdminIncentive" style="border-radius: 6px;" title="Add Incentive">
                                    <i class="fas fa-plus"></i>
                                </button>
                            </div>
                        </div>
                        <small class="text-muted font-size-11 mt-1 d-block">Each entry adds to the staff's monthly salary.</small>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-top px-4 py-3" style="background-color: #f8fafc;">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal" style="border-radius: 6px;">Close</button>
            </div>
        </div>
    </div>
</div>

