@model Application.Models.PageSettingsDto
@{
    ViewBag.Title = "Page settings";
}

<div class="row">
    <div class="col-12">
        <div class="card">

            <div class="card-body" id="ModalUser">
                @using (Html.BeginForm("Post", "PageSettings", FormMethod.Post, new { enctype = "multipart/form-data" }))
                {
                    <div class="modal-body row">
                        <input type="hidden" asp-for="@Model.Id">
                        <input type="hidden" asp-for="@Model.ParentName">
                        <input type="hidden" asp-for="@Model.Name">

                        <div class="mb-3 col-md-12">
                            <label class="col-form-label">Title</label>
                            <input type="text" class="form-control" asp-for="@Model.Title">
                        </div>

                        <div class="mb-3 col-md-12">
                            <label class="col-form-label">Banner Title</label>
                            <input type="text" class="form-control" asp-for="@Model.BannerTitle">
                        </div>

                        <div class="mb-3 col-md-12">
                            <label class="col-form-label">Banner Sub Title</label>
                            <input type="text" class="form-control" asp-for="@Model.BannerSubtitle">
                        </div>

                        <div class="mb-3 col-md-12">
                            <label class="col-form-label">SEO Title</label>
                            <input type="text" class="form-control" asp-for="@Model.SeoTitle">
                        </div>

                        <div class="mb-3 col-md-12">
                            <label class="col-form-label">SEO Description</label>
                            <textarea class="form-control" asp-for="@Model.SeoDescription"></textarea>
                        </div>

                        @if (Model.Name != null && (!Model.Name.Equals("index") || !Model.Name.Equals("error")))
                        {
                            <div class="mb-3 col-md-12">
                                <label class="col-form-label">Banner image (2048 × 1193)</label>
                                @if (!string.IsNullOrEmpty(Model.BannerImagePath))
                                {
                                    <br/>
                                    <img src="/@Model.BannerImagePath" width="150" alt="image-preview"/>
                                    <br/>
                                }
                                <input type="hidden" asp-for="@Model.BannerImagePath">
                                <input type="file" class="form-control" asp-for="BannerImage">
                            </div>
                        }

                        @if (Model.Name != "result" && Model.Name != "error")
                        {
                            <div class="mb-3 col-md-12">
                                <label class="col-form-label">Priority</label>
                                <input type="number" min="1" class="form-control" asp-for="@Model.DisplayOrder">
                            </div>
                        }
                        else
                        {
                            <input type="hidden" asp-for="@Model.DisplayOrder">
                        }

                        @*<div class="mb-3 col-md-12">
                            <label class="form-check-label">Show On Footer</label>
                            <input asp-for="@Model.ShowOnFooter" type="checkbox" class="form-check-input"/>
                        </div>*@

                        <div class="mb-3 col-md-12">
                            <label class="form-check-label">Enabled</label>
                            <input asp-for="@Model.IsActive" type="checkbox" class="form-check-input"/>
                        </div>


                        <div class="btn-group">
                            <button type="submit" id="formsubmit" class="btn btn-primary">Save changes</button>
                        </div>

                    </div>
                }
            </div>
        </div>
    </div>
</div>