@{
    ViewBag.Title = "Cold Leads Management";
}

@section Title
{
    Cold Leads Management
}

<div class="row">
    <div class="col-12">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-light d-flex align-items-center justify-content-between flex-wrap gap-3 py-3 border-bottom-0">
                <div class="d-flex align-items-center gap-2">
                    <button class="btn btn-primary btn-sm d-flex align-items-center gap-1" data-bs-toggle="modal" data-bs-target="#createColdLeadModal" style="border-radius: 6px; padding: 6px 14px;">
                        <i class="fas fa-plus"></i> Add New Cold Lead
                    </button>
                </div>

                <div class="d-flex align-items-center gap-2 flex-wrap ms-auto">
                    <select id="staffFilter" class="form-select form-select-sm" style="width: 180px; border-radius: 6px;">
                        <option value="">All Staff</option>
                        @if (ViewBag.StaffList != null)
                        {
                            foreach (var staff in ViewBag.StaffList)
                            {
                                <option value="@staff.Id">@staff.Name</option>
                            }
                        }
                    </select>

                    <select id="statusFilter" class="form-select form-select-sm" style="width: 180px; border-radius: 6px;">
                        <option value="">All Statuses</option>
                        <option value="0">Pending</option>
                        <option value="1">Partially Completed</option>
                        <option value="2">Completed</option>
                        <option value="3">Not Interested</option>
                    </select>
                </div>
            </div>

            <div class="card-body">
                <table id="coldLeadTable" class="table table-striped table-bordered dt-responsive nowrap w-100">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Name</th>
                            <th>Phone Number</th>
                            <th>Assigned Staff</th>
                            <th>Status</th>
                            <th>Remarks</th>
                            <th>Created Date</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Create Modal -->
<div class="modal fade" id="createColdLeadModal" tabindex="-1" aria-labelledby="createColdLeadModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="createColdLeadModalLabel">Add New Cold Lead</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="createColdLeadForm">
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="createName" class="form-label">User / Prospect Name <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="createName" name="name" required placeholder="Enter name" />
                    </div>
                    <div class="mb-3">
                        <label for="createPhoneNumber" class="form-label">Phone Number <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="createPhoneNumber" name="phoneNumber" required placeholder="Enter phone number" />
                    </div>
                    <div class="mb-3">
                        <label for="createStaffId" class="form-label">Assign Staff <span class="text-danger">*</span></label>
                        <select class="form-select" id="createStaffId" name="assignedStaffId" required>
                            <option value="">-- Select Staff --</option>
                            @if (ViewBag.StaffList != null)
                            {
                                foreach (var staff in ViewBag.StaffList)
                                {
                                    <option value="@staff.Id">@staff.Name</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="createRemarks" class="form-label">Remarks / Notes</label>
                        <textarea class="form-control" id="createRemarks" name="remarks" rows="3" placeholder="Enter optional remarks"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-primary">Create Cold Lead</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Edit Modal -->
<div class="modal fade" id="editColdLeadModal" tabindex="-1" aria-labelledby="editColdLeadModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="editColdLeadModalLabel">Edit Cold Lead</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="editColdLeadForm">
                <input type="hidden" id="editId" name="id" />
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="editName" class="form-label">User / Prospect Name <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="editName" name="name" required />
                    </div>
                    <div class="mb-3">
                        <label for="editPhoneNumber" class="form-label">Phone Number <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="editPhoneNumber" name="phoneNumber" required />
                    </div>
                    <div class="mb-3">
                        <label for="editStaffId" class="form-label">Assigned Staff <span class="text-danger">*</span></label>
                        <select class="form-select" id="editStaffId" name="assignedStaffId" required>
                            <option value="">-- Select Staff --</option>
                            @if (ViewBag.StaffList != null)
                            {
                                foreach (var staff in ViewBag.StaffList)
                                {
                                    <option value="@staff.Id">@staff.Name</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="editStatus" class="form-label">Status <span class="text-danger">*</span></label>
                        <select class="form-select" id="editStatus" name="status" required>
                            <option value="0">Pending</option>
                            <option value="1">Partially Completed</option>
                            <option value="2">Completed</option>
                            <option value="3">Not Interested</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="editRemarks" class="form-label">Remarks / Notes</label>
                        <textarea class="form-control" id="editRemarks" name="remarks" rows="3"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-primary">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            var table = $('#coldLeadTable').DataTable({
                processing: true,
                serverSide: true,
                ajax: {
                    url: '/admin/cold-leads-data',
                    type: 'POST',
                    data: function (d) {
                        d.staffId = $('#staffFilter').val();
                        d.statusFilter = $('#statusFilter').val();
                    }
                },
                columns: [
                    { data: null, render: function (data, type, row, meta) { return meta.row + 1; } },
                    { data: 'name' },
                    { data: 'phoneNumber' },
                    { 
                        data: 'assignedStaffName', 
                        render: function (data) { 
                            return '<span class="badge bg-soft-primary text-primary font-size-12 px-2 py-1"><i class="fas fa-user me-1"></i>' + data + '</span>'; 
                        } 
                    },
                    {
                        data: 'status',
                        render: function (data, type, row) {
                            switch (data) {
                                case 0:
                                    return '<span class="badge bg-warning text-dark px-2 py-1">Pending</span>';
                                case 1:
                                    return '<span class="badge bg-info text-white px-2 py-1">Partially Completed</span>';
                                case 2:
                                    return '<span class="badge bg-success px-2 py-1">Completed</span>';
                                case 3:
                                    return '<span class="badge bg-danger px-2 py-1">Not Interested</span>';
                                default:
                                    return '<span class="badge bg-secondary px-2 py-1">Unknown</span>';
                            }
                        }
                    },
                    { data: 'remarks' },
                    { data: 'createdOn' },
                    {
                        data: null,
                        orderable: false,
                        render: function (data, type, row) {
                            return `
                                <button class="btn btn-sm btn-soft-info edit-lead-btn" data-lead='${JSON.stringify(row)}'>
                                    <i class="fas fa-edit"></i> Edit
                                </button>
                                <button class="btn btn-sm btn-soft-danger delete-lead-btn" data-id="${row.id}">
                                    <i class="fas fa-trash-alt"></i> Delete
                                </button>
                            `;
                        }
                    }
                ]
            });

            $('#staffFilter, #statusFilter').change(function () {
                table.draw();
            });

            // Create Form Submission
            $('#createColdLeadForm').submit(function (e) {
                e.preventDefault();
                var $btn = $(this).find('button[type="submit"]');
                var originalHtml = $btn.html();
                $btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span> Creating...');

                $.ajax({
                    url: '/admin/cold-lead/create',
                    type: 'POST',
                    data: $(this).serialize(),
                    success: function (res) {
                        if (res.success) {
                            Swal.fire('Success', res.message, 'success');
                            $('#createColdLeadModal').modal('hide');
                            $('#createColdLeadForm')[0].reset();
                            table.draw();
                        } else {
                            Swal.fire('Error', res.message, 'error');
                        }
                    },
                    error: function () {
                        Swal.fire('Error', 'Failed to create cold lead.', 'error');
                    },
                    complete: function () {
                        $btn.prop('disabled', false).html(originalHtml);
                    }
                });
            });

            // Edit button click
            $(document).on('click', '.edit-lead-btn', function () {
                var lead = $(this).data('lead');
                $('#editId').val(lead.id);
                $('#editName').val(lead.name);
                $('#editPhoneNumber').val(lead.phoneNumber);
                $('#editStaffId').val(lead.assignedStaffId);
                $('#editStatus').val(lead.status);
                $('#editRemarks').val(lead.remarks);
                $('#editColdLeadModal').modal('show');
            });

            // Edit Form Submission
            $('#editColdLeadForm').submit(function (e) {
                e.preventDefault();
                var $btn = $(this).find('button[type="submit"]');
                var originalHtml = $btn.html();
                $btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span> Updating...');

                $.ajax({
                    url: '/admin/cold-lead/update',
                    type: 'POST',
                    data: $(this).serialize(),
                    success: function (res) {
                        if (res.success) {
                            Swal.fire('Success', res.message, 'success');
                            $('#editColdLeadModal').modal('hide');
                            table.draw();
                        } else {
                            Swal.fire('Error', res.message, 'error');
                        }
                    },
                    error: function () {
                        Swal.fire('Error', 'Failed to update cold lead.', 'error');
                    },
                    complete: function () {
                        $btn.prop('disabled', false).html(originalHtml);
                    }
                });
            });

            // Delete lead
            $(document).on('click', '.delete-lead-btn', function () {
                var id = $(this).data('id');
                Swal.fire({
                    title: 'Are you sure?',
                    text: "You won't be able to revert this!",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#3085d6',
                    cancelButtonColor: '#d33',
                    confirmButtonText: 'Yes, delete it!'
                }).then((result) => {
                    if (result.isConfirmed) {
                        $.ajax({
                            url: '/admin/cold-lead/delete/' + id,
                            type: 'POST',
                            success: function (res) {
                                if (res.success) {
                                    Swal.fire('Deleted!', res.message, 'success');
                                    table.draw();
                                } else {
                                    Swal.fire('Error', res.message, 'error');
                                }
                            },
                            error: function () {
                                Swal.fire('Error', 'Failed to delete cold lead.', 'error');
                            }
                        });
                    }
                });
            });
        });
    </script>
}
