                                <li><a asp-action="GetAll" asp-controller="BodyFeatures" asp-route-type="@BodyFeature.Course">Course</a></li>
                                <li><a asp-action="GetAll" asp-controller="BodyFeatures" asp-route-type="@BodyFeature.ProfessionType">Profession Type</a></li>
