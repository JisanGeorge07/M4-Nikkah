                                <span data-key="t-dashboard">Staff Management</span>
                            </a>
                        </li> -->

                    </ul>
                </div> 
            </div>
        </div>

        <div class="main-content" style="min-height: 512px;">
            <div class="page-content">
                <div class="container-fluid">
                    <div class="row">
                        <div class="col-12">
                            <div class="page-title-box d-sm-flex align-items-center justify-content-between">
                                    <h4 class="mb-sm-0 font-size-18">@await RenderSectionAsync("Title", required: false)</h4>
                            </div>
                        </div>
                    </div>
                    @RenderBody()
                </div>
            </div>

            <footer class="footer">
                <div class="container-fluid">
                    <div class="row">
                        <div class="col-sm-12">
                            <div class="text-sm-end d-none d-sm-block">
                                © @DateTime.Now.Year <a href="https://uniwebonline.com/" target="_blank" class="text-decoration-underline">Uniweb IT Solutions</a>. All rights reserved.
                            </div>
                        </div>
                    </div>
                </div>
            </footer>
        </div>
    </div>

    <script src="~/admin/assets/libs/jquery/jquery.min.js"></script>
