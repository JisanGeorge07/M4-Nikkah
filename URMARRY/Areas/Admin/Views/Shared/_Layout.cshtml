                                <li><a asp-action="AssignProfiles" asp-controller="Staff">Assign Profiles</a></li>
                                <li><a asp-action="ProfileVerifications" asp-controller="Staff">Profile Verification</a></li>
                                <li><a asp-action="PremiumFollowups" asp-controller="Staff">Premium Follow-up</a></li>
                                <li><a asp-action="RenewalFollowups" asp-controller="Staff">Renewal Follow-up</a></li>
