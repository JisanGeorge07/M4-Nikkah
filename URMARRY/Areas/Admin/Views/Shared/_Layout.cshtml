                            </a>
                            <ul class="sub-menu" aria-expanded="false">
                                <li><a asp-action="GetAll" asp-controller="ProfileFor">Profile For</a></li>
                                <li><a asp-action="GetAll" asp-controller="Nationality">Nationality</a></li>
                                <li><a asp-action="GetAll" asp-controller="MaritalStatus">Marital Status</a></li>
                                <li><a asp-action="GetAll" asp-controller="BodyFeatures" asp-route-type="@BodyFeature.Height">Height</a></li>
