    @await RenderSectionAsync("css", false)
</head>
<body>
    <div id="layout-wrapper">
        <header id="page-topbar">
            <div class="navbar-header">
                <div class="d-flex">
                    <div class="navbar-brand-box">
                        <a asp-action="Index" asp-controller="Admin" class="logo logo-dark">
                            <span class="logo-sm">
                                <span class="logo-txt"></span>
                            </span>
                            <span class="logo-lg">
                                <span class="logo-txt">M4 NIKAH</span>
                            </span>
                        </a>
                    </div>
                    <button type="button" class="btn btn-sm px-3 font-size-16 header-item" id="vertical-menu-btn">
                        <i class="fa fa-fw fa-bars"></i>
                    </button>
                </div>
                <div class="d-flex">
                    <div class="dropdown d-inline-block">
                        <button type="button" class="btn header-item bg-soft-light border-start border-end" id="page-header-user-dropdown"
                                data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                            <span class="d-none d-xl-inline-block ms-1 fw-medium">Admin.</span>
                            <i class="mdi mdi-chevron-down d-none d-xl-inline-block"></i>
                        </button>
                        <div class="dropdown-menu dropdown-menu-end">
                            <a class="dropdown-item" asp-controller="Admin" asp-action="Get"><i class="mdi mdi-lock font-size-16 align-middle me-1"></i> Change Password</a>
                            <a class="dropdown-item" asp-controller="Admin" asp-action="ChangePhone"><i class="mdi mdi-phone font-size-16 align-middle me-1"></i> Change Phone Number</a>
                            <div class="dropdown-divider"></div>
                            <a class="dropdown-item" asp-action="Logout" asp-controller="Account"><i class="mdi mdi-logout font-size-16 align-middle me-1"></i> Logout</a>
                        </div>
                    </div>
                </div>
            </div>
        </header>

