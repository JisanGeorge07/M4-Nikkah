@model List<Application.Models.UserReportReasonDto>
@{
    ViewBag.Title = "User Report Reasons";
}

@section Title
{
    User Report Reasons management
}

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <a asp-action="UserReportReasonGet" asp-route-id="0" class="btn btn-primary btn-xs">New</a>
            </div>
            <div class="card-body">
                <table id="datatable" class="table table-striped dt-responsive nowrap w-100">
                    <thead>
                    <tr>
                        <th width="40%">Reason</th>
                        <th width="20%">Status</th>
                        <th width="20%">Requires Description</th>
                        <th width="20%">Display Order</th>
                        <th width="20%">Action</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@Html.Raw(item.Reason)</td>
                            <td>
                                @Html.Raw(item.IsActive ? "Enabled" : "Disabled")
                            </td>
                            <td>
                                @Html.Raw(item.ShowDescriptionPopup ? "Yes" : "No")
                            </td>
                            <td>@Html.Raw(item.DisplayOrder)</td>
                            <td>
                                <a asp-action="UserReportReasonGet" asp-route-id="@item.Id" class="btn btn-primary btn-xs">
                                    <i class="fas fa-pencil-alt"></i>
                                </a>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>