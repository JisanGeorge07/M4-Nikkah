@using Domain
@model Application.Models.SuccessStoryDto
@{
    ViewBag.Title = "Success Story";
    List<RegistrationDto> users = ViewBag.users;
    string submitterName = ViewBag.SubmitterName;
    string submitterRegNumber = ViewBag.SubmitterRegNumber;
    long submitterId = ViewBag.SubmitterId;
    bool submitterIsDeleted = ViewBag.SubmitterIsDeleted ?? false;
    string partnerName = ViewBag.PartnerName;
    string partnerRegNumber = ViewBag.PartnerRegNumber;
    long partnerId = ViewBag.PartnerId;
    bool partnerIsDeleted = ViewBag.PartnerIsDeleted ?? false;
}

@section Title
{
    <a asp-action="GetAll" class="btn btn-primary btn-xs">
        <i class="fas fa-arrow-left"></i>
    </a>
    Success Story Details
}

<div class="row">
    <div class="col-12">
        <div class="card">

            <div class="card-body" id="ModalUser">
                @using (Html.BeginForm("Post", "SuccessStories", FormMethod.Post, new { enctype = "multipart/form-data" }))
                {
                    <div class="modal-body row">
                        <input type="hidden" asp-for="@Model.Id">
                        <input type="hidden" asp-for="@Model.SubmittedByUserId">
                        <input type="hidden" asp-for="@Model.PartnerUserId">
                        <input type="hidden" asp-for="@Model.MatchStatusUpdateId">
                        <input type="hidden" asp-for="@Model.BrideDisplayName">
                        <input type="hidden" asp-for="@Model.GroomDisplayName">
                        <input type="hidden" asp-for="@Model.MarriageDate">
                        <input type="hidden" asp-for="@Model.Rating">
                        <input type="hidden" asp-for="@Model.CouplePhotoPath">
                        <input type="hidden" asp-for="@Model.ConsentToPublish">
                        <input type="hidden" asp-for="@Model.Story">

                        @* --- Submission Info --- *@
                        <div class="mb-3 col-md-12 alert alert-info">
                            <p class="col-form-label mb-0">
                                <strong>
                                    <i class="fas fa-heart me-1"></i>
                                    <span class="text-body">Submitted on</span>
                                    @Model.CreatedOn!.Value.ToLocalTime().ToLongDateString()
                                    <span class="text-body">at</span>
                                    @Model.CreatedOn!.Value.ToLocalTime().ToShortTimeString()
                                </strong>
                            </p>
                        </div>

                        @if (Model.ReviewedOn is not null)
                        {
                            string alertClass =
                                "mb-3 col-md-12 alert alert-" +
                                Model.Status switch
                                {
                                    SuccessStoryStatus.Published => "success",
                                    SuccessStoryStatus.Approved => "info",
                                    SuccessStoryStatus.Rejected => "danger",
                                    _ => "warning"
                                };

                            string iconClass = Model.Status switch
                            {
                                SuccessStoryStatus.Published => "fas fa-check-circle me-1",
                                SuccessStoryStatus.Approved => "fas fa-thumbs-up me-1",
                                SuccessStoryStatus.Rejected => "fas fa-times-circle me-1",
                                _ => "fas fa-info-circle me-1"
                            };

                            <div class="@alertClass">
                                <p class="col-form-label mb-0">
                                    <strong>
                                        <i class="@iconClass"></i>
                                        <span class="text-body">@(Model.Status.ToString()) on</span>
                                        @Model.ReviewedOn!.Value.ToLocalTime().ToLongDateString()
                                        <span class="text-body">at</span>
                                        @Model.ReviewedOn!.Value.ToLocalTime().ToShortTimeString()
                                        <span class="text-body">by</span>
                                        @(Model.ReviewedByUsername ?? "Admin")
                                    </strong>
                                </p>
                            </div>
                        }

                        @* --- Profile Links --- *@
                        <div class="mb-3 col-md-6">
                            <label class="col-form-label"><strong>Submitted By</strong></label>
                            <div class="d-flex align-items-center">
                                @if (submitterIsDeleted)
                                {
                                    <span class="btn btn-outline-secondary btn-sm disabled">
                                        <i class="fas fa-user-slash me-1"></i>@submitterName (@submitterRegNumber) (Deleted)
                                    </span>
                                }
                                else
                                {
                                    <a href="/admin/enquiry/@submitterId" target="_blank" class="btn btn-outline-primary btn-sm">
                                        <i class="fas fa-user me-1"></i>@submitterName (@submitterRegNumber)
                                    </a>
                                }
                            </div>
                        </div>

                        <div class="mb-3 col-md-6">
                            <label class="col-form-label"><strong>Matched Partner</strong></label>
                            <div class="d-flex align-items-center">
                                @if (partnerIsDeleted)
                                {
                                    <span class="btn btn-outline-secondary btn-sm disabled">
                                        <i class="fas fa-user-slash me-1"></i>@partnerName (@partnerRegNumber) (Deleted)
                                    </span>
                                }
                                else
                                {
                                    <a href="/admin/enquiry/@partnerId" target="_blank" class="btn btn-outline-primary btn-sm">
                                        <i class="fas fa-user me-1"></i>@partnerName (@partnerRegNumber)
                                    </a>
                                }
                            </div>
                        </div>

                        @* --- Couple Names --- *@
                        <div class="mb-3 col-md-6">
                            <label class="col-form-label">Groom Display Name</label>
                            <input type="text" value="@Model.GroomDisplayName" class="form-control" readonly>
                        </div>

                        <div class="mb-3 col-md-6">
                            <label class="col-form-label">Bride Display Name</label>
                            <input type="text" value="@Model.BrideDisplayName" class="form-control" readonly>
                        </div>

                        @* --- Marriage Date & Rating --- *@
                        <div class="mb-3 col-md-6">
                            <label class="col-form-label">Marriage Date</label>
                            <input type="text" value="@Model.MarriageDate.ToString("dd/MM/yyyy")" class="form-control" readonly>
                        </div>

                        <div class="mb-3 col-md-6">
                            <label class="col-form-label">Rating</label>
                            <div class="pt-2">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    <i class="@(i <= Model.Rating ? "fas fa-star text-warning" : "far fa-star text-muted")" style="font-size: 18px;"></i>
                                }
                                <span class="ms-2 text-muted">(@Model.Rating / 5)</span>
                            </div>
                        </div>

                        @* --- Couple Photo --- *@
                        <div class="mb-3 col-md-12">
                            <label class="col-form-label">Couple Photo</label>
                            <div>
                                @if (!string.IsNullOrEmpty(Model.CouplePhotoPath))
                                {
                                    <img src="/@Model.CouplePhotoPath" alt="Couple Photo" style="max-width: 300px; max-height: 300px; border-radius: 8px; border: 2px solid #ddd;">
                                }
                                else
                                {
                                    <span class="text-muted">No photo uploaded</span>
                                }
                            </div>
                        </div>

                        @* --- Original Story --- *@
                        <div class="mb-3 col-md-12">
                            <label class="col-form-label">Original Story (read-only)</label>
                            <textarea class="form-control" rows="4" readonly>@Model.Story</textarea>
                        </div>

                        <div class="mb-3 col-md-12">
                            <label class="col-form-label">Admin Edited Story <small class="text-muted">(edit for spelling/grammar corrections — this version will be published)</small></label>
                            <textarea asp-for="@Model.AdminEditedStory" class="form-control" rows="4" maxlength="300"
                                      placeholder="Leave empty to use original story text">@(Model.AdminEditedStory ?? Model.Story)</textarea>
                            <div class="text-end mt-1">
                                <small class="text-muted"><span id="adminStoryCharCount">0</span>/300 characters</small>
                            </div>
                        </div>

                        @* --- Consent & Privacy --- *@
                        <div class="mb-3 col-md-6">
                            <label class="col-form-label">Consent to Publish</label>
                            <div>
                                @if (Model.ConsentToPublish)
                                {
                                    <span class="badge bg-success"><i class="fas fa-check me-1"></i>Yes - Consent Given</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger"><i class="fas fa-times me-1"></i>No - No Consent</span>
                                }
                            </div>
                        </div>

                        <div class="mb-3 col-md-6">
                            <label class="col-form-label">Name Privacy</label>
                            <div class="form-check mt-1">
                                <input class="form-check-input" type="checkbox" asp-for="@Model.HideFullName" id="HideFullName">
                                <label class="form-check-label" for="HideFullName">
                                    Hide full name (show initials only on website)
                                </label>
                            </div>
                        </div>

                        @* --- Status --- *@
                        <div class="mb-3 col-md-6">
                            <label class="col-form-label">Status</label>
                            <select asp-for="@Model.Status" class="form-select" required="required">
                                <option value="@SuccessStoryStatus.PendingApproval">Pending Approval</option>
                                <option value="@SuccessStoryStatus.Approved">Approved</option>
                                <option value="@SuccessStoryStatus.Published">Published</option>
                                <option value="@SuccessStoryStatus.Rejected">Rejected</option>
                                <option value="@SuccessStoryStatus.Unpublished">Unpublished</option>
                            </select>
                        </div>

                        @* --- Featured --- *@
                        <div class="mb-3 col-md-6">
                            <label class="col-form-label">Featured</label>
                            <div class="form-check mt-1">
                                <input class="form-check-input" type="checkbox" asp-for="@Model.IsFeatured" id="IsFeatured">
                                <label class="form-check-label" for="IsFeatured">
                                    Mark as Featured (shows first on home page)
                                </label>
                            </div>
                        </div>

                        @* --- Admin Notes --- *@
                        <div class="mb-3 col-md-12">
                            <label class="col-form-label">Admin Notes (internal only)</label>
                            <textarea asp-for="@Model.AdminNotes" class="form-control" rows="3"
                                      placeholder="Internal notes, not visible to users"></textarea>
                        </div>

                        @* --- Action Buttons --- *@
                        <div class="d-flex justify-content-between align-items-center mt-3">
                            <div class="btn-group">
                                <button type="submit" id="formsubmit" class="btn btn-primary">
                                    <i class="fas fa-save me-1"></i>Save Changes
                                </button>
                            </div>

                            @if (Model.Id > 0)
                            {
                                <form asp-action="Delete" asp-route-id="@Model.Id" method="post"
                                      onsubmit="return confirm('Are you sure you want to delete this success story?');"
                                      style="display: inline;">
                                    <button type="submit" class="btn btn-danger">
                                        <i class="fas fa-trash me-1"></i>Delete
                                    </button>
                                </form>
                            }
                        </div>

                    </div>
                }
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        var textarea = document.getElementById("AdminEditedStory");
        var counter = document.getElementById("adminStoryCharCount");
        var form = textarea ? textarea.closest("form") : null;
        
        if (textarea && counter) {
            function updateCounter() {
                counter.innerText = textarea.value.length;
                if (textarea.value.length > 300) {
                    counter.style.color = 'red';
                } else {
                    counter.style.color = '';
                }
            }
            textarea.addEventListener("input", updateCounter);
            updateCounter(); // Initial load count
        }
        
        if (form && textarea) {
            form.addEventListener("submit", function (e) {
                if (textarea.value.length > 300) {
                    e.preventDefault();
                    alert("Admin Edited Story cannot exceed 300 characters!");
                }
            });
        }
    });
</script>
