@model Application.Models.Call.CallReportReasonDto
@{
    ViewBag.Title = Model.Id > 0 ? "Edit Call Report Reason" : "New Call Report Reason";
}

@section Title
{
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm me-2">
        <i class="fas fa-arrow-left"></i> Back
    </a>
    @(Model.Id > 0 ? "Edit Reason" : "Create New Reason")
}

<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6">
        <div class="card shadow-sm">
            <div class="card-header">
                <h5 class="card-title mb-0">@(Model.Id > 0 ? "Edit Complaint Reason" : "Add New Complaint Reason")</h5>
            </div>
            <div class="card-body">
                <form asp-action="Post" asp-controller="CallReportReasons" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />

                    <div class="mb-3">
                        <label class="form-label fw-semibold" asp-for="Reason">Reason Title <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" asp-for="Reason" placeholder="e.g. Inappropriate Behaviour" required />
                        <span asp-validation-for="Reason" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold" asp-for="Description">Description (Optional)</label>
                        <textarea class="form-control" asp-for="Description" rows="2" placeholder="Internal notes or description"></textarea>
                    </div>

                    @if (Model.Id > 0)
                    {
                        <div class="mb-3">
                            <label class="form-label fw-semibold" asp-for="DisplayOrder">Display Order</label>
                            <input type="number" min="1" class="form-control" asp-for="DisplayOrder" />
                        </div>
                    }

                    <div class="mb-4 form-check form-switch">
                        <input asp-for="IsActive" type="checkbox" class="form-check-input" id="isActiveSwitch" />
                        <label class="form-check-label fw-semibold" for="isActiveSwitch">Active (Show in Client Dropdown)</label>
                    </div>

                    <div class="d-flex justify-content-between">
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="fas fa-save me-1"></i> Save Reason
                        </button>

                        @if (Model.Id > 0)
                        {
                            <button type="submit" formaction="@Url.Action("Delete", "CallReportReasons", new { id = Model.Id })"
                                    onclick="return confirm('Are you sure you want to delete this reason?')"
                                    class="btn btn-outline-danger">
                                <i class="fas fa-trash-alt me-1"></i> Delete
                            </button>
                        }
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
