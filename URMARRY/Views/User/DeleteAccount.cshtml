@model HomeViewModel
@{
    Layout = "/Views/Shared/_LayoutAccount.cshtml";
}

<div class="d-md-flex justify-content-between align-items-center">
    <h5 class="mb-0">Delete Profile</h5>

    <nav aria-label="breadcrumb" class="d-inline-block mt-2 mt-sm-0">
        <ul class="breadcrumb bg-transparent rounded mb-0 p-0">
            <li class="breadcrumb-item text-capitalize">
                <a asp-action="Dashboard" asp-controller="User">M4NIKAH</a>
            </li>
            <li class="breadcrumb-item text-capitalize active" aria-current="page">Delete Profile</li>
        </ul>
    </nav>
</div>

<div class="col-xl-12 mt-3">
    <div class="card mb-4">
        <div class="card-header">Delete Profile</div>
        <div class="card-body">
            <div class="row gx-3 mb-3">
                <div class="col-lg-12 mt-4">
                    <div class="card border-0 rounded shadow p-4 mt-4">
                        <h5 class="mb-0 text-danger">Delete Account :</h5>

                        <div class="mt-4">
                            <h6 class="mb-0">
                                Do you want to delete the account? Please press the "Delete" button below.
                            </h6>
                            <div class="mt-4">
                                <a asp-action="AccountDelete" asp-controller="User" class="btn btn-danger" id="deleteAccountBtn">
                                    Delete Account
                                </a>
                            </div><!--end col-->
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('deleteAccountBtn').addEventListener('click', function() {
            alert('Your Account Has Been Deleted Successfully');
        });
    </script>
}