@model HomeViewModel
@using Application.Helpers
@{
    Layout = "/Views/Shared/_LayoutAccount.cshtml";
    var user = Model.Registration!;
    var image = Model.Images!;
    var dateOfBirth = !string.IsNullOrEmpty(user.DOB) ? user.DOB : "01/01/1990";
    var str1 = dateOfBirth.Replace("-", "/").Split('/');
    var day1 = string.Empty;
    var month1 = string.Empty;
    var year1 = str1[2];
    if (str1[0].Length < 2)
    {
        day1 = "0" + str1[0];
    }
    else
    {
        day1 = str1[0];
    }
    if (str1[1].Length < 2)
    {
        month1 = "0" + str1[1];
    }
    else
    {
        month1 = str1[1];
    }
    if (day1.Length > 2)
    {
        var y = year1;
        var d = day1;
        day1 = y;
        year1 = d;
    }
    var dob1 = day1 + "/" + month1 + "/" + year1;
    DateTime myDate1 = DateTime.ParseExact(dob1, "dd/MM/yyyy", System.Globalization.CultureInfo.InvariantCulture);
    DateTime today = DateTime.UtcNow;
    DateTime birthDate = myDate1;
    int age = today.Year - birthDate.Year;

    if (birthDate > today.AddYears(-age))
    {
        age--;
    }

}

