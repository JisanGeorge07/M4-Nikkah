@{
    Layout = null;
}

<!doctype html>
<html lang="en" dir="ltr">
<head>
    <meta charset="utf-8">
    <title>M4NIKAH - Login with Mobile OTP</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="M4NIKAH - Login with Mobile OTP">

    <!-- favicon -->
    <link rel="shortcut icon" href="/assets/images/favicon.png">

    <!-- Css -->
    <link href="/assets/css/bootstrap.min.css" id="bootstrap-style" class="theme-opt" rel="stylesheet" type="text/css">
    <!-- Icons Css -->
    <link href="/assets/libs/%40mdi/font/css/materialdesignicons.min.css" rel="stylesheet" type="text/css">
    <link href="/assets/libs/%40iconscout/unicons/css/line.css" type="text/css" rel="stylesheet">
    <!-- Style Css-->
    <link href="/assets/css/style.min.css" id="color-opt" class="theme-opt" rel="stylesheet" type="text/css">
    
    <style>
        .otp-container {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 8px;
            flex-wrap: nowrap !important;
            margin-top: 15px;
            margin-bottom: 20px;
        }

        .otp-input {
            width: 45px;
            height: 45px;
            text-align: center;
            font-size: 20px;
            font-weight: 600;
            border: 1.5px solid #dce8e3;
            border-radius: 8px;
            background-color: #e7efec;
            color: #00662d;
            outline: none;
            transition: all 0.2s ease;
            margin: 0 !important;
            padding: 0;
            -webkit-appearance: none;
            appearance: none;
            -moz-appearance: textfield;
        }

        .otp-input::-webkit-outer-spin-button,
        .otp-input::-webkit-inner-spin-button {
            -webkit-appearance: none;
            margin: 0;
        }

        .otp-input:focus {
            border-color: #a5be25;
            background-color: #ffffff;
            box-shadow: 0 0 0 3px rgba(165, 190, 37, 0.25);
        }

        @@media (max-width: 480px) {
            .otp-container {
                gap: 5px;
            }
            .otp-input {
                width: 35px;
                height: 35px;
                font-size: 16px;
            }
        }
    </style>
</head>

<body>
    <div class="back-to-home">
        <a asp-action="Login" asp-controller="User" class="back-button btn btn-icon btn-primary"><i data-feather="arrow-left" class="icons"></i></a>
    </div>

    <!-- Hero Start -->
    <section class="position-relative" style="background: url('/assets/images/login_bg.jpg') center;">
        <div class="bg-overlay bg-linear-gradient-2"></div>
        <div class="container-fluid">
            <div class="row">
                <div class="col-12 p-0">
                    <div class="d-flex flex-column min-vh-100 p-4">
                        <!-- Start Logo -->
                        <div class="text-center mb-3">
                            <a href="~/"><img src="/assets/images/favicon.png" alt=""></a>
                        </div>
                        <!-- End Logo -->
                        <!-- Start Content -->
                        <div class="title-heading my-auto">
                            <div class="card form-signin px-4 py-5 rounded-md shadow-sm setpdiv">
                                <div class="text-center">
                                    <h5 class="mb-4">Login with Mobile OTP</h5>
                                </div>

                                <div id="feedbackMessage" class="alert d-none mb-3" role="alert"></div>

                                <!-- Step 1: Send OTP -->
                                <div id="stepSendOtp">
                                    <p class="text-muted">Enter your registered mobile number. We will send you a 6-digit One-Time Password (OTP) via SMS to log in.</p>
                                    <div class="row">
                                        <div class="col-12">
                                            <div class="mb-3">
                                                <input type="tel" class="reg-input-custom text-center" id="MobileInput" placeholder="Mobile Number *" required>
                                            </div>
                                        </div><!--end col-->

                                        <div class="col-12">
                                            <button class="btn btn-primary rounded-md w-100" id="SendOtpBtn" type="button">
                                                <span class="spinner-border spinner-border-sm d-none me-2" id="sendSpinner" role="status" aria-hidden="true"></span>
                                                Send OTP
                                            </button>
                                        </div><!--end col-->
                                    </div><!--end row-->
                                </div>

                                <!-- Step 2: Verify OTP -->
                                <div id="stepVerifyOtp" class="d-none">
                                    <p class="text-muted">Enter the 6-digit OTP code sent to <strong id="displayMobile"></strong>.</p>
                                    <div class="row">
                                        <div class="col-12">
                                            <div class="mb-3">
                                                <div class="otp-container d-flex justify-content-between align-items-center mb-3">
                                                    <input type="number" class="otp-input" id="Pin1" pattern="\d" maxlength="1">
                                                    <input type="number" class="otp-input" id="Pin2" pattern="\d" maxlength="1" disabled>
                                                    <input type="number" class="otp-input" id="Pin3" pattern="\d" maxlength="1" disabled>
                                                    <input type="number" class="otp-input" id="Pin4" pattern="\d" maxlength="1" disabled>
                                                    <input type="number" class="otp-input" id="Pin5" pattern="\d" maxlength="1" disabled>
                                                    <input type="number" class="otp-input" id="Pin6" pattern="\d" maxlength="1" disabled>
                                                </div>
                                                <input type="hidden" id="verificationCode">
                                            </div>
                                        </div><!--end col-->

                                        <div class="col-12">
                                            <button class="btn btn-primary rounded-md w-100 mb-3" id="VerifyOtpBtn" type="button">
                                                <span class="spinner-border spinner-border-sm d-none me-2" id="verifySpinner" role="status" aria-hidden="true"></span>
                                                Verify & Login
                                            </button>
                                        </div><!--end col-->

                                        <div class="col-12 text-center">
                                            <small class="text-muted">
                                                Didn't receive code? 
                                                <a href="javascript:void(0);" id="ResendLink" class="text-dark fw-bold">Resend OTP</a>
                                                <span id="countdownContainer" class="d-none">in <span id="countdownTimer">30</span>s</span>
                                            </small>
                                        </div>
                                    </div><!--end row-->
                                </div>

                                <div class="col-12 text-center mt-4">
                                    <small><span class="text-muted me-2">Remember your password? </span><a asp-action="Login" asp-controller="User" class="text-dark fw-bold">Sign in</a></small>
                                </div><!--end col-->
                            </div>
                        </div>
                        <!-- End Content -->
                        <!-- Start Footer -->
                        <div class="text-center text-white">
                            <p class="mb-0">© @DateTime.UtcNow.Year M4NIKAH. All Rights Reserved.</p>
                        </div>
                        <!-- End Footer -->
                    </div>
                </div><!--end col-->
            </div><!--end row-->
        </div><!--end container-->
    </section><!--end section-->
    
    <script src="/assets/libs/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="/assets/libs/feather-icons/feather.min.js"></script>
    <script src="/assets/js/plugins.init.js"></script>
    <script src="/assets/js/app.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const stepSendOtp = document.getElementById("stepSendOtp");
            const stepVerifyOtp = document.getElementById("stepVerifyOtp");
            const mobileInput = document.getElementById("MobileInput");
            const sendOtpBtn = document.getElementById("SendOtpBtn");
            const verifyOtpBtn = document.getElementById("VerifyOtpBtn");
            const resendLink = document.getElementById("ResendLink");
            const displayMobile = document.getElementById("displayMobile");
            const feedbackMessage = document.getElementById("feedbackMessage");
            const sendSpinner = document.getElementById("sendSpinner");
            const verifySpinner = document.getElementById("verifySpinner");
            const countdownContainer = document.getElementById("countdownContainer");
            const countdownTimer = document.getElementById("countdownTimer");

            let resendCooldown = 0;
            let cooldownInterval;

            function showFeedback(message, type = "danger") {
                feedbackMessage.textContent = message;
                feedbackMessage.className = `alert alert-${type} mb-3`;
            }

            function clearFeedback() {
                feedbackMessage.textContent = "";
                feedbackMessage.className = "alert d-none mb-3";
            }

            function startResendCooldown() {
                resendCooldown = 30;
                resendLink.classList.add("d-none");
                countdownContainer.classList.remove("d-none");
                countdownTimer.textContent = resendCooldown;

                clearInterval(cooldownInterval);
                cooldownInterval = setInterval(function () {
                    resendCooldown--;
                    if (resendCooldown <= 0) {
                        clearInterval(cooldownInterval);
                        resendLink.classList.remove("d-none");
                        countdownContainer.classList.add("d-none");
                    } else {
                        countdownTimer.textContent = resendCooldown;
                    }
                }, 1000);
            }

            async function sendOtp() {
                const mobile = mobileInput.value.trim();
                if (!mobile) {
                    showFeedback("Please enter a valid mobile number.");
                    return;
                }

                clearFeedback();
                sendOtpBtn.disabled = true;
                sendSpinner.classList.remove("d-none");

                try {
                    const response = await fetch("/user/otp/send", {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/json"
                        },
                        body: JSON.stringify({ type: "mobile", identifier: mobile })
                    });

                    const data = await response.json();
                    if (data.success) {
                        displayMobile.textContent = mobile;
                        stepSendOtp.classList.add("d-none");
                        stepVerifyOtp.classList.remove("d-none");
                        showFeedback(data.message || "OTP code sent successfully.", "success");
                        startResendCooldown();

                        // Clear and focus OTP inputs
                        document.querySelectorAll(".otp-input").forEach(el => {
                            el.value = "";
                            if (el.id !== "Pin1") {
                                el.disabled = true;
                            } else {
                                el.disabled = false;
                            }
                        });
                        document.getElementById("verificationCode").value = "";
                        setTimeout(() => {
                            document.getElementById("Pin1").focus();
                        }, 100);
                    } else {
                        showFeedback(data.error || "Failed to send OTP. Account may not exist.");
                    }
                } catch (error) {
                    showFeedback("An error occurred. Please try again.");
                } finally {
                    sendOtpBtn.disabled = false;
                    sendSpinner.classList.add("d-none");
                }
            }

            async function verifyOtp() {
                const mobile = mobileInput.value.trim();
                const otp = document.getElementById("verificationCode").value.trim();
                if (!otp || otp.length !== 6) {
                    showFeedback("Please enter a valid 6-digit OTP code.");
                    return;
                }

                clearFeedback();
                verifyOtpBtn.disabled = true;
                verifySpinner.classList.remove("d-none");

                try {
                    const response = await fetch("/user/otp/login", {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/json"
                        },
                        body: JSON.stringify({ type: "mobile", identifier: mobile, otp: otp })
                    });

                    const data = await response.json();
                    if (data.success) {
                        showFeedback("Verification successful! Redirecting...", "success");
                        window.location.href = data.returnUrl || "/";
                    } else {
                        showFeedback(data.error || "Invalid or expired OTP code.");
                    }
                } catch (error) {
                    showFeedback("An error occurred during verification. Please try again.");
                } finally {
                    verifyOtpBtn.disabled = false;
                    verifySpinner.classList.add("d-none");
                }
            }

            sendOtpBtn.addEventListener("click", sendOtp);
            verifyOtpBtn.addEventListener("click", verifyOtp);
            resendLink.addEventListener("click", sendOtp);
        });
    </script>
</body>
</html>
