<style>
    .no-results-container {
        font-family: Arial, sans-serif;
        background-color: #f4f4f4;
        display: flex;
        justify-content: center;
        align-items: center;
        height: 100vh;
        margin: 0;
    }

    .no-results-box {
        background-color: #fff;
        padding: 2rem;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        border-radius: 10px;
        text-align: center;
        max-width: 400px;
        width: 100%;
    }

    .icon-no-results {
        font-size: 3rem;
        color: #4caf50;
        margin-bottom: 1rem;
    }

    .no-results-message {
        margin: 1rem 0;
        font-size: 1.2rem;
        color: #555;
    }

    .btn {
        display: inline-block;
        margin-top: 1rem;
        padding: 0.7rem 1.5rem;
        background-color: #4caf50;
        color: #fff;
        text-decoration: none;
        border-radius: 5px;
        font-size: 1rem;
    }

        .btn:hover {
            background-color: forestgreen;
            color: #fff;
        }
</style>

<div class="no-results-container">
    <div class="no-results-box">
        <div class="icon-no-results">🔍</div>
        <h2>No Results Found</h2>
        <div class="no-results-message">
            <p>Sorry, we couldn't find any results for your search.</p>
        </div>
        <a asp-controller="User" asp-action="SearchProfile" class="btn">Return to Search</a>
    </div>
</div>

