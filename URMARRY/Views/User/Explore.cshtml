@section Scripts
{
    <script>
    (function () {
        // --- State ---
        const userId = @Model.Registration.Id;
        const isPremiumMember = @Model.Registration.IsPremiumMember.ToString().ToLower();
        let currentType = 'favorited';
        let currentStatus = 1; // Default to Actioned for reported sub-tabs
        let currentInterestStatus = 0; // Default to Pending for liked sub-tabs
        let currentLikedSubMode = 'sent'; // 'sent' = I Liked Profiles, 'received' = My Profile Likes
        let currentPage = 0;
        let isLoading = false;
        let hasMore = true;
        let currentActionBtn = null;
        let currentActionType = null;
        let isRemovingInteraction = false;

        // --- DOM refs ---
        const grid = document.getElementById('profile-grid');
        const sentinel = document.getElementById('scroll-sentinel');
        const loader = document.getElementById('scroll-loader');
        const noResults = document.getElementById('no-results');
        const reportedSubTabs = document.getElementById('reported-sub-tabs');
        const likedMiddleTabs = document.getElementById('liked-middle-tabs');
        const likedSubTabs = document.getElementById('liked-sub-tabs');

        // --- Tab Type Map (new tab IDs → API type strings) ---
        const tabTypeMap = {
            'favorite': 'favorited',
            'liked': 'liked',
            'contacted': 'contactviewed',
            'reported': 'reported',
            'close': 'closeprofiles'
        };

        // --- Override showMainTab for Explore-specific behavior ---
        window.showMainTab = function(tabId) {
            // Update tab button styles
            document.querySelectorAll(".main-tab").forEach((btn) => {
                btn.classList.remove("active");
            });

            // Find tab button that matches tabId
            const tabBtn = Array.from(document.querySelectorAll(".main-tab")).find(btn => {
                const onclickAttr = btn.getAttribute("onclick");
                return onclickAttr && onclickAttr.includes(tabId);
            });
            if (tabBtn) {
                tabBtn.classList.add("active");
            } else if (event && event.target && event.target.classList.contains("main-tab")) {
                event.target.classList.add("active");
            }

            const type = tabTypeMap[tabId] || 'favorited';

            // Show/Hide reported sub-tabs
            if (type === 'reported') {
                reportedSubTabs.style.display = '';
                reportedSubTabs.style.cssText = ''; // Remove the !important inline override
                reportedSubTabs.classList.remove('d-none');
                currentStatus = 1; // Default to Actioned
                // Reset sub-tab active state
                reportedSubTabs.querySelectorAll('.bottom-tabs').forEach(btn => {
                    btn.classList.remove('active');
                    if (btn.getAttribute('data-status') === '1') btn.classList.add('active');
                });
                // Hide liked sub-tabs & middle tabs
                likedSubTabs.style.display = 'none';
                likedSubTabs.style.cssText = 'display: none !important;';
                if (likedMiddleTabs) {
                    likedMiddleTabs.style.display = 'none';
                    likedMiddleTabs.style.cssText = 'display: none !important;';
                }
            } else if (type === 'liked' || type === 'likedby') {
                // Show middle tabs
                if (likedMiddleTabs) {
                    likedMiddleTabs.style.display = '';
                    likedMiddleTabs.style.cssText = '';
                    likedMiddleTabs.classList.remove('d-none');
                    // Reset middle tabs active state
                    likedMiddleTabs.querySelectorAll('.bottom-tabs').forEach(btn => {
                        btn.classList.remove('active');
                    });
                    const btnILiked = document.getElementById('btn-i-liked');
                    if (btnILiked) btnILiked.classList.add('active');
                }
                currentLikedSubMode = 'sent';

                // Show sub-tabs
                likedSubTabs.style.display = '';
                likedSubTabs.style.cssText = ''; // Remove the !important inline override
                likedSubTabs.classList.remove('d-none');
                currentInterestStatus = 0; // Default to Pending
                // Reset sub-tab active state
                likedSubTabs.querySelectorAll('.bottom-tabs').forEach(btn => {
                    btn.classList.remove('active');
                    if (btn.getAttribute('data-interest-status') === '0') btn.classList.add('active');
                });
                // Hide reported sub-tabs
                reportedSubTabs.style.display = 'none';
                reportedSubTabs.style.cssText = 'display: none !important;';
            } else {
                reportedSubTabs.style.display = 'none';
                reportedSubTabs.style.cssText = 'display: none !important;';
                likedSubTabs.style.display = 'none';
                likedSubTabs.style.cssText = 'display: none !important;';
                if (likedMiddleTabs) {
                    likedMiddleTabs.style.display = 'none';
                    likedMiddleTabs.style.cssText = 'display: none !important;';
                }
            }

            if (type === currentType && currentPage > 0) return;

            // Reset and fetch
            currentType = type;
            currentPage = 0;
            hasMore = true;
            grid.innerHTML = '';
            noResults.style.display = 'none';
            loader.style.display = 'none';
            sentinel.style.display = 'none';
            fetchProfiles(false);
        };

        // --- Reported Sub-Tab Switching ---
        window.switchReportedStatus = function(btn, status) {
            if (status === currentStatus && currentPage > 0) return;

            // Update active styling
            reportedSubTabs.querySelectorAll('.bottom-tabs').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');

            // Reset and fetch
            currentStatus = status;
            currentPage = 0;
            hasMore = true;
            grid.innerHTML = '';
            noResults.style.display = 'none';
            loader.style.display = 'none';
            sentinel.style.display = 'none';
            fetchProfiles(false);
        };

        // --- Liked Sub-Tab Switching ---
        window.switchLikedStatus = function(btn, interestStatus) {
            if (interestStatus === currentInterestStatus && currentPage > 0) return;

            // Update active styling
            likedSubTabs.querySelectorAll('.bottom-tabs').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');

            // Reset and fetch
            currentInterestStatus = interestStatus;
            currentPage = 0;
            hasMore = true;
            grid.innerHTML = '';
            noResults.style.display = 'none';
            loader.style.display = 'none';
            sentinel.style.display = 'none';
            fetchProfiles(false);
        };

        // --- Liked Middle Tab Switching ---
        window.switchLikedMiddleTab = function(btn, mode) {
            if (mode === currentLikedSubMode && currentPage > 0) return;

            // Update active styling
            if (likedMiddleTabs) {
                likedMiddleTabs.querySelectorAll('.bottom-tabs').forEach(b => b.classList.remove('active'));
            }
            btn.classList.add('active');

            currentLikedSubMode = mode;
            currentType = (mode === 'received') ? 'likedby' : 'liked';
            
            // Reset to Pending subtab on change of middle tab
            currentInterestStatus = 0;
            likedSubTabs.querySelectorAll('.bottom-tabs').forEach(b => {
                b.classList.remove('active');
                if (b.getAttribute('data-interest-status') === '0') b.classList.add('active');
            });

            // Reset and fetch
            currentPage = 0;
            hasMore = true;
            grid.innerHTML = '';
            noResults.style.display = 'none';
            loader.style.display = 'none';
            sentinel.style.display = 'none';
            fetchProfiles(false);
        };

        // --- Fetch Profiles ---
        async function fetchProfiles(showLoader) {
            if (isLoading || !hasMore) return;
            isLoading = true;
            currentPage++;

            if (showLoader) {
                loader.style.display = 'block';
            }

            try {
                let url = `/api/profile/exploreprofiles?userId=${userId}&type=${currentType}&page=${currentPage}&pageSize=30`;
                if (currentType === 'reported') {
                    url += `&status=${currentStatus}`;
                }
                if (currentType === 'liked' || currentType === 'likedby') {
                    url += `&interestStatus=${currentInterestStatus}`;
                }
                const response = await fetch(url);
                const result = await response.json();

                if (!result.success) {
                    console.error('API error:', result);
                    isLoading = false;
                    return;
                }

                hasMore = result.hasMore;
                const profiles = result.data;

                if (profiles.length === 0 && currentPage === 1) {
                    noResults.style.display = 'block';
                    loader.style.display = 'none';
                    sentinel.style.display = 'none';
                    isLoading = false;
                    return;
                }

                if (showLoader) {
                    // Standard delay for a premium feel
                    await new Promise(resolve => setTimeout(resolve, 2000));
                }

                profiles.forEach(p => renderProfileCard(p));
                loader.style.display = 'none';

                if (!hasMore) {
                    sentinel.style.display = 'none';
                } else {
                    sentinel.style.display = 'block';
                }

                // Re-initialize Lucide Icons for the newly created elements
                if (window.lucide && typeof window.lucide.createIcons === 'function') {
                    window.lucide.createIcons();
                }
            } catch (err) {
                console.error('Fetch error:', err);
            } finally {
                isLoading = false;
            }
        }

        // --- Render Profile Card (using new UI Profile Card 1 template) ---
        function renderProfileCard(profile) {
            const imagePath = profile.imagePath
                ? '/' + profile.imagePath
                : (profile.gender === 'Female' ? '/assets/images/default-user-women.png' : '/assets/images/default-user-men.png');

            const detailParts = [
                profile.age ? profile.age + ' Yrs' : null,
                profile.height ? profile.height.replace(/\s*(feet|ft|\([^)]*\))/gi, '') : null,
                // profile.weight ? profile.weight + ' kg' : null,
                profile.maritalStatus,
                profile.community,
                profile.higherEducation,
                profile.village,
                profile.district,
                profile.state
            ].filter(Boolean);
            const profileDetails = detailParts.join(', ');
            const cleanName = (profile.name || '').replace(/'/g, "\\'");

            // Define dynamic link action pointing directly to the profile details page
            const profileUrl = '/profile/' + (profile.registerNumber ? profile.registerNumber : profile.id);
            const cardClickAction = `onclick="location.href='${profileUrl}'"`;

            const starClass = profile.isStarred ? 'glow-star' : '';
            let heartClass = '';
            if (profile.interestStatus === 'Pending') {
                heartClass = 'glow-heart-pending';
            } else if (profile.interestStatus === 'Accepted') {
                heartClass = 'glow-heart-accepted';
            } else if (profile.interestStatus === 'Declined') {
                heartClass = 'glow-heart-declined';
            } else if (profile.isLiked) {
                heartClass = 'glow-heart';
            }
            const isLockedClass = (profile.photosUnlocked || !profile.imagePath) ? '' : 'premium-card';

            let blurOverlayHtml = '';
            if (!profile.photosUnlocked && profile.imagePath) {
