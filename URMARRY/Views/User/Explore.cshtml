@using Application.Models
@model UserExploreViewModel
@{
    Layout = "/Views/Shared/_LayoutAccount.cshtml";
    <link href="/assets/account/assets/css/style.min.css" id="color-opt" class="theme-opt" rel="stylesheet" type="text/css">
}

@*

<div class="d-md-flex justify-content-between align-items-center">
    <!--<h5 class="mb-0">Profile</h5>-->
    <nav aria-label="breadcrumb" class="d-inline-block twomenu">
        <ul class="breadcrumb bg-transparent rounded mb-0 p-0">
            <li class="breadcrumb-item text-capitalize active"><a href="javascript:void(0)" data-type="favorited" class="explore-tab">Favorited Profiles</a></li>
            <li class="breadcrumb-item text-capitalize"><a href="javascript:void(0)" data-type="liked" class="explore-tab">Liked Profiles</a></li>
            <li class="breadcrumb-item text-capitalize"><a href="javascript:void(0)" data-type="contactviewed" class="explore-tab">Contact Viewed</a></li>
            <li class="breadcrumb-item text-capitalize"><a href="javascript:void(0)" data-type="reported" class="explore-tab">Reported Profiles</a></li>
            <li class="breadcrumb-item text-capitalize"><a href="javascript:void(0)" data-type="closeprofiles" class="explore-tab">Closed Profiles</a></li>
        </ul>
    </nav>
</div>

<!-- Reported Sub-Tabs -->
<div id="reported-sub-tabs" class="mt-2 text-center" style="display:none;">
    <nav aria-label="breadcrumb" class="d-inline-block twomenu">
        <ul class="breadcrumb bg-transparent rounded mb-0 p-0">
            <li class="breadcrumb-item text-capitalize active"><a href="javascript:void(0)" data-status="1" class="explore-status-tab">Actioned</a></li>
            <li class="breadcrumb-item text-capitalize"><a href="javascript:void(0)" data-status="2" class="explore-status-tab">Dismissed</a></li>
            <li class="breadcrumb-item text-capitalize"><a href="javascript:void(0)" data-status="0" class="explore-status-tab">Pending</a></li>
        </ul>
    </nav>
</div>


<div class="row">
    <div class="col-lg-12 mt-4 order-md-2 order-lg-2 order-2">
        <div class="card border-0 shadow rounded p-4 pt-0">

            <div id="profile-grid" class="row matchprofile">
                <!-- Profile cards will be loaded here -->
            </div>

            <!-- No results message -->
            <div id="no-results" class="text-center py-5" style="display:none;">
                <h6 class="text-muted">No profiles found in this category.</h6>
            </div>

            <!-- Loader spinner -->
            <div id="scroll-loader" class="mt-4 text-center" style="display:none;">
                <span class="h6 mb-0">Loading.. <i class="mdi mdi-loading mdi-spin h4 mb-0 align-middle"></i></span>
            </div>

            <!-- Invisible trigger for Infinite Scroll -->
            <div id="scroll-sentinel" style="height:1px; display:none;"></div>

        </div><!--end card-->
    </div><!--end col-->
</div><!--end row-->

@section Scripts
{
    <script>
    (function () {
        // --- State ---
        const userId = @Model.Registration.Id;
        const isPremiumMember = @Model.Registration.IsPremiumMember.ToString().ToLower();
        let currentType = 'favorited';
        let currentStatus = 1; // Default to Actioned
        let currentPage = 0;
        let isLoading = false;
        let hasMore = true;

        // --- DOM refs ---
        const grid = document.getElementById('profile-grid');
        const sentinel = document.getElementById('scroll-sentinel');
        const loader = document.getElementById('scroll-loader');
        const noResults = document.getElementById('no-results');
        const tabs = document.querySelectorAll('.explore-tab');
        const subTabContainer = document.getElementById('reported-sub-tabs');
        const statusTabs = document.querySelectorAll('.explore-status-tab');

        // --- Tab Switching ---
        tabs.forEach(tab => {
            tab.addEventListener('click', function (e) {
                e.preventDefault();
                const type = this.getAttribute('data-type');
                if (type === currentType && currentPage > 0) return;

                // Update active styling
                tabs.forEach(t => {
                    t.closest('li').classList.remove('active');
                });
                this.closest('li').classList.add('active');

                // Show/Hide sub-tabs
                if (type === 'reported') {
                    subTabContainer.style.display = 'block';
                    currentStatus = 1; // Default to Actioned when entering reported
                    statusTabs.forEach(st => {
                        st.closest('li').classList.remove('active');
                        if (st.getAttribute('data-status') == "1") st.closest('li').classList.add('active');
                    });
                } else {
                    subTabContainer.style.display = 'none';
                }

                // Reset and fetch
                currentType = type;
                currentPage = 0;
                hasMore = true;
                grid.innerHTML = '';
                noResults.style.display = 'none';
                loader.style.display = 'none';
                sentinel.style.display = 'none';
                fetchProfiles(false);
            });
        });

        // --- Status Tab Switching ---
        statusTabs.forEach(tab => {
            tab.addEventListener('click', function (e) {
                e.preventDefault();
                const status = parseInt(this.getAttribute('data-status'));
                if (status === currentStatus && currentPage > 0) return;

                // Update active styling
                statusTabs.forEach(t => t.closest('li').classList.remove('active'));
                this.closest('li').classList.add('active');

                // Reset and fetch
                currentStatus = status;
                currentPage = 0;
                hasMore = true;
                grid.innerHTML = '';
                noResults.style.display = 'none';
                loader.style.display = 'none';
                sentinel.style.display = 'none';
                fetchProfiles(false);
            });
        });

        // --- Fetch Profiles ---
        async function fetchProfiles(showLoader) {
            if (isLoading || !hasMore) return;
            isLoading = true;
            currentPage++;

            if (showLoader) {
                loader.style.display = 'block';
            }

            try {
                let url = `/api/profile/exploreprofiles?userId=${userId}&type=${currentType}&page=${currentPage}&pageSize=30`;
                if (currentType === 'reported') {
                    url += `&status=${currentStatus}`;
                }
                const response = await fetch(url);
                const result = await response.json();

                if (!result.success) {
                    console.error('API error:', result);
                    isLoading = false;
                    return;
                }

                hasMore = result.hasMore;
                const profiles = result.data;

                if (profiles.length === 0 && currentPage === 1) {
                    noResults.style.display = 'block';
                    loader.style.display = 'none';
                    sentinel.style.display = 'none';
                    isLoading = false;
                    return;
                }

                if (showLoader) {
                    // Standard delay for a premium feel
                    await new Promise(resolve => setTimeout(resolve, 2000));
                }

                profiles.forEach(p => renderProfileCard(p));
                loader.style.display = 'none';

                if (!hasMore) {
                    sentinel.style.display = 'none';
                } else {
                    sentinel.style.display = 'block';
                }
            } catch (err) {
                console.error('Fetch error:', err);
            } finally {
                isLoading = false;
            }
        }

        // --- Render Profile Card ---
        function renderProfileCard(profile) {
            const imagePath = profile.imagePath
                ? '/' + profile.imagePath
                : (profile.gender === 'Female' ? '/assets/images/default-user-women.png' : '/assets/images/default-user-men.png');

            const profileUrl = '/profile/' +
                (profile.registerNumber ? profile.registerNumber : profile.id);

            const detailParts = [
                profile.age ? profile.age + ' Yrs' : null,
                profile.height ? profile.height.replace(/\s*(feet|ft|\([^)]*\))/gi, '') : null,
                profile.maritalStatus,
                profile.educationType,
                // profile.profession,
                profile.community,
                // profile.religion,
                profile.village,
                profile.district
            ].filter(Boolean);
            const profileDetails = detailParts.join(', ');

            const starStyle = profile.isStarred
                ? 'text-shadow: 0px 0px 6px white, 0px 0px 6px yellow,0px 0px 6px yellow;'
                : '';
            
            let likeStyle = '';
            let likeClass = 'uil uil-heart-sign align-middle';
            let likeAction = 'Add';

            if (profile.interestStatus === 'Pending') {
                likeStyle = 'text-shadow: 0px 0px 6px white, 0px 0px 6px #ffc107, 0px 0px 6px #ffc107; color: #ffc107 !important;';
                likeClass += ' glow-heart-pending';
                likeAction = 'Remove';
            } else if (profile.interestStatus === 'Accepted') {
                likeStyle = 'text-shadow: 0px 0px 6px white, 0px 0px 6px #28a745, 0px 0px 6px #28a745; color: #28a745 !important;';
                likeClass += ' glow-heart-accepted';
                likeAction = 'Remove';
            } else if (profile.interestStatus === 'Declined') {
                likeStyle = 'color: #6c757d !important;';
                likeClass += ' glow-heart-declined';
                likeAction = 'Add';
            } else if (profile.isLiked) {
                likeStyle = 'text-shadow: 0px 0px 6px white, 0px 0px 6px red, 0px 0px 6px red; color: red !important;';
                likeClass += ' glow-heart';
                likeAction = 'Remove';
            }

            const starAction = profile.isStarred ? 'Remove' : 'Add';

            const cardHtml = `
                <div class="col-lg-4 col-md-6 mt-4 pt-2" id="profile-${profile.id}">
                    <div class="card team team-primary text-center nnewone1">
                        <div class="imagenew position-relative">
                            <a href="${profileUrl}">
                                <img src="${imagePath}" class="img-fluid" alt="${profile.name}">
                                ${imagePath.includes('_wm') ? '' : `<img src="/assets/images/card-watermark.png" class="card-watermark position-absolute" alt="Watermark">`}
                            </a>
                        </div>
                        <div class="card-body py-3 px-0 pb-0 content newdiv">
                            <h5><a href="${profileUrl}">${profile.name || ''}</a></h5>
                            <div class="row mt-2">
                                <div class="col-12 text-center addtxt02">
                                    <h5 class="mb-0">${profileDetails}</h5>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-12 text-center newadd_div1 newdiv2">
                            <ul class="list-unstyled social-icon social mb-4 mt-0 newicon">
                                <li class="list-inline-item">
                                    <form id="starform-${profile.id}" method="post" action="/User/StarredIcon">
                                        <input type="hidden" name="StarId" value="${profile.id}"/>
                                        <input type="hidden" name="StarredId" value="${profile.id}"/>
                                        <input type="hidden" id="action-star-${profile.id}" name="Action" value="${starAction}"/>
                                        <a href="javascript:void(0)" id="starbutton-${profile.id}" class="rounded" title="Shortlist">
                                            <i class="uil uil-star align-middle" id="staricon-${profile.id}" style="${starStyle}"></i>
                                        </a>
                                    </form>
                                </li>
                                <li class="list-inline-item">
                                    <form id="likeform-${profile.id}" method="post" action="/User/UserFavouriteProfile">
                                        <input type="hidden" name="LikedId" value="${profile.id}"/>
                                        <input type="hidden" id="action-like-${profile.id}" name="Action" value="${likeAction}"/>
                                        <a id="likebutton-${profile.id}" href="javascript:void(0)" class="rounded" title="Express Interest">
                                            <i class="${likeClass}" id="likeicon-${profile.id}" style="${likeStyle}"></i>
                                        </a>
                                    </form>
                                </li>
                                <li class="list-inline-item">
                                    <a href="javascript:void(0)" id="notlikebutton-${profile.id}" class="rounded" title="Not Like" data-notliked-id="${profile.id}">
                                        <i class="uil uil-times align-middle"></i>
                                    </a>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>`;

            grid.insertAdjacentHTML('beforeend', cardHtml);
        }

        // --- Infinite Scroll ---
        const observer = new IntersectionObserver(entries => {
            entries.forEach(entry => {
                if (entry.isIntersecting && !isLoading && hasMore) {
                    fetchProfiles(true);
                }
            });
        }, { rootMargin: '100px' });

        observer.observe(sentinel);

        // --- Event Delegation (Star/Like/NotLike) ---
        grid.addEventListener('click', function (e) {
            const starButton = e.target.closest('a[id^="starbutton-"]');
            const likeButton = e.target.closest('a[id^="likebutton-"]');
            const notLikeButton = e.target.closest('a[id^="notlikebutton-"]');

            if (starButton || likeButton) {
                e.preventDefault();
                const btn = starButton || likeButton;
                const type = btn.id.includes('star') ? 'star' : 'like';
                const itemId = btn.id.split('-')[1];
                const form = document.getElementById(`${type}form-${itemId}`);
                const actionInput = document.getElementById(`action-${type}-${itemId}`);
                const icon = document.getElementById(`${type}icon-${itemId}`);

                if (!form) return;

                const isAdding = actionInput.value === 'Add';
                const actionText = type === 'star' 
                    ? (isAdding ? 'Shortlist' : 'Remove Shortlist') 
                    : (isAdding ? 'Express Interest' : 'Remove Interest');
                
                const confirmButtonColor = type === 'star' ? '#A5BE25' : '#e43f52';

                Swal.fire({
                    title: 'Are you sure?',
                    text: `Do you want to ${actionText.toLowerCase()} this profile?`,
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonColor: confirmButtonColor,
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: 'Yes',
                    cancelButtonText: 'No'
                }).then((result) => {
                    if (result.isConfirmed) {
                        fetch(form.action, {
                            method: 'POST',
                            body: new FormData(form),
                            headers: { 'X-Requested-With': 'XMLHttpRequest' }
                        })
                        .then(r => r.json())
                        .then(data => {
                            if (data.success) {
                                if (type === 'star') {
                                    icon.style.textShadow = isAdding ? '0px 0px 6px white, 0px 0px 6px yellow, 0px 0px 6px yellow' : '';
                                    actionInput.value = isAdding ? 'Remove' : 'Add';
                                    
                                    // If we are on the Favorited tab and removing, hide the card
                                    if (currentType === 'favorited' && !isAdding) {
                                        const card = document.getElementById(`profile-${itemId}`);
                                        if (card) {
                                            card.style.transition = 'opacity 0.4s ease';
                                            card.style.opacity = '0';
                                            setTimeout(() => card.remove(), 400);
                                        }
                                    }
                                } else {
                                    icon.style.textShadow = isAdding ? '0px 0px 6px white, 0px 0px 6px red, 0px 0px 6px red' : '';
                                    actionInput.value = isAdding ? 'Remove' : 'Add';

                                    // If we are on the Liked tab and removing, hide the card
                                    if (currentType === 'liked' && !isAdding) {
                                        const card = document.getElementById(`profile-${itemId}`);
                                        if (card) {
                                            card.style.transition = 'opacity 0.4s ease';
                                            card.style.opacity = '0';
                                            setTimeout(() => card.remove(), 400);
                                        }
                                    }
                                }
                            } else {
                                Swal.fire('Error', data.message || 'An error occurred.', 'error');
                            }
                        });
                    }
                });
            }

            if (notLikeButton) {
                e.preventDefault();
                const profileId = notLikeButton.getAttribute('data-notliked-id');

                const isClosedTab = currentType === 'closeprofiles';
                const swalTitle = isClosedTab ? 'Restore Profile?' : 'Dismiss Profile?';
                const swalText = isClosedTab 
                    ? "Are you sure you want to restore this profile? It will be removed from your Closed list." 
                    : "Are you sure you want to dismiss this profile? It will be moved to your Closed list.";
                const swalConfirmText = isClosedTab ? 'Yes, Restore' : 'Yes, Dismiss';

                Swal.fire({
                    title: swalTitle,
                    text: swalText,
                    icon: isClosedTab ? 'question' : 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#e43f52',
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: swalConfirmText,
                    cancelButtonText: 'Cancel'
                }).then((result) => {
                    if (result.isConfirmed) {
                        const formData = new FormData();
                        formData.append('NotLikedId', profileId);

                        fetch('/User/NotLikeProfile', {
                            method: 'POST',
                            body: formData,
                            headers: { 'X-Requested-With': 'XMLHttpRequest' }
                        })
                        .then(r => r.json())
                        .then(data => {
                            if (data.success) {
                                const card = document.getElementById(`profile-${profileId}`);
                                if (card) {
                                    card.style.opacity = '0';
                                    setTimeout(() => card.remove(), 400);
                                }
                            } else {
                                Swal.fire('Error', data.message || 'An error occurred.', 'error');
                            }
                        });
                    }
                });
            }
        });

        // Initial Load
        fetchProfiles(false);
    })();
    </script>
}
