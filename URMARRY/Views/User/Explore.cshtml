                        <i data-lucide="check" style="width: 16px; height: 16px;"></i> Accept
                    </button>
                    <button class="btn btn-sm px-3 py-2 text-white border-0 fw-semibold rounded-pill d-flex align-items-center gap-1 shadow-sm" style="background-color: #e43f52; font-size: 13px; z-index: 999; position: relative;" id="declinebutton-${profile.id}" onclick="event.stopPropagation(); showInteractionModal(this, 'decline')">
                        <i data-lucide="x" style="width: 16px; height: 16px;"></i> Decline
                    </button>
                `;
            } else {
                buttonsHtml = `
                    <button class="action-btn" style="background-color: #A5BE25;" id="starbutton-${profile.id}" onclick="event.stopPropagation(); showInteractionModal(this, 'favourite')">
                        <i data-lucide="star" class="${starClass}" fill="white" style="color: white; width: 18px; height: 18px; border-radius: 50%;"></i>
                    </button>

                    <button class="action-btn" style="background-color: #00662D;" id="likebutton-${profile.id}" onclick="event.stopPropagation(); showInteractionModal(this, 'interest')">
                        <i data-lucide="heart" class="${heartClass}" fill="white" style="color: white; width: 18px; height: 18px; border-radius: 50%;"></i>
                    </button>

                    <button class="action-btn" style="background-color: #648472;" id="notlikebutton-${profile.id}" onclick="event.stopPropagation(); showInteractionModal(this, 'reject')">
                        <i data-lucide="circle-x" style="color: white; width: 18px; height: 18px;"></i>
                    </button>
                `;
            }

            const cardHtml = `
                <div class="col-12 col-md-6 col-lg-4" id="profile-${profile.id}">
                    <div class="profile-card position-relative overflow-hidden rounded ${isLockedClass}" ${cardClickAction}>

                        <!-- Background Image -->
                        <div class="profile-bg position-absolute top-0 start-0 w-100 h-100"
                            style="background-image: url('${imagePath}');">
                        </div>

                         <!-- Watermark Image -->
                         ${imagePath.includes('_wm') ? '' : `<img src="/assets/images/card-watermark.png" class="card-watermark position-absolute" alt="Watermark">`}

                         <div class="single-chart">
										<svg viewBox="0 0 36 36" class="circular-chart green">
										  <path class="circle-bg"
											d="M18 2.0845
											  a 15.9155 15.9155 0 0 1 0 31.831
											  a 15.9155 15.9155 0 0 1 0 -31.831"
										  />
										  <path class="circle"
											stroke-dasharray="${profile.totalMatchingScore || 0}, 100"
											d="M18 2.0845
											  a 15.9155 15.9155 0 0 1 0 31.831
											  a 15.9155 15.9155 0 0 1 0 -31.831"
										  />
										  <text x="18" y="20.35" class="percentage">${profile.totalMatchingScore || 0}%</text>
										</svg>
						</div>

                        <!-- Overlay -->
                        <div class="profile-overlay position-absolute top-0 start-0 w-100 h-100"></div>

