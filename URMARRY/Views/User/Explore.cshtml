                        </div>

                    </div>
                </div>`;

            grid.insertAdjacentHTML('beforeend', cardHtml);
        }

        // --- Override showInteractionModal for Explore-specific modal text ---
        window.showInteractionModal = function(btn, type) {
            if (event) event.stopPropagation();
            currentActionBtn = btn;
            currentActionType = type;

            const iconEl = btn.querySelector('i, svg');
            isRemovingInteraction = false;

            if (iconEl) {
                if (type === 'favourite' && iconEl.classList.contains('glow-star')) {
                    isRemovingInteraction = true;
                } else if (type === 'interest') {
                    if (iconEl.classList.contains('glow-heart-accepted')) {
                        if (typeof Swal !== 'undefined') {
                            Swal.fire({
                                title: 'Interest Accepted!',
                                text: 'You already have an accepted/mutual interest with this profile.',
                                icon: 'success',
                                confirmButtonColor: '#0d6b38'
                            });
                        } else {
                            alert('Interest already accepted!');
                        }
                        return;
                    } else if (iconEl.classList.contains('glow-heart-pending')) {
                        isRemovingInteraction = true;
                    } else if (iconEl.classList.contains('glow-heart')) {
                        isRemovingInteraction = true;
                    }
                }
            }


            const modal = document.getElementById('interactionModal');
            const title = document.getElementById('interactionModalTitle');

            if (type === 'favourite') {
                if (isRemovingInteraction) {
                    title.innerText = 'Are you sure you want to remove the person from favourite?';
                } else {
                    title.innerText = 'Are you sure you want to make this person as favourite?';
                }
            } else if (type === 'interest') {
                if (isRemovingInteraction) {
                    title.innerText = 'Are you sure you want to remove the person from interested?';
                } else {
                    title.innerText = 'Are you sure you want to make this person as interested?';
                }
            } else if (type === 'reject') {
                if (currentType === 'closeprofiles') {
                    title.innerText = 'Are you sure you want to restore this profile? It will be removed from your Closed list.';
                } else {
                    title.innerText = 'Are you sure you want to dismiss this profile? It will be moved to your Closed list.';
                }
            } else if (type === 'accept') {
                title.innerText = 'Are you sure you want to accept this person\'s interest?';
            } else if (type === 'decline') {
                title.innerText = 'Are you sure you want to decline this person\'s interest?';
            }

            if (modal) {
                modal.classList.add('active');
                document.body.style.overflow = 'hidden';
            }
        };

        // --- Override handleInteractionYes for Explore-specific actions ---
        window.handleInteractionYes = function() {
            if (currentActionBtn) {
                const idParts = currentActionBtn.id.split('-');
                const itemId = idParts[1];
                if (!itemId) {
                    console.error("No profile item ID found on button: ", currentActionBtn.id);
                    hideInteractionModal();
                    return;
                }

                const iconEl = currentActionBtn.querySelector('i, svg');
                const cardColumn = document.getElementById('profile-' + itemId) || currentActionBtn.closest('.col-12');

                const fadeAndRemoveCard = () => {
                    if (cardColumn) {
                        cardColumn.style.transition = 'opacity 0.4s ease';
                        cardColumn.style.opacity = '0';
                        setTimeout(() => cardColumn.remove(), 400);
                    }
                };

                if (currentActionType === 'reject') {
                    // Close / Restore profile
                    const formData = new FormData();
                    formData.append('NotLikedId', itemId);

                    const isRestoring = currentType === 'closeprofiles';

                    fetch('/User/NotLikeProfile', {
                        method: 'POST',
                        body: formData,
                        headers: { 'X-Requested-With': 'XMLHttpRequest' }
                    })
                    .then(r => r.json())
                    .then(data => {
                        if (data.success) {
                            Swal.fire({
                                title: isRestoring ? 'Restored!' : 'Dismissed!',
                                text: isRestoring ? 'Profile has been restored successfully.' : 'Profile has been dismissed successfully.',
                                icon: 'success',
                                width: '320px',
                                confirmButtonColor: '#00662d'
                            });
                            fadeAndRemoveCard();
                        } else {
                            Swal.fire('Error', data.message || 'An error occurred.', 'error');
                        }
                    })
                    .catch(err => {
                        console.error(err);
                        Swal.fire('Error', 'Failed to process request.', 'error');
                    });
                } else if (currentActionType === 'accept' || currentActionType === 'decline') {
                    const formData = new FormData();
                    formData.append('LikedId', itemId);
                    
                    const endpoint = currentActionType === 'accept' ? '/AcceptInterest' : '/DeclineInterest';
                    
                    fetch(endpoint, {
                        method: 'POST',
                        body: formData,
                        headers: { 'X-Requested-With': 'XMLHttpRequest' }
                    })
                    .then(r => r.json())
                    .then(data => {
                        if (data.success) {
                            Swal.fire({
                                title: currentActionType === 'accept' ? 'Accepted!' : 'Declined!',
                                text: `Interest request has been successfully ${currentActionType === 'accept' ? 'accepted' : 'declined'}.`,
                                icon: 'success',
                                width: '320px',
                                confirmButtonColor: '#00662d'
                            });
                            fadeAndRemoveCard();
                        } else {
                            Swal.fire('Error', data.message || 'An error occurred.', 'error');
                        }
                    })
                    .catch(err => {
                        console.error(err);
                        Swal.fire('Error', 'Failed to process request.', 'error');
                    });
                } else {
                    const isAdding = !isRemovingInteraction;
                    const actionText = isAdding ? 'Add' : 'Remove';

                    if (currentActionType === 'favourite') {
                        const formData = new FormData();
                        formData.append('StarId', itemId);
                        formData.append('StarredId', itemId);
                        formData.append('Action', actionText);

                        fetch('/User/StarredIcon', {
                            method: 'POST',
                            body: formData,
                            headers: { 'X-Requested-With': 'XMLHttpRequest' }
                        })
                        .then(r => r.json())
                        .then(data => {
                            if (data.success) {
                                Swal.fire({
                                    title: isAdding ? 'Shortlisted!' : 'Removed!',
                                    text: isAdding ? 'Profile has been added to your favorites.' : 'Profile has been removed from your favorites.',
                                    icon: 'success',
                                    width: '320px',
                                    confirmButtonColor: '#00662d'
                                });
                                if (iconEl) {
                                    if (isAdding) {
                                        iconEl.classList.add('glow-star');
                                    } else {
                                        iconEl.classList.remove('glow-star');
                                    }
                                }
                                // If on Favorited tab and removing, hide the card
                                if (currentType === 'favorited' && !isAdding) {
                                    fadeAndRemoveCard();
                                }
                            } else {
                                Swal.fire('Error', data.message || 'An error occurred.', 'error');
                            }
                        })
                        .catch(err => {
                            console.error(err);
                            Swal.fire('Error', 'Failed to process request.', 'error');
                        });
                    } else if (currentActionType === 'interest') {
                        const formData = new FormData();
                        formData.append('LikedId', itemId);
                        formData.append('Action', actionText);

                        fetch('/User/UserFavouriteProfile', {
                            method: 'POST',
                            body: formData,
                            headers: { 'X-Requested-With': 'XMLHttpRequest' }
                        })
                        .then(r => r.json())
                        .then(data => {
                            if (data.success) {
                                Swal.fire({
                                    title: isAdding ? 'Interest Sent!' : 'Interest Removed!',
                                    text: isAdding ? 'Interest has been expressed successfully.' : 'Interest has been removed successfully.',
                                    icon: 'success',
                                    width: '320px',
                                    confirmButtonColor: '#00662d'
                                });
                                if (iconEl) {
                                    if (isAdding) {
                                        iconEl.classList.add('glow-heart-pending');
                                        iconEl.classList.remove('glow-heart');
                                        iconEl.classList.remove('glow-heart-accepted');
                                    } else {
                                        iconEl.classList.remove('glow-heart-pending');
                                        iconEl.classList.remove('glow-heart-accepted');
                                        iconEl.classList.remove('glow-heart');
                                    }
                                }
                                // If on Liked tab and removing, hide the card
                                if (currentType === 'liked' && !isAdding) {
                                    fadeAndRemoveCard();
                                }
                            } else {
                                Swal.fire('Error', data.message || 'An error occurred.', 'error');
                            }
                        })
                        .catch(err => {
                            console.error(err);
                            Swal.fire('Error', 'Failed to process request.', 'error');
                        });
                    }
                }
            }
            hideInteractionModal();
        };

        // --- Infinite Scroll Observer ---
        const observer = new IntersectionObserver(entries => {
            entries.forEach(entry => {
                if (entry.isIntersecting && !isLoading && hasMore) {
                    fetchProfiles(true);
                }
            });
        }, { rootMargin: '100px' });

        observer.observe(sentinel);

        // --- Initial Load ---
        fetchProfiles(false);

        // Photo Unlock Modal script integration
        let selectedPhotoOwnerId = null;
        window.showPhotoUnlockModal = function(ownerId, ownerName) {
            if (typeof event !== 'undefined' && event) event.stopPropagation();
            if (typeof window.isPremiumMember !== 'undefined' && !window.isPremiumMember) {
                if (typeof showPackagesLayoutModal === 'function') {
                    showPackagesLayoutModal('photo');
                } else {
                    alert('Please upgrade to premium membership to request photo unlock.');
                }
                return;
            }
            selectedPhotoOwnerId = ownerId;

            const title = document.getElementById('photoUnlockModalTitle');
            if (title) {
                title.innerText = `Request Photo Access from ${ownerName || 'User'}?`;
            }
            document.getElementById('photoUnlockModal').classList.add('active');
            document.body.style.overflow = 'hidden';
        };

        window.hidePhotoUnlockModal = function() {
            document.getElementById('photoUnlockModal').classList.remove('active');
            document.body.style.overflow = '';
            selectedPhotoOwnerId = null;
        };

        document.getElementById('btnConfirmPhotoUnlock').addEventListener('click', function() {
            if (!selectedPhotoOwnerId) return;
            
            const formData = new FormData();
            formData.append('ownerId', selectedPhotoOwnerId);

            fetch('/RequestPhotoUnlock', {
                method: 'POST',
                body: formData,
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            })
            .then(response => response.json())
            .then(data => {
                window.hidePhotoUnlockModal();
                if (data.success) {
                    Swal.fire({
                        title: 'Request Sent!',
                        text: data.message || 'Unlock request is pending owner approval.',
                        icon: 'success',
                        width: '320px',
                        confirmButtonColor: '#00662d'
                    }).then(() => {
                        window.location.reload();
                    });
                } else {
                    Swal.fire({
                        title: 'Error',
                        text: data.message || 'Could not send request.',
                        icon: 'error',
                        width: '320px'
                    });
                }
            })
            .catch(error => {
                console.error('Error:', error);
                window.hidePhotoUnlockModal();
                Swal.fire({
                    title: 'Error',
                    text: 'An error occurred. Please try again.',
                    icon: 'error',
                    width: '320px'
                });
            });
        });

    })();
    </script>
}