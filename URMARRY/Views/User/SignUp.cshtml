					}
					else if ($("#EducationType").val() == "" || $("#EducationType").val() == null) {
						$("#EducationType").css('border', '3px solid red');
						$("#EducationType").focus();
						alert("Please provide highest education");
					}
					else if ($("#ProfessionId").val() == "" || $("#ProfessionId").val() == null) {
						$("#ProfessionId").css('border', '3px solid red');
						$("#ProfessionId").focus();
						alert("Please provide profession");
					} else if ($("#ProfessionType").val() == "" || $("#ProfessionType").val() == null) {
						$("#ProfessionType").css('border', '3px solid red');
						$("#ProfessionType").focus();
