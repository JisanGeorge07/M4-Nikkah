		// Gender change listener for profile image preview
		$('input[name="Gender"]').change(function() {
			var gender = $(this).val();
			var profileImg = $('#profile-img');
			// Only change if it's currently showing a default image
			if (profileImg.attr('src').includes('default-user')) {
				if (gender === 'Female') {
					profileImg.attr('src', '/assets/images/default-user-women.png');
				} else {
					profileImg.attr('src', '/assets/images/default-user-men.png');
				}
			}
		});

		// handle file selection preview
		function handleFileUpload(files) {
			if (files && files.length > 0) {
				const file = files[0];
				const reader = new FileReader();

				reader.onload = function (e) {
					// Hide placeholder section
					document.getElementById('profile-img-div').style.display = 'none';

					// Set the uploaded image src
					const uploadedPhoto = document.getElementById('uploaded-photo');
					uploadedPhoto.src = e.target.result;
					uploadedPhoto.style.display = 'block';

					// Display uploaded div
					document.getElementById('file-uploaded').style.display = 'block';
				}

				reader.readAsDataURL(file);
			}
		}

	</script>

	<!-- Image Crop/Resize Modal -->
	<style>
		.img-crop-modal-overlay {
			display: flex;
			position: fixed;
			inset: 0;
			opacity: 0;
			visibility: hidden;
		}

		/* Registration Submit Loader Overlay */
		.submit-loader-overlay {
			position: fixed;
			top: 0;
			left: 0;
			width: 100%;
			height: 100%;
			background-color: rgba(255, 255, 255, 0.85);
			backdrop-filter: blur(5px);
			-webkit-backdrop-filter: blur(5px);
			display: flex;
			flex-direction: column;
			justify-content: center;
			align-items: center;
			z-index: 99999;
			opacity: 0;
			pointer-events: none;
			transition: opacity 0.3s ease-in-out;
		}

		.submit-loader-overlay.active {
			opacity: 1;
			pointer-events: auto;
		}

		.submit-loader-spinner-container {
			display: flex;
			flex-direction: column;
			align-items: center;
			text-align: center;
		}

		.submit-loader-spinner {
			width: 55px;
			height: 55px;
			border: 5px solid rgba(0, 102, 45, 0.1);
			border-top: 5px solid #00662d;
			border-radius: 50%;
			animation: submit-spin 1s linear infinite;
		}

		@@keyframes submit-spin {
			0% { transform: rotate(0deg); }
			100% { transform: rotate(360deg); }
		}
	</style>
	<div id="imgCropModal" class="img-crop-modal-overlay">
		<div class="img-crop-modal-card">
			<button type="button" id="imgCropBtnClose" class="img-crop-modal-close">
				<i class="fa fa-times"></i>
			</button>
			<div class="img-crop-modal-header">
				<h5>Crop & Resize Image</h5>
				<p>Adjust the crop area to fit the required 630×800 dimensions</p>
			</div>
			<div class="img-crop-modal-body">
				<img id="imgCropImage" src="" alt="Crop preview">
			</div>
			<div class="img-crop-dim-info">
				<span class="dim-original">Original: <strong id="imgCropDimOriginal">—</strong></span>
				<span class="dim-target">Target: <strong id="imgCropDimTarget">630×800</strong></span>
			</div>
			<div class="img-crop-modal-footer">
				<button type="button" id="imgCropBtnCancel" class="img-crop-btn-cancel">Cancel</button>
				<button type="button" id="imgCropBtnApply" class="img-crop-btn-crop">Crop & Resize</button>
			</div>
		</div>
	</div>

	<!-- Cropper.js JS -->
	<script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.2/cropper.min.js"></script>
	<!-- Image Validator JS -->
	<script src="/js/image-validator.js"></script>

	<script>
		document.addEventListener('DOMContentLoaded', function () {
			// Initialize Image Validator for SignUp
			if (typeof ImageValidator !== 'undefined') {
				ImageValidator.initSignup();
			}
		});
	</script>

