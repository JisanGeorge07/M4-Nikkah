			$(".previous").click(function () {

				current_fs = $(this).closest('fieldset');
				previous_fs = current_fs.prev();

				//Remove class active
				$("#progressbar li").eq($("fieldset").index(current_fs)).removeClass("active");

				//show the previous fieldset
				previous_fs.show();

				//hide the current fieldset with style
				current_fs.animate({ opacity: 0 }, {
					step: function (now) {
						// for making fielset appear animation
						opacity = 1 - now;

						current_fs.css({
							'display': 'none',
							'position': 'relative'
						});
						previous_fs.css({ 'opacity': opacity });
					},
					duration: 500
				});
				setProgressBar(--current);
			});

			function goNext(current_fs, next_fs) {
				//Add Class Active
				$("#progressbar li").eq($("fieldset").index(next_fs)).addClass("active");

				//show the next fieldset
				next_fs.show();
				//hide the current fieldset with style
				current_fs.animate({ opacity: 0 }, {
					step: function (now) {
						// for making fielset appear animation
						opacity = 1 - now;

						current_fs.css({
							'display': 'none',
							'position': 'relative'
						});
						next_fs.css({ 'opacity': opacity });
					},
					duration: 500
				});
				setProgressBar(++current);
			}

			function setProgressBar(curStep) {
				var percent = parseFloat(100 / steps) * curStep;
				percent = percent.toFixed();
				$(".progress-bar")
					.css("width", percent + "%")
			}

			$(".submit").click(function () {
				return false;
			});

			$("#resendOTPBtn").click(function () {
				var id = $("#Id").val();
				if (!id || id <= 0) {
					alert("Registration session not found. Please try again from Step 1.");
					return;
				}

				$("#resendOTPBtn").hide();
				$("#otpMessage").css("color", "gray").text("Resending OTP...");

				$.ajax({
					type: 'POST',
					url: '/Home/ResendOtp',
					data: { id: id },
					dataType: 'json',
					success: function (response) {
						if (response.success) {
							$("#otpMessage").css("color", "green").text("OTP resent successfully.");
							startOTPTimer();
						} else {
							$("#otpMessage").css("color", "red").text(response.message);
							if (response.message.indexOf("Limit exceeded") >= 0 || response.message.indexOf("Maximum") >= 0) {
								$("#otpCountdownText").hide();
								$("#resendOTPBtn").hide();
							} else {
								$("#resendOTPBtn").show();
							}
						}
					},
					error: function () {
						$("#otpMessage").css("color", "red").text("Failed to resend OTP. Please try again.");
						$("#resendOTPBtn").show();
					}
				});
			});

		});

		var otpCountdownInterval;
		function startOTPTimer() {
			clearInterval(otpCountdownInterval);
			var duration = 60;
			$("#resendOTPBtn").hide();
			$("#otpCountdownText").show();
			$("#otpTimer").text(duration);
			$("#otpMessage").text("");

			otpCountdownInterval = setInterval(function () {
				duration--;
				$("#otpTimer").text(duration);

				if (duration <= 0) {
					clearInterval(otpCountdownInterval);
					$("#otpCountdownText").hide();
					$("#resendOTPBtn").show();
				}
			}, 1000);
		}

		function PinVerification() {
			if ($("#Pin1").val() != "" && $("#Pin1").val() != null
				&& $("#Pin2").val() != "" && $("#Pin2").val() != null
				&& $("#Pin3").val() != "" && $("#Pin3").val() != null
				&& $("#Pin4").val() != "" && $("#Pin4").val() != null
				&& $("#Pin5").val() != "" && $("#Pin5").val() != null
				&& $("#Pin6").val() != "" && $("#Pin6").val() != null) {
				var pin = $("#Pin1").val() + $("#Pin2").val() + $("#Pin3").val() + $("#Pin4").val() + $("#Pin5").val() + $("#Pin6").val();
				
				$.ajax({
					type: 'POST',
					url: '/Home/VerifyOtp',
					data: { id: $("#Id").val(), otp: pin },
					dataType: 'json',
					success: function(response) {
						if (response.success) {
							Save("Step-6");
							alert("Registration has been successfully completed");
							window.location.href = "/User/Login";
						} else {
							alert(response.message);
						}
					},
					error: function() {
						alert("An error occurred during verification. Please try again.");
					}
				});
			}
			else {
				alert("Please provide verification code");
			}
		}

		function Save(step, isSubmit = false) {
			var formData = new FormData();
			var totalFiles = document.getElementById("Image").files.length;

			for (var i = 0; i < totalFiles; i++) {
				var file = document.getElementById("Image").files[i];
				formData.append("Image", file);
			}
			formData.append("Id", $("#Id").val());
			formData.append("ProfileForId", $("#ProfileForId").val());
			formData.append("Name", $("#Name").val());
			formData.append("Email", $("#Email").val());
			formData.append("Phone", $("#Phone").val());
			formData.append("Gender", $('input[name="Gender"]:checked').val());
			formData.append("Password", $("#Password").val());
			formData.append("Day", $("#Day").val());
			formData.append("Month", $("#Month").val());
			formData.append("Year", $("#Year").val());
			formData.append("ReligionId", $("#ReligionId").val());
			formData.append("NationalityId", $("#NationalityId").val());
			formData.append("MaritalStatusId", $("#MaritalStatusId").val());
			formData.append("HeightId", $("#HeightId").val());
			formData.append("WeightId", $("#WeightId").val());
			formData.append("ComplexionId", $("#ComplexionId").val());
			formData.append("BodyTypeId", $("#BodyTypeId").val());
			formData.append("IsPhysicallyChallenged", $('input[name="IsPhysicallyChallenged"]:checked').val() === 'Yes');
			formData.append("HighestEducation", $("#HighestEducation").val());
			formData.append("EducationType", $("#EducationType").val());
			formData.append("ProfessionId", $("#ProfessionId").val());
			formData.append("ProfessionType", $("#ProfessionType").val());
			formData.append("MotherTongueId", $("#MotherTongueId").val());
			formData.append("CommunityId", $("#CommunityId").val());
			formData.append("ReligiousnessId", $("#ReligiousnessId").val());
			formData.append("FinancialStatusId", $("#FinancialStatusId").val());
			formData.append("FamilyName", $("#FamilyName").val());
			formData.append("FatherName", $("#FatherName").val());
			formData.append("Post", $("#Post").val());
			formData.append("Village", $("#Village").val());
			formData.append("PinCode", $("#PinCode").val());
			formData.append("Country", $("#Country").val());
			formData.append("State", $("#State").val());
			formData.append("District", $("#District").val());
			formData.append("PresentCountry", $("#PresentCountry").val());
			formData.append("PresentState", $("#PresentState").val());
			formData.append("PresentDistrict", $("#PresentDistrict").val());
			formData.append("CompletedStep", step);

			if (step === "Step-5" && isSubmit) {
				$("#submitLoaderOverlay").addClass("active");
				$("#btnSubmitRegistration").prop("disabled", true);
			}

			$.ajax({
				type: 'post',
				url: '/Home/Save',
				data: formData,
				dataType: 'json',
				contentType: false,
				processData: false,
				success: function (response) {
					if (response.status == 1) {
						$("#Id").val(response.id);
						$("#VerificationCode").val(response.code);
						if (step === "Step-5" && isSubmit) {
							$("#submitLoaderOverlay").removeClass("active");
							$("#btnSubmitRegistration").prop("disabled", false);
						}
					}
					else {
						if (step === "Step-5" && isSubmit) {
							$("#submitLoaderOverlay").removeClass("active");
							$("#btnSubmitRegistration").prop("disabled", false);
						}
						alert(response.message);
					}
				},
				error: function (error) {
					if (step === "Step-5" && isSubmit) {
						$("#submitLoaderOverlay").removeClass("active");
						$("#btnSubmitRegistration").prop("disabled", false);
					}
					alert("Something went wrong");
				}
			});
		}

		function isnumber(evt) {
			var ikeycode = (evt.which) ? evt.which : evt.ikeycode
			if (ikeycode != 46 && ikeycode > 37 && ikeycode > 47 && ikeycode > 57)
				return false;
			return true;
		}

		// -----Country Code Selection
		$("#Phone").intlTelInput({
