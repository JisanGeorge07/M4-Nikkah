                childrenField.style.display = "none";
                $('#NumberOfChildrens').val('');
                document.getElementById("childrenField").style.display = "none";
            } else {
                childrenField.style.display = "block";
            }
        });
        // Trigger the change event on page load to handle the initial state
        $('#MaritalStatusId').trigger('change');
    });

    
</script>
<script>

