<!-- Modals Structure -->
    <!-- Basic Information Modal -->
    <div id="basicModal" class="edit-modal-overlay">
        <form id="form-basic" onsubmit="submitEditForm(event, 'basic')" class="edit-modal-card">
            <div class="edit-modal-close" onclick="closeEditModal('basicModal')">
                <i class="uil uil-times"></i>
            </div>
            <div class="edit-modal-header">
                <h3 class="edit-modal-title">Basic Information</h3>
            </div>
            <div class="edit-modal-body">
                <div class="form-group-custom">
                    <label class="form-label-custom">Marital Status</label>
                    <div class="custom-select-wrapper">
                        <div class="custom-select-trigger">
                            <span>@(Model.MaritalStatuses.FirstOrDefault(x => x.Id == enquiry.MaritalStatusId)?.Title ?? "Select Marital Status")</span>
                            <i class="uil uil-angle-down"></i>
                        </div>
                        <div class="custom-options">
                            @foreach (var item in Model.MaritalStatuses)
                            {
                                <div class="custom-option @(item.Id == enquiry.MaritalStatusId ? "selected" : "")" data-value="@item.Id">@Html.Raw(item.Title)</div>
                            }
                        </div>
                        <input type="hidden" name="MaritalStatusId" id="MaritalStatusIdVal" value="@enquiry.MaritalStatusId">
                    </div>
                </div>
                <div class="form-group-custom" id="childrenEditContainer" style="display: none;">
                    <label class="form-label-custom">Number Of Children</label>
                    <div class="custom-select-wrapper">
                        <div class="custom-select-trigger">
                            <span>@(enquiry.NumberOfChildrens?.ToString() ?? "0")</span>
                            <i class="uil uil-angle-down"></i>
                        </div>
                        <div class="custom-options">
                            <div class="custom-option @(enquiry.NumberOfChildrens == 0 || enquiry.NumberOfChildrens == null ? "selected" : "")" data-value="0">0</div>
                            <div class="custom-option @(enquiry.NumberOfChildrens == 1 ? "selected" : "")" data-value="1">1</div>
                            <div class="custom-option @(enquiry.NumberOfChildrens == 2 ? "selected" : "")" data-value="2">2</div>
                            <div class="custom-option @(enquiry.NumberOfChildrens == 3 ? "selected" : "")" data-value="3">3</div>
                            <div class="custom-option @(enquiry.NumberOfChildrens >= 4 ? "selected" : "")" data-value="4">4+</div>
                        </div>
                        <input type="hidden" name="NumberOfChildrens" id="NumberOfChildrensVal" value="@(enquiry.NumberOfChildrens ?? 0)">
                    </div>
                </div>
                <div class="form-group-custom">
                    <label class="form-label-custom">Mother Tongue</label>
                    <div class="custom-select-wrapper">
                        <div class="custom-select-trigger">
                            <span>@(Model.MotherTongues.FirstOrDefault(x => x.Id == enquiry.MotherTongueId)?.Title ?? "Select Mother Tongue")</span>
                            <i class="uil uil-angle-down"></i>
                        </div>
                        <div class="custom-options">
                            @foreach (var item in Model.MotherTongues)
                            {
                                <div class="custom-option @(item.Id == enquiry.MotherTongueId ? "selected" : "")" data-value="@item.Id">@Html.Raw(item.Title)</div>
                            }
                        </div>
                        <input type="hidden" name="MotherTongueId" value="@enquiry.MotherTongueId">
                    </div>
                </div>
                <div class="form-group-custom">
                    <label class="form-label-custom">About</label>
                    <textarea name="About" class="form-control-custom" placeholder="Brief About Yourself..." style="min-height: 100px; padding: 20px; resize: vertical;" maxlength="300">@Html.Raw(enquiry.About)</textarea>
                </div>
            </div>
            <div class="edit-modal-footer">
                <button type="submit" class="btn-save-custom">Save</button>
            </div>
        </form>
    </div>

    <!-- Education Modal -->
    <div id="educationModal" class="edit-modal-overlay">
        <form id="form-education" onsubmit="submitEditForm(event, 'education')" class="edit-modal-card">
            <div class="edit-modal-close" onclick="closeEditModal('educationModal')">
                <i class="uil uil-times"></i>
            </div>
            <div class="edit-modal-header">
                <h3 class="edit-modal-title">Education Information</h3>
            </div>
            <div class="edit-modal-body">
                <div class="form-group-custom">
                    <label class="form-label-custom">Highest Education</label>
                    <div class="custom-select-wrapper">
                        <div class="custom-select-trigger">
                            <span>@(string.IsNullOrEmpty(enquiry.HighestEducation) ? "Select Education" : enquiry.HighestEducation)</span>
                            <i class="uil uil-angle-down"></i>
                        </div>
                        <div class="custom-options">
                            @foreach (var item in Model.BodyFeatures.Where(x => x.Type == BodyFeature.Education))
                            {
                                <div class="custom-option @(item.Title == enquiry.HighestEducation ? "selected" : "")" data-value="@item.Title">@Html.Raw(item.Title)</div>
                            }
                        </div>
                        <input type="hidden" name="HighestEducation" value="@enquiry.HighestEducation">
                    </div>
                </div>
                <div class="form-group-custom">
                    <label class="form-label-custom">Course</label>
                    <div class="custom-select-wrapper multi-select">
                        <div class="custom-select-trigger">
                            <span>Select Course(s)</span>
                            <i class="uil uil-angle-down"></i>
                        </div>
                        <div class="custom-options">
                            @{
                                var selectedCoursesList = (enquiry?.EducationType ?? "").Split(',').Select(s => s.Trim()).Where(s => !string.IsNullOrEmpty(s)).ToList();
                                var dbCourses = Model.BodyFeatures.Where(x => x.Type == BodyFeature.Course).Select(x => x.Title).ToList();
                            }
                            @foreach (var item in Model.BodyFeatures.Where(x => x.Type == BodyFeature.Course))
                            {
