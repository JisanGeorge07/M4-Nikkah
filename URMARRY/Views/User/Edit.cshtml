<script>
$(document).ready(function() {
    $('#State').change(function() {
            var selectedStateId = $(this).data('state-id');
        $('#District').empty(); // Clear the existing options
        $('#District').append('
<option value="">Select District</option>'); // Add the default option

        // Filter districts based on selected state
        $('#districtContainer option[data-state-id]').each(function() {
            var districtStateId = $(this).data('state-id');
            if (districtStateId == selectedStateId) {
                $('#District').append($(this).clone());
            }
        });

        // Optionally, you can trigger change event for the district dropdown here
        $('#District').trigger('change');
    });

    // Trigger the state change event on page load if a state is already selected (e.g., in edit scenarios)
    $('#State').trigger('change');
});
 </script>

<script type="text/javascript">
    $(document).ready(function () {
        $('#State').change(function () {
            var stateName = $(this).val(); // Get the selected state's name

            // Make an AJAX call to fetch districts based on the selected state name
            $.ajax({
                url: '/Home/GetDistrictsByStateName', // Action method to fetch districts by state name
                type: 'GET',
                data: { stateName: stateName },
                dataType: 'json',
                xhr: function () {
                    var xhr = new window.XMLHttpRequest();
                    xhr.open("GET", '/Home/GetDistrictsByStateName?stateName=' + encodeURIComponent(stateName), true);
                    xhr.setRequestHeader("Upgrade-Insecure-Requests", "1"); // Hint at HTTP/1.1
                    return xhr;
                },
                success: function (response) {
                    if (response.success) {
                        // Clear existing options in the district dropdown
                        $('#District').empty();
                         $('#District').append('<option value="">District</option>');

                        // Populate the district dropdown with new options
                        $.each(response.message, function (index, item) {
                            $('#District').append('<option value="' + item.name + '">' + item.name + '</option>');
                        });
                    }
                    else {

                    }
                },
                error: function () {
                }
            });
        });
      // $('#State').trigger('change');

    });

