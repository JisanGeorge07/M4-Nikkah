                $('#stateContainer').hide(); // Hide the state dropdown if any other country is selected
                $('#districtContainer').hide();
                $('#cityContainer').hide();
                $('#State').prop('disabled', true);
            }
        });

        // Trigger the change event on page load to handle the initial state
        $('#Country').trigger('change');
