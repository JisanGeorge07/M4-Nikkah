@using Application.Helpers
@model HomeViewModel

@{
    Layout = "/Views/Shared/_LayoutAccount.cshtml";
    var enquiry = Model.Registration!;
    var image = Model.Images!;
    var _selectedStateId = 0;
    var str = enquiry.DOB.Replace("-", "/").Split('/');
    var day = string.Empty;
    var month = string.Empty;
    var year = str[2];
    if (str[0].Length < 2)
    {
        day = "0" + str[0];
    }
    else
    {
        day = str[0];
    }
    if (str[1].Length < 2)
    {
        month = "0" + str[1];
    }
    else
    {
        month = str[1];
    }
    if (day.Length > 2)
    {
        var y = year;
        var d = day;
        day = y;
        year = d;
    }
    var dob = day + "/" + month + "/" + year;
    DateTime myDate = DateTime.ParseExact(dob, "dd/MM/yyyy", System.Globalization.CultureInfo.InvariantCulture);
    DateTime today = DateTime.UtcNow;
    int age = today.Year - myDate.Year;
    if (myDate > today.AddYears(-age))
    {
        age--;
    }

    string defaultImage = string.Equals(enquiry.Gender, "Female", StringComparison.OrdinalIgnoreCase) ?
    "~/assets/images/default-user-women.png" : "~/assets/images/default-user-men.png";
    string imagePath = !string.IsNullOrEmpty(enquiry.ImagePath) ? enquiry.ImagePath : defaultImage;
}

