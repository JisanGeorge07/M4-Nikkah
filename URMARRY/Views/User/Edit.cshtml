@section Scripts {
    <script>
        function submitEditForm(event, section) {
            event.preventDefault();
            
            const form = event.target;
            const $form = $(form);
            const submitBtn = $form.find('.btn-save-custom');
            const originalBtnText = submitBtn.text();
            
            // Client-side validation: if physically challenged is 'Yes', they must select a detail
            if (section === 'physical') {
                var isPhysChallenged = $('#IsPhysicallyChallengedVal').val();
                var detail = $('#PhysicallyChallengedDetailVal').val();
                if (isPhysChallenged === 'Yes' && (!detail || detail.trim() === '')) {
                    Swal.fire({
                        title: 'Required Field!',
                        text: 'Please select a Physical Challenge Detail.',
                        icon: 'warning',
                        confirmButtonColor: '#0B6B2E'
                    });
                    return false;
                }
            }
            
            // Disable button and show loading state
            submitBtn.prop('disabled', true).text('Saving...');
            
            // Serialize form data
            let formData = $form.serializeArray();
            
            // Special handling for IsPhysicallyChallenged to ensure it binds to boolean true/false
            formData = formData.map(field => {
                if (field.name === 'IsPhysicallyChallenged') {
                    return {
                        name: field.name,
                        value: (field.value === 'Yes' || field.value === 'true').toString()
                    };
                }
                return field;
            });
            
            $.ajax({
                url: '/edit-profile?section=' + encodeURIComponent(section),
                type: 'POST',
                data: $.param(formData),
                success: function (response) {
                    if (response.success) {
                        
                            closeEditModal(section + 'Modal');
                            window.location.reload();
                    
                    } else {
                        Swal.fire({
                            title: 'Error!',
                            text: response.message || 'Failed to update profile.',
                            icon: 'error',
                            confirmButtonColor: '#0B6B2E'
                        });
                        submitBtn.prop('disabled', false).text(originalBtnText);
                    }
                },
                error: function (xhr, status, error) {
                    Swal.fire({
                        title: 'Error!',
                        text: 'An error occurred while saving your changes. Please try again.',
                        icon: 'error',
                        confirmButtonColor: '#0B6B2E'
                    });
                    submitBtn.prop('disabled', false).text(originalBtnText);
                }
            });
        }

        $(document).ready(function () {
            // Event delegation to capture click on dynamically modified gender-btn buttons
            $(document).on('click', '#physicallyChallengedWrapper .gender-btn', function () {
                setTimeout(function() {
                    var val = $('#IsPhysicallyChallengedVal').val();
                    if (val === 'Yes') {
                        $('#physicalChallengeDetailEditContainer').show();
                    } else {
                        $('#physicalChallengeDetailEditContainer').hide();
                        // Reset selection
                        $('#physicalChallengeDetailEditContainer .custom-option').removeClass('selected');
                        $('#physicalChallengeDetailEditContainer .custom-select-trigger span').text('Select Detail');
                        $('#PhysicallyChallengedDetailVal').val('');
                    }
                }, 50);
            });

            $(document).on('change', '#MaritalStatusIdVal', function () {
                var maritalStatusId = $(this).val();
                if (maritalStatusId == '2' || maritalStatusId == '3' || maritalStatusId == '4' || maritalStatusId == '5' || maritalStatusId == '6') {
                    $('#childrenEditContainer').show();
                } else {
                    $('#childrenEditContainer').hide();
                    $('#childrenEditContainer .custom-option').removeClass('selected');
                    $('#childrenEditContainer .custom-option[data-value="0"]').addClass('selected');
                    $('#childrenEditContainer .custom-select-trigger span').text('0');
                    $('#NumberOfChildrensVal').val('0');
                }
            });
            setTimeout(function () {
                $('#MaritalStatusIdVal').trigger('change');
            }, 100);
        });
    </script>
}