                                    Save Changes
                                </button>
                            </div>
                        </div>

</form>
            </main>

<!-- Image Crop/Resize Modal -->
<style>
    .img-crop-modal-overlay {
        display: flex;
        position: fixed;
        inset: 0;
        opacity: 0;
        visibility: hidden;
    }
</style>
<div id="imgCropModal" class="img-crop-modal-overlay">
    <div class="img-crop-modal-card">
        <button type="button" id="imgCropBtnClose" class="img-crop-modal-close">
            <i class="uil uil-times"></i>
        </button>
        <div class="img-crop-modal-header">
            <h5>Crop & Resize Image</h5>
            <p>Adjust the crop area to fit the required 630×800 dimensions</p>
        </div>
        <div class="img-crop-modal-body">
            <img id="imgCropImage" src="" alt="Crop preview">
        </div>
        <div class="img-crop-dim-info">
            <span class="dim-original">Original: <strong id="imgCropDimOriginal">—</strong></span>
            <span class="dim-target">Target: <strong id="imgCropDimTarget">630×800</strong></span>
        </div>
        <div class="img-crop-modal-footer">
            <button type="button" id="imgCropBtnCancel" class="img-crop-btn-cancel">Cancel</button>
            <button type="button" id="imgCropBtnApply" class="img-crop-btn-crop">Crop & Resize</button>
        </div>
    </div>
</div>

@section Scripts {
    <!-- Cropper.js CSS -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.2/cropper.min.css" />
    <!-- Image Validator CSS -->
    <link rel="stylesheet" href="/css/image-validator.css" />
    <!-- Cropper.js JS -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.2/cropper.min.js"></script>
    <!-- Image Validator JS -->
    <script src="/js/image-validator.js"></script>

	<script>
    document.addEventListener('DOMContentLoaded', function () {

        if (window.lucide) {
            window.lucide.createIcons();
        }

        const photoWrappers = document.querySelectorAll('.photo-box-wrapper');

        photoWrappers.forEach(wrapper => {

            const fileInput = wrapper.querySelector('.photo-input');
            const previewImg = wrapper.querySelector('.preview-img');
            const placeholderImg = wrapper.querySelector('.placeholder-img');
            const removeBtn = wrapper.querySelector('.remove-btn');
            const photoBox = wrapper.querySelector('.photo-box');
            const uploadText = wrapper.querySelector('.upload-text');
            const pathInput = wrapper.querySelector('.path-input');

            // Existing image check
            if (previewImg.getAttribute('src')) {
                photoBox.classList.add('has-image');
            }

            // Upload image
            fileInput.addEventListener('change', function (e) {

                // Skip if this change was triggered by the cropper
                if (fileInput._croppedUpdate) {
                    fileInput._croppedUpdate = false;
                    return;
                }

                const file = e.target.files[0];

                if (file) {

                    const objectUrl = URL.createObjectURL(file);

                    previewImg.src = objectUrl;

                    previewImg.classList.remove('d-none');

                    placeholderImg.classList.add('d-none');

                    removeBtn.classList.add('visible');

                    photoBox.classList.add('has-image');

                    uploadText.innerText = file.name;
                }
            });

            // Remove image
            removeBtn.addEventListener('click', function (e) {

                e.preventDefault();
                e.stopPropagation();

                fileInput.value = '';

                previewImg.src = '';
                previewImg.removeAttribute('src');
                previewImg.classList.add('d-none');

                placeholderImg.src = '../../../../assets/images/icon/upload-placeholder.png';
                placeholderImg.classList.remove('d-none');

                removeBtn.classList.remove('visible');

                photoBox.classList.remove('has-image');

                placeholderImg.style.display = 'block';
                uploadText.style.display = 'block';

                uploadText.innerText = 'Select file';
                uploadText.style.display = 'block';

                const overlay = wrapper.querySelector('.upload-overlay');

                if (overlay) {
                    overlay.style.opacity = '';
                }

                if (pathInput) {
                    pathInput.value = '';
                }

                // Hide dimension badge on remove
                const badge = wrapper.querySelector('.img-dimension-badge');
                if (badge) {
                    badge.style.display = 'none';
                    badge.className = 'img-dimension-badge';
                    badge.innerHTML = '';
                }
            });
 
        });

        // Initialize Image Validator for Manage Photos
        if (typeof ImageValidator !== 'undefined') {
            ImageValidator.initManagePhotos();
        }

        // Photo Privacy Toggle Combinability Logic
        const toggleAll = document.getElementById('photoVisibleToAll');
        const togglePremium = document.getElementById('photoVisibleToPremium');
        const toggleAccepted = document.getElementById('photoVisibleToAccepted');

        if (toggleAll && togglePremium && toggleAccepted) {
            toggleAll.addEventListener('change', function() {
                if (this.checked) {
                    togglePremium.checked = false;
                    toggleAccepted.checked = false;
                }
            });

            const onRestrictionToggle = function() {
                if (this.checked) {
                    toggleAll.checked = false;
                }
                if (!togglePremium.checked && !toggleAccepted.checked) {
                    toggleAll.checked = true;
                }
            };

            togglePremium.addEventListener('change', onRestrictionToggle);
            toggleAccepted.addEventListener('change', onRestrictionToggle);
        }

    });
</script>
}