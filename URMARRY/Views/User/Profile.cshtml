                                                View Contact Details
                                            </button>
                                        }
                                        else
                                        {
                                            <button id="view-contact-details-btn" class="btn btn-lime-green text-white rounded-pill px-4 py-2 small shadow fs-14 fw-medium d-none">
                                                <i class="uil uil-phone-volume me-1"></i>
                                                View Contact Details
                                            </button>
                                        }

                                        @{
                                            var cleanCode = displayCountryCode.Replace("+", "");
                                            var cleanPhone = user.Phone?.Replace(" ", "").Replace("+", "");
                                            var waHref = Model.ContactDetailsUnlocked ? $"https://wa.me/{cleanCode}{cleanPhone}" : "javascript:void(0)";
                                            var waOnclick = Model.ContactDetailsUnlocked ? "" : (Model.Registration.IsPremiumMember || Model.Registration.IsSpecialRequest ? "showPremiumContactModal()" : "showUpgradeModal()");
                                        }
                                        <a id="whatsapp-link" href="@waHref" onclick="@waOnclick" @(Model.ContactDetailsUnlocked ? "target=\"_blank\"" : "")
                                            class="btn btn-forest-green text-white rounded-circle d-flex align-items-center justify-content-center shadow p-0 whatsupp"
                                            style="width: 42px; height: 42px;">
                                            <img src="../../../../assets/images/icon/whatsapp.icon.png" width="24" alt="WhatsApp">
                                        </a>
                                    </div>
                                </div>
