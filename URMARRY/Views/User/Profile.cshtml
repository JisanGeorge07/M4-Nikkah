<form id="unlockContactDetailsForm" method="post" asp-action="ViewUserContactDetails" asp-controller="User" style="display:none;">
    <input type="hidden" name="ViewerUserId" value="@Model.Registration.Id"/>
    <input type="hidden" name="ViewedUserId" value="@user.Id"/>
</form>

<form id="starform-@user.Id" method="post" asp-action="StarredIcon" asp-controller="User" style="display:none;">
    <input type="hidden" name="StarId" value="@user.Id"/>
    <input type="hidden" name="StarredId" value="@user.Id"/>
    <input type="hidden" id="action-star-@user.Id" name="Action" value="@((user.IsStarred) ? "Remove" : "Add")"/>
</form>

<form id="reportForm" method="post" asp-action="ReportProfile" asp-controller="User" style="display:none;">
    <input type="hidden" id="reportReason" name="Reason"/>
    <input type="hidden" name="ReporterUserId" value="@Model.Registration!.Id"/>
    <input type="hidden" name="ReportedUserId" value="@user.Id"/>
    <input type="hidden" id="reportDetails" name="Details"/>
</form>

@section Scripts
{
    <script type="text/javascript">
        let reportReasonSelected = false;
        let isContactUnlocked = @Model.ContactDetailsUnlocked.ToString().ToLower();
        let selectedReportReason = "";
        let isAlreadyReported = @Model.AlreadyReported.ToString().ToLower();

        function showFavouriteModal() {
            const modal = document.getElementById("favouriteModal");
            if (modal) {
                modal.classList.add("active");
                document.body.style.overflow = "hidden";
            }
        }

        function hideFavouriteModal() {
            const modal = document.getElementById("favouriteModal");
            if (modal) {
                modal.classList.remove("active");
                document.body.style.overflow = "";
            }
        }

        function showInterestModal() {
            const modal = document.getElementById("interestConfirmationModal");
            if (modal) {
                modal.classList.add("active");
                document.body.style.overflow = "hidden";
            }
        }

        function hideInterestModal() {
            const modal = document.getElementById("interestConfirmationModal");
            if (modal) {
                modal.classList.remove("active");
                document.body.style.overflow = "";
            }
        }

        let pendingInterestAction = null;

        function confirmInterestAction() {
            hideInterestModal();
            if (pendingInterestAction) {
                pendingInterestAction();
                pendingInterestAction = null;
            }
        }

        function showBlockedModal() {
            const modal = document.getElementById("blockedModal");
            if (modal) {
                modal.classList.add("active");
                document.body.style.overflow = "hidden";
            }
        }

        function hideBlockedModal() {
            const modal = document.getElementById("blockedModal");
            if (modal) {
                modal.classList.remove("active");
                document.body.style.overflow = "";
            }
        }

        function showUpgradeModal() {
            const modal = document.getElementById("upgradeModal");
            if (modal) {
                modal.classList.add("active");
                document.body.style.overflow = "hidden";
            }
        }

        function hideUpgradeModal() {
            const modal = document.getElementById("upgradeModal");
            if (modal) {
                modal.classList.remove("active");
                document.body.style.overflow = "";
            }
        }

        function showPackagesModal(mode) {
            hideUpgradeModal();
            hidePremiumContactModal();
            const modal = document.getElementById("packagesModal");
            if (modal) {
                const titleElem = document.getElementById('packagesLocalModalTitle');
                const subTitleElem = document.getElementById('packagesLocalModalSubTitle');
                if (titleElem && subTitleElem) {
                    if (mode === 'photo') {
                        titleElem.innerText = 'Upgrade to premium membership to request photo unlock';
                        subTitleElem.innerText = 'Unlock the ability to request photo access by upgrading to premium! Connect with your perfect match today.';
                    } else {
                        titleElem.innerText = 'Upgrade to premium membership to view contact details';
                        subTitleElem.innerText = 'Unlock access to contact details by upgrading to premium! Get closer to meaningful connections.';
                    }
                }
                modal.classList.add("active");
                document.body.style.overflow = "hidden";
            }
        }

        function hidePackagesModal() {
            const modal = document.getElementById("packagesModal");
            if (modal) {
                modal.classList.remove("active");
                document.body.style.overflow = "";
            }
        }

        function showPremiumContactModal() {
            const modal = document.getElementById("premiumContactModal");
            if (modal) {
                modal.classList.add("active");
                document.body.style.overflow = "hidden";
            }
        }

        function hidePremiumContactModal() {
            const modal = document.getElementById("premiumContactModal");
            if (modal) {
                modal.classList.remove("active");
                document.body.style.overflow = "";
            }
        }

        function showActionRequiredModal() {
            const modal = document.getElementById("actionRequiredModal");
            if (modal) {
                modal.classList.add("active");
                document.body.style.overflow = "hidden";
            }
        }

        function hideActionRequiredModal() {
            const modal = document.getElementById("actionRequiredModal");
            if (modal) {
                modal.classList.remove("active");
                document.body.style.overflow = "";
            }
        }

        function showReportMainModal() {
            hideReportModals();
            const modal = document.getElementById("reportMainModal");
            if (modal) {
                setTimeout(() => {
                    modal.classList.add("active");
                    document.body.style.overflow = "hidden";
                }, 50);
            }
        }

        function handleReportReasonSelection(reason, showDescription) {
            selectedReportReason = reason;
            hideReportModals();

            if (showDescription) {
                const modal = document.getElementById("reportDetailsModal");
                if (modal) {
                    setTimeout(() => {
                        modal.classList.add("active");
                        document.body.style.overflow = "hidden";
                    }, 50);
                }
            } else {
                // Skip description popup, clear any old description, submit directly
                const reasonText = document.getElementById("reportReasonText");
                if (reasonText) reasonText.value = "";
                
                submitReportNew();
            }
        }

        function showReportFinalModal() {
            hideReportModals();
            const modal = document.getElementById("reportFinalModal");
            if (modal) {
                setTimeout(() => {
                    modal.classList.add("active");
                    document.body.style.overflow = "hidden";
                }, 50);
            }
        }

        function hideReportModals() {
            const modals = ["reportMainModal", "reportDetailsModal", "reportFinalModal"];
            modals.forEach((id) => {
                const modal = document.getElementById(id);
                if (modal) modal.classList.remove("active");
            });
            document.body.style.overflow = "";
        }

        function handleReportButtonClick() {
            if (isAlreadyReported) {
                Swal.fire({
                    title: 'Already Reported',
                    text: 'You have already reported this profile.',
                    icon: 'info',
                    width: '350px',
                    confirmButtonColor: '#00662d'
                });
                return;
            }

            const isPremium = @Model.Registration.IsPremiumMember.ToString().ToLower() || @Model.Registration.IsSpecialRequest.ToString().ToLower();

            if (!isPremium) {
                showUpgradeModal();
                return;
            }

            if (!isContactUnlocked) {
                showActionRequiredModal();
                return;
            }

            showReportFinalModal();
        }

        async function submitReportNew() {
            const reason = selectedReportReason;
            const details = document.getElementById('reportReasonText') ? document.getElementById('reportReasonText').value : "";
            const reporterUserId = '@(Model.Registration?.Id)';
            const reportedUserId = '@(user.Id)';
            
            const formData = new URLSearchParams();
            formData.append('Reason', reason);
            formData.append('Details', details);
            formData.append('ReporterUserId', reporterUserId);
            formData.append('ReportedUserId', reportedUserId);

            try {
                const response = await fetch('@Url.Action("ReportProfile", "User")', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    body: formData.toString()
                });

                const result = await response.json();
                hideReportModals();

                if (result.success) {
                    Swal.fire({
                        title: 'Report Submitted',
                        text: 'Thank you for reporting this profile. We will review it shortly.',
                        icon: 'success',
                        width: '350px',
                        confirmButtonColor: '#00662d'
                    });

                    // Dynamically update UI to reported state
                    isAlreadyReported = true;
                    const reportTextSpan = document.getElementById('report-text-span');
                    if (reportTextSpan) reportTextSpan.textContent = 'Reported';
                    const reportIconCircle = document.getElementById('report-icon-circle');
                    if (reportIconCircle) reportIconCircle.style.backgroundColor = '#6c757d';
                } else {
                    Swal.fire({
                        title: 'Error',
                        text: result.message,
                        icon: 'error',
                        width: '350px',
                        confirmButtonColor: '#e43f52'
                    });
                }

                // Reset the form details textarea
                if (document.getElementById('reportReasonText')) {
                    document.getElementById('reportReasonText').value = "";
                }

            } catch (error) {
                console.error('Error:', error);
                Swal.fire('Error', 'Something went wrong. Please try again.', 'error');
            }
        }

        function showContactDetails(user) {
            isContactUnlocked = true;

            // Hide view contact button in both contact bar and status bar
            const viewContactBtn = document.getElementById('view-contact-details-btn');
            if (viewContactBtn) viewContactBtn.classList.add('d-none');

            const statusBarViewContactBtn = document.getElementById('status-bar-view-contact-btn');
            if (statusBarViewContactBtn) statusBarViewContactBtn.classList.add('d-none');

            // Hide bottom upgrade section card
            const upgradeSection = document.getElementById('upgrade-section-bottom');
            if (upgradeSection) upgradeSection.classList.add('d-none');

            // Hide lock covers
            document.querySelectorAll('.contact-lock').forEach(div => {
                div.classList.add('d-none');
            });
            document.querySelectorAll('.blur-wrapper').forEach(div => {
                div.classList.remove('locked');
            });

            if (user !== null) {
                // Update contact number in Contact Bar
                const contactNumberElem = document.getElementById(`contactNumber-${@user.Id}`);
                if (contactNumberElem) contactNumberElem.innerHTML = user.phone || "";

                // Update WhatsApp link
                const whatsappLink = document.getElementById('whatsapp-link');
                if (whatsappLink && user.phone) {
                    const cleanCode = (user.countryCode || "91").replace('+', '');
                    whatsappLink.href = `https://wa.me/${cleanCode}${user.phone.replace(/\s+/g, '').replace('+', '')}`;
                    whatsappLink.onclick = null;
                    whatsappLink.target = "_blank";
                    whatsappLink.removeAttribute('data-bs-toggle');
                    whatsappLink.removeAttribute('data-bs-target');
                }

                // Update Family details pills
                const familyNameElem = document.querySelector('.family-name-val');
                if (familyNameElem) familyNameElem.innerText = user.familyName || "";
                const fatherNameElem = document.querySelector('.father-name-val');
                if (fatherNameElem) fatherNameElem.innerText = user.fatherName || "";
                const postElem = document.querySelector('.post-val');
                if (postElem) postElem.innerText = user.post || "";
                const pincodeElem = document.querySelector('.pincode-val');
                if (pincodeElem) pincodeElem.innerText = user.pinCode || "";

                // Update Contact details pills
                const phoneElem = document.querySelector('.phone-val');
                if (phoneElem) phoneElem.innerText = (user.countryCode || "") + " " + (user.phone || "");
                const landlineElem = document.querySelector('.landline-val');
                if (landlineElem && user.landlineNumber) {
                    landlineElem.innerText = (user.presentCountryCode || "") + " " + user.landlineNumber;
                }
            }
        }

        function showContactUnlockedSuccessModal(user) {
            if (!user) return;

            // Populate Primary Number
            const phone1 = (user.countryCode || user.CountryCode || "").trim();
            const number1 = (user.phone || "").trim();
            const fullPhone1 = phone1 + " " + number1;
            document.getElementById("unlockFinalPhone1").textContent = fullPhone1;

            const cleanPhone1 = (phone1 + number1).replace(/\+/g, '').replace(/\s+/g, '');
            document.getElementById("unlockCallBtn1").onclick = function() {
                window.location.href = 'tel:' + cleanPhone1;
            };

            // Populate Secondary Number
            const phone2 = (user.presentCountryCode || user.PresentCountryCode || "").trim();
            const number2 = (user.landlineNumber || "").trim();
            const secondaryGroup = document.getElementById("unlockPhone2Group");

            if (number2) {
                const fullPhone2 = phone2 + " " + number2;
                document.getElementById("unlockFinalPhone2").textContent = fullPhone2;

                const cleanPhone2 = (phone2 + number2).replace(/\+/g, '').replace(/\s+/g, '');
                document.getElementById("unlockCallBtn2").onclick = function() {
                    window.location.href = 'tel:' + cleanPhone2;
                };
                if (secondaryGroup) {
                    secondaryGroup.style.setProperty('display', 'flex', 'important');
                }
            } else {
                if (secondaryGroup) {
                    secondaryGroup.style.setProperty('display', 'none', 'important');
                }
            }

            // Open Modal
            const modal = document.getElementById("contactUnlockedSuccessModal");
            if (modal) {
                modal.classList.add("active");
                document.body.style.overflow = "hidden";
            }
        }

        function hideContactUnlockedSuccessModal() {
            const modal = document.getElementById("contactUnlockedSuccessModal");
            if (modal) {
                modal.classList.remove("active");
                document.body.style.overflow = "";
            }
        }

        function unlockContactDetails() {
            hidePremiumContactModal();
            const form = document.getElementById(`unlockContactDetailsForm`);
            const formData = new FormData(form);
            fetch(
                form.action, {
                    method: 'POST',
                    body: formData,
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest'
                    }
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        showContactDetails(data.user);
                        showContactUnlockedSuccessModal(data.user);
                    } else {
                        if (data.message.toLowerCase() === "insufficient credits.") {
                            showPackagesModal();
                        } else {
                            Swal.fire('Error', data.message || 'An error occurred.', 'error');
                        }
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    if (error.message !== "Unexpected token 'A', \"An error o\"... is not valid JSON") {
                         Swal.fire('Error', 'An error occurred. Please try again.', 'error');
                    }
                });
        }

        function confirmFavourite() {
            hideFavouriteModal();
            const itemId = '@user.Id';
            const form = document.getElementById(`starform-${itemId}`);
            const actionInput = document.getElementById(`action-star-${itemId}`);
            const starText = document.getElementById(`startext-${itemId}`);

            const isAdding = actionInput.value === 'Add';
            const formData = new FormData(form);

            fetch(form.action, {
                method: 'POST',
                body: formData,
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    Swal.fire({
                        title: isAdding ? 'Shortlisted!' : 'Removed!',
                        text: isAdding ? 'Profile has been added to your favorites.' : 'Profile has been removed from your favorites.',
                        icon: 'success',
                        width: '320px',
                        confirmButtonColor: '#00662d'
                    });
                    if (isAdding) {
                        if (starText) starText.textContent = 'Favourited';
                        actionInput.value = 'Remove';
                        document.getElementById('favouriteModalTitle').innerText = "Are you sure you want to remove this person from Favourite?";
                    } else {
                        if (starText) starText.textContent = 'Shortlist';
                        actionInput.value = 'Add';
                        document.getElementById('favouriteModalTitle').innerText = "Are you sure you want to add this person as Favourite?";
                    }
                } else {
                    Swal.fire('Error', data.message || 'An error occurred.', 'error');
                }
            })
            .catch(err => {
                console.error('Error:', err);
                Swal.fire('Error', 'An error occurred. Please try again.', 'error');
            });
        }

        function confirmBlock() {
            hideBlockedModal();
            const profileId = '@user.Id';
            const formData = new FormData();
            formData.append('NotLikedId', profileId);

            fetch('/User/NotLikeProfile', {
                method: 'POST',
                body: formData,
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    Swal.fire({
                        title: 'Dismissed!',
                        text: 'Profile has been removed from your matches.',
                        icon: 'success',
                        width: '320px',
                        confirmButtonColor: '#00662d'
                    }).then(() => {
                        window.location.href = '/dashboard';
                    });
                } else {
                    Swal.fire('Error', data.message || 'An error occurred.', 'error');
                }
            })
            .catch(error => {
                console.error('Error:', error);
                Swal.fire('Error', 'An error occurred. Please try again.', 'error');
            });
        }

        // Whether the viewed profile has already sent us an interest (from server)
        const profileLikedUs = @Model.ProfileLikedUs.ToString().ToLower();

        function handleInterestClick() {
            const itemId = '@user.Id';
            const form = document.getElementById(`likeform-${itemId}`);
            const actionInput = document.getElementById(`action-like-${itemId}`);
            const likeButton = document.getElementById(`likebutton-${itemId}`);
            const interestInfo = document.getElementById('interest-info-section');

            const isAdding = actionInput.value === 'Add';

            if (isAdding) {
                const confirmLabel = profileLikedUs ? 'Confirm Interest' : 'Express Interest';
                const confirmText = profileLikedUs
                    ? `Do you want to confirm interest in @(user.Name)?`
                    : `Do you want to send interest to @(user.Name)?`;

                const titleElem = document.getElementById('interestModalTitle');
                if (titleElem) {
                    titleElem.innerHTML = `<strong>${confirmLabel}</strong><br><br><span style="font-size: 15px; font-weight: 400; color: #555;">${confirmText}</span>`;
                }

                const confirmBtn = document.getElementById('interestModalConfirmBtn');
                if (confirmBtn) {
                    confirmBtn.textContent = 'Yes, Send!';
                    confirmBtn.style.setProperty('background-color', '#00662d', 'important');
                }

                pendingInterestAction = function() {
                    doSendInterestRequest(form, actionInput, likeButton, interestInfo, isAdding);
                };
                
                showInterestModal();
            } else {
                // Cancel Interest popup
                const titleElem = document.getElementById('interestModalTitle');
                if (titleElem) {
                    titleElem.innerHTML = `<strong>Cancel Interest</strong><br><br><span style="font-size: 15px; font-weight: 400; color: #555;">Are you sure you want to cancel interest in @(user.Name)?</span>`;
                }

                const confirmBtn = document.getElementById('interestModalConfirmBtn');
                if (confirmBtn) {
                    confirmBtn.textContent = 'Yes, Cancel!';
                    confirmBtn.style.setProperty('background-color', '#E93B3B', 'important');
                }

                pendingInterestAction = function() {
                    doSendInterestRequest(form, actionInput, likeButton, interestInfo, isAdding);
                };

                showInterestModal();
            }
        }

        function doSendInterestRequest(form, actionInput, likeButton, interestInfo, isAdding) {
            if (likeButton) likeButton.disabled = true;

            const formData = new FormData(form);
            fetch(form.action, {
                method: 'POST',
                body: formData,
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            })
            .then(response => response.json())
            .then(data => {
                if (likeButton) likeButton.disabled = false;
                if (data.success) {
                    Swal.fire({
                        title: isAdding ? 'Interest Sent!' : 'Interest Removed!',
                        text: isAdding ? 'Interest has been expressed successfully.' : 'Interest has been removed successfully.',
                        icon: 'success',
                        width: '320px',
                        confirmButtonColor: '#00662d'
                    }).then(() => {
                        window.location.reload();
                    });
                } else {
                    Swal.fire('Error', data.message || 'An error occurred.', 'error');
                }
            })
            .catch(err => {
                if (likeButton) likeButton.disabled = false;
                console.error('Error:', err);
                Swal.fire('Error', 'An error occurred. Please try again.', 'error');
            });
        }

        // Inline click handler for the interest button (send interest only)
        function onInterestButtonClick(e) {
            e.preventDefault();
            const actionInput = document.getElementById('action-like-@user.Id');
            // If interest already sent, do nothing — only Cancel Interest can remove it
            if (actionInput && actionInput.value === 'Remove') return;
            handleInterestClick();
        }

        // Inline click handler for the cancel interest button (remove interest only)
        function onCancelInterestClick(e) {
            e.preventDefault();
            const form = document.getElementById('likeform-@user.Id');
            const actionInput = document.getElementById('action-like-@user.Id');
            const likeBtn = document.getElementById('likebutton-@user.Id');
            const interestInfo = document.getElementById('interest-info-section');
            if (actionInput) actionInput.value = 'Remove';

            // Show cancellation popup
            const titleElem = document.getElementById('interestModalTitle');
            if (titleElem) {
                titleElem.innerHTML = `<strong>Cancel Interest</strong><br><br><span style="font-size: 15px; font-weight: 400; color: #555;">Are you sure you want to cancel interest in @(user.Name)?</span>`;
            }

            const confirmBtn = document.getElementById('interestModalConfirmBtn');
            if (confirmBtn) {
                confirmBtn.textContent = 'Yes, Cancel!';
                confirmBtn.style.setProperty('background-color', '#E93B3B', 'important');
            }

            pendingInterestAction = function() {
                doSendInterestRequest(form, actionInput, likeBtn, interestInfo, false);
            };

            showInterestModal();
        }

        function respondToInterest(likedId, action) {
            const url = action === 'Accept' ? '/AcceptInterest' : '/DeclineInterest';
            const formData = new FormData();
            formData.append('LikedId', likedId);

            fetch(url, {
                method: 'POST',
                body: formData,
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    Swal.fire({
                        title: 'Success!',
                        text: `Interest request has been ${action.toLowerCase()}ed.`,
                        icon: 'success',
                        width: '350px',
                        timer: 2000,
                        showConfirmButton: false
                    }).then(() => {
                        window.location.reload();
                    });
                } else {
                    Swal.fire('Error', data.message || 'An error occurred.', 'error');
                }
            })
            .catch(error => {
                console.error('Error:', error);
                Swal.fire('Error', 'An error occurred. Please try again.', 'error');
            });
        }

        function sendSMSToast() {
            Swal.fire({
                title: 'Coming Soon',
                text: 'The SMS sending feature is coming soon!',
                icon: 'info',
                timer: 2500,
                showConfirmButton: false
            });
        }

        let selectedPhotoOwnerId = null;
        function sendPhotoUnlockRequest(ownerId) {
            if (!ownerId) return;
            if (typeof window.isPremiumMember !== 'undefined' && !window.isPremiumMember) {
                showPackagesModal('photo');
                return;
            }
            selectedPhotoOwnerId = ownerId;

            const title = document.getElementById('photoUnlockModalTitle');
            if (title) {
                title.innerText = `Request Photo Access from ${'@Html.Raw(Model.MatchedUserProfile.Name?.Replace("'", "\\'"))'}?`;
            }
            document.getElementById('photoUnlockModal').classList.add('active');
            document.body.style.overflow = 'hidden';
        }

        function hidePhotoUnlockModal() {
            document.getElementById('photoUnlockModal').classList.remove('active');
            document.body.style.overflow = '';
            selectedPhotoOwnerId = null;
        }

        function confirmPhotoUnlock() {
            if (!selectedPhotoOwnerId) return;

            const formData = new FormData();
            formData.append('ownerId', selectedPhotoOwnerId);

            fetch('/RequestPhotoUnlock', {
                method: 'POST',
                body: formData,
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            })
            .then(response => response.json())
            .then(data => {
                hidePhotoUnlockModal();
                if (data.success) {
                    Swal.fire({
                        title: 'Request Sent!',
                        text: data.message || 'Unlock request is pending owner approval.',
                        icon: 'success',
                        width: '320px',
                        confirmButtonColor: '#00662d'
                    }).then(() => {
                        window.location.reload();
                    });
                } else {
                    Swal.fire({
                        title: 'Error',
                        text: data.message || 'Could not send request.',
                        icon: 'error',
                        width: '320px'
                    });
                }
            })
            .catch(error => {
                console.error('Error:', error);
                hidePhotoUnlockModal();
                Swal.fire({
                    title: 'Error',
                    text: 'An error occurred. Please try again.',
                    icon: 'error',
                    width: '320px'
                });
            });
        }

        document.addEventListener('DOMContentLoaded', function () {
            if (isContactUnlocked) {
                showContactDetails(null);
            }
        });
    </script>
}