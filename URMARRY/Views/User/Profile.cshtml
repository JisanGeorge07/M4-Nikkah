@using Application.Helpers
@model HomeViewModel

@{
    // <link href="https://stackpath.bootstrapcdn.com/bootstrap/5.3.0/css/bootstrap.min.css" rel="stylesheet">
    Layout = "/Views/Shared/_LayoutAccount.cshtml";
    //var user = Model.Registration!;
    var user = Model.MatchedUserProfile!;
    var image = Model.Images!;
    var displayCountryCode = CountryCodeHelper.GetCountryCode(user.CountryCode ?? user.Country);
    var displaySecondaryCountryCode = CountryCodeHelper.GetCountryCode(user.SecondaryCountryCode ?? user.PresentCountry);
    var dateOfBirth = !string.IsNullOrEmpty(user.DOB) ? user.DOB : "01/01/1990";
    var str1 = dateOfBirth.Replace("-", "/").Split('/');
    var day1 = string.Empty;
    var month1 = string.Empty;
    var year1 = str1[2];
    if (str1[0].Length < 2)
    {
        day1 = "0" + str1[0];
    }
    else
    {
        day1 = str1[0];
    }
    if (str1[1].Length < 2)
    {
        month1 = "0" + str1[1];
    }
    else
    {
        month1 = str1[1];
    }
    if (day1.Length > 2)
    {
        var y = year1;
        var d = day1;
        day1 = y;
        year1 = d;
    }
    var dob1 = day1 + "/" + month1 + "/" + year1;
    DateTime myDate1 = DateTime.ParseExact(dob1, "dd/MM/yyyy", System.Globalization.CultureInfo.InvariantCulture);
    DateTime today = DateTime.UtcNow;
    DateTime birthDate = myDate1;
    int age = today.Year - birthDate.Year;

    if (birthDate > today.AddYears(-age))
    {
        age--;
    }

    string defaultImage = string.Equals(user.Gender, "Female", StringComparison.OrdinalIgnoreCase) ? "~/assets/images/default-user-women.png" : "~/assets/images/default-user-men.png";
    string imagePath = !string.IsNullOrEmpty(user.ImagePath) ? user.ImagePath : defaultImage;
    string restrictedAccessModalAttributes = !Model.Registration.IsPremiumMember && !Model.Registration.IsSpecialRequest ? $"data-bs-toggle=\"modal\" data-bs-target=\"#payment1\" data-name=\"{user.Name}\" data-registernumber=\"{user.RegisterNumber}\" data-imagepath=\"{Url.Content(imagePath)}\"" : "";
}


<style>
    .contact-lock {
        position: absolute !important;
        inset: 0;
        width: 100% !important;
        height: 100% !important;
        backdrop-filter: blur(5px);
        background: rgba(255, 255, 255, 0.15);
        z-index: 5;
        border-radius: 10px;
    }
    .blur-wrapper {
        position: relative;
        overflow: hidden;
        border-radius: 10px;
    }
    .blur-wrapper.locked .family-information,
    .blur-wrapper.locked .contact-details {
        filter: blur(5px);
        user-select: none;
        pointer-events: none;
        transition: filter 0.3s ease;
    }
    .profile-detail-image-wrapper.photos-unlocked .tiny-slide img {
        filter: none !important;
        transform: none !important;
    }
    /* Modal image blur overlay and lock icon styling */
    .modal-image-blur-wrapper {
        position: relative;
        overflow: hidden;
        display: inline-block;
        vertical-align: middle;
    }
    .modal-image-blur-wrapper img {
        filter: blur(8px) !important;
        transform: scale(1.05);
        transition: filter 0.3s ease, transform 0.3s ease;
    }
    .modal-image-blur-wrapper.photos-unlocked img {
        filter: none !important;
        transform: none !important;
    }
    .modal-image-blur-wrapper .modal-premium-blur {
        backdrop-filter: blur(4px);
        -webkit-backdrop-filter: blur(4px);
        background: rgba(255, 255, 255, 0.05);
        z-index: 2;
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        pointer-events: none;
    }
    .modal-image-blur-wrapper .modal-premium-lock {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        z-index: 3;
        display: flex;
        align-items: center;
        justify-content: center;
        pointer-events: none;
    }
    .modal-image-blur-wrapper .modal-premium-lock i {
        font-size: 24px;
        color: #ffffff;
        display: inline-flex;
        text-shadow: 0 2px 5px rgba(0, 0, 0, 0.5);
    }
</style>

