                                }
                                else
                                {
                                    <img id="unlockFinalImage" src="@Url.Content(defaultImage)" alt="Profile"
                                        class="report-avatar-small">
                                }
                                <div>
                                    <h5 id="unlockFinalName" class="fw-semibold fs-16 mb-0">@Html.Raw(user.Name)</h5>
                                    <span id="unlockFinalId" class="text-muted fs-12">@user.RegisterNumber?.ToUpper()</span>
                                </div>
                            </div>
    
                            <div class="report-info-group">
                                <span class="report-info-label">Address</span>
                                <p id="unlockFinalAddress" class="report-info-value mb-0">@(!string.IsNullOrWhiteSpace(user.FamilyName) ? user.FamilyName + ", " : "")@(!string.IsNullOrWhiteSpace(user.FatherName) ? user.FatherName + ", " : "")@(!string.IsNullOrWhiteSpace(user.Post) ? user.Post + ", " : "")@(!string.IsNullOrWhiteSpace(user.PinCode) ? user.PinCode + ", " : "")@(!string.IsNullOrWhiteSpace(user.Village) ? user.Village : "")</p>
                            </div>
    
