                                    if (!Model.ContactDetailsUnlocked)
                                    {
                                        contactPhone = contactPhone[0] + new string('X', contactPhone.Length - 2) + contactPhone[^1];
                                    }
                                }
                                <h6 class="mb-0 fs-14 fw-medium">Contact Number: @displayCountryCode <span id="contactNumber-@user.Id" class="text-warning">@contactPhone</span></h6>
                        
