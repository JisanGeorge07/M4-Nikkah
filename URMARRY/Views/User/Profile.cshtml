                                    <div class="modal-image-blur-wrapper @(Model.PhotosUnlocked ? "photos-unlocked" : "")" style="width: 60px; height: 60px; border-radius: 50%;">
                                        <img id="unlockFinalImage" src="@Html.Raw("/" + user.ImagePath)" alt="Profile"
                                            class="report-avatar-small" onerror="this.src='@Url.Content(defaultImage)'">
                                        @if (!Model.PhotosUnlocked)
