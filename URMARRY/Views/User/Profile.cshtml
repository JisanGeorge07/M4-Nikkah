                                    {
                                        <div class="col-12 col-md-4">
                                            <div class="info-pill p-2" style="white-space: normal; height: auto; min-height: 38px; text-overflow: clip;" title="@(string.IsNullOrEmpty(user.PhysicallyChallengedDetail) ? "N/A" : user.PhysicallyChallengedDetail)">
                                                <span class="fw-medium opacity-75">Physical Challenge Detail:</span>
                                                <span class="fw-semibold">@(string.IsNullOrEmpty(user.PhysicallyChallengedDetail) ? "N/A" : user.PhysicallyChallengedDetail)</span>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>

                            <div class="mb-4">
                                <h5 class="fw-medium fs-18 mb-3">Education & Profession</h5>
                                <div class="row g-2">
                                    <div class="col-12 col-md-4">
                                        <div class="info-pill p-2"><span class="fw-medium opacity-75">Education:</span>
                                            <span class="fw-semibold">@(string.IsNullOrEmpty(user.HighestEducation) ? "N/A" : user.HighestEducation)</span>
                                        </div>
                                    </div>
                                    <div class="col-12 col-md-4">
                                        <div class="info-pill p-2"><span class="fw-medium opacity-75">Course:</span>
                                            <span class="fw-semibold">@(string.IsNullOrEmpty(user.EducationType) ? "N/A" : user.EducationType)</span>
                                        </div>
                                    </div>
                                    <div class="col-12 col-md-4">
                                        <div class="info-pill p-2"><span class="fw-medium opacity-75">Profession:</span>
                                            <span class="fw-semibold">@(Model.Professions?.FirstOrDefault(x => x.Id == user.ProfessionId)?.Title ?? "N/A")</span>
                                        </div>
                                    </div>
                                    <div class="col-12 col-md-4">
                                        <div class="info-pill p-2"><span class="fw-medium opacity-75">Profession Type:</span>
                                            <span class="fw-semibold">@(string.IsNullOrEmpty(user.ProfessionType) ? "N/A" : user.ProfessionType)</span>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="mb-4">
                                <h5 class="fw-medium fs-18 mb-3">Religious Information</h5>
                                <div class="row g-2">
                                    <div class="col-12 col-md-4">
                                        <div class="info-pill p-2"><span class="fw-medium opacity-75">Religion:</span>
                                            <span class="fw-semibold">@(Model.Religions?.FirstOrDefault(x => x.Id == user.ReligionId)?.Title ?? "N/A")</span>
                                        </div>
                                    </div>
                                    <div class="col-12 col-md-4">
                                        <div class="info-pill p-2"><span class="fw-medium opacity-75">Community:</span>
                                            <span class="fw-semibold">@(Model.Communities?.FirstOrDefault(x => x.Id == user.CommunityId)?.Title ?? "N/A")</span>
                                        </div>
                                    </div>
                                    <div class="col-12 col-md-4">
                                        <div class="info-pill p-2"><span class="fw-medium opacity-75">Religiousness:</span>
                                            <span class="fw-semibold">@(Model.Religiousnesses?.FirstOrDefault(x => x.Id == user.ReligiousnessId)?.Title ?? "N/A")</span>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="mb-4">
                                <h5 class="fw-medium fs-18 mb-3">Location Information</h5>
                                <div class="row g-2 location-details">
                                    <div class="col-12 col-md-4">
                                        <div class="info-pill p-2" style="white-space: normal;"><span class="fw-medium opacity-75">Present Location:</span>
                                            <span class="fw-semibold">@(!string.IsNullOrWhiteSpace(user.PresentCity) ? user.PresentCity + ", " : "")@(!string.IsNullOrWhiteSpace(user.PresentState) ? user.PresentState + ", " : "")@user.PresentCountry</span>
                                        </div>
                                    </div>
                                    <div class="col-12 col-md-4">
                                        <div class="info-pill p-2"><span class="fw-medium opacity-75">Nationality:</span>
                                            <span class="fw-semibold">@(Model.Nationalities?.FirstOrDefault(x => x.Id == user.NationalityId)?.Title ?? "N/A")</span>
                                        </div>
                                    </div>
                                    <div class="col-12 col-md-4">
                                        <div class="info-pill p-2"><span class="fw-medium opacity-75">State:</span>
                                            <span class="fw-semibold">@(user.State ?? "N/A")</span>
                                        </div>
                                    </div>
                                    <div class="col-12 col-md-4">
                                        <div class="info-pill p-2"><span class="fw-medium opacity-75">District:</span>
                                            <span class="fw-semibold">@(user.District ?? "N/A")</span>
                                        </div>
                                    </div>
                                    <div class="col-12 col-md-4">
                                        <div class="info-pill p-2"><span class="fw-medium opacity-75">City:</span>
                                            <span class="fw-semibold">@(user.Village ?? "N/A")</span>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="mb-4">
                                <h5 class="fw-medium fs-18 mb-3">Family Information</h5>
                                <div class="blur-wrapper @(Model.ContactDetailsUnlocked ? "" : "locked")">
                                    <div class="contact-lock d-flex align-items-center justify-content-center @(Model.ContactDetailsUnlocked ? "d-none" : "")"></div>
                                    <div class="row g-2 family-information">
                                        <div class="col-12 col-md-4">
                                            <div class="info-pill p-2" style="white-space: normal;"><span class="fw-medium opacity-75">Family Name:</span>
                                                <span class="fw-semibold family-name-val">@(Model.ContactDetailsUnlocked ? user.FamilyName : "*******")</span>
                                            </div>
                                        </div>
                                        <div class="col-12 col-md-4">
                                            <div class="info-pill p-2"><span class="fw-medium opacity-75">Father's Name:</span>
                                                <span class="fw-semibold father-name-val">@(Model.ContactDetailsUnlocked ? user.FatherName : "*******")</span>
                                            </div>
                                        </div>
                                        <div class="col-12 col-md-4">
                                            <div class="info-pill p-2"><span class="fw-medium opacity-75">Post:</span>
                                                <span class="fw-semibold post-val">@(Model.ContactDetailsUnlocked ? user.Post : "*******")</span>
                                            </div>
                                        </div>
                                        <div class="col-12 col-md-4">
                                            <div class="info-pill p-2"><span class="fw-medium opacity-75">Pin Code:</span>
                                                <span class="fw-semibold pincode-val">@(Model.ContactDetailsUnlocked ? user.PinCode : "*******")</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="mb-4">
                                <h5 class="fw-medium fs-18 mb-3">Contact Information</h5>
                                @{
                                    string displayPhone = user.Phone;
                                    string? displayLandline = user.LandlineNumber;
                                    if (!Model.ContactDetailsUnlocked)
                                    {
                                        displayPhone = displayPhone[0] + new string('X', displayPhone.Length - 2) + displayPhone[^1];
                                        displayLandline = displayLandline is null ? null : displayLandline[0] + new string('X', displayLandline.Length - 2) + displayLandline[^1];
                                    }
                                }
                                <div class="blur-wrapper @(Model.ContactDetailsUnlocked ? "" : "locked")">
                                    <div class="contact-lock d-flex align-items-center justify-content-center @(Model.ContactDetailsUnlocked ? "d-none" : "")"></div>
                                    <div class="row g-2 contact-details">
                                        <div class="col-12 col-md-6">
                                            <div class="info-pill p-2"><span class="fw-medium opacity-75">Primary Number:</span>
                                                <span class="fw-semibold phone-val">@($"{displayCountryCode} {displayPhone}")</span>
                                            </div>
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(user.LandlineNumber))
                                        {
                                            <div class="col-12 col-md-6">
                                                <div class="info-pill p-2"><span class="fw-medium opacity-75">Secondary Number:</span>
                                                    <span class="fw-semibold landline-val">@($"{displaySecondaryCountryCode} {displayLandline}")</span>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        
                        
                        
                            <!-- Action Footer -->
                            <div class="d-flex bg-light rounded-pill mb-4 action-footer border">
                                <div class="flex-fill action-pill" onclick="showFavouriteModal()" style="cursor: pointer;">
                                    <div class="icon-circle mb-1" style="background-color: #648472; color: white;"><i class="uis uis-star"></i>
                                    </div>
                                    <span class="fs-14 fw-normal" id="startext-@user.Id">@(user.IsStarred ? "Favourited" : "Shortlist")</span>
                                </div>
                                <div class="flex-fill action-pill" onclick="showBlockedModal()" style="cursor: pointer;">
                                    <div class="icon-circle mb-1" style="background-color: #E93B3B; color: white;"><i class="uil uil-ban"></i>
                                    </div>
                                    <span class="fs-14 fw-normal">Closed</span>
                                </div>
                                <div class="flex-fill action-pill" id="report-action-pill" onclick="handleReportButtonClick()" style="cursor: pointer;">
                                    <div class="icon-circle mb-1" id="report-icon-circle" style="background-color: @(Model.AlreadyReported ? "#6c757d" : "#017132"); color: white;"><i
                                            class="uil uil-file-edit-alt"></i></div>
                                    <span class="fs-14 fw-normal" id="report-text-span">@(Model.AlreadyReported ? "Reported" : "Report")</span>
                                </div>
                            </div>
                        
                            <!-- Write a Note -->
                            <!-- <div class="rounded-4 p-3 mb-4 d-flex align-items-center justify-content-between border"
                                style="background-color: #EDF3E8;">
                                <div>
                                    <h6 class="fw-medium fs-18 mb-1">Write a Note</h6>
                                    <p class="fs-12 fw-normal text-dark mb-0">About this profile for future reference
                                    </p>
                                </div>
                                <img src="../../../../assets/images/icon/edit-note-icon.png" width="24">
                            </div> -->
                        
                            <!-- Upgrade Box -->
                            @if (!Model.ContactDetailsUnlocked)
                            {
                                @if (Model.Registration.IsPremiumMember || Model.Registration.IsSpecialRequest)
                                {
                                    <div class="rounded-4 p-4 text-white mb-4" id="upgrade-section-bottom" style="background-color: #111111;">
                                        <h5 class="fs-18 fw-medium mb-2">Contact Details</h5>
                                        <p class="fs-12 fw-normal opacity-75 mb-4">Would you like to view @(user.Name)'s contact details?</p>
                                        <button class="btn btn-lime-green text-white rounded-pill px-5 py-2 fs-12 fw-semibold"
                                            onclick="showPremiumContactModal()">Unlock</button>
                                    </div>
                                }
                                else
                                {
                                    <div class="rounded-4 p-4 text-white mb-4" id="upgrade-section-bottom" style="background-color: #111111;">
                                        <h5 class="fs-18 fw-medium mb-2">Upgrade Your Profile</h5>
                                        <p class="fs-12 fw-normal opacity-75 mb-4">Upgrade your profile to view contact details of interested profiles, send super interests, enjoy increased profile visibility, and access advanced search features for better matches. Unlock these premium features and elevate your experience!</p>
                                        <button class="btn btn-lime-green text-white rounded-pill px-5 py-2 fs-12 fw-semibold"
                                            onclick="showUpgradeModal()">Upgrade</button>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="rounded-4 p-4 text-white mb-4 d-none" id="upgrade-section-bottom" style="background-color: #111111;">
                                </div>
                            }
                        </div>
                        <!-- PROFILE DETAIL SECTION ENDS  -->

                    </div>
                </div>
            </main>

    <!-- MODAL SECTIONS STARTS -->

    <!-- Upgrade Premium Modal -->
    <div id="upgradeModal" class="upgrade-modal-overlay" onclick="if(event.target === this) hideUpgradeModal()">
        <div class="upgrade-modal-card">
            <div class="modal-close-btn" onclick="hideUpgradeModal()">
                <i class="uil uil-times"></i>
            </div>
    
            <div class="modal-body-scroll">
                @if (!string.IsNullOrEmpty(user.ImagePath))
                {
                    <div class="modal-image-blur-wrapper @(Model.PhotosUnlocked ? "photos-unlocked" : "")" style="width: 100px; height: 100px; border-radius: 50%;">
                        <img id="modalProfileImg" src="@Html.Raw("/" + user.ImagePath)" alt="Profile"
                            class="modal-profile-img" onerror="this.src='@Url.Content(defaultImage)'">
                        @if (!Model.PhotosUnlocked)
                        {
                            <div class="modal-premium-blur" style="border-radius: 50%;"></div>
                            <div class="modal-premium-lock">
                                <i class="uil uil-lock-alt"></i>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <img id="modalProfileImg" src="@Url.Content(defaultImage)" alt="Profile"
                        class="modal-profile-img">
                }
    
                <h4 id="modalProfileName" class="fw-medium fs-18 mb-1" style="color: #000;">@Html.Raw(user.Name)</h4>
                <p id="modalProfileId" class="text-muted fs-14 fw-normal mb-0">@user.RegisterNumber</p>
    
                <div class="modal-inner-box">
                    <!-- Illustration Placeholder -->
                    <div class="d-flex justify-content-center mb-3">
                        <div class="position-relative d-flex align-items-center gap-2">
    
                            <img src="../../../../assets/images/icon/birds.png">
    
                        </div>
                    </div>
    
                    <p class="mb-4 small px-3" style="color:#3E3E3E;line-height: 1.6; font-weight: 500;">
                        To view the contact details you must be a premium member.
                        <br>
                        @*<a href="tel:+919847838325" class="customer-care-link">+919847838325</a>*@
                    </p>
    
                </div>
                <button class="btn btn-upgrade-now shadow" style="font-size: 17px;" onclick="showPackagesModal()">Upgrade
                    Now</button>
            </div>
        </div>
    </div>
    
    <!-- Package Details Modal -->
    <div id="packagesModal" class="upgrade-modal-overlay" onclick="if(event.target === this) hidePackagesModal()">
        <div class="upgrade-modal-card" style="max-width: 630px;">
            <div class="modal-close-btn" onclick="hidePackagesModal()">
                <i class="uil uil-times"></i>
            </div>
    
            <div class="modal-body-scroll">
                @if (!string.IsNullOrEmpty(user.ImagePath))
                {
                    <div class="modal-image-blur-wrapper @(Model.PhotosUnlocked ? "photos-unlocked" : "")" style="width: 100px; height: 100px; border-radius: 50%;">
                        <img id="packageModalProfileImg" src="@Html.Raw("/" + user.ImagePath)" alt="Profile"
                            class="modal-profile-img" onerror="this.src='@Url.Content(defaultImage)'">
                        @if (!Model.PhotosUnlocked)
                        {
                            <div class="modal-premium-blur" style="border-radius: 50%;"></div>
                            <div class="modal-premium-lock">
                                <i class="uil uil-lock-alt"></i>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <img id="packageModalProfileImg" src="@Url.Content(defaultImage)" alt="Profile"
                        class="modal-profile-img">
                }
    
                <h5 class="fw-medium fs-18 mb-2 px-3" style="color: #000;" id="packagesLocalModalTitle">Upgrade to premium membership to view contact
                    details</h5>
                <p class="text-muted fs-12 mb-3 px-4" id="packagesLocalModalSubTitle">Unlock access to contact details by upgrading to premium! Get
                    closer to meaningful connections.</p>
    
                <div class="package-details-inner">
                    <!-- Illustration -->
                    <div class="d-flex justify-content-center mb-3">
                        <div class="position-relative d-flex align-items-center gap-2">
                            <img src="../../../../assets/images/icon/birds.png">
                        </div>
                    </div>
    
                    <h6 class="fw-medium fs-18 mb-2 text-uppercase" style="letter-spacing: 1px;">Membership Package</h6>
    
                    <div class="package-pill-days">180 DAYS</div><br>
                    <div class="package-pill-price">₹ 2000</div>
    
                    <div class="mt-3 mb-3">
                        <p class="fw-bold mb-3" style="font-size: 14px;">Features</p>
                        <div class="d-flex justify-content-center">
                            <div class="package-feature-list">
                                <!-- <div class="package-feature-item">
                                    <i class="uil uil-comment-alt-notes"></i>
                                    <span>Personalised messages to 40 Members</span>
                                </div>
                                <div class="package-feature-item">
                                    <i class="uil uil-comments"></i>
                                    <span>Chat with prospects directly</span>
                                </div> -->
                                <div class="package-feature-item">
                                    <i class="uil uil-mobile-android"></i>
                                    <span>View mobile numbers 50</span>
                                </div>
                                <div class="package-feature-item">
                                    <i class="uil uil-camera"></i>
                                    <span>Send photo unlock requests</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
    
                <a asp-action="MakePayment" asp-controller="Transaction" class="btn btn-pay-online shadow" style="font-size: 17px;">Pay Online</a>
            </div>
        </div>
    </div>

    <!-- Premium Contact Details Modal -->
    <div id="premiumContactModal" class="upgrade-modal-overlay" onclick="if(event.target === this) hidePremiumContactModal()">
        <div class="upgrade-modal-card" style="max-width: 460px; overflow: visible;">
            <!-- Premium Close Button -->
            <div class="premium-modal-close" onclick="hidePremiumContactModal()">
                <i class="uil uil-times"></i>
            </div>

            <div class="modal-body-scroll" style="padding: 30px 25px;">
                <!-- Profile Header -->
                <div class="premium-profile-header d-flex align-items-center gap-3 w-100 mb-3">
                    @if (!string.IsNullOrEmpty(user.ImagePath))
                    {
                        <div class="modal-image-blur-wrapper @(Model.PhotosUnlocked ? "photos-unlocked" : "")" style="width: 75px; height: 75px; border-radius: 50%;">
                            <img id="premiumModalProfileImg" src="@Html.Raw("/" + user.ImagePath)" alt="Profile" class="premium-avatar" onerror="this.src='@Url.Content(defaultImage)'">
                            @if (!Model.PhotosUnlocked)
                            {
                                <div class="modal-premium-blur" style="border-radius: 50%;"></div>
                                <div class="modal-premium-lock">
                                    <i class="uil uil-lock-alt"></i>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <img id="premiumModalProfileImg" src="@Url.Content(defaultImage)" alt="Profile" class="premium-avatar">
                    }
                    <div class="text-start">
                        <h5 id="premiumModalProfileName" class="fw-bold mb-0 text-dark" style="font-size: 18px;">@Html.Raw(user.Name)</h5>
                        <span id="premiumModalProfileId" class="text-muted fw-semibold" style="font-size: 13px;">@user.RegisterNumber</span>
                    </div>
                </div>

                <hr style="border: 0; border-top: 1px solid #eaeaea; margin: 5px 0 20px 0; width: 100%;">

                <p class="fw-medium text-center text-dark my-2" style="font-size: 14.5px; font-family: var(--font-poppins);">Would you like to view <span id="premiumModalAskName">@(user.Name)</span>’s contact details?</p>

                <!-- Info Table -->
                <div class="premium-info-table">
                    <div class="premium-info-row">
                        <div class="info-label">Membership Plan</div>
                        <div class="info-colon">:</div>
                        <div class="info-value">@(Model.ActivePlan != null ? "Premium" : "None")</div>
                    </div>
                    <div class="premium-info-row">
                        <div class="info-label">Remaining Contacts</div>
                        <div class="info-colon">:</div>
                        <div class="info-value">@(Model.ActivePlan != null ? Model.ActivePlan.ViewCreditsPurchased - Model.ActivePlan.ViewCreditsUsed : 0)</div>
                    </div>
                    <div class="premium-info-row">
                        <div class="info-label">Plan Validity</div>
                        <div class="info-colon">:</div>
                        <div class="info-value">@(Model.ActivePlan != null ? Model.ActivePlan.ExpiresAt.ToString("dd MMM yyyy") : "N/A")</div>
                    </div>
                </div>
 
                <!-- Action Buttons -->
                @{
                    bool showUpgradeBtn = false;
                    if (Model.ActivePlan != null)
                    {
                        var remainingCredits = Model.ActivePlan.ViewCreditsPurchased - Model.ActivePlan.ViewCreditsUsed;
                        var remainingDays = (Model.ActivePlan.ExpiresAt - DateTime.UtcNow).TotalDays;
                        if (remainingCredits <= 5 || remainingDays <= 7)
                        {
                            showUpgradeBtn = true;
                        }
                    }
                }
                <div class="d-flex gap-3 w-100 mb-3">
                    <button class="btn btn-premium-view flex-fill shadow-none" onclick="unlockContactDetails()">View</button>
                    @if (showUpgradeBtn)
                    {
                        <button class="btn btn-premium-view flex-fill shadow-none" onclick="showPackagesModal()">Upgrade</button>
                    }
                    <button class="btn btn-premium-cancel flex-fill shadow-none" onclick="hidePremiumContactModal()">Cancel</button>
                </div>

                <!-- Warning/Notice Box --> 
                <div class="premium-notice-box w-100">
                    <p class="mb-0 text-center text-muted" style="font-size: 12px; line-height: 1.5;">
                        Viewing this profile’s contact details again won’t reduce your available contact views.
                    </p>
                </div>
            </div>
        </div>
    </div>


