                                            <p class="text-white opacity-90 fs-12 mb-0">You declined @(user.Name.Split(" ")[0])'s interest request.</p>
                                        }
                                    </div>

                                    <div class="d-flex align-items-center gap-2 mt-2 mt-sm-0">
