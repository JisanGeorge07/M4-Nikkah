                                            <span class="fw-semibold">@(Model.MaritalStatuses?.FirstOrDefault(x => x.Id == user.MaritalStatusId)?.Title ?? "N/A")</span>
                                        </div>
                                    </div>
                                    @if (user.NumberOfChildrens > 0)
                                    {
                                        <div class="col-12 col-md-4">
                                            <div class="info-pill p-2"><span class="fw-medium opacity-75">Children:</span>
                                                <span class="fw-semibold">@user.NumberOfChildrens</span>
                                            </div>
                                        </div>
                                    }
                                    <div class="col-12 col-md-4">
                                        <div class="info-pill p-2"><span class="fw-medium opacity-75">Mother Tongue:</span>
                                            <span class="fw-semibold">@(Model.MotherTongues?.FirstOrDefault(x => x.Id == user.MotherTongueId)?.Title ?? "N/A")</span>
                                        </div>
                                    </div>
                                    <div class="col-12 col-md-4">
                                        <div class="info-pill p-2"><span class="fw-medium opacity-75">Financial Status:</span>
                                            <span class="fw-semibold">@(Model.FinancialStatuses?.FirstOrDefault(x => x.Id == user.FinancialStatusId)?.Title ?? "N/A")</span>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="mb-4">
                                <h5 class="fw-medium fs-18 mb-3">Physical Information</h5>
                                <div class="row g-2">
                                    <div class="col-12 col-md-4">
                                        <div class="info-pill p-2"><span class="fw-medium opacity-75">Height:</span>
                                            <span class="fw-semibold">@(Model.BodyFeatures?.FirstOrDefault(x => x.Id == user.HeightId)?.Title ?? "N/A")</span>
                                        </div>
                                    </div>
                                    <div class="col-12 col-md-4">
                                        <div class="info-pill p-2"><span class="fw-medium opacity-75">Weight:</span>
                                            <span class="fw-semibold">@(Model.BodyFeatures?.FirstOrDefault(x => x.Id == user.WeightId)?.Title ?? "N/A")</span>
                                        </div>
                                    </div>
                                    <div class="col-12 col-md-4">
                                        <div class="info-pill p-2"><span class="fw-medium opacity-75">Complexion:</span>
                                            <span class="fw-semibold">@(Model.BodyFeatures?.FirstOrDefault(x => x.Id == user.ComplexionId)?.Title ?? "N/A")</span>
                                        </div>
                                    </div>
                                    <div class="col-12 col-md-4">
                                        <div class="info-pill p-2"><span class="fw-medium opacity-75">Body Type:</span>
                                            <span class="fw-semibold">@(Model.BodyFeatures?.FirstOrDefault(x => x.Id == user.BodyTypeId)?.Title ?? "N/A")</span>
                                        </div>
                                    </div>
                                    <div class="col-12 col-md-4">
                                        <div class="info-pill p-2"><span class="fw-medium opacity-75">Physically Challenged:</span>
                                            <span class="fw-semibold">@(user.IsPhysicallyChallenged ? "Yes" : "No")</span>
                                        </div>
                                    </div>
