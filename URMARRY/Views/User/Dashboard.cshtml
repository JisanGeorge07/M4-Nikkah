@using Application.Models
@model UserDashboardViewModel
@{
    Layout = "/Views/Shared/_LayoutAccount.cshtml";
    <link href="/assets/account/assets/css/style.min.css" id="color-opt" class="theme-opt" rel="stylesheet"
          type="text/css">
    <style>
        .online-indicator-badge {
            position: absolute;
            top: 10px;
            left: 10px;
            background: rgba(34, 197, 94, 0.92);
            color: #ffffff;
            font-size: 11px;
            font-weight: 600;
            letter-spacing: 0.3px;
            padding: 3px 8px 3px 6px;
            border-radius: 20px;
            display: inline-flex;
            align-items: center;
            gap: 5px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.25);
            z-index: 5;
            backdrop-filter: blur(4px);
            pointer-events: none;
            line-height: 1;
        }
        .online-pulse-dot {
            width: 7px;
            height: 7px;
            background-color: #ffffff;
            border-radius: 50%;
            display: inline-block;
            box-shadow: 0 0 0 0 rgba(255, 255, 255, 0.7);
            animation: onlinePulseAnim 1.8s infinite;
        }
        @@keyframes onlinePulseAnim {
            0% {
                box-shadow: 0 0 0 0 rgba(255, 255, 255, 0.7);
            }
            70% {
                box-shadow: 0 0 0 6px rgba(255, 255, 255, 0);
            }
            100% {
                box-shadow: 0 0 0 0 rgba(255, 255, 255, 0);
            }
        }
    </style>
}

   <main class="flex-fill" style="min-width: 0;">
                <div class="container" style="max-width: 960px;">
                    <div class="p-4">

                        <div class="mb-4 main-tab-container-wrapper">
                            <div class="">


                                <div
                                    class="d-flex flex-nowrap overflow-auto justify-content-start justify-content-md-evenly gap-2 main-tab-container">
                                    <!-- Main Tabs Section -->
                                    <button type="button" class="btn main-tab"
                                        onclick="window.location.href='/dashboard?tab=myMatches'">
                                        My Matches
                                    </button>
                                    <button type="button" class="btn main-tab"
                                        onclick="window.location.href='/dashboard?tab=onlineProfiles'">
                                        Online Profiles
                                    </button>
                                    <button type="button" class="btn main-tab" onclick="window.location.href='/dashboard?tab=newMatches'">
                                        New Matches
                                    </button>
                                    <button type="button" class="btn main-tab" onclick="window.location.href='/dashboard?tab=location'">
                                        Same Location
                                    </button>
                                    
                                    <button type="button" class="btn main-tab" onclick="window.location.href='/dashboard?tab=family'">
                                        Same Family
                                    </button>
                                    <button type="button" class="btn main-tab" onclick="window.location.href='/dashboard?tab=education'">
                                        Same Education
                                    </button>
                                    <button type="button" class="btn main-tab" onclick="window.location.href='/dashboard?tab=profession'">
                                        Same Profession
                                    </button><button type="button" class="btn main-tab"
                                        onclick="window.location.href='/dashboard?tab=physicallychallenged'">
                                        Physically Challenged
                                    </button>
                                </div>
                            </div>
                        </div>

                        <!-- Profiles Grid -->
                        <div class="main-tab-content active" id="profileGridContainer">
                            <div class="row g-4 matchprofile" id="profile-grid">
                            </div>

                            <!-- No results message -->
                            <div id="no-results" class="text-center py-5" style="display:none;">
                                <img src="/assets/images/icon/no-match.png" alt="no-match" height="200px">
                                <h4 class="text-black fw-semibold fs-5 lh-base align-middle mt-3 mb-1">
                                    No Matches Found
                                </h4>
                                <div class="col-lg-6 mx-auto">
                                    <p class="fw-normal fs-13 lh-base text-center align-middle text-black"
                                        style="font-size: 12px;">
                                        We couldn't find a match based on your search preferences. Don't worry, keep refining your criteria and try again.
                                    </p>
                                </div>
                            </div>

                            <!-- Loader spinner -->
                            <div id="scroll-loader" class="mt-4 text-center" style="display:none;">
                                <span class="h6 mb-0 text-muted">Loading.. <i class="mdi mdi-loading mdi-spin h4 mb-0 align-middle"></i></span>
                            </div>

                            <!-- Invisible trigger for IntersectionObserver -->
                            <div id="scroll-sentinel" style="height:1px; display:none;"></div>
                        </div>

                    </div>
                </div>
            </main>

            <!-- MODAL SECTIONS STARTS -->

    <!-- Interaction Confirmation Modal -->
    <div id="interactionModal" class="upgrade-modal-overlay" onclick="if(event.target === this) hideInteractionModal()">
        <div class="upgrade-modal-card" style="max-width: 450px;">
            <div class="modal-close-btn" onclick="hideInteractionModal()">
                <i class="uil uil-times"></i>
            </div>
            <div class="modal-body-scroll" style="padding: 40px 20px;">
                <h5 id="interactionModalTitle" class="fw-medium fs-18 mb-4 px-3 text-center" style="color: #000; line-height: 1.5;">Are you sure?</h5>
                <div class="d-flex justify-content-center gap-3 w-100 px-4 mb-2">
                    <button class="btn btn-upgrade-now shadow-none flex-fill" style="margin-top: 0; background-color: #00662d !important;" onclick="handleInteractionYes()">Yes</button>
                    <button class="btn btn-upgrade-now shadow-none flex-fill" style="margin-top: 0; background-color: #E93B3B !important;" onclick="handleInteractionNo()">No</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Photo Unlock Confirmation Modal -->
    <div id="photoUnlockModal" class="upgrade-modal-overlay" onclick="if(event.target === this) hidePhotoUnlockModal()">
        <div class="upgrade-modal-card" style="max-width: 450px;">
            <div class="modal-close-btn" onclick="hidePhotoUnlockModal()">
                <i class="uil uil-times"></i>
            </div>
            <div class="modal-body-scroll" style="padding: 40px 20px;">
                <h5 id="photoUnlockModalTitle" class="fw-medium fs-18 mb-4 px-3 text-center" style="color: #000; line-height: 1.5;">Request Photo Access?</h5>
                <p class="text-muted text-center px-3 mb-4 fs-14">This will send a request to the profile owner to unlock their photos for you.</p>
                <div class="d-flex justify-content-center gap-3 w-100 px-4 mb-2">
                    <button id="btnConfirmPhotoUnlock" class="btn btn-upgrade-now shadow-none flex-fill" style="margin-top: 0; background-color: #00662d !important;">Yes, Send Request</button>
                    <button class="btn btn-upgrade-now shadow-none flex-fill" style="margin-top: 0; background-color: #E93B3B !important;" onclick="hidePhotoUnlockModal()">No, Cancel</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Relationship Status Update Prompt Modal -->
    <div id="statusUpdatePromptModal" class="upgrade-modal-overlay" onclick="if(event.target === this) hideStatusUpdatePromptModal()">
        <div class="upgrade-modal-card" style="max-width: 480px; border-radius: 16px;">
            <div class="modal-close-btn" onclick="hideStatusUpdatePromptModal()">
                <i class="uil uil-times"></i>
            </div>
            <div class="modal-body-scroll" style="padding: 30px 20px;">
                <div class="text-center mb-4">
                    <div style="font-size: 3rem; color: #ff3a6f; animation: pulse 2s infinite;">❤️</div>
                    <h4 class="fw-semibold mt-2" style="color: #111;">Update Your Relationship Status</h4>
                    <p class="text-muted fs-14">We noticed that you accepted the interest from <span id="promptPartnerName" class="fw-bold text-dark"></span> some time ago. How are things proceeding?</p>
                </div>
                <form id="statusUpdateForm" onsubmit="event.preventDefault(); submitStatusUpdate();">
                    <input type="hidden" id="statusUpdateFavId" name="userFavouriteProfileId" />
                    <input type="hidden" id="statusUpdatePartnerId" name="partnerId" />
                    
                    <div class="mb-4">
                        <label class="form-label fw-medium text-dark mb-2">Current Status</label>
                        <select class="form-select border rounded-3 p-2 w-100" id="statusSelect" required style="font-size: 14px; outline: none; border-color: #ddd;">
                            <option value="3">Still Communicating</option>
                            <option value="0">Engaged</option>
                            <option value="1">Married</option>
                            <option value="2">Rejected / Not Proceeding</option>
                            <option value="4">Prefer Not to Say</option>
                        </select>
                    </div>

                    <div class="d-flex gap-3 mt-4">
                        <button type="submit" class="btn btn-upgrade-now shadow-none flex-fill" style="margin-top: 0; background-color: #00662d !important; border-radius: 8px;">Save Status</button>
                        <button type="button" class="btn btn-upgrade-now shadow-none flex-fill" style="margin-top: 0; background-color: #777 !important; border-radius: 8px;" onclick="hideStatusUpdatePromptModal()">Remind Me Later</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Document Verification Prompt Modal -->
    <div id="documentVerificationPromptModal" class="upgrade-modal-overlay" onclick="if(event.target === this) hideDocVerificationPromptModal()">
        <div class="upgrade-modal-card" style="max-width: 480px; border-radius: 16px;">
            <div class="modal-close-btn" onclick="hideDocVerificationPromptModal()">
                <i class="uil uil-times"></i>
            </div>
            <div class="modal-body-scroll" style="padding: 30px 20px;">
                <div class="text-center mb-4">
                    <div style="width: 70px; height: 70px; background: rgba(0, 102, 45, 0.1); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 15px auto;">
                        <i class="uil uil-file-shield-alt" style="font-size: 2.5rem; color: #00662d;"></i>
                    </div>
                    <h4 class="fw-semibold mt-2" style="color: #111;">Complete Document Verification</h4>
                    <p class="text-muted fs-14" style="line-height: 1.5;">Document verification is required for your profile. Please upload your identity or qualification document to complete verification and unlock full access.</p>
                </div>
                <div class="d-flex gap-3 mt-4">
                    <a href="@Url.Action("ProfileVerification", "User")" class="btn btn-upgrade-now shadow-none flex-fill text-white text-center text-decoration-none py-2" style="margin-top: 0; background-color: #00662d !important; border-radius: 8px; font-weight: 600; display: flex; align-items: center; justify-content: center;">Continue</a>
                    <button type="button" class="btn btn-upgrade-now shadow-none flex-fill" style="margin-top: 0; background-color: #777 !important; border-radius: 8px;" onclick="hideDocVerificationPromptModal()">Remind Me Later</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Success Story Submission Modal -->
    <div id="successStoryModal" class="upgrade-modal-overlay" onclick="if(event.target === this) hideSuccessStoryModal()">
        <div class="upgrade-modal-card" style="max-width: 550px; border-radius: 16px;">
            <div class="modal-close-btn" onclick="hideSuccessStoryModal()">
                <i class="uil uil-times"></i>
            </div>
            <div class="modal-body-scroll" style="padding: 25px 20px; max-height: 85vh; overflow-y: auto;">
                <div class="text-center mb-4">
                    <div style="font-size: 2.5rem; color: #ffb400;">💖</div>
                    <h4 class="fw-semibold mt-2" style="color: #111;">Share Your Happy Journey!</h4>
                    <p class="text-muted fs-13">Alhamdulillah! We are thrilled to hear you got married through M4Nikkah. Share your story to inspire others!</p>
                </div>
                
                <form id="successStoryForm" onsubmit="event.preventDefault(); submitSuccessStory();" enctype="multipart/form-data">
                    <input type="hidden" id="storyMatchStatusId" name="MatchStatusUpdateId" />
                    <input type="hidden" id="storyPartnerUserId" name="PartnerUserId" />
                    
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-medium text-dark mb-1" style="font-size: 13px;">Groom's Display Name *</label>
                            <input type="text" class="form-control rounded-3" id="groomNameInput" name="GroomDisplayName" required placeholder="e.g. Ibrahim" style="font-size: 13px; padding: 10px;" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-medium text-dark mb-1" style="font-size: 13px;">Bride's Display Name *</label>
                            <input type="text" class="form-control rounded-3" id="brideNameInput" name="BrideDisplayName" required placeholder="e.g. Mariam" style="font-size: 13px; padding: 10px;" />
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-medium text-dark mb-1" style="font-size: 13px;">Marriage Date *</label>
                            <input type="date" class="form-control rounded-3" id="marriageDateInput" name="MarriageDate" required style="font-size: 13px; padding: 8px 10px;" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-medium text-dark mb-1" style="font-size: 13px;">Rate Your Experience *</label>
                            <div class="d-flex align-items-center gap-1 mt-1" id="starRatingContainer" style="font-size: 1.5rem; color: #ccc; cursor: pointer;">
                                <span class="star-item active" data-rating="1" onclick="setRating(1)" onmouseover="hoverRating(1)" onmouseout="resetRating()">★</span>
                                <span class="star-item active" data-rating="2" onclick="setRating(2)" onmouseover="hoverRating(2)" onmouseout="resetRating()">★</span>
                                <span class="star-item active" data-rating="3" onclick="setRating(3)" onmouseover="hoverRating(3)" onmouseout="resetRating()">★</span>
                                <span class="star-item active" data-rating="4" onclick="setRating(4)" onmouseover="hoverRating(4)" onmouseout="resetRating()">★</span>
                                <span class="star-item active" data-rating="5" onclick="setRating(5)" onmouseover="hoverRating(5)" onmouseout="resetRating()">★</span>
                            </div>
                            <input type="hidden" id="ratingInput" name="Rating" value="5" required />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-medium text-dark mb-1" style="font-size: 13px;">Your Success Story / Feedback *</label>
                        <textarea class="form-control rounded-3" id="storyTextInput" name="Story" rows="4" required maxlength="300" placeholder="Tell us how you connected, your experience on M4Nikkah, and your blessings..." style="font-size: 13px; padding: 10px; resize: none;"></textarea>
                        <div class="text-end mt-1">
                            <small class="text-muted"><span id="dashboardStoryCharCount">0</span>/300 characters</small>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-medium text-dark mb-1" style="font-size: 13px;">Upload Couple Photo (Optional)</label>
                        <input type="file" class="form-control rounded-3" id="couplePhotoInput" name="CouplePhoto" accept="image/*" onchange="validateCouplePhoto(this)" style="font-size: 13px; padding: 8px;" />
                        <div class="form-text text-muted" style="font-size: 11px;">Recommended dimensions: 630×800px. Max size: 2MB.</div>
                        <div id="photoErrorMsg" class="text-danger mt-1 d-none" style="font-size: 12px;"></div>
                    </div>

                    <div class="mb-3 form-check text-start">
                        <input type="checkbox" class="form-check-input" id="consentCheck" name="ConsentToPublish" required checked style="cursor: pointer;" />
                        <label class="form-check-label fs-12 text-muted" for="consentCheck" style="cursor: pointer;">I agree to publish our success story on M4Nikkah website.</label>
                    </div>

                    <div class="mb-4 form-check text-start">
                        <input type="checkbox" class="form-check-input" id="privacyCheck" name="HideFullName" style="cursor: pointer;" />
                        <label class="form-check-label fs-12 text-muted" for="privacyCheck" style="cursor: pointer;">Privacy option: Hide full names (show only initials, e.g. I. &amp; M.)</label>
                    </div>

                    <div class="d-flex gap-3">
                        <button type="submit" id="btnSubmitStory" class="btn btn-upgrade-now shadow-none flex-fill" style="margin-top: 0; background-color: #00662d !important; border-radius: 8px;">Submit Story</button>
                        <button type="button" class="btn btn-upgrade-now shadow-none flex-fill" style="margin-top: 0; background-color: #777 !important; border-radius: 8px;" onclick="hideSuccessStoryModal()">Cancel</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <style>
        .star-item {
            transition: color 0.15s ease, transform 0.15s ease;
        }
        .star-item:hover {
            transform: scale(1.25);
        }
        .star-item.active {
            color: #ffb400;
        }
        @@keyframes pulse {
            0% { transform: scale(1); }
            50% { transform: scale(1.08); }
            100% { transform: scale(1); }
        }
    </style>
            
    <!-- MODAL SECTIONS ENDS -->

@section Scripts
{
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
    <script>
    (function () {
        // --- SignalR Presence Connection ---
        try {
            if (typeof signalR !== 'undefined') {
                const presenceConn = new signalR.HubConnectionBuilder()
                    .withUrl("/hubs/presence?userId=" + @Model.Registration.Id)
                    .withAutomaticReconnect([0, 2000, 5000, 10000, 30000])
                    .configureLogging(signalR.LogLevel.Warning)
                    .build();

                // Real-time: when another user comes online, light up their green badge immediately
                presenceConn.on("UserOnline", function (onlineUserId) {
                    console.log("PresenceHub: UserOnline event for userId:", onlineUserId);
                    const cardCol = document.getElementById('matchingProfile-' + onlineUserId);
                    if (cardCol) {
                        const card = cardCol.querySelector('.profile-card');
                        if (card && !card.querySelector('.online-indicator-badge')) {
                            card.insertAdjacentHTML('afterbegin', '<span class="online-indicator-badge" title="Online"><span class="online-pulse-dot"></span>Online</span>');
                        }
                        // In My Matches tab, move newly online users to the top in real-time
                        if (activeTab === 'myMatches' && grid && cardCol.parentElement === grid) {
                            grid.prepend(cardCol);
                        }
                    } else if (activeTab === 'onlineProfiles') {
                        // If we are on Online Profiles tab and grid was empty, refresh first page
                        if (grid && grid.children.length === 0) {
                            currentPage = 0;
                            hasMore = true;
                            fetchProfiles(true);
                        }
                    }
                });

                // Real-time: when a user goes offline, remove their green badge
                presenceConn.on("UserOffline", function (offlineUserId) {
                    console.log("PresenceHub: UserOffline event for userId:", offlineUserId);
                    const cardCol = document.getElementById('matchingProfile-' + offlineUserId);
                    if (cardCol) {
                        const badge = cardCol.querySelector('.online-indicator-badge');
                        if (badge) badge.remove();

                        // On Online Profiles tab, immediately remove the offline user's card
                        if (activeTab === 'onlineProfiles') {
                            cardCol.style.transition = 'opacity 0.4s ease, transform 0.4s ease';
                            cardCol.style.opacity = '0';
                            cardCol.style.transform = 'scale(0.95)';
                            setTimeout(() => {
                                cardCol.remove();
                                if (grid && grid.querySelectorAll('.col-12').length === 0 && noResults) {
                                    noResults.style.display = 'block';
                                }
                            }, 400);
                        }
                    }
                });

                presenceConn.onreconnected(function (connectionId) {
                    console.log("PresenceHub: Reconnected with connectionId:", connectionId);
                });

                presenceConn.start()
                    .then(() => console.log("PresenceHub: Connected successfully as user @Model.Registration.Id"))
                    .catch(function (err) {
                        console.error("PresenceHub: Connection FAILED:", err);
                    });
            } else {
                console.error("PresenceHub: signalR library not loaded! Check CDN script tag.");
            }
        } catch (e) {
            console.error("SignalR presence init error:", e);
        }

        // --- State ---
        const userId = @Model.Registration.Id;
        const isPremiumMember = @Model.Registration.IsPremiumMember.ToString().ToLower();
        let currentPage = 0;
        let isLoading = false;
        let hasMore = true;

        // --- Read active tab from URL query parameter ---
        const urlParams = new URLSearchParams(window.location.search);
        const activeTab = urlParams.get('tab') || 'myMatches';

        // --- DOM refs ---
        const grid = document.getElementById('profile-grid');
        const sentinel = document.getElementById('scroll-sentinel');
        const loader = document.getElementById('scroll-loader');
        const noResults = document.getElementById('no-results');

        // --- Tab Type Map ---
        const tabTypeMap = {
            'myMatches': 'mymatching',
            'onlineProfiles': 'onlineprofiles',
            'newMatches': 'newmatching',
            'location': 'mylocation',
            'family': 'samefamilystatus',
            'education': 'sameeducation',
            'profession': 'sameprofession',
            'physicallychallenged': 'physicallychallenged'
        };

        let currentType = tabTypeMap[activeTab] || 'mymatching';

        // --- Immediate offline notification on browser close / page unload ---
        window.addEventListener('beforeunload', function () {
            if (navigator.sendBeacon) {
                navigator.sendBeacon('/api/presence/offline?userId=' + userId);
            }
        });
        window.addEventListener('pagehide', function () {
            if (navigator.sendBeacon) {
                navigator.sendBeacon('/api/presence/offline?userId=' + userId);
            }
        });

        // --- Set active tab button on page load based on URL param ---
        document.querySelectorAll('.main-tab').forEach(btn => {
            const onclickAttr = btn.getAttribute('onclick') || '';
            if (onclickAttr.includes("tab=" + activeTab + "'")) {
                btn.classList.add('active');
                // Scroll the active tab into view within the horizontal tab container
                setTimeout(() => {
                    btn.scrollIntoView({ behavior: 'instant', inline: 'center', block: 'nearest' });
                }, 100);
            }
        });

        // --- Expose showMainTab for backward compatibility (redirects) ---
        window.showMainTab = function(tabId) {
            window.location.href = '/dashboard?tab=' + tabId;
        };

        // --- Fetch Profiles ---
        async function fetchProfiles(showLoader) {
            if (isLoading || !hasMore) return;
            isLoading = true;
            currentPage++;

            if (showLoader) {
                loader.style.display = 'block';
            }

            try {
                const url = `/api/profile/homeprofiles?userId=${userId}&type=${currentType}&page=${currentPage}&pageSize=30`;
                const response = await fetch(url);
                const result = await response.json();

                if (!result.success) {
                    console.error('API error:', result);
                    isLoading = false;
                    return;
                }

                hasMore = result.hasMore;
                const profiles = result.data;

                if (profiles.length === 0 && currentPage === 1) {
                    noResults.style.display = 'block';
                    loader.style.display = 'none';
                    sentinel.style.display = 'none';
                    isLoading = false;
                    return;
                }

                profiles.forEach(p => renderProfileCard(p));
                loader.style.display = 'none';

                if (!hasMore) {
                    sentinel.style.display = 'none';
                } else {
                    sentinel.style.display = 'block';
                }

                // Re-initialize Lucide Icons for the newly created elements
                if (window.lucide && typeof window.lucide.createIcons === 'function') {
                    window.lucide.createIcons();
                }
            } catch (err) {
                console.error('Fetch error:', err);
            } finally {
                isLoading = false;
            }
        }

        // --- Render Profile Card ---
        function renderProfileCard(profile) {
            const imagePath = profile.imagePath
                ? '/' + profile.imagePath
                : (profile.gender === 'Female' ? '/assets/images/default-user-women.png' : '/assets/images/default-user-men.png');

            const detailParts = [
                profile.age ? profile.age + ' Yrs' : null,
                profile.height ? profile.height.replace(/\s*(feet|ft|\([^)]*\))/gi, '') : null,
                // profile.weight ? profile.weight: null,
                profile.maritalStatus,
                profile.community,
                profile.higherEducation,
                profile.village,
                profile.district,
                profile.state
            ].filter(Boolean);
            const profileDetails = detailParts.join(', ');

            // Ensure profile.name is clean  
            const cleanName = (profile.name || '').replace(/'/g, "\\'");
            const cleanDetails = profileDetails.replace(/'/g, "\\'");

            // Define dynamic link action pointing directly to the profile details page
            const profileUrl = '/profile/' + (profile.registerNumber ? profile.registerNumber : profile.id);
            const cardClickAction = `onclick="location.href='${profileUrl}'"`;

            const starClass = profile.isStarred ? 'glow-star' : '';
            const heartClass = profile.isLiked ? 'glow-heart' : '';
            const isLockedClass = (profile.photosUnlocked || !profile.imagePath) ? '' : 'premium-card';

            const onlineBadgeHtml = profile.isOnline
                ? `<span class="online-indicator-badge" title="Online"><span class="online-pulse-dot"></span>Online</span>`
                : '';

            let blurOverlayHtml = '';
            if (!profile.photosUnlocked && profile.imagePath) {
                const reqStatus = profile.photoUnlockRequestStatus;
                const isPending = reqStatus === 0;
                const isRejected = reqStatus === 2;
                
                let buttonText = 'Unlock Images';
                let iconClass = 'lock';
                if (isPending) {
                    buttonText = 'Request Pending...';
                    iconClass = 'clock';
                } else if (isRejected) {
                    buttonText = 'Request Rejected - Retry?';
                }

                blurOverlayHtml = `
                    <div class="premium-blur position-absolute top-0 start-0 w-100 h-100" style="z-index: 2;"></div>
                    <div class="premium-lock" style="z-index: 3; cursor: ${isPending ? 'default' : 'pointer'};" 
                         onclick="${isPending ? '' : `event.stopPropagation(); showPhotoUnlockModal(${profile.id}, '${cleanName}')`}">
                        <i class="uil uil-${iconClass}"></i>
                        <span class="premium-text">${buttonText}</span>
                    </div> 
                `;
            }

            const cardHtml = `
                <div class="col-12 col-md-6 col-lg-4" id="matchingProfile-${profile.id}">
                    <div class="profile-card position-relative overflow-hidden rounded ${isLockedClass}" ${cardClickAction}>
                        ${onlineBadgeHtml}

                        <!-- Background Image -->
                        <div class="profile-bg position-absolute top-0 start-0 w-100 h-100"
                            style="background-image: url('${imagePath}');">
                        </div>

                         <!-- Watermark Image -->
                         ${imagePath.includes('_wm') ? '' : `<img src="../../../../assets/images/card-watermark.png" class="card-watermark position-absolute" alt="Watermark">`}

                        <div class="single-chart">
										<svg viewBox="0 0 36 36" class="circular-chart green">
										  <path class="circle-bg"
											d="M18 2.0845
											  a 15.9155 15.9155 0 0 1 0 31.831
											  a 15.9155 15.9155 0 0 1 0 -31.831"
										  />
										  <path class="circle"
											stroke-dasharray="${profile.totalMatchingScore || 0}, 100"
											d="M18 2.0845
											  a 15.9155 15.9155 0 0 1 0 31.831
											  a 15.9155 15.9155 0 0 1 0 -31.831"
										  />
										  <text x="18" y="20.35" class="percentage">${profile.totalMatchingScore || 0}%</text>
										</svg>
						</div>

                        <!-- Overlay -->
                        <div class="profile-overlay position-absolute top-0 start-0 w-100 h-100"></div>

                        ${blurOverlayHtml}

                        <!-- Content -->
                        <div class="position-absolute bottom-0 start-0 w-100 p-3 text-center text-white" style="z-index: 3;">

                            <h5 class="fw-semibold mb-1">
                                ${profile.name || ''}${(profile.documentVerificationComplete && profile.documentVerificationFollowupApproved) ? ' <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="#0d6efd" class="bi bi-patch-check-fill ms-1 align-middle" viewBox="0 0 16 16" style="vertical-align: middle; display: inline-block;" title="Document Verified Profile" data-bs-toggle="tooltip"><path d="M10.067.87a2.89 2.89 0 0 0-4.134 0l-.622.638-.89-.011a2.89 2.89 0 0 0-2.924 2.924l.01.89-.636.622a2.89 2.89 0 0 0 0 4.134l.637.622-.011.89a2.89 2.89 0 0 0 2.924 2.924l.89-.01.622.636a2.89 2.89 0 0 0 4.134 0l.622-.637.89.011a2.89 2.89 0 0 0 2.924-2.924l-.01-.89.636-.622a2.89 2.89 0 0 0 0-4.134l-.637-.622.011-.89a2.89 2.89 0 0 0-2.924-2.924l-.89.01zm.287 5.984-3 3a.5.5 0 0 1-.708 0l-1.5-1.5a.5.5 0 1 1 .708-.708L7 8.793l2.646-2.647a.5.5 0 0 1 .708.708"/></svg>' : ''}
                            </h5>

                            <p class="small mb-2 text-white-50">
                                ${profileDetails}
                            </p>

                            <!-- Buttons -->
                            <div class="d-flex justify-content-center gap-2 mt-2 position-relative">

                                <button class="action-btn" style="background-color: #A5BE25;" id="starbutton-${profile.id}" onclick="event.stopPropagation(); showInteractionModal(this, 'favourite')">
                                    <i data-lucide="star" class="${starClass}" fill="white" style="color: white; width: 18px; height: 18px; border-radius: 50%;"></i>
                                </button>

                                <button class="action-btn" style="background-color: #00662D;" id="likebutton-${profile.id}" onclick="event.stopPropagation(); showInteractionModal(this, 'interest')">
                                    <i data-lucide="heart" class="${heartClass}" fill="white" style="color: white; width: 18px; height: 18px; border-radius: 50%;"></i>
                                </button>

                                <button class="action-btn" style="background-color: #648472;" id="notlikebutton-${profile.id}" onclick="event.stopPropagation(); showInteractionModal(this, 'reject')">
                                    <i data-lucide="circle-x" style="color: white; width: 18px; height: 18px;"></i>
                                </button>

                            </div>
                        </div>

                    </div>
                </div>`;

            grid.insertAdjacentHTML('beforeend', cardHtml);
        }

        // --- Infinite Scroll Observer ---
        const observer = new IntersectionObserver(entries => {
            entries.forEach(entry => {
                if (entry.isIntersecting && !isLoading && hasMore) {
                    fetchProfiles(true);
                }
            });
        }, { rootMargin: '100px' });

        observer.observe(sentinel);

        // --- Initial Load ---
        fetchProfiles(false);

        // Photo Unlock Modal script integration
        let selectedPhotoOwnerId = null;
        window.showPhotoUnlockModal = function(ownerId, ownerName) {
            if (typeof event !== 'undefined' && event) event.stopPropagation();
            if (typeof window.isPremiumMember !== 'undefined' && !window.isPremiumMember) {
                if (typeof showPackagesLayoutModal === 'function') {
                    showPackagesLayoutModal('photo');
                } else {
                    alert('Please upgrade to premium membership to request photo unlock.');
                }
                return;
            }
            selectedPhotoOwnerId = ownerId;

            const title = document.getElementById('photoUnlockModalTitle');
            if (title) {
                title.innerText = `Request Photo Access from ${ownerName || 'User'}?`;
            }
            document.getElementById('photoUnlockModal').classList.add('active');
            document.body.style.overflow = 'hidden';
        };

        window.hidePhotoUnlockModal = function() {
            document.getElementById('photoUnlockModal').classList.remove('active');
            document.body.style.overflow = '';
            selectedPhotoOwnerId = null;
        };

        document.getElementById('btnConfirmPhotoUnlock').addEventListener('click', function() {
            if (!selectedPhotoOwnerId) return;
            
            const formData = new FormData();
            formData.append('ownerId', selectedPhotoOwnerId);

            fetch('/RequestPhotoUnlock', {
                method: 'POST',
                body: formData,
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            })
            .then(response => response.json())
            .then(data => {
                window.hidePhotoUnlockModal();
                if (data.success) {
                    Swal.fire({
                        title: 'Request Sent!',
                        text: data.message || 'Unlock request is pending owner approval.',
                        icon: 'success',
                        width: '320px',
                        confirmButtonColor: '#00662d'
                    }).then(() => {
                        window.location.reload();
                    });
                } else {
                    Swal.fire({
                        title: 'Error',
                        text: data.message || 'Could not send request.',
                        icon: 'error',
                        width: '320px'
                    });
                }
            })
            .catch(error => {
                console.error('Error:', error);
                window.hidePhotoUnlockModal();
                Swal.fire({
                    title: 'Error',
                    text: 'An error occurred. Please try again.',
                    icon: 'error',
                    width: '320px'
                });
            });
        });

        // --- Testimonials & Relationship Status Updates Prompt logic ---
        function checkPendingPrompts() {
            fetch(`/api/testimonial/pending-status-prompts?userId=${userId}`)
            .then(res => res.json())
            .then(data => {
                // Instantly update badge count if notification was created
                if (typeof window.checkUnreadNotifications === 'function') {
                    window.checkUnreadNotifications();
                }

                if (data.success && data.data && data.data.length > 0) {
                    // Show prompt for the first pending interest status update
                    const firstPrompt = data.data[0];
                    window.showStatusUpdatePromptModal(
                        firstPrompt.userFavouriteProfileId, 
                        firstPrompt.partnerId, 
                        firstPrompt.partnerName,
                        firstPrompt.currentStatus
                    );
                }
            })
            .catch(err => console.error('Error checking prompts:', err));
        }

        // Run prompt check 3 seconds after dashboard load so it's less obtrusive
        setTimeout(checkPendingPrompts, 3000);

        window.showStatusUpdatePromptModal = function(favId, partnerId, partnerName, currentStatus) {
            document.getElementById('statusUpdateFavId').value = favId;
            document.getElementById('statusUpdatePartnerId').value = partnerId;
            document.getElementById('promptPartnerName').innerText = partnerName;
            
            const statusSelect = document.getElementById('statusSelect');
            if (currentStatus !== undefined && currentStatus !== null) {
                statusSelect.value = currentStatus.toString();
            } else {
                statusSelect.value = "3"; // Default to Still Communicating
            }
            
            document.getElementById('statusUpdatePromptModal').classList.add('active');
            document.body.style.overflow = 'hidden';
        };

        window.showDocVerificationPromptModal = function() {
            var modal = document.getElementById('documentVerificationPromptModal');
            if (modal) {
                modal.classList.add('active');
                document.body.style.overflow = 'hidden';
            }
        };

        window.hideDocVerificationPromptModal = function() {
            var modal = document.getElementById('documentVerificationPromptModal');
            if (modal) {
                modal.classList.remove('active');
                document.body.style.overflow = '';
            }
        };

        @if (Model?.Registration != null && Model.Registration.DocumentVerificationEnabled == true && !Model.Registration.DocumentVerificationComplete && string.IsNullOrWhiteSpace(Model.Registration.VerificationDocumentUrl))
        {
            <text>
            setTimeout(function() {
                if (typeof window.showDocVerificationPromptModal === 'function') {
                    window.showDocVerificationPromptModal();
                }
            }, 800);
            </text>
        }

        window.hideStatusUpdatePromptModal = function() {
            document.getElementById('statusUpdatePromptModal').classList.remove('active');
            document.body.style.overflow = '';
        };

        window.submitStatusUpdate = function() {
            const favId = document.getElementById('statusUpdateFavId').value;
            const partnerId = document.getElementById('statusUpdatePartnerId').value;
            const partnerName = document.getElementById('promptPartnerName').innerText;
            const status = document.getElementById('statusSelect').value;

            const formData = new FormData();
            formData.append('userId', userId);
            formData.append('partnerId', partnerId);
            formData.append('userFavouriteProfileId', favId);
            formData.append('status', status);

            fetch('/api/testimonial/update-status', {
                method: 'POST',
                body: formData
            })
            .then(res => res.json())
            .then(data => {
                window.hideStatusUpdatePromptModal();
                if (data.success) {
                    if (data.showStoryForm) {
                        // User selected Married! Show success story modal
                        // Check if they can submit
                        fetch(`/api/testimonial/can-submit-story?userId=${userId}&partnerId=${partnerId}`)
                        .then(r => r.json())
                        .then(storyData => {
                            if (storyData.success && storyData.canSubmit) {
                                window.showSuccessStoryModal(
                                    partnerId, 
                                    partnerName, 
                                    storyData.matchStatusUpdateId,
                                    storyData.userName,
                                    storyData.partnerName,
                                    storyData.userGender
                                );
                            } else {
                                Swal.fire({
                                    title: 'Status Saved!',
                                    text: 'Your relationship status has been updated to Married. Thank you!',
                                    icon: 'success',
                                    confirmButtonColor: '#00662d',
                                    width: '320px'
                                });
                            }
                        });
                    } else {
                        Swal.fire({
                            title: 'Status Updated!',
                            text: 'Thank you for updating your relationship status.',
                            icon: 'success',
                            confirmButtonColor: '#00662d',
                            width: '320px'
                        });
                    }
                } else {
                    Swal.fire({
                        title: 'Error',
                        text: data.message || 'Could not update status.',
                        icon: 'error',
                        width: '320px'
                    });
                }
            })
            .catch(err => {
                console.error('Error:', err);
                Swal.fire({
                    title: 'Error',
                    text: 'An error occurred. Please try again.',
                    icon: 'error',
                    width: '320px'
                });
            });
        };

        window.showSuccessStoryModal = function(partnerId, partnerName, matchStatusId, currentUserName, partnerFullName, currentUserGender) {
            document.getElementById('storyMatchStatusId').value = matchStatusId || 0;
            document.getElementById('storyPartnerUserId').value = partnerId || 0;
            
            // Auto-fill Groom & Bride names based on genders if known
            const groomInput = document.getElementById('groomNameInput');
            const brideInput = document.getElementById('brideNameInput');
            
            if (currentUserGender === 'Male') {
                groomInput.value = currentUserName || '';
                brideInput.value = partnerFullName || '';
            } else if (currentUserGender === 'Female') {
                groomInput.value = partnerFullName || '';
                brideInput.value = currentUserName || '';
            } else {
                groomInput.value = partnerFullName || '';
                brideInput.value = '';
            }

            // Set default date to today
            const today = new Date().toISOString().split('T')[0];
            document.getElementById('marriageDateInput').value = today;

            // Reset form fields
            document.getElementById('storyTextInput').value = '';
            const charSpan = document.getElementById('dashboardStoryCharCount');
            if (charSpan) charSpan.innerText = '0';
            document.getElementById('couplePhotoInput').value = '';
            document.getElementById('photoErrorMsg').classList.add('d-none');
            setRating(5);

            document.getElementById('successStoryModal').classList.add('active');
            document.body.style.overflow = 'hidden';
        };

        window.hideSuccessStoryModal = function() {
            document.getElementById('successStoryModal').classList.remove('active');
            document.body.style.overflow = '';
        };

        let activeRating = 5;
        window.setRating = function(rating) {
            activeRating = rating;
            document.getElementById('ratingInput').value = rating;
            const stars = document.querySelectorAll('.star-item');
            stars.forEach(s => {
                const r = parseInt(s.getAttribute('data-rating'));
                s.classList.toggle('active', r <= rating);
            });
        };

        window.hoverRating = function(rating) {
            const stars = document.querySelectorAll('.star-item');
            stars.forEach(s => {
                const r = parseInt(s.getAttribute('data-rating'));
                s.style.color = r <= rating ? '#ffb400' : '#ccc';
            });
        };

        window.resetRating = function() {
            const stars = document.querySelectorAll('.star-item');
            stars.forEach(s => {
                const r = parseInt(s.getAttribute('data-rating'));
                s.style.color = r <= activeRating ? '#ffb400' : '#ccc';
            });
        };

        window.validateCouplePhoto = function(input) {
            const file = input.files[0];
            const errorDiv = document.getElementById('photoErrorMsg');
            errorDiv.classList.add('d-none');
            errorDiv.innerText = '';

            if (!file) return;

            // Size check: Max 2MB
            if (file.size > 2 * 1024 * 1024) {
                errorDiv.innerText = 'Photo size exceeds 2MB limit.';
                errorDiv.classList.remove('d-none');
                input.value = '';
                return;
            }

            // Image dimension check (optional validation)
            const img = new Image();
            img.src = URL.createObjectURL(file);
            img.onload = function() {
                if (img.width < 300 || img.height < 300) {
                    errorDiv.innerText = 'Image resolution is low. For best results, use a higher resolution image.';
                    errorDiv.classList.remove('d-none');
                }
            };
        };

        window.submitSuccessStory = function() {
            const storyText = document.getElementById('storyTextInput').value;
            if (storyText.length > 300) {
                Swal.fire({
                    title: 'Limit Exceeded',
                    text: 'Your success story cannot exceed 300 characters.',
                    icon: 'error',
                    width: '320px'
                });
                return;
            }

            const form = document.getElementById('successStoryForm');
            const btn = document.getElementById('btnSubmitStory');
            
            const errorDiv = document.getElementById('photoErrorMsg');
            if (!errorDiv.classList.contains('d-none') && errorDiv.innerText.includes('exceeds')) {
                return;
            }

            btn.disabled = true;
            btn.innerText = 'Submitting...';

            const formData = new FormData(form);
            formData.append('SubmittedByUserId', userId);
            
            // Explicitly set boolean fields so ASP.NET Core binds them correctly!
            formData.set('ConsentToPublish', document.getElementById('consentCheck').checked ? 'true' : 'false');
            formData.set('HideFullName', document.getElementById('privacyCheck').checked ? 'true' : 'false');

            fetch('/api/testimonial/submit-story', {
                method: 'POST',
                body: formData
            })
            .then(res => res.json())
            .then(data => {
                btn.disabled = false;
                btn.innerText = 'Submit Story';
                
                if (data.success) {
                    window.hideSuccessStoryModal();
                    Swal.fire({
                        title: 'Congratulations! 🎉',
                        text: data.message,
                        icon: 'success',
                        confirmButtonColor: '#00662d',
                        width: '350px'
                    });
                } else {
                    // Extract rich C# model validation errors if present
                    let errMsg = data.message || 'Could not submit story.';
                    if (data.errors) {
                        const errList = [];
                        for (const key in data.errors) {
                            if (data.errors.hasOwnProperty(key)) {
                                errList.push(`• <b>${key}</b>: ${data.errors[key].join(', ')}`);
                            }
                        }
                        if (errList.length > 0) {
                            errMsg = `<div style="text-align: left; font-size: 13px;">One or more validation errors occurred:<br/><br/>${errList.join('<br/>')}</div>`;
                        }
                    }
                    Swal.fire({
                        title: 'Submission Failed',
                        html: errMsg,
                        icon: 'error',
                        width: '350px'
                    });
                }
            })
            .catch(err => {
                btn.disabled = false;
                btn.innerText = 'Submit Story';
                console.error('Error:', err);
                Swal.fire({
                    title: 'Error',
                    text: 'An error occurred. Please try again.',
                    icon: 'error',
                    width: '320px'
                });
            });
        };

        // Event listener for live character count
        const dashboardStoryInput = document.getElementById('storyTextInput');
        const dashboardCharCountSpan = document.getElementById('dashboardStoryCharCount');
        if (dashboardStoryInput && dashboardCharCountSpan) {
            dashboardStoryInput.addEventListener('input', function() {
                dashboardCharCountSpan.innerText = this.value.length;
            });
        }
    })();
    </script>
}
