@model URMARRY.Models.UserProfileVerificationViewModel
@{
    Layout = "/Views/Shared/_LayoutAccount.cshtml";
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.2/cropper.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" />
}

<style>
    /* Container & Base Styles */
    .verification-page-container {
        max-width: 960px;
        margin: 0 auto;
        padding: 24px 20px;
        font-family: 'Poppins', sans-serif;
    }

    .verification-header-box {
        margin-bottom: 24px;
    }

    .verification-header-box h2 {
        font-size: 20px;
        font-weight: 700;
        color: #1e293b;
        margin-bottom: 6px;
        display: flex;
        align-items: center;
        gap: 8px;
        letter-spacing: -0.2px;
    }

    .verification-header-box p {
        color: #626563;
        font-size: 13.5px;
        line-height: 1.55;
        margin-bottom: 0;
    }

    /* Status Hero Card */
    .status-hero-card {
        border-radius: 16px;
        padding: 20px 24px;
        margin-bottom: 26px;
        border: 1.5px solid #e2e8f0;
        transition: all 0.25s ease;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.03);
    }

    .status-hero-card.status-verified {
        background: linear-gradient(135deg, #e9f5ee 0%, #d8f0e2 100%);
        border-color: #a7dfb8;
    }

    .status-hero-card.status-rejected {
        background: linear-gradient(135deg, #fff5f5 0%, #fee2e2 100%);
        border-color: #fca5a5;
    }

    .status-hero-card.status-review {
        background: linear-gradient(135deg, #f0f9ff 0%, #e0f2fe 100%);
        border-color: #bae6fd;
    }

    .status-hero-card.status-pending {
        background: linear-gradient(135deg, #fbfdfc 0%, #f4f9f6 100%);
        border-color: #dce8e0;
    }

    .status-icon-box {
        width: 48px;
        height: 48px;
        min-width: 48px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
        background: #ffffff;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
    }

    .status-badge-custom {
        font-size: 12px;
        font-weight: 600;
        padding: 5px 10px;
        border-radius: 50px;
        display: inline-flex;
        align-items: center;
        gap: 4px;
        white-space: nowrap;
    }

    .status-badge-verified {
        background-color: #00662d;
        color: #ffffff;
    }

    .status-badge-rejected {
        background-color: #E93B3B;
        color: #ffffff;
    }

    .status-badge-review {
        background-color: #0284c7;
        color: #ffffff;
    }

    .status-badge-pending {
        background-color: #626563;
        color: #ffffff;
    }

    .verified-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        color: #00662d;
        font-weight: 700;
        font-size: 14px;
        background: rgba(0, 102, 45, 0.08);
        padding: 6px 14px;
        border-radius: 50px;
        border: 1px solid rgba(0, 102, 45, 0.2);
    }

    /* Document Grid */
    .doc-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
        gap: 20px;
        margin-bottom: 28px;
    }

    .doc-card {
        background: #ffffff;
        border: 1.5px dashed #a5be25;
        border-radius: 16px;
        padding: 18px;
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: space-between;
        min-height: 310px;
        transition: all 0.25s ease;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.03);
    }

    .doc-card.has-doc {
        border-style: solid;
        border-color: #e2e8f0;
        background: #ffffff;
        box-shadow: 0 4px 14px rgba(0, 0, 0, 0.05);
    }

    .doc-card:hover {
        border-color: #00662d;
        box-shadow: 0 6px 20px rgba(0, 102, 45, 0.09);
        transform: translateY(-2px);
    }

    .doc-card-header {
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 12px;
        gap: 8px;
    }

    .doc-slot-badge {
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        padding: 4px 10px;
        border-radius: 20px;
        letter-spacing: 0.4px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        max-width: 170px;
    }

    .doc-slot-badge.badge-primary-slot {
        background: #e9f5ee;
        color: #00662d;
    }

    .doc-slot-badge.badge-add-slot {
        background: #f4f9f6;
        color: #00662d;
    }

    .doc-status-badge-uploaded {
        background: #e9f5ee;
        color: #00662d;
        font-size: 11px;
        font-weight: 600;
        padding: 3px 8px;
        border-radius: 20px;
        border: 1px solid #bfe3cc;
        white-space: nowrap;
    }

    .doc-preview-area {
        width: 100%;
        height: 180px;
        border-radius: 12px;
        overflow: hidden;
        position: relative;
        background: #f8fafc;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        border: 1px solid #f1f5f9;
        transition: all 0.2s ease;
    }

    .doc-preview-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.3s ease;
    }

    .doc-preview-area:hover .doc-preview-img {
        transform: scale(1.04);
    }

    .doc-placeholder {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        padding: 16px;
        color: #626563;
        width: 100%;
    }

    .doc-placeholder i {
        font-size: 38px;
        color: #00662d;
        margin-bottom: 8px;
        transition: transform 0.25s ease, color 0.25s ease;
    }

    .doc-card:hover .doc-placeholder i {
        transform: translateY(-4px) scale(1.05);
        color: #00853b;
    }

    .doc-placeholder span {
        font-size: 13px;
        font-weight: 600;
        color: #1e293b;
    }

    .doc-placeholder small {
        font-size: 11px;
        color: #626563;
    }

    .doc-pdf-preview {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        color: #dc2626;
        gap: 6px;
        padding: 10px;
    }

    .doc-pdf-preview i {
        font-size: 46px;
    }

    .doc-card-actions {
        width: 100%;
        margin-top: 14px;
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .btn-doc-action {
        flex: 1;
        min-width: 0;
        font-size: 12px;
        font-weight: 600;
        padding: 8px 6px;
        border-radius: 8px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 4px;
        text-decoration: none;
        border: 1px solid transparent;
        transition: all 0.2s ease;
        white-space: nowrap;
        cursor: pointer;
    }

    .btn-doc-view {
        background-color: #f1f5f9;
        color: #334155;
        border-color: #cbd5e1;
    }

    .btn-doc-view:hover {
        background-color: #e2e8f0;
        color: #0f172a;
    }

    .btn-doc-crop {
        background-color: #e9f5ee;
        color: #00662d;
        border-color: #a8dfbc;
    }

    .btn-doc-crop:hover {
        background-color: #d5eedd;
        color: #004d22;
    }

    .btn-doc-delete {
        background-color: #fff1f2;
        color: #e11d48;
        border-color: #fecdd3;
    }

    .btn-doc-delete:hover {
        background-color: #ffe4e6;
        color: #be123c;
    }

    .btn-doc-upload-new {
        width: 100%;
        background-color: #00662d;
        color: #ffffff;
        font-weight: 600;
        font-size: 13px;
        padding: 10px 16px;
        border-radius: 50px;
        border: none;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        cursor: pointer;
        transition: all 0.3s ease;
        box-shadow: 0 4px 12px rgba(0, 102, 45, 0.18);
    }

    .btn-doc-upload-new:hover {
        background-color: #00853b;
        color: #ffffff;
        transform: translateY(-2px);
        box-shadow: 0 6px 16px rgba(0, 102, 45, 0.28);
    }

    /* Guidelines Card */
    .guidelines-card {
        background: #E9F5EE;
        border: 1.5px solid #d4ebdc;
        border-radius: 16px;
        padding: 20px 22px;
    }

    .guidelines-card h6 {
        font-weight: 700;
        color: #00662d;
        font-size: 15px;
        margin-bottom: 14px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .guidelines-list {
        list-style: none;
        padding-left: 0;
        margin-bottom: 0;
    }

    .guidelines-list li {
        position: relative;
        padding-left: 24px;
        margin-bottom: 9px;
        color: #475569;
        font-size: 13px;
        line-height: 1.55;
    }

    .guidelines-list li:last-child {
        margin-bottom: 0;
    }

    .guidelines-list li i {
        position: absolute;
        left: 0;
        top: 2px;
        color: #00662d;
        font-size: 15px;
    }

    /* Cropper Modal Overlay */
    .crop-modal-overlay {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.75);
        z-index: 99999;
        align-items: center;
        justify-content: center;
        padding: 16px;
        backdrop-filter: blur(4px);
        -webkit-backdrop-filter: blur(4px);
    }

    .crop-modal-overlay.active {
        display: flex;
    }

    .crop-modal-card {
        background: #ffffff;
        border-radius: 16px;
        max-width: 680px;
        width: 100%;
        max-height: 92vh;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.35);
        animation: modalFadeIn 0.25s ease-out;
    }

    @@keyframes modalFadeIn {
        from { opacity: 0; transform: scale(0.96) translateY(8px); }
        to { opacity: 1; transform: scale(1) translateY(0); }
    }

    .crop-modal-header {
        padding: 14px 18px;
        border-bottom: 1px solid #e2e8f0;
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: #f8fafc;
    }

    .crop-modal-header h5 {
        margin: 0;
        font-weight: 700;
        font-size: 15px;
        color: #0f172a;
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .crop-modal-body {
        padding: 12px;
        height: 48vh;
        max-height: 420px;
        min-height: 220px;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #0f172a;
        position: relative;
    }

    .crop-modal-body img {
        max-width: 100%;
        max-height: 100%;
        display: block;
    }

    .crop-modal-footer {
        padding: 14px 18px;
        border-top: 1px solid #e2e8f0;
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: #f8fafc;
        gap: 10px;
        flex-wrap: wrap;
    }

    .btn-crop-cancel {
        padding: 8px 16px;
        border-radius: 8px;
        border: 1px solid #cbd5e1;
        background: #ffffff;
        color: #475569;
        font-weight: 600;
        font-size: 13px;
        cursor: pointer;
        transition: all 0.2s ease;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 5px;
    }

    .btn-crop-cancel:hover {
        background: #f1f5f9;
        color: #0f172a;
    }

    .btn-crop-without {
        padding: 8px 14px;
        border-radius: 8px;
        border: 1px solid #a5be25;
        background: #fbfdf5;
        color: #4d5c0b;
        font-weight: 600;
        font-size: 13px;
        cursor: pointer;
        transition: all 0.2s ease;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 5px;
    }

    .btn-crop-without:hover {
        background: #f4f9e8;
        color: #3b4608;
    }

    .btn-crop-apply {
        padding: 8px 20px;
        border-radius: 8px;
        border: none;
        background: #00662d;
        color: #ffffff;
        font-weight: 600;
        font-size: 13px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        cursor: pointer;
        box-shadow: 0 4px 12px rgba(0, 102, 45, 0.2);
        transition: all 0.2s ease;
    }

    .btn-crop-apply:hover {
        background: #00853b;
        color: #ffffff;
        box-shadow: 0 6px 16px rgba(0, 102, 45, 0.3);
    }

    /* Mobile Responsive Optimizations */
    @@media (max-width: 576px) {
        .verification-page-container {
            padding: 16px 12px;
        }

        .verification-header-box {
            margin-bottom: 18px;
        }

        .verification-header-box h2 {
            font-size: 18px;
        }

        .verification-header-box p {
            font-size: 12.5px;
        }

        .status-hero-card {
            padding: 16px 14px;
            margin-bottom: 20px;
            border-radius: 14px;
        }

        .status-hero-card .hero-inner-wrapper {
            flex-direction: column;
            align-items: flex-start !important;
            gap: 12px;
        }

        .status-hero-card .hero-content-row {
            flex-direction: row;
            align-items: flex-start !important;
            gap: 10px;
            width: 100%;
        }

        .status-icon-box {
            width: 42px;
            height: 42px;
            min-width: 42px;
            font-size: 20px;
            border-radius: 10px;
        }

        .status-badge-custom {
            font-size: 11px;
            padding: 4px 8px;
        }

        .verified-pill {
            font-size: 12.5px;
            padding: 5px 12px;
            width: 100%;
            justify-content: center;
        }

        .doc-grid {
            grid-template-columns: 1fr;
            gap: 16px;
            margin-bottom: 22px;
        }

        .doc-card {
            min-height: auto;
            padding: 14px;
        }

        .doc-preview-area {
            height: 190px;
        }

        .doc-slot-badge {
            max-width: 140px;
        }

        .doc-card-actions {
            gap: 6px;
        }

        .btn-doc-action {
            font-size: 11.5px;
            padding: 7px 4px;
        }

        .guidelines-card {
            padding: 16px 14px;
            border-radius: 14px;
        }

        .guidelines-card h6 {
            font-size: 14px;
            margin-bottom: 10px;
        }

        .guidelines-list li {
            font-size: 12.5px;
            padding-left: 22px;
            margin-bottom: 8px;
        }

        .crop-modal-overlay {
            padding: 10px;
        }

        .crop-modal-card {
            max-height: 94vh;
            border-radius: 14px;
        }

        .crop-modal-header {
            padding: 12px 14px;
        }

        .crop-modal-header h5 {
            font-size: 14px;
        }

        .crop-modal-body {
            height: 42vh;
            max-height: 320px;
            min-height: 180px;
            padding: 8px;
        }

        .crop-modal-footer {
            padding: 12px 14px;
            flex-direction: column-reverse;
            gap: 8px;
        }

        .crop-modal-footer .modal-btn-group-right {
            width: 100%;
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 8px;
        }

        .crop-modal-footer .modal-btn-group-right .btn-crop-apply {
            grid-column: span 2;
            width: 100%;
            padding: 10px;
        }

        .btn-crop-cancel {
            width: 100%;
            padding: 9px;
        }
    }
</style>

<main class="flex-fill" style="min-width: 0;">
    <div class="verification-page-container">
        
        <!-- Header -->
        <div class="verification-header-box">
            <h2>
                <i class="uil uil-shield-check" style="color: #00662d;"></i> Profile Verification Documents
            </h2>
            <p>Upload your Government ID Proof or certificate to receive a verified badge and increase trust and responses from other members.</p>
        </div>

        <!-- Verification Status Hero Card -->
        @{
            var reg = Model.Registration;
            var isComplete = Model.DocumentVerificationComplete && Model.DocumentVerificationFollowupApproved;
            var isRejected = Model.DocumentVerificationRejected;
            var docsList = Model.Documents ?? new List<Domain.VerificationDocument>();
            var hasDocs = docsList.Count > 0;
            var isUnderReview = hasDocs && !isComplete && !isRejected;
        }

        <div class="status-hero-card @(isComplete ? "status-verified" : isRejected ? "status-rejected" : isUnderReview ? "status-review" : "status-pending")">
            <div class="d-flex align-items-center justify-content-between flex-wrap gap-3 hero-inner-wrapper">
                <div class="d-flex align-items-center gap-3 hero-content-row" style="min-width: 0; flex: 1;">
                    <div class="status-icon-box">
                        @if (isComplete)
                        {
                            <i class="uil uil-check-circle" style="color: #00662d;"></i>
                        }
                        else if (isRejected)
                        {
                            <i class="uil uil-exclamation-triangle" style="color: #E93B3B;"></i>
                        }
                        else if (isUnderReview)
                        {
                            <i class="uil uil-clock" style="color: #0284c7;"></i>
                        }
                        else
                        {
                            <i class="uil uil-file-shield-alt" style="color: #a5be25;"></i>
                        }
                    </div>
                    <div style="min-width: 0; flex: 1;">
                        <div class="d-flex align-items-center gap-2 flex-wrap">
                            <span class="fw-bold fs-6" style="color: #1e293b;">Verification Status:</span>
                            @if (isComplete)
                            {
                                <span class="status-badge-custom status-badge-verified"><i class="uil uil-check-circle"></i> Verified & Approved</span>
                            }
                            else if (isRejected)
                            {
                                <span class="status-badge-custom status-badge-rejected"><i class="uil uil-exclamation-circle"></i> Verification Rejected</span>
                            }
                            else if (isUnderReview)
                            {
                                <span class="status-badge-custom status-badge-review"><i class="uil uil-clock"></i> Documents Under Review</span>
                            }
                            else
                            {
                                <span class="status-badge-custom status-badge-pending"><i class="uil uil-info-circle"></i> Not Submitted</span>
                            }
                        </div>
                        <p class="mb-0 mt-1 font-size-13" style="color: #626563;">
                            @if (isComplete)
                            {
                                <span>Congratulations! Your profile identity has been verified and approved. The verified badge is active on your profile.</span>
                            }
                            else if (isRejected)
                            {
                                <span style="color: #E93B3B; font-weight: 500;">Your document verification was not accepted. Please re-upload clear and valid ID proof documents below.</span>
                            }
                            else if (isUnderReview)
                            {
                                <span>Your documents have been submitted and are currently being reviewed by the M4Nikkah team.</span>
                            }
                            else
                            {
                                <span>Upload your Government ID proof (Aadhaar, Passport, Driving License, Voter ID, etc.) below for profile verification.</span>
                            }
                        </p>
                    </div>
                </div>

                <!-- @if (isComplete)
                {
                    <div class="verified-pill">
                        <i class="uil uil-patch-check fs-5"></i> Verified Profile
                    </div>
                } -->
            </div>
        </div>

        <!-- Document Dynamic Grid -->
        <div class="doc-grid">

            <!-- Render All Uploaded Documents -->
            @for (int i = 0; i < docsList.Count; i++)
            {
                var doc = docsList[i];
                var isPdf = doc.DocumentUrl != null && doc.DocumentUrl.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase);
                var docTitle = !string.IsNullOrWhiteSpace(doc.OriginalFileName) ? doc.OriginalFileName : (!string.IsNullOrWhiteSpace(doc.DocumentType) ? doc.DocumentType : $"Document {i + 1}");

                <div class="doc-card has-doc" id="doc-card-@doc.Id">
                    <div class="doc-card-header">
                        <span class="doc-slot-badge badge-primary-slot" title="@docTitle"><i class="uil uil-file-bookmark-alt me-1"></i> @docTitle</span>
                        <span class="doc-status-badge-uploaded"><i class="uil uil-check"></i> Uploaded</span>
                    </div>

                    <div class="doc-preview-area">
                        @if (isPdf)
                        {
                            <a href="/@doc.DocumentUrl" target="_blank" class="text-decoration-none w-100 h-100 d-flex align-items-center justify-content-center">
                                <div class="doc-pdf-preview">
                                    <i class="uil uil-file-alt"></i>
                                    <span class="font-size-12 fw-semibold text-truncate px-2" style="max-width: 220px;">@(doc.OriginalFileName ?? "Document.pdf")</span>
                                </div>
                            </a>
                        }
                        else
                        {
                            <a href="/@doc.DocumentUrl" target="_blank" class="w-100 h-100">
                                <img src="/@doc.DocumentUrl" alt="@docTitle" class="doc-preview-img" id="img-preview-@doc.Id" />
                            </a>
                        }
                    </div>

                    <div class="doc-card-actions">
                        <a href="/@doc.DocumentUrl" target="_blank" class="btn-doc-action btn-doc-view" title="View Full Document">
                            <i class="uil uil-eye"></i> View
                        </a>
                        @if (!isPdf)
                        {
                            <button type="button" class="btn-doc-action btn-doc-crop" onclick="openExistingCropModal('/@doc.DocumentUrl', @doc.Id)" title="Crop & Adjust Image">
                                <i class="uil uil-crop-alt"></i> Crop
                            </button>
                        }
                        <button type="button" class="btn-doc-action btn-doc-delete" onclick="deleteDocument(@doc.Id, '@docTitle')" title="Delete Document">
                            <i class="uil uil-trash-alt"></i> Delete
                        </button>
                    </div>
                </div>
            }

            <!-- Upload Slot: Initial Slot or 'Add Another Document' Slot -->
            @if (docsList.Count < 5)
            {
                var nextDocIndex = docsList.Count + 1;
                <div class="doc-card" id="slot-upload-new">
                    <div class="doc-card-header">
                        <span class="doc-slot-badge @(docsList.Count == 0 ? "badge-primary-slot" : "badge-add-slot")">
                            <i class="uil @(docsList.Count == 0 ? "uil-upload" : "uil-plus-circle") me-1"></i> Document @nextDocIndex
                        </span>
                    </div>

                    <div class="doc-preview-area" onclick="triggerUpload()">
                        <div class="doc-placeholder">
                            <i class="uil @(docsList.Count == 0 ? "uil-cloud-upload" : "uil-plus-circle")"></i>
                            <span>@(docsList.Count == 0 ? "Upload ID Proof / Document" : "Upload Another Document")</span>
                            <small class="mt-1">JPG, PNG, WEBP, PDF (Max 10MB)</small>
                        </div>
                    </div>

                    <div class="doc-card-actions">
                        <button type="button" class="btn-doc-upload-new" onclick="triggerUpload()">
                            <i class="uil @(docsList.Count == 0 ? "uil-upload" : "uil-plus")"></i> @(docsList.Count == 0 ? "Upload Document" : "Add Document")
                        </button>
                    </div>
                </div>
            }

        </div>

        <!-- Guidelines Card -->
        <div class="guidelines-card">
            <h6><i class="uil uil-shield-question" style="color: #00662d;"></i> Verification Guidelines</h6>
            <ul class="guidelines-list">
                <li><i class="uil uil-check-circle"></i><strong>Accepted Documents:</strong> Government ID Proof (Aadhaar Card, Passport, Driving License, Voter ID, PAN Card) or educational certificates.</li>
                <li><i class="uil uil-check-circle"></i><strong>Image Clarity:</strong> Ensure your document is clearly legible, with name, date of birth, and photo distinctly visible.</li>
                <li><i class="uil uil-check-circle"></i><strong>Multiple Documents:</strong> You can upload additional documents (e.g. back side of ID proof or additional certificate) by clicking <em>Add Document</em>.</li>
                <li><i class="uil uil-check-circle"></i><strong>Crop & Adjust:</strong> For image files, you can rotate and crop framing as needed using our built-in image editor.</li>
                <li><i class="uil uil-check-circle"></i><strong>Supported Formats:</strong> JPG, PNG, WEBP, and PDF files up to 10MB per file.</li>
            </ul>
        </div>

    </div>
</main>

<!-- Hidden File Input -->
<input type="file" id="hiddenFileInput" accept=".pdf,.jpg,.jpeg,.png,.webp" style="display: none;" />

<!-- Image Crop Modal -->
<div id="cropModal" class="crop-modal-overlay">
    <div class="crop-modal-card">
        <div class="crop-modal-header">
            <h5><i class="uil uil-crop-alt me-1" style="color: #00662d;"></i> Crop & Adjust Document Image</h5>
            <button type="button" class="btn-close" onclick="closeCropModal()"></button>
        </div>
        <div class="crop-modal-body">
            <img id="cropTargetImage" src="" alt="Crop Target" />
        </div>
        <div class="crop-modal-footer">
            <button type="button" class="btn-crop-cancel" onclick="closeCropModal()">Cancel</button>
            <div class="modal-btn-group-right d-flex gap-2 align-items-center">
                <button type="button" class="btn-crop-cancel" onclick="rotateCropper(-90)" title="Rotate Left">
                    <i class="uil uil-corner-up-left"></i> Rotate
                </button>
                <button type="button" id="btnUploadWithoutCrop" class="btn-crop-without" style="display:none;" onclick="uploadOriginalFileDirectly()">
                    Upload Without Crop
                </button>
                <button type="button" class="btn-crop-apply" onclick="applyCrop()">
                    <i class="uil uil-check"></i> <span id="cropApplyBtnText">Save & Upload</span>
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.2/cropper.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        let cropperInstance = null;
        let activeCropMode = 'new'; // 'new' or 'existing'
        let activeExistingDocId = null;
        let pendingRawFile = null;

        // Trigger hidden file input
        function triggerUpload() {
            const fileInput = document.getElementById('hiddenFileInput');
            fileInput.value = '';
            fileInput.click();
        }

        // File selection handler
        document.getElementById('hiddenFileInput').addEventListener('change', function (e) {
            const file = e.target.files[0];
            if (!file) return;

            // Validate file size (10MB max)
            if (file.size > 10 * 1024 * 1024) {
                Swal.fire({
                    icon: 'error',
                    title: 'File Too Large',
                    text: 'The selected file exceeds the 10MB size limit. Please choose a smaller file.',
                    confirmButtonColor: '#00662d'
                });
                return;
            }

            const fileName = file.name.toLowerCase();
            const isPdf = fileName.endsWith('.pdf');

            if (isPdf) {
                // PDF cannot be cropped; upload directly
                uploadDocumentFile(file);
            } else {
                // For images, open cropper modal so user can adjust/crop before upload
                pendingRawFile = file;
                const reader = new FileReader();
                reader.onload = function (evt) {
                    openNewCropModal(evt.target.result);
                };
                reader.readAsDataURL(file);
            }
        });

        // Open Cropper for NEW file upload
        function openNewCropModal(dataUrl) {
            activeCropMode = 'new';
            activeExistingDocId = null;
            document.getElementById('cropApplyBtnText').innerText = 'Save & Upload';
            document.getElementById('btnUploadWithoutCrop').style.display = 'inline-flex';

            setupCropperModal(dataUrl);
        }

        // Open Cropper for EXISTING uploaded document
        function openExistingCropModal(imageUrl, docId) {
            activeCropMode = 'existing';
            activeExistingDocId = docId;
            pendingRawFile = null;
            document.getElementById('cropApplyBtnText').innerText = 'Save Crop';
            document.getElementById('btnUploadWithoutCrop').style.display = 'none';

            setupCropperModal(imageUrl);
        }

        function setupCropperModal(srcUrl) {
            const modal = document.getElementById('cropModal');
            const targetImg = document.getElementById('cropTargetImage');

            targetImg.src = srcUrl;
            modal.classList.add('active');

            if (cropperInstance) {
                cropperInstance.destroy();
                cropperInstance = null;
            }

            // Init Cropper with freeform/flexible aspect ratio (not fixed) for ID card / certificates
            setTimeout(() => {
                cropperInstance = new Cropper(targetImg, {
                    viewMode: 2,
                    dragMode: 'move',
                    autoCropArea: 1,
                    restore: false,
                    guides: true,
                    center: true,
                    highlight: false,
                    cropBoxMovable: true,
                    cropBoxResizable: true,
                    toggleDragModeOnDblclick: false
                });
            }, 200);
        }

        function closeCropModal() {
            const modal = document.getElementById('cropModal');
            modal.classList.remove('active');
            if (cropperInstance) {
                cropperInstance.destroy();
                cropperInstance = null;
            }
            pendingRawFile = null;
        }

        function rotateCropper(degree) {
            if (cropperInstance) {
                cropperInstance.rotate(degree);
            }
        }

        // Upload original file directly without crop
        function uploadOriginalFileDirectly() {
            if (pendingRawFile) {
                const fileToUpload = pendingRawFile;
                closeCropModal();
                uploadDocumentFile(fileToUpload);
            }
        }

        // Apply Cropped Image
        function applyCrop() {
            if (!cropperInstance) return;

            const canvas = cropperInstance.getCroppedCanvas({
                maxWidth: 2000,
                maxHeight: 2000,
                fillColor: '#fff',
                imageSmoothingEnabled: true,
                imageSmoothingQuality: 'high'
            });

            if (!canvas) {
                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: 'Could not crop the image.',
                    confirmButtonColor: '#00662d'
                });
                return;
            }

            canvas.toBlob(function (blob) {
                if (!blob) {
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: 'Failed to generate cropped image.',
                        confirmButtonColor: '#00662d'
                    });
                    return;
                }

                if (activeCropMode === 'new') {
                    // Upload new cropped document
                    const fileName = (pendingRawFile && pendingRawFile.name) ? pendingRawFile.name : 'document.jpg';
                    const croppedFile = new File([blob], fileName, { type: 'image/jpeg' });
                    closeCropModal();
                    uploadDocumentFile(croppedFile);
                } else if (activeCropMode === 'existing' && activeExistingDocId) {
                    // Update existing cropped document
                    closeCropModal();
                    saveExistingCrop(blob, activeExistingDocId);
                }
            }, 'image/jpeg', 0.92);
        }

        // Async Document Upload
        function uploadDocumentFile(file) {
            const formData = new FormData();
            formData.append('verificationDocument', file);

            Swal.fire({
                title: 'Uploading...',
                text: 'Please wait while your document is being uploaded.',
                allowOutsideClick: false,
                didOpen: () => Swal.showLoading()
            });

            fetch('/User/UploadVerificationDocument', {
                method: 'POST',
                body: formData
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    Swal.fire({
                        icon: 'success',
                        title: 'Uploaded Successfully!',
                        text: data.message || 'Document uploaded successfully.',
                        timer: 1600,
                        showConfirmButton: false
                    }).then(() => {
                        window.location.reload();
                    });
                } else {
                    Swal.fire({
                        icon: 'error',
                        title: 'Upload Failed',
                        text: data.message || 'Failed to upload document. Please try again.',
                        confirmButtonColor: '#00662d'
                    });
                }
            })
            .catch(err => {
                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: 'An unexpected error occurred during upload.',
                    confirmButtonColor: '#00662d'
                });
            });
        }

        // Save existing document crop
        function saveExistingCrop(blob, docId) {
            const formData = new FormData();
            formData.append('croppedImage', blob, 'cropped_doc_' + docId + '.jpg');
            formData.append('documentId', docId);

            Swal.fire({
                title: 'Saving Cropped Image...',
                allowOutsideClick: false,
                didOpen: () => Swal.showLoading()
            });

            fetch('/User/SaveCroppedVerificationDocument', {
                method: 'POST',
                body: formData
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    Swal.fire({
                        icon: 'success',
                        title: 'Cropped & Saved!',
                        text: data.message,
                        timer: 1600,
                        showConfirmButton: false
                    }).then(() => {
                        window.location.reload();
                    });
                } else {
                    Swal.fire({
                        icon: 'error',
                        title: 'Failed to Save Crop',
                        text: data.message,
                        confirmButtonColor: '#00662d'
                    });
                }
            })
            .catch(err => {
                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: 'An error occurred while saving cropped document.',
                    confirmButtonColor: '#00662d'
                });
            });
        }

        // Delete Document Handler
        function deleteDocument(docId, docTitle) {
            Swal.fire({
                title: 'Delete Document?',
                text: `Are you sure you want to delete ${docTitle}?`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#E93B3B',
                cancelButtonColor: '#626563',
                confirmButtonText: 'Yes, Delete',
                cancelButtonText: 'Cancel'
            }).then((result) => {
                if (result.isConfirmed) {
                    Swal.fire({
                        title: 'Deleting...',
                        allowOutsideClick: false,
                        didOpen: () => Swal.showLoading()
                    });

                    fetch('/User/DeleteVerificationDocument', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({ documentId: docId })
                    })
                    .then(res => res.json())
                    .then(data => {
                        if (data.success) {
                            Swal.fire({
                                icon: 'success',
                                title: 'Deleted!',
                                text: data.message,
                                timer: 1500,
                                showConfirmButton: false
                            }).then(() => {
                                window.location.reload();
                            });
                        } else {
                            Swal.fire({
                                icon: 'error',
                                title: 'Delete Failed',
                                text: data.message,
                                confirmButtonColor: '#00662d'
                            });
                        }
                    })
                    .catch(err => {
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: 'An unexpected error occurred while deleting.',
                            confirmButtonColor: '#00662d'
                        });
                    });
                }
            });
        }
    </script>
}

