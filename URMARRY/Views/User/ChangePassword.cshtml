            </main>

    <!-- Delete Account Confirmation Modal -->
    <div id="deleteAccountModal" class="upgrade-modal-overlay" onclick="if(event.target === this) hideDeleteAccountModal()">
        <div class="upgrade-modal-card" style="max-width: 450px;">
            <div class="modal-close-btn" onclick="hideDeleteAccountModal()">
                <i class="uil uil-times"></i>
            </div>
            <div class="modal-body-scroll" style="padding: 40px 20px;">
                <div class="mb-3">
                    <div class="icon-circle shadow-sm"
                        style="background-color: #E93B3B; color: white; width: 60px; height: 60px; font-size: 24px; margin: 0 auto; display: flex; align-items: center; justify-content: center; border-radius: 50%;">
                        <i class="uil uil-trash-alt" style="font-size: 24px; width: 24px; height: 24px; display: inline-block; line-height: 1;"></i>
                    </div>
                </div>
                <h5 class="fw-medium fs-18 mb-2 px-3 text-center" style="color: #000; line-height: 1.4;">
                    Are you sure you want to delete your account?
                </h5>
                <p class="text-muted fs-14 mb-4 px-3 text-center">
                    This action cannot be undone.
                </p>
                <div class="d-flex justify-content-center gap-3 w-100 px-4 mb-2">
                    <button class="btn btn-upgrade-now shadow-none flex-fill"
                        style="margin-top: 0; background-color: #00662d !important;"
                        onclick="hideDeleteAccountModal()">Cancel</button>
                    <button class="btn btn-upgrade-now shadow-none flex-fill"
                        style="margin-top: 0; background-color: #E93B3B !important;"
                        onclick="handleDeleteAccount()">Delete</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Delete Account - Step 2: Select Delete Reason Modal -->
    <div id="deleteReasonModal" class="upgrade-modal-overlay" onclick="if(event.target === this) hideDeleteReasonModal()">
        <div class="upgrade-modal-card" style="max-width: 480px; border-radius: 16px;">
            <div class="modal-close-btn" onclick="hideDeleteReasonModal()">
                <i class="uil uil-times"></i>
            </div>
            <div class="modal-body-scroll" style="padding: 30px 20px;">
                <div class="text-center mb-4">
                    <div style="font-size: 3rem; color: #ff9f43;">❓</div>
                    <h4 class="fw-semibold mt-2" style="color: #111;">Reason for deleting</h4>
                    <p class="text-muted fs-14">Please tell us why you are deleting your account. This helps us improve our service.</p>
                </div>
                <div id="deleteReasonsList" class="mb-4" style="max-height: 250px; overflow-y: auto; text-align: left;">
                    <!-- Reasons will be loaded dynamically here -->
                    <div class="text-center py-3">
                        <span class="text-muted"><i class="mdi mdi-loading mdi-spin fs-4 align-middle"></i> Loading reasons...</span>
                    </div>
                </div>
                <div class="d-flex gap-3 mt-4">
                    <button type="button" class="btn btn-upgrade-now shadow-none flex-fill" style="margin-top: 0; background-color: #00662d !important; border-radius: 8px;" onclick="handleReasonSubmit()">Next</button>
                    <button type="button" class="btn btn-upgrade-now shadow-none flex-fill" style="margin-top: 0; background-color: #777 !important; border-radius: 8px;" onclick="hideDeleteReasonModal()">Cancel</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Delete Account - Step 3: Choose Partner Modal -->
    <div id="deletePartnerModal" class="upgrade-modal-overlay" onclick="if(event.target === this) hideDeletePartnerModal()">
        <div class="upgrade-modal-card" style="max-width: 500px; border-radius: 16px;">
            <div class="modal-close-btn" onclick="hideDeletePartnerModal()">
                <i class="uil uil-times"></i>
            </div>
            <div class="modal-body-scroll" style="padding: 30px 20px;">
                <div class="text-center mb-4">
                    <div style="font-size: 3rem; color: #ff3a6f;">💑</div>
                    <h4 class="fw-semibold mt-2" style="color: #111;">Select Your Spouse</h4>
                    <p class="text-muted fs-14">Who is the partner you found? We'd love to associate your success story with them.</p>
                </div>
                <div id="deletePartnersList" class="mb-4" style="max-height: 250px; overflow-y: auto; text-align: left;">
                    <!-- Partners will be loaded dynamically here -->
                    <div class="text-center py-3">
                        <span class="text-muted"><i class="mdi mdi-loading mdi-spin fs-4 align-middle"></i> Loading partners...</span>
                    </div>
                </div>
                <div class="d-flex gap-3 mt-4">
                    <button type="button" class="btn btn-upgrade-now shadow-none flex-fill" style="margin-top: 0; background-color: #00662d !important; border-radius: 8px;" onclick="handlePartnerSubmit()">Next</button>
                    <button type="button" class="btn btn-upgrade-now shadow-none flex-fill" style="margin-top: 0; background-color: #777 !important; border-radius: 8px;" onclick="hideDeletePartnerModal()">Cancel</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Delete Account - Step 4: Testimonial Story Modal -->
    <div id="deleteTestimonialModal" class="upgrade-modal-overlay" onclick="if(event.target === this) hideDeleteTestimonialModal()">
        <div class="upgrade-modal-card" style="max-width: 550px; border-radius: 16px;">
            <div class="modal-close-btn" onclick="hideDeleteTestimonialModal()">
                <i class="uil uil-times"></i>
            </div>
            <div class="modal-body-scroll" style="padding: 25px 20px; max-height: 80vh; overflow-y: auto; text-align: left;">
                <div class="text-center mb-3">
                    <div style="font-size: 2.5rem; color: #ffb400;">💖</div>
                    <h4 class="fw-semibold mt-1" style="color: #111;">Share Your Success Story!</h4>
                    <p class="text-muted fs-13">Alhamdulillah! We are thrilled to hear you found your partner. Share your story to inspire others!</p>
                </div>
                
                <form id="deleteTestimonialForm" onsubmit="event.preventDefault(); submitDeleteWithStory();" enctype="multipart/form-data">
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-medium text-dark mb-1" style="font-size: 13px;">Groom's Display Name *</label>
                            <input type="text" class="form-control rounded-3" id="delGroomNameInput" name="GroomDisplayName" required placeholder="e.g. Ibrahim" style="font-size: 13px; padding: 10px;" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-medium text-dark mb-1" style="font-size: 13px;">Bride's Display Name *</label>
                            <input type="text" class="form-control rounded-3" id="delBrideNameInput" name="BrideDisplayName" required placeholder="e.g. Mariam" style="font-size: 13px; padding: 10px;" />
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-medium text-dark mb-1" style="font-size: 13px;">Marriage Date *</label>
                            <input type="date" class="form-control rounded-3" id="delMarriageDateInput" name="MarriageDate" required style="font-size: 13px; padding: 8px 10px;" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-medium text-dark mb-1" style="font-size: 13px;">Rate Your Experience *</label>
                            <div class="d-flex align-items-center gap-1 mt-1" id="delStarRatingContainer" style="font-size: 1.5rem; color: #ccc; cursor: pointer;">
                                <span class="del-star-item active" data-rating="1" onclick="setDelRating(1)">★</span>
                                <span class="del-star-item active" data-rating="2" onclick="setDelRating(2)">★</span>
                                <span class="del-star-item active" data-rating="3" onclick="setDelRating(3)">★</span>
                                <span class="del-star-item active" data-rating="4" onclick="setDelRating(4)">★</span>
                                <span class="del-star-item active" data-rating="5" onclick="setDelRating(5)">★</span>
                            </div>
                            <input type="hidden" id="delRatingInput" name="Rating" value="5" required />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-medium text-dark mb-1" style="font-size: 13px;">Your Success Story / Feedback *</label>
                        <textarea class="form-control rounded-3" id="delStoryTextInput" name="Story" rows="4" required placeholder="Tell us how you connected, your experience on M4Nikkah, and your blessings..." style="font-size: 13px; padding: 10px; resize: none;"></textarea>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-medium text-dark mb-1" style="font-size: 13px;">Upload Couple Photo (Optional)</label>
                        <input type="file" class="form-control rounded-3" id="delCouplePhotoInput" name="CouplePhoto" accept="image/*" style="font-size: 13px; padding: 8px;" />
                        <div class="form-text text-muted" style="font-size: 11px;">Recommended dimensions: 630×800px. Max size: 2MB.</div>
                    </div>

                    <div class="mb-3 form-check text-start">
                        <input type="checkbox" class="form-check-input" id="delConsentCheck" name="ConsentToPublish" required checked style="cursor: pointer;" />
                        <label class="form-check-label fs-12 text-muted" for="delConsentCheck" style="cursor: pointer;">I agree to publish our success story on M4Nikkah website.</label>
                    </div>

                    <div class="mb-4 form-check text-start">
                        <input type="checkbox" class="form-check-input" id="delPrivacyCheck" name="HideFullName" style="cursor: pointer;" />
                        <label class="form-check-label fs-12 text-muted" for="delPrivacyCheck" style="cursor: pointer;">Privacy option: Hide full names (show only initials, e.g. I. &amp; M.)</label>
                    </div>

                    <div class="d-flex gap-3">
                        <button type="submit" id="btnSubmitDelStory" class="btn btn-upgrade-now shadow-none flex-fill" style="margin-top: 0; background-color: #00662d !important; border-radius: 8px;">Submit &amp; Delete Account</button>
                        <button type="button" class="btn btn-upgrade-now shadow-none flex-fill" style="margin-top: 0; background-color: #777 !important; border-radius: 8px;" onclick="hideDeleteTestimonialModal()">Cancel</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    @section Scripts{
        <script>
        // Toggle password logic
        document.querySelectorAll(".toggle-password").forEach(function (icon) {
            icon.addEventListener("click", function () {
                const input = this.parentElement.querySelector("input");
                if (input.type === "password") {
                    input.type = "text";
                    this.classList.remove("uil-eye-slash");
                    this.classList.add("uil-eye");
                } else {
                    input.type = "password";
                    this.classList.remove("uil-eye");
                    this.classList.add("uil-eye-slash");
                }
            });
        });

        // Account deletion dynamic flow
        const loggedInUserId = @(Model.Registration?.Id ?? 0);
        const loggedInUserGender = "@Html.Raw(Model.Registration?.Gender ?? "")";
        const loggedInUserName = "@Html.Raw(Model.Registration?.Name ?? "")";

        let deleteReasons = [];
        let selectedReason = null;
        let partners = [];
        let selectedPartnerId = null;
        let selectedRating = 5;

        window.handleDeleteAccount = function() {
            hideDeleteAccountModal();
            showDeleteReasonModal();
        };

        window.showDeleteReasonModal = function() {
            document.getElementById("deleteReasonModal").classList.add("active");
            document.body.style.overflow = "hidden";
            loadDeleteReasons();
        };

        window.hideDeleteReasonModal = function() {
            document.getElementById("deleteReasonModal").classList.remove("active");
            document.body.style.overflow = "auto";
        };

        window.showDeletePartnerModal = function() {
            document.getElementById("deletePartnerModal").classList.add("active");
            document.body.style.overflow = "hidden";
            loadPartners();
        };

        window.hideDeletePartnerModal = function() {
            document.getElementById("deletePartnerModal").classList.remove("active");
            document.body.style.overflow = "auto";
        };

        window.showDeleteTestimonialModal = function() {
            const groomInput = document.getElementById("delGroomNameInput");
            const brideInput = document.getElementById("delBrideNameInput");

            const partnerObj = partners.find(p => p.id == selectedPartnerId);
            const spouseName = partnerObj ? partnerObj.name : "";

            if (loggedInUserGender === "Female") {
                if (brideInput) brideInput.value = loggedInUserName;
                if (groomInput) groomInput.value = spouseName;
            } else {
                if (groomInput) groomInput.value = loggedInUserName;
                if (brideInput) brideInput.value = spouseName;
            }

            // Default marriage date to today
            const marriageDateInput = document.getElementById("delMarriageDateInput");
            if (marriageDateInput && !marriageDateInput.value) {
                marriageDateInput.value = new Date().toISOString().split('T')[0];
            }

            document.getElementById("deleteTestimonialModal").classList.add("active");
            document.body.style.overflow = "hidden";
        };

        window.hideDeleteTestimonialModal = function() {
            document.getElementById("deleteTestimonialModal").classList.remove("active");
            document.body.style.overflow = "auto";
        };

        async function loadDeleteReasons() {
            try {
                const response = await fetch("/api/delete-account/reasons");
                const data = await response.json();
                if (data.success) {
                    deleteReasons = data.reasons;
                    const container = document.getElementById("deleteReasonsList");
                    container.innerHTML = "";

                    deleteReasons.forEach(r => {
                        const div = document.createElement("div");
                        div.className = "reason-option";
                        div.onclick = () => {
                            const radio = document.getElementById(`reason_${r.id}`);
                            if (radio) radio.checked = true;
                            selectedReason = r;
                        };
                        div.innerHTML = `
                            <input type="radio" name="delete_reason" id="reason_${r.id}" value="${r.id}">
                            <label style="cursor:pointer; margin-bottom:0; font-weight: 500;" for="reason_${r.id}">${r.reason}</label>
                        `;
                        container.appendChild(div);
                    });
                } else {
                    document.getElementById("deleteReasonsList").innerHTML = `<div class="text-danger text-center">Failed to load reasons.</div>`;
                }
            } catch (err) {
                console.error(err);
                document.getElementById("deleteReasonsList").innerHTML = `<div class="text-danger text-center">An error occurred loading reasons.</div>`;
            }
        }

        window.handleReasonSubmit = function() {
            const checkedRadio = document.querySelector('input[name="delete_reason"]:checked');
            if (!checkedRadio) {
                alert("Please select a reason for deleting your account.");
                return;
            }
            const reasonId = checkedRadio.value;
            selectedReason = deleteReasons.find(r => r.id == reasonId);

            hideDeleteReasonModal();

            if (selectedReason.showTestimonialPrompt) {
                showDeletePartnerModal();
            } else {
                if (confirm("Are you sure you want to permanently delete your account?")) {
                    submitDeleteAccountOnly(reasonId);
                }
            }
        };

        async function submitDeleteAccountOnly(reasonId) {
            try {
                const formData = new FormData();
                formData.append("userId", loggedInUserId);
                formData.append("deleteReasonId", reasonId);

                const response = await fetch("/api/delete-account/submit", {
                    method: "POST",
                    body: formData
                });
                const data = await response.json();
                if (response.ok && data.success) {
                    alert(data.message);
                    window.location.href = "/user/login";
                } else {
                    let errMsg = data.message;
                    if (!errMsg && data.errors) {
                        errMsg = Object.values(data.errors).flat().join("\n");
                    }
                    alert(errMsg || "Deactivation failed.");
                }
            } catch (err) {
                console.error(err);
                alert("An error occurred during deactivation.");
            }
        }

        async function loadPartners() {
            try {
                const response = await fetch(`/api/delete-account/partners?userId=${loggedInUserId}`);
                const data = await response.json();
                if (data.success) {
                    partners = data.partners;
                    const container = document.getElementById("deletePartnersList");
                    container.innerHTML = "";

                    if (partners.length === 0) {
                        container.innerHTML = `<div class="text-muted text-center py-3">No accepted interest matches found. Click Next to write your testimonial.</div>`;
                        selectedPartnerId = null;
                        return;
                    }

                    partners.forEach(p => {
                        const img = p.imagePath ? '/' + p.imagePath : (p.gender === 'Female' ? '/assets/images/default-user-women.png' : '/assets/images/default-user-men.png');
                        const div = document.createElement("div");
                        div.className = "partner-option-card";
                        div.id = `partner_card_${p.id}`;
                        div.onclick = () => {
                            document.querySelectorAll(".partner-option-card").forEach(c => c.classList.remove("selected"));
                            div.classList.add("selected");
                            selectedPartnerId = p.id;
                        };
                        div.innerHTML = `
                            <img src="${img}" class="partner-avatar" alt="${p.name}">
                            <div>
                                <h6 class="mb-0 fw-semibold">${p.name}</h6>
                                <span class="text-muted small">${p.registerNumber}</span>
                            </div>
                        `;
                        container.appendChild(div);
                    });
                } else {
                    document.getElementById("deletePartnersList").innerHTML = `<div class="text-danger text-center">Failed to load partners.</div>`;
                }
            } catch (err) {
                console.error(err);
                document.getElementById("deletePartnersList").innerHTML = `<div class="text-danger text-center">An error occurred loading partners.</div>`;
            }
        }

        window.handlePartnerSubmit = function() {
            if (partners.length > 0 && !selectedPartnerId) {
                alert("Please select your partner to proceed.");
                return;
            }
            hideDeletePartnerModal();
            showDeleteTestimonialModal();
        };

        window.setDelRating = function(rating) {
            selectedRating = rating;
            const ratingInput = document.getElementById("delRatingInput");
            if (ratingInput) ratingInput.value = rating;
            
            document.querySelectorAll(".del-star-item").forEach((star, idx) => {
                if (idx < rating) {
                    star.classList.add("active");
                } else {
                    star.classList.remove("active");
                }
            });
        };

        window.submitDeleteWithStory = function() {
            const form = document.getElementById("deleteTestimonialForm");
            if (!form.checkValidity()) {
                form.reportValidity();
                return;
            }

            const formData = new FormData(form);
            formData.append("userId", loggedInUserId);
            formData.append("deleteReasonId", selectedReason.id);
            if (selectedPartnerId) {
                formData.append("partnerUserId", selectedPartnerId);
            }

            // Explicitly set boolean fields so ASP.NET Core binds them correctly!
            formData.set("ConsentToPublish", document.getElementById("delConsentCheck").checked ? "true" : "false");
            formData.set("HideFullName", document.getElementById("delPrivacyCheck").checked ? "true" : "false");

            const btn = document.getElementById("btnSubmitDelStory");
            btn.disabled = true;
            btn.innerText = "Processing...";

            fetch("/api/delete-account/submit", {
                method: "POST",
                body: formData
            })
            .then(async res => {
                const data = await res.json();
                if (res.ok && data.success) {
                    hideDeleteTestimonialModal();
                    alert(data.message);
                    window.location.href = "/user/login";
                } else {
                    let errMsg = data.message;
                    if (!errMsg && data.errors) {
                        errMsg = Object.values(data.errors).flat().join("\n");
                    }
                    if (!errMsg) {
                        errMsg = data.title || "Failed to submit story & delete account.";
                    }
                    alert(errMsg);
                    btn.disabled = false;
                    btn.innerText = "Submit & Delete Account";
                }
            })
            .catch(err => {
                console.error(err);
                alert("An error occurred during submission.");
                btn.disabled = false;
                btn.innerText = "Submit & Delete Account";
            });
        };
        </script>
    }