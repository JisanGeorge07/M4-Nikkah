@model ChangePasswordViewModel

@{
    Layout = "/Views/Shared/_LayoutAccount.cshtml";
}
<style>
.settings-icon {
    top: 50%;
    right: 18px;
    transform: translateY(-50%);
    font-size: 20px;
    color: #888;
    z-index: 10;
}

.custom-error-message {
    color: #dc3545;
    font-size: 13px;
    margin-top: 6px;
    display: block;
    padding-left: 4px;
}

.password-alert {
    background: #ffe5e5;
    color: #d62828;
    border: 1px solid #ffb3b3;
    border-radius: 10px;
    padding: 12px 15px;
    margin-bottom: 20px;
    font-size: 14px;
    font-weight: 500;
}
.del-star-item {
    transition: color 0.15s ease, transform 0.15s ease;
}
.del-star-item:hover {
    transform: scale(1.25);
}
.del-star-item.active {
    color: #ffb400;
}
.reason-option {
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 12px 16px;
    margin-bottom: 10px;
    cursor: pointer;
    transition: all 0.2s ease;
    display: flex;
    align-items: center;
    background-color: #fff;
}
.reason-option:hover {
    border-color: #a5be25;
    background-color: #f8fafc;
}
.reason-option input[type="radio"] {
    margin-right: 12px;
    accent-color: #00662d;
    width: 18px;
    height: 18px;
    cursor: pointer;
}
.partner-option-card {
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding: 10px;
    margin-bottom: 10px;
    cursor: pointer;
    transition: all 0.2s ease;
    display: flex;
    align-items: center;
    background-color: #fff;
}
.partner-option-card:hover, .partner-option-card.selected {
    border-color: #00662d;
    background-color: #e9f5ee;
}
.partner-avatar {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    object-fit: cover;
    margin-right: 12px;
}
</style>
