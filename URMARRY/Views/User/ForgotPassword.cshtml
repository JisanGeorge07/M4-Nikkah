@{
    Layout = null;
}

<!doctype html>
<html lang="en" dir="ltr">
<head>
    <meta charset="utf-8">
    <title>M4NIKAH - Recover Your Password</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="M4NIKAH - Recover Your Password">

    <!-- favicon -->
    <link rel="shortcut icon" href="/assets/images/favicon.png">

    <!-- Css -->
    <link href="/assets/css/bootstrap.min.css" id="bootstrap-style" class="theme-opt" rel="stylesheet" type="text/css">
    <!-- Icons Css -->
    <link href="/assets/libs/%40mdi/font/css/materialdesignicons.min.css" rel="stylesheet" type="text/css">
    <link href="/assets/libs/%40iconscout/unicons/css/line.css" type="text/css" rel="stylesheet">
    <!-- Style Css-->
    <link href="/assets/css/style.min.css" id="color-opt" class="theme-opt" rel="stylesheet" type="text/css">

    <style>
        .nav-pills .nav-link {
            color: #989898;
            font-weight: 600;
            font-size: 14px;
            transition: all 0.3s ease;
            border-radius: 30px;
            padding: 8px 25px;
            background-color: #f8f9fa;
            border: 1px solid #e9ecef;
        }
        .nav-pills .nav-link.active {
            background-color: #00662d !important;
            color: white !important;
            border-color: #00662d;
        }
        .otp-container {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 8px;
            flex-wrap: nowrap !important;
            margin-top: 15px;
            margin-bottom: 20px;
        }
        .otp-input {
            width: 45px;
            height: 45px;
            text-align: center;
            font-size: 20px;
            font-weight: 600;
            border: 1.5px solid #dce8e3;
            border-radius: 8px;
            background-color: #e7efec;
            color: #00662d;
            outline: none;
            transition: all 0.2s ease;
            margin: 0 !important;
            padding: 0;
            -webkit-appearance: none;
            appearance: none;
            -moz-appearance: textfield;
        }
        .otp-input::-webkit-outer-spin-button,
        .otp-input::-webkit-inner-spin-button {
            -webkit-appearance: none;
            margin: 0;
        }
        .otp-input:focus {
            border-color: #a5be25;
            background-color: #ffffff;
            box-shadow: 0 0 0 3px rgba(165, 190, 37, 0.25);
        }
        @@media (max-width: 480px) {
            .otp-container {
                gap: 5px;
            }
            .otp-input {
                width: 35px;
                height: 35px;
                font-size: 16px;
            }
        }
    </style>
</head>

<body>
    <div class="back-to-home">
        <a asp-action="Login" asp-controller="User" class="back-button btn btn-icon btn-primary"><i data-feather="arrow-left" class="icons"></i></a>
    </div>

    <!-- Hero Start -->
    <section class="position-relative" style="background: url('/assets/images/login_bg.jpg') center;">
        <div class="bg-overlay bg-linear-gradient-2"></div>
        <div class="container-fluid">
            <div class="row">
                <div class="col-12 p-0">
                    <div class="d-flex flex-column min-vh-100 p-4">
                        <!-- Start Logo -->
                        <div class="text-center mb-3">
                            <a href="~/"><img src="/assets/images/favicon.png" alt=""></a>
                        </div>
                        <!-- End Logo -->
                        <!-- Start Content -->
                        <div class="title-heading my-auto">
                            <div class="card form-signin px-4 py-5 rounded-md shadow-sm setpdiv">
                                <div class="text-center">
                                    <h5 class="mb-4">Recover Your Password</h5>
                                </div>

                                <ul class="nav nav-pills justify-content-center mb-4" id="recoveryTab" role="tablist">
                                    <li class="nav-item" role="presentation">
                                        <button class="nav-link active" id="email-tab" data-bs-toggle="pill" data-bs-target="#email-recovery" type="button" role="tab" aria-controls="email-recovery" aria-selected="true">Email</button>
                                    </li>
                                    <li class="nav-item ms-2" role="presentation">
                                        <button class="nav-link" id="mobile-tab" data-bs-toggle="pill" data-bs-target="#mobile-recovery" type="button" role="tab" aria-controls="mobile-recovery" aria-selected="false">Mobile</button>
                                    </li>
                                </ul>

                                <div class="tab-content" id="recoveryTabContent">
                                    <!-- Email Recovery Tab -->
                                    <div class="tab-pane fade show active" id="email-recovery" role="tabpanel" aria-labelledby="email-tab">
                                        <form asp-action="ForgotPassword" asp-controller="User">
                                            <p class="text-muted">Please enter your email address. You will receive the password via email.</p>
                                            <div class="row">
                                                <div class="col-12">
                                                    <div class="mb-3">
                                                        <input type="email" class="reg-input-custom" id="Email" name="Email" placeholder="Email Address *" required>
                                                    </div>
                                                </div><!--end col-->

                                                <div class="col-12">
                                                    <button class="btn btn-primary rounded-md w-100" type="submit">Recover Password</button>
                                                </div><!--end col-->

                                                <div class="col-12 text-center mt-4">
                                                    @Html.ValidationMessage("error", new { @class = "text-danger" })
                                                </div>
                                            </div>
                                        </form>
                                    </div>

                                    <!-- Mobile Recovery Tab -->
                                    <div class="tab-pane fade" id="mobile-recovery" role="tabpanel" aria-labelledby="mobile-tab">
                                        <div id="mobileFeedback" class="alert d-none mb-3" role="alert"></div>

                                        <!-- Direct Recover Form -->
                                        <div id="mobileRecoveryForm">
                                            <p class="text-muted">Please enter your mobile number. You will receive the password via SMS.</p>
                                            <div class="row">
                                                <div class="col-12">
                                                    <div class="mb-3">
                                                        <input type="tel" class="reg-input-custom" id="MobileInput" placeholder="Mobile Number *" required>
                                                    </div>
                                                </div>
                                                <div class="col-12">
                                                    <button class="btn btn-primary rounded-md w-100" id="RecoverMobileBtn" type="button">
                                                        <span class="spinner-border spinner-border-sm d-none me-2" id="mobileSpinner" role="status" aria-hidden="true"></span>
                                                        Recover Password
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-12 text-center mt-4">
                                    <small><span class="text-muted me-2">Remember your password? </span><a asp-action="Login" asp-controller="User" class="text-dark fw-bold">Sign in</a></small>
                                </div><!--end col-->
                            </div>
                        </div>
                        <!-- End Content -->
                        <!-- Start Footer -->
                        <div class="text-center text-white">
                            <p class="mb-0">© @DateTime.UtcNow.Year M4NIKAH. All Rights Reserved.</p>
                        </div>
                        <!-- End Footer -->
                    </div>
                </div><!--end col-->
            </div><!--end row-->
        </div><!--end container-->
    </section><!--end section-->
    
    <script src="/assets/libs/bootstrap/js/bootstrap.bundle.min.js"></script>
    <!-- Main Js -->
    <script src="/assets/libs/feather-icons/feather.min.js"></script>
    <script src="/assets/js/plugins.init.js"></script>
    <script src="/assets/js/app.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const mobileInput = document.getElementById("MobileInput");
            const recoverBtn = document.getElementById("RecoverMobileBtn");
            const feedback = document.getElementById("mobileFeedback");
            const spinner = document.getElementById("mobileSpinner");
            const mobileForm = document.getElementById("mobileRecoveryForm");

            function showFeedback(message, type = "danger") {
                feedback.textContent = message;
                feedback.className = `alert alert-${type} mb-3`;
            }

            function clearFeedback() {
                feedback.textContent = "";
                feedback.className = "alert d-none mb-3";
            }

            async function recoverPassword() {
                const phone = mobileInput.value.trim();
                if (!phone) {
                    showFeedback("Please enter a valid mobile number.");
                    return;
                }

                clearFeedback();
                recoverBtn.disabled = true;
                spinner.classList.remove("d-none");

                try {
                    const response = await fetch("/user/forgot-password/mobile/recover", {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/json"
                        },
                        body: JSON.stringify({ type: "mobile", identifier: phone })
                    });

                    const data = await response.json();
                    if (data.success) {
                        showFeedback(data.message || "Your password has been sent successfully.", "success");
                        mobileForm.classList.add("d-none");
                        setTimeout(function () {
                            window.location.href = "/user/login";
                        }, 3000);
                    } else {
                        showFeedback(data.error || "Failed to recover password. Account may not exist.");
                    }
                } catch (error) {
                    showFeedback("An error occurred. Please try again.");
                } finally {
                    recoverBtn.disabled = false;
                    spinner.classList.add("d-none");
                }
            }

            recoverBtn.addEventListener("click", recoverPassword);
        });
    </script>

</body>
</html>