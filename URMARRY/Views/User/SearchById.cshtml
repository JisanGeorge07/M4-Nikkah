@model SearchViewModel;
@{
	Layout = "/Views/Shared/_LayoutAccount.cshtml";
}

<div class="d-md-flex justify-content-between align-items-center">
	<h5 class="mb-0">Search</h5>

	<nav aria-label="breadcrumb" class="d-inline-block mt-2 mt-sm-0">
		<ul class="breadcrumb bg-transparent rounded mb-0 p-0">
			<li class="breadcrumb-item text-capitalize"><a asp-action="Dashboard" asp-controller="User">M4NIKAH</a></li>
			<li class="breadcrumb-item text-capitalize active" aria-current="page">Search</li>
		</ul>
	</nav>
</div>

<div class="col-xl-12 mt-3">
	<div class="card mb-4">
		<div class="card-header">Search</div>
		<div class="card-body">
			<form asp-controller="User" asp-action="SearchProfileResults" method="post">
				<div class="row mb-3 searchdiv">
					<div class="col-md-4 d-flex">
						<p>Profile ID</p>
					</div>
					<div class="col-md-8 d-flex">
						<input type="text" class="form-control m_lr" asp-for="ProfileId" />
					</div>
				</div>
				<!-- Save changes button-->
				<button class="btn btn-primary" type="submit">Search Now</button>
			</form>
		</div>
	</div>
</div>
<script>
	function nonPremiumAlert(event) {
		event.preventDefault();
		var paymentModal = new bootstrap.Modal(document.getElementById('payment1'));
		paymentModal.show();
	}
</script>