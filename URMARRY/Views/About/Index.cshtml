@model HomeViewModel

@{
    var about = Model.About!;
}

<section class="bg-half-170 d-table w-100" style="background: url('@Html.Raw("/" + about.BannerImagePath)');">
    <div class="bg-overlay"></div>
    <div class="container">
        <div class="row mt-5 justify-content-center">
            <div class="col-lg-12 text-center">
                <div class="pages-heading title-heading">
                    <h2 class="text-white title-dark"> @Html.Raw(about.BannerTitle) </h2>
                    <p class="text-white-50 para-desc mb-0 mx-auto">@Html.Raw(about.BannerBody)</p>
                </div>
            </div><!--end col-->
        </div><!--end row-->

        <div class="position-breadcrumb">
            <nav aria-label="breadcrumb" class="d-inline-block">
                <ul class="breadcrumb rounded shadow mb-0 px-4 py-2">
                    <li class="breadcrumb-item"><a href="~/">Home</a></li>
                    <li class="breadcrumb-item active" aria-current="page">@Html.Raw(about.BannerTitle)</li>
                </ul>
            </nav>
        </div>
    </div> <!--end container-->
</section>

<section class="section">
    <div class="container">
        <div class="row align-items-center" id="counter">

            <div class="col-md-12 mt-4 pt-2 mt-sm-0 pt-sm-0 text-center">
                <div class="ms-lg-4">
                    <div class="section-title titlebar">
                        <h4 class="title mb-4">@Html.Raw(about.Title)</h4>
                        <img src="/assets/images/titile_bar.jpg" alt="">
                        <p class="text-muted pt-4">@Html.Raw(about.Body)</p>
                        <a href="@Html.Raw(about.ButtonUrl)" class="btn btn-primary mt-3">@Html.Raw(about.ButtonTitle)</a>
                    </div>
                </div>
            </div><!--end col-->
        </div><!--end row-->
    </div><!--end container-->


</section>