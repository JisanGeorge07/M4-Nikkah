            @RenderSection("Scripts", required: false)
            <script>
                    function updateChatUnreadBadge(count) {
                        if (count && count > 0) {
                            $('.chat-unread-badge').text(count > 99 ? '99+' : count).show();
                        } else {
                            $('.chat-unread-badge').hide();
                        }
                    }

                    function checkUnreadChatMessages() {
                        $.ajax({
                            url: '/api/chat/unread-count',
                            type: 'GET',
                            success: function (data) {
                                if (data && typeof data.unreadCount === 'number') {
                                    updateChatUnreadBadge(data.unreadCount);
                                }
                            },
                            error: function (xhr, status, error) {
                                console.error('Error fetching unread chat count:', error);
                            }
                        });
                    }

                    (function () {
                        // Check unread messages on initial script evaluation
                        checkUnreadChatMessages();

                        const uid = @(loggedInUserPresenceId ?? 0);
                        if (uid > 0) {
                            if (typeof signalR !== 'undefined' && !window.globalPresenceConn) {
                                window.globalPresenceConn = new signalR.HubConnectionBuilder()
                                    .withUrl('/hubs/presence?userId=' + uid)
                                    .withAutomaticReconnect([0, 2000, 5000, 10000, 30000])
                                    .configureLogging(signalR.LogLevel.Warning)
                                    .build();

                                window.globalPresenceConn.start().catch(function (err) {
                                    console.error("Global PresenceHub connection failed:", err);
                                });
                            }

                            // Global ChatHub listener for real-time unread badge updates across all pages
                            if (typeof signalR !== 'undefined' && !window.globalChatConn) {
                                window.globalChatConn = new signalR.HubConnectionBuilder()
                                    .withUrl('/hubs/chat?userId=' + uid)
                                    .withAutomaticReconnect([0, 2000, 5000, 10000, 30000])
                                    .configureLogging(signalR.LogLevel.Warning)
                                    .build();

                                window.globalChatConn.on('UnreadCountUpdated', function (unreadCount) {
                                    updateChatUnreadBadge(unreadCount);
                                });

                                window.globalChatConn.on('MessagesRead', function () {
                                    checkUnreadChatMessages();
                                });

                                window.globalChatConn.on('ReceiveNewMessageNotification', function (msg) {
                                    checkUnreadChatMessages();
                                });

                                window.globalChatConn.on('ReceiveMessage', function (msg) {
                                    checkUnreadChatMessages();
                                });

                                window.globalChatConn.start().catch(function (err) {
                                    console.error("Global ChatHub connection failed:", err);
                                });
                            }

                            // Global CallHub listener for real-time incoming voice & video calls
                            if (typeof signalR !== 'undefined' && !window.globalCallConn) {
                                window.globalCallConn = new signalR.HubConnectionBuilder()
                                    .withUrl('/hubs/call?userId=' + uid)
                                    .withAutomaticReconnect([0, 2000, 5000, 10000, 30000])
                                    .configureLogging(signalR.LogLevel.Warning)
                                    .build();

                                window.globalCallConn.on('IncomingCall', function (callLog) {
                                    showIncomingCallModal(callLog);
                                });

                                window.globalCallConn.on('CallEnded', function (callLog) {
                                    hideIncomingCallModal();
                                });

                                window.globalCallConn.on('CallRejected', function (callLog) {
                                    hideIncomingCallModal();
                                });

                                window.globalCallConn.start().catch(function (err) {
                                    console.error("Global CallHub connection failed:", err);
                                });
                            }

                            // Real-time offline beacon when closing browser tab or navigating away
                            window.addEventListener('beforeunload', function () {
                                if (navigator.sendBeacon) {
                                    navigator.sendBeacon('/api/presence/offline?userId=' + uid);
                                }
                            });
                            window.addEventListener('pagehide', function () {
                                if (navigator.sendBeacon) {
                                    navigator.sendBeacon('/api/presence/offline?userId=' + uid);
                                }
                            });
                        }

                        $(document).ready(function () {
                            checkUnreadChatMessages();
                        });

                        window.addEventListener('pageshow', function () {
                            checkUnreadChatMessages();
                        });
                    })();
            </script>
            <script>
                    function checkUnreadNotifications() {
                        $.ajax({
                            url: '/api/notifications/unread-count',
                            type: 'GET',
                            success: function (data) {
                                if (data && data.unreadCount > 0) {
                                    $('#notificationBadge').text(data.unreadCount).show();
                                } else {
                                    $('#notificationBadge').hide();
                                }
                            },
                            error: function (xhr, status, error) {
                                console.error('Error fetching unread notification count:', error);
                            }
                        });
                    }

                    $(document).ready(function () {
                        // Check immediately on load
                        checkUnreadNotifications();
                        checkUnreadChatMessages();

                        // Poll periodically
                        setInterval(checkUnreadNotifications, 30000);
                        setInterval(checkUnreadChatMessages, 15000);
                    });
            </script>

            <!-- M4Nikah Themed Global Incoming Call Modal -->
            <div id="incomingCallModalOverlay" class="upgrade-modal-overlay" onclick="if(event.target === this) declineCurrentIncomingCall()">
                <div class="upgrade-modal-card" style="max-width: 420px; box-shadow: 0 20px 50px rgba(0,0,0,0.25);">
                    
                    <!-- Close button -->
                    <div class="modal-close-btn" onclick="declineCurrentIncomingCall()" title="Dismiss">
                        <i class="uil uil-times"></i>
                    </div>

                    <div class="modal-body-scroll" style="padding: 36px 24px 30px;">
                        
                        <!-- Call Type Pill Badge -->
                        <div class="d-inline-flex align-items-center gap-2 px-3 py-1 mb-3" style="background: #eef7ed; border: 1px solid #d4ecd1; border-radius: 999px; color: #007B3D; font-size: 13px; font-weight: 600;">
                            <i class="uil uil-phone-alt fs-16" id="incomingCallTypeIcon"></i>
                            <span id="incomingCallTypeText">Incoming Voice Call...</span>
                        </div>

                        <!-- Profile Avatar with soft pulsing effect -->
                        <div class="position-relative my-2" style="width: 96px; height: 96px;">
                            <div class="m4-call-avatar-pulse"></div>
                            <img id="incomingCallerPhoto" src="/assets/images/default-user-men.png" alt="Caller"
                                 onerror="this.onerror=null; this.src='/assets/images/default-user-men.png';"
                                 style="width: 96px; height: 96px; border-radius: 50%; object-fit: cover; border: 3px solid #007B3D; box-shadow: 0 6px 18px rgba(0, 123, 61, 0.25); background: #fff;">
                        </div>

                        <!-- Caller Name & ID -->
                        <h5 id="incomingCallerName" class="fw-bold fs-18 mb-1 mt-2" style="color: #1e293b;">Member</h5>
                        <p id="incomingCallerRegNo" class="text-muted fs-12 mb-4">Reg ID: M4N</p>

                        <!-- Action Buttons -->
                        <div class="d-flex justify-content-center gap-3 w-100 px-2">
                            <!-- Decline Button -->
                            <button type="button" id="declineIncomingCallBtn" class="btn d-flex align-items-center justify-content-center gap-2 flex-fill py-2 text-white"
                                    style="background-color: #E93B3B !important; border-radius: 999px; font-size: 14px; font-weight: 600; padding: 10px 18px; box-shadow: 0 4px 12px rgba(233, 59, 59, 0.25); border: none;">
                                <i class="uil uil-phone-slash fs-18"></i>
                                <span>Decline</span>
                            </button>

                            <!-- Accept Button -->
                            <button type="button" id="acceptIncomingCallBtn" class="btn d-flex align-items-center justify-content-center gap-2 flex-fill py-2 text-white"
                                    style="background-color: #007B3D !important; border-radius: 999px; font-size: 14px; font-weight: 600; padding: 10px 18px; box-shadow: 0 4px 14px rgba(0, 123, 61, 0.35); animation: m4AcceptPulse 1.6s infinite; border: none;">
                                <i class="uil uil-phone-alt fs-18"></i>
                                <span>Accept</span>
                            </button>
                        </div>

                    </div>
                </div>
            </div>

            <style>
                .m4-call-avatar-pulse {
                    position: absolute;
                    inset: -8px;
                    border-radius: 50%;
                    border: 2px solid rgba(0, 123, 61, 0.5);
                    animation: m4nikahPulse 1.8s infinite ease-out;
                }
                @@keyframes m4nikahPulse {
                    0% { transform: scale(1); opacity: 0.8; }
                    50% { transform: scale(1.18); opacity: 0.3; }
                    100% { transform: scale(1.35); opacity: 0; }
                }
                @@keyframes m4AcceptPulse {
                    0%, 100% { transform: scale(1); box-shadow: 0 4px 12px rgba(0, 123, 61, 0.35); }
                    50% { transform: scale(1.04); box-shadow: 0 6px 20px rgba(0, 123, 61, 0.6); }
                }
            </style>

            <script>
                let globalRingtoneCtx = null;
                let globalRingtoneTimer = null;
                let activeIncomingCallData = null;

                function startGlobalRingtone() {
                    try {
                        if (!globalRingtoneCtx) {
                            globalRingtoneCtx = new (window.AudioContext || window.webkitAudioContext)();
                        }
                        if (globalRingtoneCtx.state === 'suspended') {
                            globalRingtoneCtx.resume();
                        }

                        function playTonePair() {
                            if (!globalRingtoneCtx) return;
                            const osc1 = globalRingtoneCtx.createOscillator();
                            const osc2 = globalRingtoneCtx.createOscillator();
                            const gain = globalRingtoneCtx.createGain();

                            osc1.type = 'sine';
                            osc1.frequency.setValueAtTime(440, globalRingtoneCtx.currentTime);
                            osc2.type = 'sine';
                            osc2.frequency.setValueAtTime(480, globalRingtoneCtx.currentTime);

                            gain.gain.setValueAtTime(0, globalRingtoneCtx.currentTime);
                            gain.gain.linearRampToValueAtTime(0.18, globalRingtoneCtx.currentTime + 0.1);
                            gain.gain.linearRampToValueAtTime(0, globalRingtoneCtx.currentTime + 1.2);

                            osc1.connect(gain);
                            osc2.connect(gain);
                            gain.connect(globalRingtoneCtx.destination);

                            osc1.start();
                            osc2.start();
                            osc1.stop(globalRingtoneCtx.currentTime + 1.2);
                            osc2.stop(globalRingtoneCtx.currentTime + 1.2);
                        }

                        playTonePair();
                        globalRingtoneTimer = setInterval(playTonePair, 2500);
                    } catch (e) {
                        console.warn('Ringtone sound playback notice:', e);
                    }
                }

                function stopGlobalRingtone() {
                    if (globalRingtoneTimer) {
                        clearInterval(globalRingtoneTimer);
                        globalRingtoneTimer = null;
                    }
                }

                function showIncomingCallModal(callLog) {
                    activeIncomingCallData = callLog;
                    const modal = document.getElementById('incomingCallModalOverlay');
                    if (!modal) return;

                    const isVideo = callLog.callType === 1 || callLog.callType === 'Video';
                    const typeIcon = document.getElementById('incomingCallTypeIcon');
                    const typeText = document.getElementById('incomingCallTypeText');
                    
                    if (typeIcon) {
                        typeIcon.className = isVideo ? 'uil uil-video fs-16' : 'uil uil-phone-alt fs-16';
                    }
                    if (typeText) {
                        typeText.textContent = isVideo ? 'Incoming Video Call...' : 'Incoming Voice Call...';
                    }

                    document.getElementById('incomingCallerName').textContent = callLog.callerName || 'Member';
                    document.getElementById('incomingCallerRegNo').textContent = callLog.callerRegisterNumber ? 'Reg ID: ' + callLog.callerRegisterNumber : '';

                    const isCallerFemale = callLog.callerGender && String(callLog.callerGender).toLowerCase() === 'female';
                    const defaultAvatar = isCallerFemale ? '/assets/images/default-user-women.png' : '/assets/images/default-user-men.png';
                    const photoEl = document.getElementById('incomingCallerPhoto');
                    if (photoEl) {
                        photoEl.onerror = function () {
                            this.onerror = null;
                            this.src = defaultAvatar;
                        };
                        if (callLog.callerPhotoUrl && callLog.callerPhotoUrl.trim() !== '' && !callLog.callerPhotoUrl.includes('default-user') && !callLog.callerPhotoUrl.includes('chat-img2')) {
                            photoEl.src = (callLog.callerPhotoUrl.startsWith('http') || callLog.callerPhotoUrl.startsWith('/'))
                                ? callLog.callerPhotoUrl
                                : '/' + callLog.callerPhotoUrl;
                        } else {
                            photoEl.src = defaultAvatar;
                        }
                    }

                    modal.classList.add('active');
                    startGlobalRingtone();

                    document.getElementById('acceptIncomingCallBtn').onclick = function () {
                        stopGlobalRingtone();
                        modal.classList.remove('active');
                        const targetUrl = isVideo 
                            ? `/call/video/${callLog.callerId}?isIncoming=true&callLogId=${callLog.id}&roomId=${callLog.roomId}`
                            : `/call/voice/${callLog.callerId}?isIncoming=true&callLogId=${callLog.id}&roomId=${callLog.roomId}`;
                        window.location.href = targetUrl;
                    };

                    document.getElementById('declineIncomingCallBtn').onclick = function () {
                        declineCurrentIncomingCall();
                    };
                }

                function declineCurrentIncomingCall() {
                    stopGlobalRingtone();
                    const modal = document.getElementById('incomingCallModalOverlay');
                    if (modal) {
                        modal.classList.remove('active');
                    }
                    if (activeIncomingCallData && window.globalCallConn) {
                        window.globalCallConn.invoke('RejectCall', { callLogId: activeIncomingCallData.id, reason: 'Declined by user' })
                            .catch(function (err) { console.error('Error rejecting call:', err); });
                    }
                    activeIncomingCallData = null;
                }

                function hideIncomingCallModal() {
                    stopGlobalRingtone();
                    const modal = document.getElementById('incomingCallModalOverlay');
                    if (modal) {
                        modal.classList.remove('active');
                    }
                    activeIncomingCallData = null;
                }
            </script>
        </body>

    </html>