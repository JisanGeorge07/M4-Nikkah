                        <i data-lucide="bell-ring"></i>
                        <span id="notificationBadge" class="position-absolute badge rounded-pill bg-danger" 
                              style="top: -2px; right: -2px; font-size: 9px; padding: 2px 5px; display: none; z-index: 10; line-height: 1;">
                            0
                        </span>
                    </a>

                    <!-- Search -->
                    <a asp-controller="User" asp-action="SearchProfile" class="header-search-btn d-none d-md-flex">

                        <i data-lucide="search"></i>
                        <span>Search</span>
                    </a>

