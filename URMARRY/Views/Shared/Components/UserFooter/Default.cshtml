<style>
    .img_final {
        border-radius: 100px;
        width: 120px;
        height: 120px;
        position: relative;
        overflow: hidden;
        margin-top: 20px;
    }

    .img_bg1::before {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        width: 100%;
        height: 80px;
        background-color: rgb(1, 102, 46);
        margin: auto;
    }

    .newbtn a {
        padding: 15px 20px;
        outline: 0;
        text-decoration: none;
        font-size: 15px;
        letter-spacing: .5px;
        -webkit-transition: all .3s;
        transition: all .3s;
        font-weight: 600;
        border-radius: 6px;
        background: rgb(1, 102, 46);
        color: #fff;
    }

</style>
<script>
    document.addEventListener('DOMContentLoaded', function () {
        // Event listener for showing the modal
        var profileModal = document.getElementById('payment1');
        profileModal.addEventListener('show.bs.modal', function (event) {
            var button = event.relatedTarget; // Button that triggered the modal
            var profileName = button.getAttribute('data-name'); // Extract name from data-* attribute
            var registerNumber = button.getAttribute('data-registernumber'); // Extract register number

            // Update the modal's content
            var modalNameElement = document.getElementById('profileName');
            var modalRegisterNumberElement = document.getElementById('profileRegisterNumber');

            modalNameElement.textContent = profileName;
            modalRegisterNumberElement.textContent = registerNumber;
        });
    });

</script>

