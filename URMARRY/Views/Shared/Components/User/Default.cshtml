@model HeaderViewModel

<li class="list-inline-item mb-0">
    @if(Model.IsLogin)
    {
        <a asp-action="Dashboard" asp-controller="User" class="btn btn-primary mt-2 me-2"><i class="uil uil-user"></i> <span class="d-none d-lg-inline">Dashboard</span></a>
    }
    else
    {
        <a asp-action="Login" asp-controller="User" class="btn btn-primary mt-2 me-2"><i class="uil uil-user"></i> <span class="d-none d-lg-inline">Login</span></a>
    }
</li>