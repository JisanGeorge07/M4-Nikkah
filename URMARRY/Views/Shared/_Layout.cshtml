    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    @if (IsSectionDefined("Head"))
    {
        @RenderSection("Head", required: false)
    }
    else
    {
        <title>@(ViewData["Title"] != null && ViewData["Title"]?.ToString() != "Home Page" ? $"{ViewData["Title"]} - M4NIKAH" : "M4NIKAH - We help you find your perfect life partner")</title>
        <meta name="description" content="M4NIKAH - We help you find your perfect life partner">
    }
    <link rel="shortcut icon" href="/assets/images/favicon.png">
    <link href="/assets/libs/tiny-slider/tiny-slider.css" rel="stylesheet">
    <link href="/assets/libs/tobii/css/tobii.min.css" rel="stylesheet">
    <link href="/assets/css/bootstrap.min.css" id="bootstrap-style" class="theme-opt" rel="stylesheet" type="text/css">
    <link href="/assets/libs/%40mdi/font/css/materialdesignicons.min.css" rel="stylesheet" type="text/css">
    <link href="/assets/libs/%40iconscout/unicons/css/line.css" type="text/css" rel="stylesheet">
    <!-- Account Section Style -->
    <link href="~/assets/account/assets/css/style-main.css" class="theme-opt" rel="stylesheet" type="text/css" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.0.3/css/font-awesome.css" type="text/css" rel="stylesheet">
    <link href="/assets/css/style.min.css" id="color-opt" class="theme-opt" rel="stylesheet" type="text/css">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/intl-tel-input/17.0.13/css/intlTelInput.css" rel="stylesheet">
    <script src="https://www.google.com/recaptcha/api.js"></script>
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>
<body>
    
    <header id="topnav" class="defaultscroll sticky navbar-white-bg">
        <div class="container">
            
            <a class="logo" href="~/">
                <img src="/assets/images/logo.png" height="58" class="logo-light-mode" alt="">
            </a>

            <div class="menu-extras">
                <div class="menu-item">
                    <a class="navbar-toggle" id="isToggle" onclick="toggleMenu()">
                        <div class="lines">
                            <span></span>
                            <span></span>
                            <span></span>
                        </div>
                    </a>
                </div>
            </div>

            <ul class="buy-button list-inline mb-0 loginbtn">
                
                @await Component.InvokeAsync("User")

                <li class="list-inline-item mb-0">
                    <a href="javascript:void(0)" data-bs-toggle="offcanvas" data-bs-target="#offcanvasRight" aria-controls="offcanvasRight">
                        <div class="btn btn-icon btn-pills btn-soft-primary">
                            <i class="uil uil-apps align-middle" title="Contact Details"></i>
                        </div>
                    </a>
                </li>
            </ul>

            <div id="navigation">
                <ul class="navigation-menu">
                    <li><a asp-action="Index" asp-controller="About" class="">About Us</a></li>
                    <li><a asp-action="Index" asp-controller="Contact" class="">Contact Us</a></li>

                </ul>
            </div>
        </div>
    </header>
    @*@await Component.InvokeAsync("Header")*@

    @RenderBody()

    @await Component.InvokeAsync("Footer")
    

    <a href="#" onclick="topFunction()" id="back-to-top" class="back-to-top fs-5"><i data-feather="arrow-up" class="fea icon-sm icons align-middle"></i></a>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.2.1/jquery.min.js"></script>
    <script src="/assets/libs/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="/assets/libs/tiny-slider/min/tiny-slider.js"></script>
    <script src="/assets/libs/tobii/js/tobii.min.js"></script>
    <script src="/assets/libs/feather-icons/feather.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/intl-tel-input/17.0.13/js/intlTelInput-jquery.min.js"></script>
    <script src="/assets/js/plugins.init.js"></script>
    <script src="/assets/js/app.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
