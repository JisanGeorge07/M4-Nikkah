@{
    Layout = "/Views/Shared/_LayoutAccount.cshtml";
    int viewUsed = ViewBag.ViewCreditsUsed != null ? (int)ViewBag.ViewCreditsUsed : 0;
    int viewPurchased = ViewBag.ViewCreditsPurchased != null ? (int)ViewBag.ViewCreditsPurchased : 50;
    int msgUsed = ViewBag.MessageCreditsUsed != null ? (int)ViewBag.MessageCreditsUsed : 0;
    int msgPurchased = ViewBag.MessageCreditsPurchased != null ? (int)ViewBag.MessageCreditsPurchased : 50;
    int audioUsed = ViewBag.AudioCallContactsUsed != null ? (int)ViewBag.AudioCallContactsUsed : 0;
    int audioPurchased = ViewBag.AudioCallContactsPurchased != null ? (int)ViewBag.AudioCallContactsPurchased : 50;
    int videoUsed = ViewBag.VideoCallMinutesUsed != null ? (int)ViewBag.VideoCallMinutesUsed : 0;
    int videoPurchased = ViewBag.VideoCallMinutesPurchased != null ? (int)ViewBag.VideoCallMinutesPurchased : 60;
    
    int viewRemaining = Math.Max(0, viewPurchased - viewUsed);
    int msgRemaining = Math.Max(0, msgPurchased - msgUsed);
    int audioRemaining = Math.Max(0, audioPurchased - audioUsed);
    int videoRemaining = Math.Max(0, videoPurchased - videoUsed);
    
    int viewPercent = viewPurchased > 0 ? Math.Min(100, (viewUsed * 100) / viewPurchased) : 0;
    int msgPercent = msgPurchased > 0 ? Math.Min(100, (msgUsed * 100) / msgPurchased) : 0;
    int audioPercent = audioPurchased > 0 ? Math.Min(100, (audioUsed * 100) / audioPurchased) : 0;
    int videoPercent = videoPurchased > 0 ? Math.Min(100, (videoUsed * 100) / videoPurchased) : 0;
    
    DateTime? planExpiry = ViewBag.PlanExpiresAt as DateTime?;
    bool isPremium = Model?.Registration != null && Model.Registration.IsPremiumMember;
    string limitMsg = TempData["LimitMessage"] as string;
}

<main class="flex-fill p-4">
    <div class="container" style="max-width: 960px;">
        <div>
            <!-- Profiles Grid -->
            <div class="row g-4">
                <!-- Profile Card 1 -->
                <div class="col-12 col-md-12 col-lg-12">
                    <div class="premium-page">
                        <!-- TITLE -->
                        <div class="page-title">
                            My Premium
                        </div>

                        <!-- PREMIUM MEMBER -->
                        <div class="member-card">
                            <div class="member-icon">
                                <svg viewBox="0 0 80 80" fill="none">
                                    <!-- Hand -->
                                    <path d="M12 45H23L34 53H51C54 53 56 51 56 48C56 46 55 45 53 44L42 39"
                                          stroke="#FFD21F" stroke-width="5" stroke-linecap="round"
                                          stroke-linejoin="round" />
                                    <path d="M23 45L32 36C34 34 37 34 39 36L51 45" stroke="#FFD21F" stroke-width="5"
                                          stroke-linecap="round" stroke-linejoin="round" />
                                    <path d="M12 43V58H23V43" stroke="#FFD21F" stroke-width="5"
                                          stroke-linejoin="round" />
                                    <!-- Star -->
                                    <path d="M48 12L52 21L62 22L54 29L56 39L48 34L39 39L41 29L34 22L44 21L48 12Z"
                                          fill="none" stroke="#FFD21F" stroke-width="4" stroke-linejoin="round" />
                                </svg>
                            </div>

                            <div class="member-info">
                                <div class="member-title">
                                    @(isPremium ? "Premium Member" : "Free Member")
                                </div>
                                <div class="member-valid">
                                    @(planExpiry.HasValue ? "Valid until " + planExpiry.Value.ToString("dd MMM yyyy") : (isPremium ? "Active" : "No Active Plan"))
                                </div>
                            </div>
                        </div>

                        <!-- BENEFITS -->
                        <div class="benefits-title">
                            Your Premium Benefits
                        </div>

                        <!-- CONTACT VIEWS -->
                        <div class="benefit-card">
                            <div class="benefit-icon">
                                <svg viewBox="0 0 60 60" fill="none">
                                    <rect x="8" y="8" width="44" height="44" rx="10" stroke="white" stroke-width="3"
                                          stroke-dasharray="7 5" />
                                    <ellipse cx="30" cy="30" rx="11" ry="8" stroke="white" stroke-width="3" />
                                    <circle cx="30" cy="30" r="4" fill="white" />
                                </svg>
                            </div>
                            <div class="benefit-content">
                                <div class="benefit-name">
                                    Contact Views
                                </div>
                                <div class="usage">
                                    <strong>@viewUsed</strong>
                                    <span>/ @viewPurchased Used</span>
                                </div>
                                <div class="progress-container">
                                    <div class="progress" style="width: @(viewPercent)%;"></div>
                                </div>
                                <div class="remaining">
                                    @viewRemaining Remaining
                                </div>
                            </div>
                        </div>

                        <!-- MESSAGE CONTACTS -->
                        <div class="benefit-card">
                            <div class="benefit-icon">
                                <svg viewBox="0 0 60 60" fill="none">
                                    <path d="M30 8C17 8 7 17 7 29C7 35 9 40 13 44L10 52L19 48C22 50 26 51 30 51C43 51 53 42 53 29C53 17 43 8 30 8Z"
                                          stroke="white" stroke-width="2.5" stroke-linejoin="round" />
                                    <circle cx="21" cy="29" r="1.3" fill="white" />
                                    <circle cx="30" cy="29" r="1.3" fill="white" />
                                    <circle cx="39" cy="29" r="1.3" fill="white" />
                                </svg>
                            </div>
                            <div class="benefit-content">
                                <div class="benefit-name">
                                    Message Contacts
                                </div>
                                <div class="usage">
                                    <strong>@msgUsed</strong>
                                    <span>/ @msgPurchased Used</span>
                                </div>
                                <div class="progress-container">
                                    <div class="progress" style="width: @(msgPercent)%;"></div>
                                </div>
                                <div class="remaining">
                                    @msgRemaining Remaining
                                </div>
                            </div>
                        </div>

                        <!-- AUDIO CALL CONTACTS -->
                        <div class="benefit-card">
                            <div class="benefit-icon">
                                <svg viewBox="0 0 60 60" fill="none">
                                    <path d="M42 36V41C42 43.2 40.2 45 38 45C22.5 44 16 37.5 15 22C15 19.8 16.8 18 19 18H24C25.1 18 26 18.8 26.3 19.9C26.7 21.8 27.5 23.7 28.5 25.4C28.9 26.1 28.7 27 28.1 27.6L25 30.2C27.2 34.9 31.1 38.8 35.8 41L38.4 37.9C39 37.3 39.9 37.1 40.6 37.5C42.3 38.5 44.2 39.3 46.1 39.7C47.2 40 48 40.9 48 42V45"
                                          stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
                                </svg>
                            </div>
                            <div class="benefit-content">
                                <div class="benefit-name">
                                    Audio Call Contacts
                                </div>
                                <div class="usage">
                                    <strong>@audioUsed</strong>
                                    <span>/ @audioPurchased Used</span>
                                </div>
                                <div class="progress-container">
                                    <div class="progress" style="width: @(audioPercent)%;"></div>
                                </div>
                                <div class="remaining">
                                    @audioRemaining Remaining
                                </div>
                            </div>
                        </div>

                        <!-- VIDEO CALL MINUTES -->
                        <div class="benefit-card">
                            <div class="benefit-icon">
                                <svg viewBox="0 0 60 60" fill="none">
                                    <rect x="10" y="16" width="26" height="24" rx="4" stroke="white" stroke-width="2.5" />
                                    <path d="M36 24L48 18V38L36 32V24Z" stroke="white" stroke-width="2.5" stroke-linejoin="round" />
                                </svg>
                            </div>
                            <div class="benefit-content">
                                <div class="benefit-name">
                                    Video Call Minutes
                                </div>
                                <div class="usage">
                                    <strong>@videoUsed</strong>
                                    <span>/ @videoPurchased Min Used</span>
                                </div>
                                <div class="progress-container">
                                    <div class="progress" style="width: @(videoPercent)%;"></div>
                                </div>
                                <div class="remaining">
                                    @videoRemaining Min Remaining
                                </div>
                            </div>
                        </div>

                        <!-- WARNING -->
                        @if (!string.IsNullOrEmpty(limitMsg))
                        {
                            <div class="warning-box">
                                <div class="warning-icon">
                                    <svg viewBox="0 0 50 50" fill="none">
                                        <path d="M15 4H35L46 15V35L35 46H15L4 35V15L15 4Z" stroke="#006B31" stroke-width="4"
                                              stroke-linejoin="round" />
                                        <path d="M25 16V29" stroke="#006B31" stroke-width="4" stroke-linecap="round" />
                                        <circle cx="25" cy="36" r="2" fill="#006B31" />
                                    </svg>
                                </div>
                                <div class="warning-text">
                                    @limitMsg
                                </div>
                            </div>
                        }
                        else if (msgRemaining <= 0 || viewRemaining <= 0)
                        {
                            <div class="warning-box">
                                <div class="warning-icon">
                                    <svg viewBox="0 0 50 50" fill="none">
                                        <path d="M15 4H35L46 15V35L35 46H15L4 35V15L15 4Z" stroke="#006B31" stroke-width="4"
                                              stroke-linejoin="round" />
                                        <path d="M25 16V29" stroke="#006B31" stroke-width="4" stroke-linecap="round" />
                                        <circle cx="25" cy="36" r="2" fill="#006B31" />
                                    </svg>
                                </div>
                                <div class="warning-text">
                                    You've reached your limit for new conversations or contact views. Renew your Premium membership to continue.
                                </div>
                            </div>
                        }

                        <!-- RENEW BUTTON -->
                        <button class="renew-button" onclick="window.location.href='/Transaction/MakePayment'">
                            <svg viewBox="0 0 30 30" fill="none">
                                <path d="M5 17H11L16 21H22C24 21 25 20 25 18C25 17 24 16 22 15L17 12" stroke="white"
                                      stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                                <path d="M11 17L15 13C16 12 17 12 18 13L22 16" stroke="white" stroke-width="2"
                                      stroke-linecap="round" />
                                <path d="M5 16V23H11V16" stroke="white" stroke-width="2" />
                                <path d="M21 5L22.5 8.5L26 10L22.5 11.5L21 15L19.5 11.5L16 10L19.5 8.5L21 5Z"
                                      stroke="white" stroke-width="1.5" stroke-linejoin="round" />
                            </svg>
                            Renew Premium
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>