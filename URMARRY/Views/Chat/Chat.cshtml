                                        </path>
                                        <line x1="10" y1="11" x2="10" y2="17"></line>
                                        <line x1="14" y1="11" x2="14" y2="17"></line>
                                    </svg>
                                </button>

                                <div class="recording-indicator">
                                    <span class="recording-pulse-dot"></span>
                                    <span class="recording-timer" id="recordingTimer">00:00</span>
                                </div>

                                <div class="recording-waves">
                                    <span></span><span></span><span></span><span></span><span></span>
                                    <span></span><span></span><span></span><span></span><span></span>
                                    <span></span><span></span><span></span><span></span><span></span>
                                </div>

                                <button type="button" class="send-recording-btn" id="sendVoiceBtn"
                                        title="Send voice note">
                                    <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
                                        <path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z" />
                                    </svg>
                                </button>
                            </div>

                        </footer>

                    </div>
								
                </div>

            </div>

        </div>
    </div>
</main>

<!-- ================= CAMERA MODAL OVERLAY ================= -->
<div id="cameraModalOverlay" class="camera-modal-overlay" style="display: none;">
    <div class="camera-modal-container">
        <!-- Header -->
        <div class="camera-modal-header">
            <span class="camera-title"><i class="uil uil-camera me-1"></i> Take Photo</span>
            <div class="camera-header-actions">
                <button type="button" class="camera-icon-btn" id="switchCameraBtn" title="Switch Camera"
                        style="display: none;">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M20 16v-4a8 8 0 0 0-16 0v4m16 0-3-3m3 3-3 3M4 8v4a8 8 0 0 0 16 0V8M4 8l3 3M4 8l3-3" />
                    </svg>
                </button>
                <button type="button" class="camera-icon-btn" id="closeCameraBtn" title="Close">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                        <line x1="18" y1="6" x2="6" y2="18"></line>
                        <line x1="6" y1="6" x2="18" y2="18"></line>
                    </svg>
                </button>
            </div>
        </div>

        <!-- Viewport -->
        <div class="camera-viewport">
            <video id="cameraVideo" autoplay playsinline muted></video>
            <img id="cameraPreviewImg" alt="Captured preview" style="display: none;" />
            <canvas id="cameraCanvas" style="display: none;"></canvas>

            <div id="cameraLoadingSpinner" class="camera-loading-spinner" style="display: none;">
                <div class="spinner-border text-light" role="status"></div>
                <span class="mt-2 text-light" style="font-size: 13px;">Opening camera...</span>
            </div>
        </div>

        <!-- Footer / Controls -->
        <div class="camera-modal-footer">
            <!-- State 1: Live Viewport Shutter Button -->
            <div id="cameraLiveControls" class="camera-controls-row">
                <button type="button" class="camera-shutter-btn" id="capturePhotoBtn" title="Capture Photo">
                    <span class="shutter-inner"></span>
                </button>
            </div>

            <!-- State 2: Captured Preview Actions -->
            <div id="cameraPreviewControls" class="camera-controls-row" style="display: none;">
                <button type="button" class="btn btn-outline-light rounded-pill px-4" id="retakePhotoBtn">
                    <i class="uil uil-redo me-1"></i> Retake
                </button>
                <button type="button" class="btn btn-success rounded-pill px-4" id="sendCapturedPhotoBtn">
                    <i class="uil uil-message me-1"></i> Send Photo
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts
{
    <script>
        const currentUserId = @(ViewBag.CurrentUserId ?? 0);
        const targetUserId = @(ViewBag.TargetUserId ?? 0);
        const isSupportChat = @((ViewBag.IsSupportChat ?? false).ToString().ToLower());

        let currentConversationId = 0;
        let chatHub = null;
        let presenceHub = null;
        let typingTimeout = null;
        let lastTypingSent = 0;

        // Camera State
        let cameraStream = null;
        let capturedBlob = null;
        let currentFacingMode = 'user'; // 'user' (front) or 'environment' (back)

        // Voice Recording State
        let mediaRecorder = null;
        let audioStream = null;
        let audioChunks = [];
        let recordingTimerInterval = null;
        let recordingStartTime = 0;
        let isCancelledRecording = false;

        function handleBackClick() {
            if (document.referrer && document.referrer.includes('/chat')) {
                history.back();
            } else {
                window.location.href = '/chat';
            }
        }

        function escapeHtml(text) {
            if (!text) return '';
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }

        function parseUtcDate(dateStr) {
            if (!dateStr) return null;
            let s = String(dateStr).trim();
            if (!s.endsWith('Z') && !s.includes('+') && !/T.*\d{2}-\d{2}$/.test(s)) {
                s += 'Z';
            }
            const d = new Date(s);
            return isNaN(d.getTime()) ? null : d;
        }

        function formatMsgTime(dateStr) {
            const date = parseUtcDate(dateStr);
            if (!date) return '';
            return date.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', hour12: true });
        }

        function scrollToBottom() {
            const chatArea = document.getElementById('chatArea');
            if (chatArea) {
                setTimeout(() => {
                    chatArea.scrollTop = chatArea.scrollHeight;
                }, 50);
            }
        }

        function renderMessage(msg) {
            const isMe = msg.senderId === currentUserId;
            const rowClass = isMe ? 'message-row sent' : 'message-row received';
            const voiceRowClass = isMe ? 'voice-message-row sent' : 'voice-message-row received';
            const timeText = formatMsgTime(msg.sentAt || msg.createdOn);
            let readCheck = '';
            if (isMe) {
                const isRead = msg.status === 3 || msg.status === 'Read' || msg.isRead === true || Boolean(msg.readAt);
                const isDelivered = msg.status === 2 || msg.status === 'Delivered' || Boolean(msg.deliveredAt);
                if (isRead) {
                    readCheck = '<span class="read-receipt" style="color: #0d6efd; margin-left: 4px; font-weight: bold;">✓✓</span>';
                } else if (isDelivered) {
                    readCheck = '<span class="read-receipt" style="color: #888; margin-left: 4px;">✓✓</span>';
                } else {
                    readCheck = '<span class="read-receipt" style="color: #888; margin-left: 4px;">✓</span>';
                }
            }

            // Handle voice message (enum 3 or 'VoiceNote' or audio extension)
            const isVoiceNote = msg.messageType === 3 || msg.messageType === 'VoiceNote' || (msg.attachmentUrl && /\.(mp3|wav|ogg|m4a|webm)$/i.test(msg.attachmentUrl));
            if (isVoiceNote && msg.attachmentUrl) {
                return `
                        <div class="${voiceRowClass}" data-message-id="${msg.id}">
                            <div class="voice-message">
                                <div class="voice-player">
                                    <audio src="${msg.attachmentUrl}" preload="none"></audio>
                                    <button class="play-button" onclick="playVoiceNote(this)" title="Play audio">
                                        <svg viewBox="0 0 24 24">
                                            <path d="M8 5L19 12L8 19V5Z" />
                                        </svg>
                                    </button>
                                    <div class="waveform">
                                        <span></span><span></span><span></span><span></span><span></span>
                                        <span></span><span></span><span></span><span></span><span></span>
                                        <span></span><span></span><span></span><span></span><span></span>
                                    </div>
                                    <span class="duration">Voice Note</span>
                                </div>
                                <div class="voice-time">
                                    ${timeText} ${readCheck}
                                </div>
                            </div>
                        </div>
                    `;
            }

            // Handle image message (enum 2 or 'Image' or image extension)
            const isImage = msg.messageType === 2 || msg.messageType === 'Image' || (msg.attachmentUrl && /\.(jpeg|jpg|png|gif|webp)$/i.test(msg.attachmentUrl));
            if (isImage && msg.attachmentUrl) {
                return `
                        <div class="${rowClass}" data-message-id="${msg.id}">
                            <div class="message-wrapper">
                                <div class="message" style="padding: 4px; background: transparent;">
                                    <a href="${msg.attachmentUrl}" target="_blank">
                                        <img src="${msg.attachmentUrl}" style="max-width: 240px; max-height: 240px; border-radius: 12px; display: block; object-fit: cover;" alt="Attachment" />
                                    </a>
                                    ${msg.content && msg.content !== msg.attachmentFileName && msg.content !== 'Photo' ? `<div style="padding: 6px 8px; font-size: 13px;">${escapeHtml(msg.content)}</div>` : ''}
                                </div>
                                <div class="message-time">
                                    ${timeText} ${readCheck}
                                </div>
                            </div>
                        </div>
                    `;
            }

            // Handle document or file attachment
            if (msg.attachmentUrl) {
                return `
                        <div class="${rowClass}" data-message-id="${msg.id}">
                            <div class="message-wrapper">
                                <div class="message">
                                    <a href="${msg.attachmentUrl}" target="_blank" style="color: inherit; text-decoration: underline; display: flex; align-items: center; gap: 6px;">
                                        <i class="uil uil-file-download" style="font-size: 18px;"></i>
                                        <span>${escapeHtml(msg.attachmentFileName || msg.content || 'Download Attachment')}</span>
                                    </a>
                                </div>
                                <div class="message-time">
                                    ${timeText} ${readCheck}
                                </div>
                            </div>
                        </div>
                    `;
            }

            // Standard text message
            return `
                    <div class="${rowClass}" data-message-id="${msg.id}">
                        <div class="message-wrapper">
                            <div class="message">
                                ${escapeHtml(msg.content)}
                            </div>
                            <div class="message-time">
                                ${timeText} ${readCheck}
                            </div>
                        </div>
                    </div>
                `;
        }

        function appendMessage(msg) {
            const container = document.getElementById('messagesContainer');
            if (!container) return;

            // Prevent duplicate message renders
            if (msg.id && document.querySelector(`[data-message-id="${msg.id}"]`)) {
                return;
            }

            // Remove loading indicator if present
            const loading = document.getElementById('chatLoading');
            if (loading) loading.remove();

            const msgHtml = renderMessage(msg);
            container.insertAdjacentHTML('beforeend', msgHtml);
            scrollToBottom();
        }

        function updateReadReceipts() {
            document.querySelectorAll('.message-row.sent .read-receipt, .voice-message-row.sent .read-receipt, .read-receipt').forEach(elem => {
                const parentSent = elem.closest('.sent');
                if (parentSent) {
                    elem.innerHTML = '✓✓';
                    elem.style.color = '#0d6efd';
                    elem.style.fontWeight = 'bold';
                }
            });
        }

        async function markConversationAsRead() {
            if (!currentConversationId || currentConversationId <= 0) return;
            try {
                await fetch('/api/chat/read', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ conversationId: currentConversationId })
                });
                if (typeof checkUnreadChatMessages === 'function') {
                    checkUnreadChatMessages();
                }
            } catch (err) {
                console.error('Error marking as read:', err);
            }
        }

        async function initChat() {
            if (currentUserId <= 0) {
                window.location.href = '/Account/Login';
                return;
            }

            const targetPhoto = document.getElementById('chatTargetPhoto');
            const targetName = document.getElementById('chatTargetName');
            const targetStatus = document.getElementById('chatTargetStatus');
            const onlineDot = document.getElementById('chatOnlineDot');
            const container = document.getElementById('messagesContainer');

            try {
                if (isSupportChat) {
                    // Setup Support Header
                    if (targetName) targetName.innerText = 'M4Nikah Support';
                    if (targetStatus) targetStatus.innerText = 'Official Support Desk';
                    if (targetPhoto) targetPhoto.src = '/assets/images/logo.png';
                    if (onlineDot) onlineDot.className = 'online-dot';

                    const resp = await fetch('/api/chat/support/conversation');
                    if (!resp.ok) {
                        if (container) container.innerHTML = '<div class="p-4 text-center text-danger">Failed to connect to Support.</div>';
                        return;
                    }
                    const conv = await resp.json();
                    currentConversationId = conv.id;
                } else {
                    if (targetUserId <= 0) {
                        window.location.href = '/chat';
                        return;
                    }

                    const resp = await fetch(`/api/chat/with/${targetUserId}`);
                    if (!resp.ok) {
                        const err = await resp.json();
                        Swal.fire({
                            icon: 'warning',
                            title: 'Chat Access',
                            text: err.message || 'Unable to open conversation. You may have reached your message limit.',
                            confirmButtonText: 'View Premium Plans'
                        }).then(() => {
                            window.location.href = '/chat/my-premium';
                        });
                        return;
                    }

                    const conv = await resp.json();
                    currentConversationId = conv.id;

                    if (targetName) targetName.innerText = conv.participantName || 'Member';
                    
                    const defaultImg = (conv.participantGender && String(conv.participantGender).toLowerCase() === 'female')
                        ? '/assets/images/default-user-women.png'
                        : '/assets/images/default-user-men.png';

                    if (targetPhoto) {
                        targetPhoto.src = conv.participantPhotoUrl || defaultImg;
                        targetPhoto.onerror = function () {
                            this.onerror = null;
                            this.src = defaultImg;
                        };
                    }
                    
                    if (conv.isParticipantOnline) {
                        if (onlineDot) onlineDot.className = 'online-dot';
                        if (targetStatus) targetStatus.innerText = 'Active now';
                    } else {
                        if (onlineDot) onlineDot.className = 'online-dot offline';
                        if (targetStatus) targetStatus.innerText = 'Offline';
                    }

                    // Click header to open profile (same as Dashboard / Explore)
                    const headerProfile = document.getElementById('headerProfileBlock');
                    if (headerProfile) {
                        const profileUrl = '/profile/' + (conv.participantRegisterNumber ? conv.participantRegisterNumber : (conv.participantUserId || targetUserId));
                        headerProfile.onclick = () => window.location.href = profileUrl;
                    }
                }

                // Load Messages History
                await loadMessagesHistory();

                // Check and show interest card if first time after acceptance
                await checkAndShowInterestCard();

                // Immediately mark as read in database
                markConversationAsRead();

                // Connect to SignalR
                await initSignalR();

            } catch (err) {
                console.error('Error initializing chat:', err);
                if (container) container.innerHTML = '<div class="p-4 text-center text-danger">Error loading conversation. Please refresh.</div>';
            }
        }

        async function loadMessagesHistory() {
            if (!currentConversationId) return;
            const container = document.getElementById('messagesContainer');
            try {
                const resp = await fetch(`/api/chat/messages/${currentConversationId}?page=1&pageSize=50`);
                if (!resp.ok) {
                    if (container) container.innerHTML = '<div class="p-4 text-center text-muted">No messages yet. Say hello!</div>';
                    return;
                }
                const history = await resp.json();
                const messages = history.messages || [];

                if (messages.length === 0) {
                    if (container) container.innerHTML = '<div class="p-4 text-center text-muted">No messages yet. Send a message to start chatting!</div>';
                    return;
                }

                let html = '';
                messages.forEach(m => {
                    html += renderMessage(m);
                });
                if (container) container.innerHTML = html;
                scrollToBottom();

            } catch (err) {
                console.error('Error loading history:', err);
            }
        }

        async function initSignalR() {
            try {
                // Initialize ChatHub
                chatHub = new signalR.HubConnectionBuilder()
                    .withUrl(`/hubs/chat?userId=${currentUserId}`)
                    .withAutomaticReconnect([0, 2000, 5000, 10000, 30000])
                    .build();

                chatHub.onreconnected(async (connectionId) => {
                    if (currentConversationId > 0) {
                        try {
                            await chatHub.invoke('JoinConversation', currentConversationId);
                            markConversationAsRead();
                        } catch (e) {
                            console.error('Error re-joining conversation:', e);
                        }
                    }
                });

                chatHub.on('ReceiveMessage', (msg) => {
                    if (msg.conversationId === currentConversationId) {
                        appendMessage(msg);
                        if (msg.senderId !== currentUserId) {
                            markConversationAsRead();
                        }
                    }
                });

                chatHub.on('ReceiveSupportMessage', (msg) => {
                    if (isSupportChat && (msg.conversationId === currentConversationId || currentConversationId === 0)) {
                        appendMessage(msg);
                        markConversationAsRead();
                    }
                });

                chatHub.on('MessagesRead', (payload) => {
                    if (payload.conversationId === currentConversationId) {
                        updateReadReceipts();
                    }
                });

                chatHub.on('UnreadCountUpdated', (unreadCount) => {
                    if (typeof updateChatUnreadBadge === 'function') {
                        updateChatUnreadBadge(unreadCount);
                    }
                });

                chatHub.on('UserTyping', (payload) => {
                    if (payload.conversationId === currentConversationId && payload.senderId !== currentUserId) {
                        const typingRow = document.getElementById('typingRow');
                        if (typingRow) {
                            typingRow.style.display = payload.isTyping ? 'flex' : 'none';
                            scrollToBottom();
                        }
                    }
                });

                await chatHub.start();
                if (currentConversationId > 0) {
                    await chatHub.invoke('JoinConversation', currentConversationId);
                }

                // Initialize PresenceHub
                presenceHub = new signalR.HubConnectionBuilder()
                    .withUrl(`/hubs/presence?userId=${currentUserId}`)
                    .withAutomaticReconnect([0, 2000, 5000, 10000, 30000])
                    .build();

                presenceHub.on('UserOnline', (uid) => {
                    if (!isSupportChat && (uid === targetUserId || (window.currentConvParticipantId && window.currentConvParticipantId === uid))) {
                        const dot = document.getElementById('chatOnlineDot');
                        const status = document.getElementById('chatTargetStatus');
                        if (dot) dot.className = 'online-dot';
                        if (status) status.innerText = 'Active now';
                    }
                });

                presenceHub.on('UserOffline', (uid) => {
                    if (!isSupportChat && (uid === targetUserId || (window.currentConvParticipantId && window.currentConvParticipantId === uid))) {
                        const dot = document.getElementById('chatOnlineDot');
                        const status = document.getElementById('chatTargetStatus');
                        if (dot) dot.className = 'online-dot offline';
                        if (status) status.innerText = 'Offline';
                    }
                });

                await presenceHub.start();

            } catch (err) {
                console.error('Error starting SignalR connections:', err);
            }
        }

        async function sendMessage() {
            const input = document.getElementById('messageInput');
            if (!input) return;
            const content = input.value.trim();
            if (!content) return;

            input.value = '';

            try {
                if (isSupportChat) {
                    const resp = await fetch('/api/chat/support/send', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            conversationId: currentConversationId,
                            content: content,
                            messageType: 1 // Text = 1
                        })
                    });

                    if (!resp.ok) {
                        const err = await resp.json();
                        Swal.fire({
                            icon: 'error',
                            title: 'Failed to Send',
                            text: err.message || 'Error sending message.'
                        });
                        return;
                    }

                    const newMsg = await resp.json();
                    appendMessage(newMsg);
                    scrollToBottom();
                } else {
                    const resp = await fetch('/api/chat/send', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            receiverId: targetUserId,
                            content: content,
                            messageType: 1 // Text = 1
                        })
                    });

                    if (!resp.ok) {
                        const err = await resp.json();
                        Swal.fire({
                            icon: 'warning',
                            title: 'Message Limit Reached',
                            text: err.message || 'You have reached your contact limit. Please upgrade to continue.',
                            confirmButtonText: 'Upgrade Plan'
                        }).then(() => {
                            window.location.href = '/chat/my-premium';
                        });
                        return;
                    }

                    const newMsg = await resp.json();
                    appendMessage(newMsg);
                    scrollToBottom();
                }

                // Send typing stopped
                if (chatHub && currentConversationId > 0) {
                    chatHub.invoke('SendTyping', currentConversationId, isSupportChat ? null : targetUserId, false);
                }

            } catch (err) {
                console.error('Error sending message:', err);
            }
        }

        // ==========================================
        // UNIFIED MEDIA UPLOAD & SEND HANDLER
        // ==========================================
        async function uploadAndSendMedia(file, messageType, defaultContent) {
            if (!file) return;
            const formData = new FormData();
            formData.append('file', file);

            const sendBtn = document.getElementById('sendBtn');
            if (sendBtn) sendBtn.disabled = true;

            try {
                const uploadResp = await fetch('/api/chat/upload', {
                    method: 'POST',
                    body: formData
                });

                if (!uploadResp.ok) {
                    const err = await uploadResp.json();
                    Swal.fire({
                        icon: 'error',
                        title: 'Upload Failed',
                        text: err.message || 'Failed to upload attachment.'
                    });
                    if (sendBtn) sendBtn.disabled = false;
                    return;
                }

                const uploadData = await uploadResp.json();
                const contentName = defaultContent || file.name || 'Attachment';

                if (isSupportChat) {
                    const sendResp = await fetch('/api/chat/support/send', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            conversationId: currentConversationId,
                            content: contentName,
                            messageType: messageType, // 1: Text, 2: Image, 3: VoiceNote, 4: Document
                            attachmentUrl: uploadData.attachmentUrl,
                            attachmentFileName: file.name,
                            attachmentFileSize: file.size
                        })
                    });

                    if (!sendResp.ok) {
                        const err = await sendResp.json();
                        Swal.fire({
                            icon: 'error',
                            title: 'Failed to Send',
                            text: err.message || 'Error sending attachment.'
                        });
                        return;
                    }

                    const newMsg = await sendResp.json();
                    appendMessage(newMsg);
                    scrollToBottom();
                } else {
                    const sendResp = await fetch('/api/chat/send', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            receiverId: targetUserId,
                            content: contentName,
                            messageType: messageType,
                            attachmentUrl: uploadData.attachmentUrl,
                            attachmentFileName: file.name,
                            attachmentFileSize: file.size
                        })
                    });

                    if (!sendResp.ok) {
                        const err = await sendResp.json();
                        Swal.fire({
                            icon: 'warning',
                            title: 'Message Limit Reached',
                            text: err.message || 'You have reached your contact limit.',
                            confirmButtonText: 'Upgrade Plan'
                        }).then(() => {
                            window.location.href = '/chat/my-premium';
                        });
                        return;
                    }

                    const newMsg = await sendResp.json();
                    appendMessage(newMsg);
                    scrollToBottom();
                }

            } catch (err) {
                console.error('Error uploading/sending media:', err);
                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: 'An unexpected error occurred while sending.'
                });
            } finally {
                if (sendBtn) sendBtn.disabled = false;
            }
        }

        async function handleFileUpload(fileInput, defaultMessageType) {
            if (!fileInput || !fileInput.files || fileInput.files.length === 0) return;
            const file = fileInput.files[0];
            
            let msgType = defaultMessageType || 4; // 1: Text, 2: Image, 3: VoiceNote, 4: Document
            if (file.type.startsWith('image/')) msgType = 2;
            else if (file.type.startsWith('audio/')) msgType = 3;
            else msgType = 4;

            await uploadAndSendMedia(file, msgType, file.name);
            fileInput.value = '';
        }

        // ==========================================
        // LIVE CAMERA FEATURE
        // ==========================================
        async function openCameraModal() {
            if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
                Swal.fire({
                    icon: 'info',
                    title: 'Camera Access',
                    text: 'Live camera stream is not supported in this browser environment. You can take or choose a photo from your files.',
                    showCancelButton: true,
                    confirmButtonText: 'Select Photo',
                    cancelButtonText: 'Cancel'
                }).then((res) => {
                    if (res.isConfirmed) {
                        const cameraInput = document.getElementById('cameraUploadInput');
                        if (cameraInput) cameraInput.click();
                    }
                });
                return;
            }

            const modal = document.getElementById('cameraModalOverlay');
            const video = document.getElementById('cameraVideo');
            const previewImg = document.getElementById('cameraPreviewImg');
            const liveControls = document.getElementById('cameraLiveControls');
            const previewControls = document.getElementById('cameraPreviewControls');
            const spinner = document.getElementById('cameraLoadingSpinner');

            capturedBlob = null;
            if (previewImg) {
                previewImg.style.display = 'none';
                previewImg.src = '';
            }
            if (video) video.style.display = 'block';
            if (liveControls) liveControls.style.display = 'flex';
            if (previewControls) previewControls.style.display = 'none';
            if (spinner) spinner.style.display = 'flex';
            if (modal) modal.style.display = 'flex';

            // Check if multiple camera devices exist to show flip button
            try {
                const devices = await navigator.mediaDevices.enumerateDevices();
                const videoDevices = devices.filter(d => d.kind === 'videoinput');
                const switchBtn = document.getElementById('switchCameraBtn');
                if (switchBtn) {
                    switchBtn.style.display = videoDevices.length > 1 ? 'inline-flex' : 'none';
                }
            } catch (e) {
                console.warn('Could not enumerate media devices:', e);
            }

            await startCameraStream();
        }

        async function startCameraStream() {
            const video = document.getElementById('cameraVideo');
            const spinner = document.getElementById('cameraLoadingSpinner');

            if (cameraStream) {
                cameraStream.getTracks().forEach(t => t.stop());
                cameraStream = null;
            }

            try {
                try {
                    cameraStream = await navigator.mediaDevices.getUserMedia({
                        video: {
                            facingMode: currentFacingMode,
                            width: { ideal: 1280 },
                            height: { ideal: 720 }
                        },
                        audio: false
                    });
                } catch (err) {
                    // Fallback without exact constraints
                    cameraStream = await navigator.mediaDevices.getUserMedia({
                        video: true,
                        audio: false
                    });
                }

                if (video) {
                    video.srcObject = cameraStream;
                    await video.play();
                }
                if (spinner) spinner.style.display = 'none';
            } catch (err) {
                console.error('Camera access error:', err);
                if (spinner) spinner.style.display = 'none';
                closeCameraModal();
                Swal.fire({
                    icon: 'warning',
                    title: 'Camera Permission',
                    text: 'Unable to access your camera. Please allow camera permissions in your browser or select an image file.',
                    showCancelButton: true,
                    confirmButtonText: 'Choose from Files',
                    cancelButtonText: 'Cancel'
                }).then((res) => {
                    if (res.isConfirmed) {
                        const cameraInput = document.getElementById('cameraUploadInput');
                        if (cameraInput) cameraInput.click();
                    }
                });
            }
        }

        function closeCameraModal() {
            if (cameraStream) {
                cameraStream.getTracks().forEach(t => t.stop());
                cameraStream = null;
            }
            const modal = document.getElementById('cameraModalOverlay');
            if (modal) modal.style.display = 'none';
            capturedBlob = null;
        }

        async function switchCamera() {
            currentFacingMode = currentFacingMode === 'user' ? 'environment' : 'user';
            const spinner = document.getElementById('cameraLoadingSpinner');
            if (spinner) spinner.style.display = 'flex';
            await startCameraStream();
        }

        function capturePhoto() {
            const video = document.getElementById('cameraVideo');
            const canvas = document.getElementById('cameraCanvas');
            const previewImg = document.getElementById('cameraPreviewImg');
            const liveControls = document.getElementById('cameraLiveControls');
            const previewControls = document.getElementById('cameraPreviewControls');

            if (!video || !canvas) return;

            canvas.width = video.videoWidth || 640;
            canvas.height = video.videoHeight || 480;
            const ctx = canvas.getContext('2d');
            ctx.drawImage(video, 0, 0, canvas.width, canvas.height);

            canvas.toBlob((blob) => {
                if (!blob) return;
                capturedBlob = blob;
                const url = URL.createObjectURL(blob);
                if (previewImg) {
                    previewImg.src = url;
                    previewImg.style.display = 'block';
                }
                if (video) video.style.display = 'none';
                if (liveControls) liveControls.style.display = 'none';
                if (previewControls) previewControls.style.display = 'flex';
            }, 'image/jpeg', 0.9);
        }

        function retakePhoto() {
            capturedBlob = null;
            const video = document.getElementById('cameraVideo');
            const previewImg = document.getElementById('cameraPreviewImg');
            const liveControls = document.getElementById('cameraLiveControls');
            const previewControls = document.getElementById('cameraPreviewControls');

            if (previewImg) {
                previewImg.style.display = 'none';
                previewImg.src = '';
            }
            if (video) video.style.display = 'block';
            if (liveControls) liveControls.style.display = 'flex';
            if (previewControls) previewControls.style.display = 'none';
        }

        async function sendCapturedPhoto() {
            if (!capturedBlob) return;
            const photoFile = new File([capturedBlob], `photo_${Date.now()}.jpg`, { type: 'image/jpeg' });
            closeCameraModal();
            await uploadAndSendMedia(photoFile, 2, 'Photo');
        }

        // ==========================================
        // WHATSAPP-STYLE VOICE NOTE RECORDING FEATURE
        // ==========================================
        async function startVoiceRecording() {
            if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia || !window.MediaRecorder) {
                Swal.fire({
                    icon: 'info',
                    title: 'Audio Recording',
                    text: 'Direct audio recording is not supported in this browser. You can select an audio file to send.',
                    showCancelButton: true,
                    confirmButtonText: 'Choose Audio',
                    cancelButtonText: 'Cancel'
                }).then((res) => {
                    if (res.isConfirmed) {
                        const audioInput = document.getElementById('audioUploadInput');
                        if (audioInput) audioInput.click();
                    }
                });
                return;
            }

            try {
                audioStream = await navigator.mediaDevices.getUserMedia({ audio: true });
                
                let mimeType = 'audio/webm;codecs=opus';
                if (!MediaRecorder.isTypeSupported(mimeType)) mimeType = 'audio/webm';
                if (!MediaRecorder.isTypeSupported(mimeType)) mimeType = 'audio/ogg;codecs=opus';
                if (!MediaRecorder.isTypeSupported(mimeType)) mimeType = 'audio/mp4';
                if (!MediaRecorder.isTypeSupported(mimeType)) mimeType = '';

                mediaRecorder = mimeType ? new MediaRecorder(audioStream, { mimeType }) : new MediaRecorder(audioStream);
                audioChunks = [];
                isCancelledRecording = false;

                mediaRecorder.ondataavailable = (e) => {
                    if (e.data && e.data.size > 0) {
                        audioChunks.push(e.data);
                    }
                };

                mediaRecorder.onstop = async () => {
                    const elapsedSecs = Math.floor((Date.now() - recordingStartTime) / 1000);
                    
                    if (isCancelledRecording || audioChunks.length === 0) {
                        return;
                    }

                    if (elapsedSecs < 1) {
                        Swal.fire({
                            toast: true,
                            position: 'bottom-end',
                            icon: 'info',
                            title: 'Recording too short',
                            showConfirmButton: false,
                            timer: 2000
                        });
                        return;
                    }

                    const recMimeType = mediaRecorder.mimeType || 'audio/webm';
                    const audioBlob = new Blob(audioChunks, { type: recMimeType });
                    
                    let ext = '.webm';
                    if (recMimeType.includes('ogg')) ext = '.ogg';
                    else if (recMimeType.includes('mp4') || recMimeType.includes('aac')) ext = '.mp4';
                    else if (recMimeType.includes('wav')) ext = '.wav';

                    const voiceFile = new File([audioBlob], `voice_note_${Date.now()}${ext}`, { type: recMimeType });
                    await uploadAndSendMedia(voiceFile, 3, 'Voice Note');
                };

                // Switch Input UI to Recording Bar
                const normalInputs = document.getElementById('chatNormalInputs');
                const recordingBar = document.getElementById('voiceRecordingBar');
                const timerElem = document.getElementById('recordingTimer');

                if (normalInputs) normalInputs.style.setProperty('display', 'none', 'important');
                if (recordingBar) recordingBar.style.display = 'flex';
                if (timerElem) timerElem.innerText = '00:00';

                recordingStartTime = Date.now();
                clearInterval(recordingTimerInterval);
                recordingTimerInterval = setInterval(() => {
                    const elapsed = Math.floor((Date.now() - recordingStartTime) / 1000);
                    const mins = String(Math.floor(elapsed / 60)).padStart(2, '0');
                    const secs = String(elapsed % 60).padStart(2, '0');
                    if (timerElem) timerElem.innerText = `${mins}:${secs}`;
                }, 500);

                mediaRecorder.start(250);

            } catch (err) {
                console.error('Microphone access error:', err);
                cancelVoiceRecording();
                Swal.fire({
                    icon: 'warning',
                    title: 'Microphone Permission',
                    text: 'Could not access your microphone. Please grant microphone permissions to record voice notes.',
                    showCancelButton: true,
                    confirmButtonText: 'Choose Audio File',
                    cancelButtonText: 'Cancel'
                }).then((res) => {
                    if (res.isConfirmed) {
                        const audioInput = document.getElementById('audioUploadInput');
                        if (audioInput) audioInput.click();
                    }
                });
            }
        }

        function cancelVoiceRecording() {
            isCancelledRecording = true;
            clearInterval(recordingTimerInterval);

            if (mediaRecorder && mediaRecorder.state !== 'inactive') {
                mediaRecorder.stop();
            }
            if (audioStream) {
                audioStream.getTracks().forEach(t => t.stop());
                audioStream = null;
            }

            const normalInputs = document.getElementById('chatNormalInputs');
            const recordingBar = document.getElementById('voiceRecordingBar');
            if (recordingBar) recordingBar.style.display = 'none';
            if (normalInputs) normalInputs.style.setProperty('display', 'flex', 'important');
        }

        function finishAndSendVoiceRecording() {
            isCancelledRecording = false;
            clearInterval(recordingTimerInterval);

            if (mediaRecorder && mediaRecorder.state !== 'inactive') {
                mediaRecorder.stop();
            }
            if (audioStream) {
                audioStream.getTracks().forEach(t => t.stop());
                audioStream = null;
            }

            const normalInputs = document.getElementById('chatNormalInputs');
            const recordingBar = document.getElementById('voiceRecordingBar');
            if (recordingBar) recordingBar.style.display = 'none';
            if (normalInputs) normalInputs.style.setProperty('display', 'flex', 'important');
        }

        // ==========================================
        // VOICE NOTE PLAYER
        // ==========================================
        function playVoiceNote(btn) {
            const player = btn.closest('.voice-player');
            if (!player) return;
            const audio = player.querySelector('audio');
            if (!audio) return;
            const waveform = player.querySelector('.waveform');
            const durationElem = player.querySelector('.duration');

            if (audio.paused) {
                // Pause any other playing audio
                document.querySelectorAll('.voice-player audio').forEach(a => {
                    if (a !== audio && !a.paused) {
                        a.pause();
                        a.currentTime = 0;
                        const otherPlayer = a.closest('.voice-player');
                        if (otherPlayer) {
                            const otherBtn = otherPlayer.querySelector('.play-button');
                            const otherWf = otherPlayer.querySelector('.waveform');
                            const otherDur = otherPlayer.querySelector('.duration');
                            if (otherBtn) otherBtn.innerHTML = '<svg viewBox="0 0 24 24"><path d="M8 5L19 12L8 19V5Z"/></svg>';
                            if (otherWf) otherWf.classList.remove('is-playing');
                            if (otherDur) otherDur.innerText = 'Voice Note';
                        }
                    }
                });

                audio.play();
                btn.innerHTML = '<svg viewBox="0 0 24 24"><rect x="7" y="5" width="3" height="14" fill="currentColor"></rect><rect x="14" y="5" width="3" height="14" fill="currentColor"></rect></svg>';
                if (waveform) waveform.classList.add('is-playing');

                audio.ontimeupdate = () => {
                    if (durationElem && audio.duration && !isNaN(audio.duration)) {
                        const cur = Math.floor(audio.currentTime);
                        const mins = String(Math.floor(cur / 60)).padStart(2, '0');
                        const secs = String(cur % 60).padStart(2, '0');
                        durationElem.innerText = `${mins}:${secs}`;
                    }
                };

                audio.onended = () => {
                    btn.innerHTML = '<svg viewBox="0 0 24 24"><path d="M8 5L19 12L8 19V5Z"/></svg>';
                    if (waveform) waveform.classList.remove('is-playing');
                    if (durationElem) durationElem.innerText = 'Voice Note';
                };
            } else {
                audio.pause();
                btn.innerHTML = '<svg viewBox="0 0 24 24"><path d="M8 5L19 12L8 19V5Z"/></svg>';
                if (waveform) waveform.classList.remove('is-playing');
            }
        }

        // ==========================================
        // EVENT LISTENERS BINDINGS
        // ==========================================
        document.addEventListener('DOMContentLoaded', () => {
            initChat();

            const messageInput = document.getElementById('messageInput');
            const sendBtn = document.getElementById('sendBtn');
            const attachmentBtn = document.getElementById('attachmentBtn');
            const fileUploadInput = document.getElementById('fileUploadInput');
            const cameraBtn = document.getElementById('cameraBtn');
            const cameraUploadInput = document.getElementById('cameraUploadInput');
            const micBtn = document.getElementById('micBtn');
            const audioUploadInput = document.getElementById('audioUploadInput');

            // Text input listeners
            if (messageInput) {
                messageInput.addEventListener('keydown', (e) => {
                    if (e.key === 'Enter' && !e.shiftKey) {
                        e.preventDefault();
                        sendMessage();
                    } else {
                        // Send typing status throttled
                        const now = Date.now();
                        if (now - lastTypingSent > 3000 && chatHub && currentConversationId > 0) {
                            lastTypingSent = now;
                            chatHub.invoke('SendTyping', currentConversationId, isSupportChat ? null : targetUserId, true);
                            clearTimeout(typingTimeout);
                            typingTimeout = setTimeout(() => {
                                if (chatHub && currentConversationId > 0) {
                                    chatHub.invoke('SendTyping', currentConversationId, isSupportChat ? null : targetUserId, false);
                                }
                            }, 4000);
                        }
                    }
                });
            }

            if (sendBtn) {
                sendBtn.addEventListener('click', sendMessage);
            }

            // File Attachment listener
            if (attachmentBtn && fileUploadInput) {
                attachmentBtn.addEventListener('click', () => fileUploadInput.click());
                fileUploadInput.addEventListener('change', () => handleFileUpload(fileUploadInput, 4));
            }

            // Camera button -> Open Live Camera Modal
            if (cameraBtn) {
                cameraBtn.addEventListener('click', openCameraModal);
            }
            if (cameraUploadInput) {
                cameraUploadInput.addEventListener('change', () => handleFileUpload(cameraUploadInput, 2));
            }

            // Camera Modal Controls
            const closeCameraBtn = document.getElementById('closeCameraBtn');
            const switchCameraBtn = document.getElementById('switchCameraBtn');
            const capturePhotoBtn = document.getElementById('capturePhotoBtn');
            const retakePhotoBtn = document.getElementById('retakePhotoBtn');
            const sendCapturedPhotoBtn = document.getElementById('sendCapturedPhotoBtn');
            const cameraModalOverlay = document.getElementById('cameraModalOverlay');

            if (closeCameraBtn) closeCameraBtn.addEventListener('click', closeCameraModal);
            if (switchCameraBtn) switchCameraBtn.addEventListener('click', switchCamera);
            if (capturePhotoBtn) capturePhotoBtn.addEventListener('click', capturePhoto);
            if (retakePhotoBtn) retakePhotoBtn.addEventListener('click', retakePhoto);
            if (sendCapturedPhotoBtn) sendCapturedPhotoBtn.addEventListener('click', sendCapturedPhoto);

            if (cameraModalOverlay) {
                cameraModalOverlay.addEventListener('click', (e) => {
                    if (e.target === cameraModalOverlay) {
                        closeCameraModal();
                    }
                });
            }

            // Microphone button -> WhatsApp style live recording
            if (micBtn) {
                micBtn.addEventListener('click', startVoiceRecording);
            }
            if (audioUploadInput) {
                audioUploadInput.addEventListener('change', () => handleFileUpload(audioUploadInput, 3));
            }

            const cancelVoiceBtn = document.getElementById('cancelVoiceBtn');
            const sendVoiceBtn = document.getElementById('sendVoiceBtn');

            if (cancelVoiceBtn) cancelVoiceBtn.addEventListener('click', cancelVoiceRecording);
            if (sendVoiceBtn) sendVoiceBtn.addEventListener('click', finishAndSendVoiceRecording);

            // Escape key handler
            window.addEventListener('keydown', (e) => {
                if (e.key === 'Escape') {
                    closeCameraModal();
                    if (mediaRecorder && mediaRecorder.state === 'recording') {
                        cancelVoiceRecording();
                    }
                }
            });

            // Call buttons (Header)
            const headerAudioCallBtn = document.getElementById('headerAudioCallBtn');
            const headerVideoCallBtn = document.getElementById('headerVideoCallBtn');
            if (headerAudioCallBtn) headerAudioCallBtn.addEventListener('click', handleVoiceCallClick);
            if (headerVideoCallBtn) headerVideoCallBtn.addEventListener('click', handleVideoCallClick);

            // Interest Card action buttons
            const interestCardChatBtn = document.getElementById('interestCardChatBtn');
            const interestCardAudioBtn = document.getElementById('interestCardAudioBtn');
            const interestCardVideoBtn = document.getElementById('interestCardVideoBtn');
            const interestCardProfileBtn = document.getElementById('interestCardProfileBtn');

            if (interestCardChatBtn) {
                interestCardChatBtn.addEventListener('click', (e) => {
                    e.preventDefault();
                    const card = document.getElementById('chatInterestCard');
                    if (card) card.style.display = 'none';
                    const input = document.getElementById('messageInput');
                    if (input) input.focus();
                });
            }

            if (interestCardAudioBtn) {
                interestCardAudioBtn.addEventListener('click', handleVoiceCallClick);
            }

            if (interestCardVideoBtn) {
                interestCardVideoBtn.addEventListener('click', handleVideoCallClick);
            }

            if (interestCardProfileBtn) {
                interestCardProfileBtn.addEventListener('click', (e) => {
                    e.preventDefault();
                    if (targetUserId > 0) {
                        window.location.href = `/profile/${targetUserId}`;
                    }
                });
            }
        });

        // ==========================================
        // CALL & INTEREST CARD FUNCTIONS
        // ==========================================
        async function checkAndShowInterestCard() {
            const card = document.getElementById('chatInterestCard') || document.querySelector('.interest-card');
            if (!card) return;

            if (isSupportChat || targetUserId <= 0) {
                card.style.display = 'none';
                return;
            }

            try {
                const resp = await fetch(`/api/chat/interest-status/${targetUserId}`);
                if (!resp.ok) {
                    card.style.display = 'none';
                    return;
                }
                const data = await resp.json();
                
                if (data.isAccepted && data.showInterestCard) {
                    card.style.display = 'block';
                    // Mark as shown so it doesn't appear next time
                    await fetch(`/api/chat/interest-card-shown/${targetUserId}`, { method: 'POST' });
                } else {
                    card.style.display = 'none';
                }
            } catch(e) {
                console.error('Interest status check error:', e);
                card.style.display = 'none';
            }
        }

        async function handleVoiceCallClick(e) {
            if (e) e.preventDefault();
            if (isSupportChat) {
                showCallPopup("Voice Call", "Calls are not available in Support Chat.", false);
                return;
            }
            if (!targetUserId || targetUserId <= 0) return;

            try {
                const resp = await fetch(`/api/call/check-permission/${targetUserId}?callType=0`);
                const permData = await resp.json();
                
                if (!permData.allowed) {
                    if (permData.interestRequired) {
                        showCallPopup("Interest Required", permData.reason || "You need mutual interest acceptance before making calls.", false);
                    } else if (permData.requiresUpgrade || permData.audioLimitReached) {
                        showCallPopup("Plan Limit Reached", permData.reason || "Upgrade your plan to make audio calls.", true);
                    } else {
                        showCallPopup("Cannot Call", permData.reason || "Unable to make this call.", false);
                    }
                    return;
                }
                window.location.href = `/call/voice/${targetUserId}`;
            } catch(err) {
                console.error('Call permission error:', err);
                window.location.href = `/call/voice/${targetUserId}`;
            }
        }

        async function handleVideoCallClick(e) {
            if (e) e.preventDefault();
            if (isSupportChat) {
                showCallPopup("Video Call", "Calls are not available in Support Chat.", false);
                return;
            }
            if (!targetUserId || targetUserId <= 0) return;

            try {
                const resp = await fetch(`/api/call/check-permission/${targetUserId}?callType=1`);
                const permData = await resp.json();
                
                if (!permData.allowed) {
                    if (permData.interestRequired) {
                        showCallPopup("Interest Required", permData.reason || "You need mutual interest acceptance before making calls.", false);
                    } else if (permData.requiresUpgrade || permData.videoLimitReached) {
                        showCallPopup("Plan Limit Reached", permData.reason || "Upgrade your plan to make video calls.", true);
                    } else {
                        showCallPopup("Cannot Call", permData.reason || "Unable to make this call.", false);
                    }
                    return;
                }
                window.location.href = `/call/video/${targetUserId}`;
            } catch(err) {
                console.error('Call permission error:', err);
                window.location.href = `/call/video/${targetUserId}`;
            }
        }

        function showCallPopup(title, message, requiresUpgrade) {
            if (typeof Swal !== 'undefined') {
                Swal.fire({
                    icon: requiresUpgrade ? 'warning' : 'info',
                    title: title,
                    text: message,
                    confirmButtonColor: '#007b3d',
                    confirmButtonText: requiresUpgrade ? 'View Premium Plans' : 'OK',
                    showCancelButton: requiresUpgrade,
                    cancelButtonText: 'Cancel'
                }).then((result) => {
                    if (result.isConfirmed && requiresUpgrade) {
                        window.location.href = '/chat/my-premium';
                    }
                });
                return;
            }
            
            const overlay = document.createElement('div');
            overlay.style.cssText = 'position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.5);z-index:9999;display:flex;align-items:center;justify-content:center;';
            overlay.innerHTML = `
                <div style="background:#fff;border-radius:16px;padding:28px 32px;max-width:360px;text-align:center;box-shadow:0 8px 32px rgba(0,0,0,0.2);">
                    <h3 style="margin:0 0 8px;font-size:18px;color:#333;">${escapeHtml(title)}</h3>
                    <p style="margin:0 0 20px;font-size:14px;color:#666;line-height:1.5;">${escapeHtml(message)}</p>
                    <button onclick="this.closest('div').parentElement.remove(); ${requiresUpgrade ? "window.location.href='/chat/my-premium';" : ""}" 
                            style="background:#007b3d;color:#fff;border:none;border-radius:24px;padding:10px 28px;font-size:14px;cursor:pointer;">
                        ${requiresUpgrade ? 'View Premium Plans' : 'OK'}
                    </button>
                </div>
            `;
            document.body.appendChild(overlay);
            overlay.addEventListener('click', (e) => { if (e.target === overlay) overlay.remove(); });
        }
    </script>
}