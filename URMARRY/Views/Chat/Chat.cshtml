@{
    Layout = "/Views/Shared/_LayoutAccount.cshtml";
}

<style>
    /* Chat Header Online Dot Status (Matching ChatList colors) */
    .online-dot {
        position: absolute;
        width: 13px;
        height: 13px;
        background: #55c934 !important;
        border-radius: 50%;
        right: 1px;
        bottom: -6px;
        border: 2px solid #fff;
    }

    .online-dot.offline {
        background: #999 !important;
    }

    /* Voice Recording Bar (WhatsApp Style) */
    .voice-recording-bar {
        display: flex;
        align-items: center;
        width: 100%;
        height: 56px;
        background: #fdf2f2;
        border: 1px solid #fed7d7;
        border-radius: 28px;
        padding: 0 12px 0 16px;
        gap: 12px;
        animation: fadeInSlideUp 0.2s ease-out;
    }

    .cancel-recording-btn {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        border: none;
        background: #fee2e2;
        color: #dc2626;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 0.2s;
        flex-shrink: 0;
    }

    .cancel-recording-btn:hover {
        background: #fca5a5;
        color: #991b1b;
        transform: scale(1.05);
    }

    .recording-indicator {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-shrink: 0;
    }

    .recording-pulse-dot {
        width: 11px;
        height: 11px;
        border-radius: 50%;
        background-color: #ef4444;
        animation: pulseRecording 1.2s infinite ease-in-out;
    }

    @@keyframes pulseRecording {
        0% {
            transform: scale(0.9);
            box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.7);
        }

        70% {
            transform: scale(1.2);
            box-shadow: 0 0 0 8px rgba(239, 68, 68, 0);
        }

        100% {
            transform: scale(0.9);
            box-shadow: 0 0 0 0 rgba(239, 68, 68, 0);
        }
    }

    .recording-timer {
        font-size: 14px;
        font-weight: 600;
        color: #dc2626;
        font-variant-numeric: tabular-nums;
        min-width: 44px;
    }

    .recording-waves {
        display: flex;
        align-items: center;
        gap: 3px;
        flex: 1;
        height: 24px;
        justify-content: center;
        overflow: hidden;
    }

    .recording-waves span {
        width: 3px;
        height: 6px;
        background: #ef4444;
        border-radius: 3px;
        animation: soundWave 1.1s infinite ease-in-out;
    }

    .recording-waves span:nth-child(2) {
        animation-delay: 0.1s;
    }

    .recording-waves span:nth-child(3) {
        animation-delay: 0.2s;
    }

    .recording-waves span:nth-child(4) {
        animation-delay: 0.3s;
    }

    .recording-waves span:nth-child(5) {
        animation-delay: 0.4s;
    }

    .recording-waves span:nth-child(6) {
        animation-delay: 0.5s;
    }

    .recording-waves span:nth-child(7) {
        animation-delay: 0.6s;
    }

    .recording-waves span:nth-child(8) {
        animation-delay: 0.7s;
    }

    .recording-waves span:nth-child(9) {
        animation-delay: 0.8s;
    }

    .recording-waves span:nth-child(10) {
        animation-delay: 0.9s;
    }

    .recording-waves span:nth-child(11) {
        animation-delay: 1.0s;
    }

    .recording-waves span:nth-child(12) {
        animation-delay: 0.3s;
    }

    .recording-waves span:nth-child(13) {
        animation-delay: 0.5s;
    }

    .recording-waves span:nth-child(14) {
        animation-delay: 0.2s;
    }

    .recording-waves span:nth-child(15) {
        animation-delay: 0.4s;
    }

    @@keyframes soundWave {

        0%,
        100% {
            height: 4px;
            opacity: 0.4;
        }

        50% {
            height: 20px;
            opacity: 1;
        }
    }

    .send-recording-btn {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        border: none;
        background: #007b35;
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 0.2s;
        box-shadow: 0 2px 8px rgba(0, 123, 53, 0.35);
        flex-shrink: 0;
    }

    .send-recording-btn:hover {
        background: #00632b;
        transform: scale(1.06);
    }

    /* Voice message received vs sent styling */
    .voice-message-row.received {
        justify-content: flex-start;
    }

    .voice-message-row.received .voice-player {
        background: #e2e8f0;
        border-radius: 0 10px 10px 10px;
    }

    .voice-message-row.received .play-button {
        background: #007b35;
    }

    .voice-message-row.received .play-button svg {
        fill: #fff;
        stroke: #fff;
    }

    .voice-message-row.received .waveform span {
        background: #64748b;
    }

    .voice-message-row.received .duration {
        color: #475569;
    }

    .voice-message-row.received .voice-time {
        text-align: left;
        padding-left: 10px;
        padding-right: 0;
    }

    .waveform.is-playing span {
        animation: wavePlaying 0.8s infinite ease-in-out alternate;
    }

    .waveform.is-playing span:nth-child(2n) {
        animation-delay: 0.15s;
    }

    .waveform.is-playing span:nth-child(3n) {
        animation-delay: 0.3s;
    }

    .waveform.is-playing span:nth-child(4n) {
        animation-delay: 0.45s;
    }

    @@keyframes wavePlaying {
        0% {
            transform: scaleY(0.4);
        }

        100% {
            transform: scaleY(1.3);
        }
    }

    /* Camera Modal Overlay */
    .camera-modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        background: rgba(0, 0, 0, 0.85);
        backdrop-filter: blur(5px);
        z-index: 10500;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 16px;
        animation: fadeIn 0.2s ease-out;
    }

    .camera-modal-container {
        background: #18181b;
        border-radius: 20px;
        max-width: 540px;
        width: 100%;
        max-height: 92vh;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        box-shadow: 0 25px 50px rgba(0, 0, 0, 0.6);
        border: 1px solid rgba(255, 255, 255, 0.12);
    }

    .camera-modal-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 14px 20px;
        background: #27272a;
        color: #fff;
    }

    .camera-title {
        font-size: 15px;
        font-weight: 600;
        color: #f4f4f5;
        display: flex;
        align-items: center;
    }

    .camera-header-actions {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .camera-icon-btn {
        background: rgba(255, 255, 255, 0.12);
        border: none;
        border-radius: 50%;
        width: 36px;
        height: 36px;
        color: #e4e4e7;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 0.2s;
    }

    .camera-icon-btn:hover {
        background: rgba(255, 255, 255, 0.25);
        color: #fff;
    }

    .camera-viewport {
        position: relative;
        width: 100%;
        min-height: 320px;
        max-height: 60vh;
        background: #09090b;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
    }

    .camera-viewport video,
    .camera-viewport img {
        width: 100%;
        height: 100%;
        max-height: 60vh;
        object-fit: contain;
        display: block;
    }

    .camera-loading-spinner {
        position: absolute;
        inset: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        background: rgba(0, 0, 0, 0.7);
        z-index: 2;
    }

    .camera-modal-footer {
        padding: 16px 20px;
        background: #27272a;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .camera-controls-row {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 16px;
        width: 100%;
    }

    .camera-shutter-btn {
        width: 64px;
        height: 64px;
        border-radius: 50%;
        border: 4px solid #fff;
        background: transparent;
        padding: 4px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: transform 0.15s ease;
    }

    .camera-shutter-btn:active {
        transform: scale(0.92);
    }

    .camera-shutter-btn .shutter-inner {
        width: 100%;
        height: 100%;
        background: #ef4444;
        border-radius: 50%;
        display: block;
        transition: background 0.15s ease;
    }

    .camera-shutter-btn:hover .shutter-inner {
        background: #dc2626;
    }

    @@keyframes fadeInSlideUp {
        from {
            opacity: 0;
            transform: translateY(6px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
        }

        to {
            opacity: 1;
        }
    }
</style>

