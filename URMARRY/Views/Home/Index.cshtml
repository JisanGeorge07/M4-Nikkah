		  $(document).ready(function () {
			var isEmailAvailable = false;
			var isPhoneAvailable = false;

			window.checkFieldValidation = function(fieldId) {
				var $el = $('#' + fieldId);
				if (!$el.length) return;
				
				var val = $el.val();
				var isValid = false;
				
				switch (fieldId) {
					case 'Name':
					case 'FamilyName':
					case 'FatherName':
					case 'Post':
					case 'About':
						isValid = (val !== null && val.trim() !== "");
						break;
						
					case 'Phone':
						var phoneVal = val ? val.trim() : "";
						isValid = (phoneVal !== "" && /^\d{8,10}$/.test(phoneVal) && isPhoneAvailable);
						break;
						
					case 'Email':
						var emailVal = val ? val.trim() : "";
						isValid = (emailVal !== "" && validateEmail(emailVal) && isEmailAvailable);
						break;
						
					case 'Password':
						isValid = (val !== null && val.length >= 6);
						break;
						
					case 'PinCode':
						var pinVal = val ? val.trim() : "";
						isValid = (pinVal !== "" && /^\d{6}$/.test(pinVal));
						break;
						
					case 'LandlineNumber':
						var landlineVal = val ? val.trim() : "";
						isValid = (landlineVal !== "" && /^\d{8,10}$/.test(landlineVal));
						break;
						
					case 'ProfileForId':
					case 'ReligionId':
					case 'NationalityId':
					case 'MaritalStatusId':
					case 'HeightId':
					case 'WeightId':
					case 'ComplexionId':
					case 'BodyTypeId':
					case 'ProfessionId':
					case 'MotherTongueId':
					case 'CommunityId':
					case 'ReligiousnessId':
					case 'FinancialStatusId':
						isValid = (val !== null && val !== "" && val !== "0");
						break;
						
					case 'NumberOfChildrens':
						var maritalStatus = $('#MaritalStatusId').val();
						if (maritalStatus === '1') {
							isValid = true;
						} else {
							isValid = (val !== null && val !== "" && val !== "0");
						}
						break;
						
					case 'PhysicallyChallengedDetail':
						var physicallyChallenged = $('input[name="IsPhysicallyChallenged"]:checked').val();
						if (physicallyChallenged === 'No') {
							isValid = true;
						} else {
							isValid = (val !== null && val !== "" && val !== "0");
						}
						break;
						
					case 'HighestEducation':
					case 'ProfessionType':
						isValid = (val !== null && val.trim() !== "");
						break;
						
					case 'EducationType':
						if (Array.isArray(val)) {
							isValid = (val.length > 0);
						} else {
							isValid = (val !== null && val.trim() !== "");
						}
						break;
						
					case 'Year':
					case 'Month':
					case 'Day':
						// Do not show green ticks for DOB dropdowns to prevent clutter and text clipping on mobile screens
						isValid = (val !== null && val !== "" && val !== undefined);
						break;
						
					case 'Country':
					case 'PresentCountry':
						isValid = (val !== null && val.trim() !== "");
						break;
						
					case 'State':
						var country = $('#Country').val();
						if (country === 'India') {
							isValid = (val !== null && val.trim() !== "");
						} else {
							isValid = true;
						}
						break;
						
					case 'District':
						var country = $('#Country').val();
						if (country === 'India') {
							isValid = (val !== null && val.trim() !== "");
						} else {
							isValid = true;
						}
						break;
						
					case 'Village':
						var state = $('#State').val();
						if (state === 'Kerala') {
							isValid = (val !== null && val.trim() !== "");
						} else {
							isValid = true;
						}
						break;
						
					default:
						break;
				}
				
				// Apply classes
				var wrapper = $el.closest('.custom-select-wrapper');
				if (wrapper.length) {
					var trigger = wrapper.find('.custom-select-trigger');
					if (isValid) {
						trigger.addClass('is-valid');
						trigger.removeClass('is-invalid');
					} else {
						trigger.removeClass('is-valid');
					}
				} 
				
				if ($el.hasClass('reg-select-native')) {
					if (isValid) {
						$el.addClass('is-valid');
						$el.removeClass('is-invalid');
					} else {
						$el.removeClass('is-valid');
					}
				} else if ($el.hasClass('reg-input-custom') || $el.is('textarea')) {
					if (isValid) {
						$el.addClass('is-valid');
						$el.removeClass('is-invalid');
					} else {
						$el.removeClass('is-valid');
					}
				}
			};
 
			window.checkDobGroupValidation = function() {
				var d = $('#Day').val();
				var m = $('#Month').val();
				var y = $('#Year').val();
				var isValid = (d !== "" && d !== null && d !== undefined && m !== "" && m !== null && m !== undefined && y !== "" && y !== null && y !== undefined);
				if (isValid) {
					$('#dobSuccessTick').addClass('active');
				} else {
					$('#dobSuccessTick').removeClass('active');
				}
			};
 
			window.checkGenderGroupValidation = function() {
				var isValid = ($('input[name="Gender"]:checked').length > 0);
				if (isValid) {
					$('#genderSuccessTick').addClass('active');
					$('.malefemale').addClass('is-valid').removeClass('is-invalid');
				} else {
					$('#genderSuccessTick').removeClass('active');
					$('.malefemale').removeClass('is-valid');
				}
			};

			window.checkPhysicalGroupValidation = function() {
				var isValid = ($('input[name="IsPhysicallyChallenged"]:checked').length > 0);
				if (isValid) {
					$('#physicalSuccessTick').addClass('active');
				} else {
					$('#physicalSuccessTick').removeClass('active');
				}
			};

			// Dynamic validation scan on load and input change
			window.validateAllFields = function() {
				$('#msform').find('input, select, textarea').each(function() {
					if (this.id) {
						checkFieldValidation(this.id);
					}
				});
				window.checkDobGroupValidation();
				window.checkGenderGroupValidation();
				window.checkPhysicalGroupValidation();
			};

			// Listen for standard input events to show ticks on live insertion
			$('#msform').on('input change', 'input, select, textarea', function() {
				if (this.id) {
					checkFieldValidation(this.id);
				}
				window.checkDobGroupValidation();
				window.checkGenderGroupValidation();
				window.checkPhysicalGroupValidation();
			});

			@if (Model.Registration != null && Model.Registration.Id > 0 && !Model.Registration.IsComplete)
			{
				<text>
				// Show the welcome back modal
				setTimeout(function() {
					$("#resumeRegistrationModal").addClass("active");
				}, 500);

				window.hideResumeRegistrationModal = function() {
					$("#resumeRegistrationModal").removeClass("active");
				};

				// Populate/pre-fill the values
				var savedData = {
					Id: '@Model.Registration.Id',
					ProfileForId: '@Model.Registration.ProfileForId',
					Name: '@Html.Raw(Model.Registration.Name)',
					Email: '@Html.Raw(Model.Registration.Email)',
					Phone: '@Model.Registration.Phone',
					Gender: '@Model.Registration.Gender',
					Password: '', // Don't prefill password
					Day: '@Model.Registration.Day',
					Month: '@Model.Registration.Month',
					Year: '@Model.Registration.Year',
					ReligionId: '@Model.Registration.ReligionId',
					NationalityId: '@Model.Registration.NationalityId',
					MaritalStatusId: '@Model.Registration.MaritalStatusId',
					NumberOfChildrens: '@Model.Registration.NumberOfChildrens',
					HeightId: '@Model.Registration.HeightId',
					WeightId: '@Model.Registration.WeightId',
					ComplexionId: '@Model.Registration.ComplexionId',
					BodyTypeId: '@Model.Registration.BodyTypeId',
					IsPhysicallyChallenged: '@(Model.Registration.IsPhysicallyChallenged ? "Yes" : "No")',
					PhysicallyChallengedDetail: '@Html.Raw(Model.Registration.PhysicallyChallengedDetail)',
					HighestEducation: '@Html.Raw(Model.Registration.HighestEducation)',
					EducationType: '@Html.Raw(Model.Registration.EducationType)',
					ProfessionId: '@Model.Registration.ProfessionId',
					ProfessionType: '@Html.Raw(Model.Registration.ProfessionType)',
					MotherTongueId: '@Model.Registration.MotherTongueId',
					CommunityId: '@Model.Registration.CommunityId',
					ReligiousnessId: '@Model.Registration.ReligiousnessId',
					FinancialStatusId: '@Model.Registration.FinancialStatusId',
					FamilyName: '@Html.Raw(Model.Registration.FamilyName)',
					FatherName: '@Html.Raw(Model.Registration.FatherName)',
					Post: '@Html.Raw(Model.Registration.Post)',
					PinCode: '@Model.Registration.PinCode',
					Country: '@Html.Raw(Model.Registration.Country)',
					State: '@Html.Raw(Model.Registration.State)',
					District: '@Html.Raw(Model.Registration.District)',
					Village: '@Html.Raw(Model.Registration.Village)',
					PresentCountry: '@Html.Raw(Model.Registration.PresentCountry)',
					LandlineNumber: '@Model.Registration.LandlineNumber',
					About: '@Html.Raw(Model.Registration.About)'
				};

				// Prefill text inputs, select dropdowns (except address cascade fields and DOB)
				var excludedKeys = ['Country', 'State', 'District', 'Village', 'Year', 'Month', 'Day'];
				Object.keys(savedData).forEach(function(key) {
					if (excludedKeys.indexOf(key) === -1) {
						var value = savedData[key];
						if (value !== null && value !== undefined && value !== '') {
							var $elem = $('#' + key);
							if ($elem.length) {
								if ($elem.is('select') || $elem.attr('type') === 'hidden') {
									$elem.val(value).trigger('change');
								} else {
									$elem.val(value);
								}
							}
						}
					}
				});

				// Prefill DOB dropdowns in correct cascade order to build Day options before selecting Day
				if (savedData.Year) {
					$('#Year').val(savedData.Year).trigger('change');
				}
				if (savedData.Month) {
					$('#Month').val(savedData.Month).trigger('change');
				}
				if (savedData.Day) {
					$('#Day').val(savedData.Day).trigger('change');
				}

				// Prefill address dropdowns in cascade order to prevent change triggers from wiping them out
				if (savedData.Country) {
					$('#Country').val(savedData.Country).trigger('change');
					if (savedData.State) {
						$('#State').val(savedData.State).trigger('change');
						if (savedData.District) {
							$('#District').val(savedData.District).trigger('change');
							if (savedData.Village) {
								$('#Village').val(savedData.Village).trigger('change');
							}
						}
					}
				}

				// Prefill radio buttons
				if (savedData.Gender) {
					$('input[name="Gender"][value="' + savedData.Gender + '"]').prop('checked', true).trigger('change');
				}
				if (savedData.IsPhysicallyChallenged) {
					$('input[name="IsPhysicallyChallenged"][value="' + savedData.IsPhysicallyChallenged + '"]').prop('checked', true).trigger('change');
				}

				// Prefill multi-select
				if (savedData.EducationType) {
					var selectedCourses = savedData.EducationType.split(',').map(s => s.trim());
					var multiWrapper = document.querySelector('.custom-select-wrapper.multi-select[data-field="EducationType"]');
					if (multiWrapper) {
						multiWrapper.querySelectorAll('.custom-option').forEach(function(opt) {
							var optVal = opt.getAttribute('data-value') || opt.innerText.trim();
							if (selectedCourses.indexOf(optVal) !== -1) {
								opt.classList.add('selected');
							}
						});
						updateMultiSelect(multiWrapper);
					}
				}


				// Prefill photo visibility checkboxes
				$('#photoVisibleToAll').prop('checked', @(Model.Registration.PhotoVisibleToAll.ToString().ToLower())).trigger('change');
				$('#photoVisibleToPremium').prop('checked', @(Model.Registration.PhotoVisibleToPremium.ToString().ToLower())).trigger('change');
				$('#photoVisibleToAccepted').prop('checked', @(Model.Registration.PhotoVisibleToAccepted.ToString().ToLower())).trigger('change');

				// Mark email and phone as available so uniqueness checks pass and the Next button is enabled
				isEmailAvailable = true;
				isPhoneAvailable = true;
				validateStep1NextButton();

				// Automatically transition stepper wizard to current step
				var completedStep = '@Model.Registration.CompletedStep';
				var targetFsId = "s1";
				var targetProgressIndex = 0;

				if (completedStep === "Step-1") {
					targetFsId = "s6";
					targetProgressIndex = 1;
					// Start OTP timer and populate verified labels since they are on verification step
					setTimeout(function() {
						$("#lblphone").html('@Model.Registration.Phone');
						$("#lblemail").html('@Model.Registration.Email');
						startOTPTimer();
					}, 200);
				} else if (completedStep === "Step-OTP-Verify") {
					targetFsId = "s2";
					targetProgressIndex = 2;
				} else if (completedStep === "Step-2") {
					targetFsId = "s3";
					targetProgressIndex = 3;
				} else if (completedStep === "Step-3") {
					targetFsId = "s4";
					targetProgressIndex = 4;
				} else if (completedStep === "Step-4") {
					targetFsId = "s5";
					targetProgressIndex = 5;
				}

				if (targetFsId !== "s1") {
					// Hide standard Step 1 fieldset
					$("#s1").hide();
					// Show the active step fieldset
					$("#" + targetFsId).show().css("opacity", 1);

					// Sync progressbar active indicators
					$("#progressbar li").removeClass("active");
					for (var i = 0; targetProgressIndex >= i; i++) {
						$("#progressbar li").eq(i).addClass("active");
					}
					current = targetProgressIndex + 1;
					setProgressBar(current);
				}
				</text>
			}

			function validateStep1NextButton() {
				var email = $('#Email').val().trim();
				var phone = $('#Phone').val().trim();
				var emailFormatValid = validateEmail(email);
				var phoneFormatValid = phone && /^\d{8,10}$/.test(phone);

				if (emailFormatValid && phoneFormatValid && isEmailAvailable && isPhoneAvailable) {
					$('#nextButton').prop('disabled', false);
				} else {
					$('#nextButton').prop('disabled', true);
				}
			}

			$('#Email').on('input', function () {
				var email = $(this).val().trim();
				var emailValidationMessage = $('#emailValidationMessage');

				// Call the validateEmail function from validationscript.js
				if (!validateEmail(email)) {
					// If the email format is invalid, show a validation message and disable the button
					emailValidationMessage.text("Invalid email format!").show();
					isEmailAvailable = false;
					validateStep1NextButton();
					checkFieldValidation('Email');
					return; // Exit the function, do not proceed to AJAX
				} else {
					// If the email format is valid, hide the validation message
					emailValidationMessage.hide();
				}

				if (email) {
					// Proceed with AJAX if email is not empty and valid
					$.ajax({
						url: '@Url.Action("CheckEmail", "Home")',
						type: 'GET',
						data: { email: email },
						success: function (response) {
							if (response === true) {
								isEmailAvailable = true;
								emailValidationMessage.hide();
							} else {
								isEmailAvailable = false;
								emailValidationMessage.text("Email already exists!").show();
							}
							validateStep1NextButton();
							checkFieldValidation('Email');
						},
						error: function () {
							isEmailAvailable = false;
							emailValidationMessage.text("An error occurred. Please try again.").show();
							validateStep1NextButton();
							checkFieldValidation('Email');
						}
					});
				} else {
					isEmailAvailable = false;
					emailValidationMessage.hide();
					validateStep1NextButton();
					checkFieldValidation('Email');
				}
			});

			$('#Phone').on('input', function () {
				var phone = $(this).val().trim();
				var phoneValidationMessage = $('#phoneValidationMessage');

				if (phone === "") {
					isPhoneAvailable = false;
					phoneValidationMessage.hide();
					validateStep1NextButton();
					checkFieldValidation('Phone');
					return;
				}

				if (!/^\d{8,10}$/.test(phone)) {
					isPhoneAvailable = false;
					validateStep1NextButton();
					checkFieldValidation('Phone');
					return;
				}

				if (phone) {
					$.ajax({
						url: '@Url.Action("CheckPhone", "Home")',
						type: 'GET',
						data: { phone: phone },
						success: function (response) {
							if (response === true) {
								isPhoneAvailable = true;
								phoneValidationMessage.hide();
							} else {
								isPhoneAvailable = false;
								phoneValidationMessage.text("Phone number already exists!").show();
							}
							validateStep1NextButton();
							checkFieldValidation('Phone');
						},
						error: function () {
							isPhoneAvailable = false;
							phoneValidationMessage.text("An error occurred. Please try again.").show();
							validateStep1NextButton();
							checkFieldValidation('Phone');
						}
					});
				} else {
					isPhoneAvailable = false;
					phoneValidationMessage.hide();
					validateStep1NextButton();
					checkFieldValidation('Phone');
				}
			});

			// Validate all pre-filled fields on load
			setTimeout(function() {
				validateAllFields();
			}, 300);
		});

	</script>

