<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
@section Scripts{
	<script>
		// Override jQuery.fn.css to intercept border validation styling for custom selects
		(function($) {
			const originalCss = $.fn.css;
			$.fn.css = function() {
				const id = this.attr('id');
				if (id) {
					let hasBorderChange = false;
					let borderVal = null;
					
					if (typeof arguments[0] === 'string' && arguments[0] === 'border') {
						hasBorderChange = true;
						borderVal = arguments[1];
					} else if (typeof arguments[0] === 'object' && 'border' in arguments[0]) {
						hasBorderChange = true;
						borderVal = arguments[0]['border'];
					}
					
					if (hasBorderChange) {
						// For custom select wrapper triggers
						const wrapper = this.closest('.custom-select-wrapper');
						if (wrapper.length) {
							const trigger = wrapper.find('.custom-select-trigger');
							if (borderVal && borderVal.indexOf('red') !== -1) {
								trigger.addClass('is-invalid');
								trigger.removeClass('is-valid');
							} else {
								trigger.removeClass('is-invalid');
							}
							return this;
						}
						
						// For native selects (replaces Select2 styling block)
						if (this.hasClass('reg-select-native')) {
							if (borderVal && borderVal.indexOf('red') !== -1) {
								this.addClass('is-invalid');
								this.removeClass('is-valid');
							} else {
								this.removeClass('is-invalid');
							}
							return this;
						}
					}
				}
				return originalCss.apply(this, arguments);
			};

			// Shim to redirect select2 container styling to native elements
			const originalNext = $.fn.next;
			$.fn.next = function(selector) {
				if (selector === ".select2-container") {
					// If select2 container is requested but not found or not visible, return the element itself
					const nextEl = originalNext.call(this, selector);
					if (nextEl.length === 0 || !nextEl.is(':visible')) {
						return this;
					}
					return nextEl;
				}
				return originalNext.call(this, selector);
			};
		})(jQuery);

		// Custom Dropdown Selection Logic
		function setupSearchForCustomSelect(wrapper) {
			const optionsContainer = wrapper.querySelector(".custom-options");
			if (!optionsContainer) return;

			// Check if search input already exists
			if (optionsContainer.querySelector(".custom-select-search-container")) return;

			// Only add search if there are more than 8 options
			const optionsCount = optionsContainer.querySelectorAll(".custom-option").length;
			if (optionsCount <= 8) return;

			const searchContainer = document.createElement("div");
			searchContainer.className = "custom-select-search-container";

			const searchInput = document.createElement("input");
			searchInput.type = "text";
			searchInput.className = "custom-select-search-input";
			searchInput.placeholder = "Search...";

			searchContainer.appendChild(searchInput);
			// Insert search at the top of optionsContainer
			optionsContainer.insertBefore(searchContainer, optionsContainer.firstChild);

			// Stop click propagation on search container/input so clicking it doesn't close the dropdown
			searchContainer.addEventListener("click", function(e) {
				e.stopPropagation();
			});

			searchInput.addEventListener("input", function() {
				const filterText = this.value.toLowerCase().trim();
				optionsContainer.querySelectorAll(".custom-option").forEach(opt => {
					const optionText = opt.innerText.toLowerCase();
					if (optionText.includes(filterText)) {
						opt.style.display = "";
					} else {
						opt.style.display = "none";
					}
				});
			});
		}

		function initCustomSelects() {
			document.querySelectorAll(".custom-select-wrapper").forEach((wrapper) => {
				const trigger = wrapper.querySelector(".custom-select-trigger");
				const options = wrapper.querySelector(".custom-options");

				if (!trigger || !options) return;

				// Clone node to clear old listeners
				const newTrigger = trigger.cloneNode(true);
				trigger.parentNode.replaceChild(newTrigger, trigger);

				// Bind change listener on the hidden input to update the visual state of the new trigger
				const hiddenInput = wrapper.querySelector('input[type="hidden"]');
				if (hiddenInput) {
					$(hiddenInput).on('change', function () {
						// Skip for multi-select wrappers — their selected state is managed by updateMultiSelect()
						if (wrapper.classList.contains("multi-select")) return;

						const val = this.value;
						let selectedText = '';
						options.querySelectorAll('.custom-option').forEach((opt) => {
							const optVal = opt.getAttribute('data-value') || opt.innerText.trim();
							if (optVal === val) {
								opt.classList.add('selected');
								selectedText = opt.innerText.trim();
							} else {
								opt.classList.remove('selected');
							}
						});
						if (selectedText) {
							const textSpan = newTrigger.querySelector("span");
							if (textSpan) {
								textSpan.innerText = selectedText;
							} else {
								newTrigger.innerText = selectedText;
							}
						}
					});

					// Trigger change if there is an initial value (e.g. populated on load)
					if (hiddenInput.value !== null && hiddenInput.value !== undefined && hiddenInput.value !== '') {
						$(hiddenInput).trigger('change');
					}
				}

				newTrigger.addEventListener("click", function (e) {
					e.preventDefault();
					e.stopPropagation();

					const isOpen = options.classList.contains("show");

					document.querySelectorAll(".custom-options").forEach((opt) => {
						if (opt !== options) opt.classList.remove("show");
					});
					document.querySelectorAll(".custom-select-wrapper").forEach((w) => {
						if (w !== wrapper) w.classList.remove("active");
					});

					if (!isOpen) {
						options.classList.add("show");
						wrapper.classList.add("active");

						// Focus the search input if present
						const searchInput = options.querySelector(".custom-select-search-input");
						if (searchInput) {
							searchInput.value = "";
							options.querySelectorAll(".custom-option").forEach(opt => opt.style.display = "");
							setTimeout(() => searchInput.focus(), 50);
						}
					} else {
						options.classList.remove("show");
						wrapper.classList.remove("active");
					}
				});

				const isMulti = wrapper.classList.contains("multi-select");

				wrapper.querySelectorAll(".custom-option").forEach((option) => {
					const newOption = option.cloneNode(true);
					option.parentNode.replaceChild(newOption, option);

					newOption.addEventListener("click", function (e) {
						e.stopPropagation();
						const value = this.getAttribute("data-value") || this.innerText.trim();

						if (isMulti) {
							const isAlreadySelected = this.classList.contains("selected");
							if (!isAlreadySelected) {
								const currentSelectedCount = wrapper.querySelectorAll(".custom-option.selected").length;
								if (currentSelectedCount >= 4) {
									alert('You can select a maximum of 4 courses.');
									return;
								}
							}
							this.classList.toggle("selected");
							updateMultiSelect(wrapper);
						} else {
							const textSpan = newTrigger.querySelector("span");
							if (textSpan) {
								textSpan.innerText = this.innerText;
							} else {
								newTrigger.innerText = this.innerText;
							}

							wrapper.querySelectorAll(".custom-option").forEach((opt) => opt.classList.remove("selected"));
							this.classList.add("selected");

							options.classList.remove("show");
							wrapper.classList.remove("active");

							const hiddenInput = wrapper.querySelector('input[type="hidden"]');
							if (hiddenInput) {
								hiddenInput.value = value;
								$(hiddenInput).trigger('change');
								const fieldId = hiddenInput.id || hiddenInput.name;
								if (fieldId) {
									removeCustomValidation(fieldId);
								}
							}
						}
					});
				});

				// Set up typing search if applicable
				setupSearchForCustomSelect(wrapper);

				if (isMulti) {
					updateMultiSelect(wrapper);
				}
			});
		}

		function updateMultiSelect(wrapper) {
			const selectedOptions = Array.from(wrapper.querySelectorAll(".custom-option.selected"));
			const selectedValues = selectedOptions.map(opt => opt.getAttribute("data-value") || opt.innerText.trim());

			const hiddenInput = wrapper.querySelector('input[type="hidden"]');
			if (hiddenInput) {
				hiddenInput.value = selectedValues.join(", ");
				$(hiddenInput).trigger('change');
				const fieldId = hiddenInput.id || hiddenInput.name;
				if (fieldId) {
					removeCustomValidation(fieldId);
				}
			}

			const trigger = wrapper.querySelector(".custom-select-trigger");
			const textSpan = trigger.querySelector("span");
			if (textSpan) {
				if (selectedValues.length === 0) {
					textSpan.innerHTML = 'Select Course(s) <span class="mandatory-star">*</span> (Max 4)';
				} else if (selectedValues.length === 1) {
					textSpan.innerText = selectedValues[0];
				} else {
					textSpan.innerText = `${selectedValues.length} Courses Selected`;
				}
			}

			const parentGroup = wrapper.closest(".mb-3") || wrapper.parentElement;
			let tagsContainer = parentGroup.querySelector(".selected-tags-container");
			if (!tagsContainer) {
				tagsContainer = document.createElement("div");
				tagsContainer.className = "selected-tags-container mt-2";
				parentGroup.appendChild(tagsContainer);
			}

			tagsContainer.innerHTML = "";

			selectedOptions.forEach(opt => {
				const val = opt.getAttribute("data-value") || opt.innerText.trim();

				const tag = document.createElement("div");
				tag.className = "selected-tag-badge";
				tag.innerHTML = `
