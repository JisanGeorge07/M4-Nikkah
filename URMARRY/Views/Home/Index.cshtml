		function removeCustomValidation(fieldId) {
			if (fieldId === 'malefemale') {
				// Check if a radio button is selected
				if ($('input[name="Gender"]:checked').length > 0) {
					// Remove the red border from the .malefemale div
					$(".malefemale").removeClass('is-invalid');
				}
			}
			else if (fieldId === 'Day' || fieldId === 'Month' || fieldId === 'Year') {
					$("#Day").css({
						'border': '',
					});
					$("#Month").css({
						'border': '',
					});
					$("#Year").css({
						'border': '',
					});
					if (window.checkFieldValidation) {
						window.checkFieldValidation('Day');
						window.checkFieldValidation('Month');
						window.checkFieldValidation('Year');
					}
			}
			else if (fieldId === 'Country' || fieldId === 'State' || fieldId === 'District' || fieldId === 'Village') {
				// Remove the red border from the Select2 container if the field is not empty
				$("#" + fieldId).next(".select2-container").css('border', '');
			}
			else if (fieldId === 'PresentCountry' || fieldId === 'PresentState' || fieldId === 'PresentDistrict' || fieldId === 'PresentCity') {
				// Remove the red border from the Select2 container if the field is not empty
				$("#" + fieldId).next(".select2-container").css('border', '');
			}
			else {
				// Handle other fields
				$("#" + fieldId).css({
					'border': '',
				});
				if (fieldId === 'Password') {
					var passwordVal = $("#Password").val();
					var msg = $("#validation-message");
					if (passwordVal === "" || passwordVal === null) {
						msg.text("Password must have at least 6 characters").removeClass("text-success text-danger").addClass("text-muted");
					} else if (passwordVal.length < 6) {
						msg.text("Password must have at least 6 characters").removeClass("text-success text-muted").addClass("text-danger");
					} else {
						msg.text("").removeClass("text-danger text-muted").addClass("text-success");
					}
				}
			}
			
			if (fieldId !== 'malefemale' && fieldId !== 'Day' && fieldId !== 'Month' && fieldId !== 'Year' && window.checkFieldValidation) {
				window.checkFieldValidation(fieldId);
			}
		}
