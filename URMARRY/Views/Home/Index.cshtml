@if (Model.SuccessStories != null && Model.SuccessStories.Any())
{
    <!--  TESTIMONIALS SECTION START -->
    <section class="testimonials-section" id="happyStoriesSection">

        <!-- Floating heart decorations -->
        <span class="testi-heart testi-heart--tl">&#9829;</span>
        <span class="testi-heart testi-heart--tr">&#9829;</span>
        <span class="testi-heart testi-heart--bl">&#9829;</span>
        <span class="testi-heart testi-heart--br">&#9829;</span>
        <span class="testi-heart testi-heart--ml">&#9829;</span>
        <span class="testi-heart testi-heart--mr">&#9829;</span>

        <!-- Section Header -->
        <div class="testi-header">
            <h1 class="title testi-title">HAPPY STORIES</h1>
            <p class="testi-subtitle">Real People. Real Stories. Real Relationships.</p>
        </div>

        <!-- Slider Track -->
        <div class="testi-slider-wrapper">
            <div class="testi-track" id="testiTrack">
                @foreach (var story in Model.SuccessStories)
                {
                    var relativeDate = "";
                    var diff = DateTime.UtcNow - story.MarriageDate;
                    if (diff.Days < 0)
                    {
                        relativeDate = $"Married {story.MarriageDate.ToString("MMMM yyyy")}";
                    }
                    else if (diff.Days < 30)
                    {
                        relativeDate = "Married Recently";
                    }
                    else if (diff.Days < 365)
                    {
                        int months = diff.Days / 30;
                        relativeDate = $"Married {months} {(months == 1 ? "Month" : "Months")} Ago";
                    }
                    else
                    {
                        int years = diff.Days / 365;
                        relativeDate = $"Married {years} {(years == 1 ? "Year" : "Years")} Ago";
                    }

                    <div class="testi-slide">
                        <div class="testi-heart-outer">
                            <div class="testi-heart-border">
                                <div class="testi-heart-clip">
                                    <img src="@(string.IsNullOrEmpty(story.CouplePhotoPath) ? "/assets/images/person1.jpg" : story.CouplePhotoPath)" alt="Happy Couple" class="testi-couple-img">
                                </div>
                            </div>
                        </div>
                        <div class="testi-card">
                            @{
                                var displayStory = string.IsNullOrEmpty(story.AdminEditedStory) ? story.Story : story.AdminEditedStory;
                                if (displayStory != null && displayStory.Length > 300)
                                {
                                    displayStory = displayStory.Substring(0, 300) + "...";
                                }
                            }
                            <p class="testi-quote">
                                @displayStory
                            </p>
                            
                            <div class="testi-rating" style="color: #ffb400; margin-bottom: 8px; font-size: 1.1rem;">
                                @for (int s = 1; s <= 5; s++)
                                {
                                    if (s <= story.Rating)
                                    {
                                        <span>★</span>
                                    }
                                    else
                                    {
                                        <span style="color: #ccc;">★</span>
                                    }
                                }
                            </div>

                            @{
                                string groomNameDisplay = story.GroomDisplayName ?? "";
                                string brideNameDisplay = story.BrideDisplayName ?? "";
                                
                                if (story.HideFullName)
                                {
                                    Func<string, string> getInitials = (name) => {
                                        if (string.IsNullOrWhiteSpace(name)) return "?";
                                        var parts = name.Trim().Split(new[] { ' ' }, StringSplitOptions.RemoveEmptyEntries);
                                        if (parts.Length == 1)
                                            return parts[0][0].ToString().ToUpper() + ".";
                                        return string.Join(". ", parts.Select(p => p[0].ToString().ToUpper())) + ".";
                                    };
                                    
                                    groomNameDisplay = getInitials(groomNameDisplay);
                                    brideNameDisplay = getInitials(brideNameDisplay);
                                }
                            }

                            <h1 class="title testi-couple-name">@(groomNameDisplay.ToUpper()) &amp; @(brideNameDisplay.ToUpper())</h1>
                            <span class="testi-duration">@relativeDate</span>
                        </div>
                    </div>
                }
            </div><!-- /.testi-track -->
        </div><!-- /.testi-slider-wrapper -->

        <!-- Dot Navigation -->
        <div class="testi-dots" id="testiDots">
            @for (int i = 0; i < Model.SuccessStories.Count; i++)
            {
                <button class="testi-dot @(i == 0 ? "active" : "")" onclick="goToSlide(@i)" aria-label="Slide @(i + 1)"></button>
            }
        </div>

        <!-- Prev / Next arrows (tablet & desktop) -->
        <button class="testi-arrow testi-arrow--prev" onclick="prevSlide()" aria-label="Previous">
            <i class="uil uil-angle-left"></i>
        </button>
        <button class="testi-arrow testi-arrow--next" onclick="nextSlide()" aria-label="Next">
            <i class="uil uil-angle-right"></i>
        </button>

    </section>
    <!--  TESTIMONIALS SECTION END -->
}

