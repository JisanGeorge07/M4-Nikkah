						}
					});
				}
				else {
					alert("Please provide verification code");
				}
			});

			var otpCountdownInterval;
			function startOTPTimer() {
				clearInterval(otpCountdownInterval);
				var duration = 60;
				$("#resendOTPBtn").hide();
				$("#otpCountdownText").show();
				$("#otpTimer").text(duration);
				$("#otpMessage").text("");

				otpCountdownInterval = setInterval(function () {
					duration--;
					$("#otpTimer").text(duration);

					if (duration <= 0) {
						clearInterval(otpCountdownInterval);
						$("#otpCountdownText").hide();
						$("#resendOTPBtn").show();
					}
				}, 1000);
			}

			$("#resendOTPBtn").click(function () {
				var id = $("#Id").val();
				if (!id || id <= 0) {
					alert("Registration session not found. Please try again from Step 1.");
					return;
				}

				$("#resendOTPBtn").hide();
				$("#otpMessage").css("color", "gray").text("Resending OTP...");

				$.ajax({
					type: 'POST',
					url: '/Home/ResendOtp',
					data: { id: id },
					dataType: 'json',
					success: function (response) {
						if (response.success) {
							$("#otpMessage").css("color", "green").text("OTP resent successfully.");
							startOTPTimer();
						} else {
							$("#otpMessage").css("color", "red").text(response.message);
							if (response.message.indexOf("Limit exceeded") >= 0 || response.message.indexOf("Maximum") >= 0) {
								$("#otpCountdownText").hide();
								$("#resendOTPBtn").hide();
							} else {
								$("#resendOTPBtn").show();
							}
						}
					},
					error: function () {
						$("#otpMessage").css("color", "red").text("Failed to resend OTP. Please try again.");
						$("#resendOTPBtn").show();
					}
				});
			});

		});

		function handleFileUpload(files) {
			if (files && files.length > 0) {
				const file = files[0];
				const reader = new FileReader();

				reader.onload = function (e) {
					// Hide the upload section
					document.getElementById('profile-img-div').style.display = 'none';

					// Set the uploaded image src
					const uploadedPhoto = document.getElementById('uploaded-photo');
					uploadedPhoto.src = e.target.result;
					uploadedPhoto.style.display = 'block';

					// Display the success message
					document.getElementById('file-uploaded').style.display = 'block';
				}

				reader.readAsDataURL(file);
			}
		}

