	<!-- Red Asterisk Styling Script & Styles -->
	<style>
		.mandatory-star {
			color: #e43f52 !important;
			font-weight: bold;
			margin-left: 2px;
		}
		.placeholder-red-star {
			color: #e43f52 !important;
			font-weight: bold;
			font-family: inherit;
			pointer-events: none;
			position: absolute;
			transition: opacity 0.15s ease;
			z-index: 5;
		}
	</style>
	<script>
		(function() {
			var inputsWithStars = [];

			function positionStar(el, star, cleanPlaceholder) {
				var canvas = document.createElement('canvas');
				var context = canvas.getContext('2d');
				var style = window.getComputedStyle(el);
				context.font = style.fontSize + ' ' + style.fontFamily;
				var textWidth = context.measureText(cleanPlaceholder).width;

				var paddingLeft = parseFloat(style.paddingLeft) || 0;
				
				// Position relative to input boundary
				var starLeft = el.offsetLeft + paddingLeft + textWidth + 4;
				star.style.left = starLeft + 'px';

				if (el.tagName.toLowerCase() === 'textarea') {
					var paddingTop = parseFloat(style.paddingTop) || 0;
					star.style.top = (el.offsetTop + paddingTop + 2) + 'px';
					star.style.transform = 'none';
				} else {
					var starTop = el.offsetTop + (el.offsetHeight / 2);
					star.style.top = starTop + 'px';
					star.style.transform = 'translateY(-50%)';
				}
			}

			function repositionAllStars() {
				inputsWithStars.forEach(function(item) {
					if (item.el.offsetHeight > 0) {
						positionStar(item.el, item.star, item.cleanPlaceholder);
					}
				});
			}

			function initMandatoryStars() {
				// 1. Handle red asterisks in labels, spans, paragraphs inside the multi-step form
				document.querySelectorAll('#msform span, #msform p, #msform label, #msform div.genderr').forEach(function(el) {
					if (el.innerHTML && el.innerHTML.includes('*') && !el.querySelector('.mandatory-star')) {
						if (el.closest('.custom-option') || el.closest('.reg-select-native') || el.closest('select')) return;
						el.innerHTML = el.innerHTML.replace(/\s*\*/g, ' <span class="mandatory-star">*</span>');
					}
				});

				// 2. Handle red asterisks in input and textarea placeholders
				document.querySelectorAll('#msform input[placeholder*="*"], #msform textarea[placeholder*="*"]').forEach(function(el) {
					if (el.getAttribute('data-star-initialized')) return;
					el.setAttribute('data-star-initialized', 'true');

					var parent = el.parentElement;
					if (parent) {
						if (window.getComputedStyle(parent).position === 'static') {
							parent.style.position = 'relative';
						}

						var origPlaceholder = el.getAttribute('placeholder');
						var cleanPlaceholder = origPlaceholder.replace(/\s*\*/, '');
						el.setAttribute('placeholder', cleanPlaceholder);

						var star = document.createElement('span');
						star.className = 'placeholder-red-star';
						star.innerText = '*';
						parent.appendChild(star);

						// Save to tracking list
						inputsWithStars.push({
							el: el,
							star: star,
							cleanPlaceholder: cleanPlaceholder
						});

						function toggleStar() {
							if (el.value.length > 0 || document.activeElement === el) {
								star.style.opacity = '0';
							} else {
								star.style.opacity = '1';
							}
						}

						el.addEventListener('input', toggleStar);
						el.addEventListener('focus', toggleStar);
						el.addEventListener('blur', toggleStar);

						toggleStar();
					}
				});

				// Initial position calculation
				repositionAllStars();
				
				// Reposition after styles, fonts and stepper visibility initialize
				setTimeout(repositionAllStars, 100);
				setTimeout(repositionAllStars, 300);
				setTimeout(repositionAllStars, 600);
			}

			// Run when DOM is ready
			if (document.readyState === 'loading') {
				document.addEventListener('DOMContentLoaded', initMandatoryStars);
			} else {
				initMandatoryStars();
			}

			// Window listeners for responsive updates
			window.addEventListener('load', repositionAllStars);
			window.addEventListener('resize', repositionAllStars);

			// Listen for step transitions (button clicks inside form) to reposition stars
			$(document).on('click', '#msform button, #msform input[type="button"]', function() {
				setTimeout(repositionAllStars, 150);
				setTimeout(repositionAllStars, 300);
			});
		})();
	</script>

	@if (Model.SuccessStories != null && Model.SuccessStories.Any())
	{
	    <!-- ===== TESTIMONIALS SLIDER SCRIPT ===== -->
	    <script>
	        (function () {
	            var track       = document.getElementById('testiTrack');
	            var dots        = document.querySelectorAll('.testi-dot');
	            var totalSlides = document.querySelectorAll('.testi-slide').length;
	            var current     = 0;
	            var perView     = 1;          // updated on resize
	            var autoTimer   = null;
	            var touchStartX = 0;
	            var touchEndX   = 0;
	
	            /* ── Determine how many slides are visible at once ── */
	            // function getPerView() {
	            //     return window.innerWidth >= 992 ? 2 : 1;
	            // }
	            function getPerView() {
	                        return 1;
	                     }
	
	            /* ── Max index we can scroll to ── */
	            function maxIndex() {
	                return Math.max(0, totalSlides - perView);
	            }
	
	            /* ── Move the track ── */
	            function goToSlide(index) {
	                perView  = getPerView();
	                current  = Math.max(0, Math.min(index, maxIndex()));
	
	                /* slide width = 100% / perView */
	                var slideWidthPct = 100 / perView;
	                track.style.transform = 'translateX(-' + (current * slideWidthPct) + '%)';
	
	                /* update dots — we always show 4 dots regardless of perView */
	                dots.forEach(function (d, i) {
	                    d.classList.toggle('active', i === current);
	                });
	            }
	
	            /* ── Exposed to onclick on arrows / dots ── */
	            window.goToSlide = goToSlide;
	            window.prevSlide = function () { goToSlide(current - 1); resetAuto(); };
	            window.nextSlide = function () {
	                goToSlide(current >= maxIndex() ? 0 : current + 1);
	                resetAuto();
	            };
	
	            /* ── Auto-play every 4 s ── */
	            function startAuto() {
	                autoTimer = setInterval(function () {
	                    goToSlide(current >= maxIndex() ? 0 : current + 1);
	                }, 4000);
	            }
	            function resetAuto() {
	                clearInterval(autoTimer);
	                startAuto();
	            }
	
	            /* ── Touch / swipe support ── */
	            var wrapper = document.querySelector('.testi-slider-wrapper');
	            if (wrapper) {
	                wrapper.addEventListener('touchstart', function (e) {
	                    touchStartX = e.changedTouches[0].clientX;
	                }, { passive: true });
	                wrapper.addEventListener('touchend', function (e) {
	                    touchEndX = e.changedTouches[0].clientX;
	                    var diff  = touchStartX - touchEndX;
	                    if (Math.abs(diff) > 40) {
	                        if (diff > 0) { window.nextSlide(); }
	                        else          { window.prevSlide(); }
	                    }
	                }, { passive: true });
	            }
	
	            /* ── Re-calculate on resize (perView changes at 992px) ── */
	            window.addEventListener('resize', function () {
	                goToSlide(current);   // recalculates perView & offset
	            });
	
	            /* ── Init ── */
	            goToSlide(0);
	            startAuto();
	        })();
	    </script>
	    <!-- ===== END TESTIMONIALS SLIDER SCRIPT ===== -->
	}
}
