		// Helper to convert native select to custom select design
		function convertNativeSelectToCustomSelect(selectId) {
			const select = document.getElementById(selectId);
			if (!select) return;

			// Create wrapper
			const wrapper = document.createElement('div');
			wrapper.className = 'custom-select-wrapper';
			wrapper.setAttribute('data-field', selectId);

			// Create trigger
			const trigger = document.createElement('div');
			trigger.className = 'custom-select-trigger';
			
			const span = document.createElement('span');
			const selectedOption = select.options[select.selectedIndex];
			span.innerText = selectedOption ? selectedOption.text : '';
			trigger.appendChild(span);

			const icon = document.createElement('i');
			icon.className = 'uil uil-angle-down';
			trigger.appendChild(icon);

			// Create options container
			const optionsContainer = document.createElement('div');
			optionsContainer.className = 'custom-options';

			// Insert wrapper before the select, then move select inside the wrapper
			select.parentNode.insertBefore(wrapper, select);
			wrapper.appendChild(trigger);
			wrapper.appendChild(optionsContainer);
			wrapper.appendChild(select); // moves select inside the wrapper

			// Hide the native select
			select.style.setProperty('display', 'none', 'important');

			// Function to populate custom options from native select options
			function populateOptions() {
				optionsContainer.innerHTML = '';
				const currentVal = select.value;
				let selectedText = '';

				Array.from(select.options).forEach(opt => {
					const val = opt.value;
					const text = opt.text;
					
					const optionDiv = document.createElement('div');
					optionDiv.className = 'custom-option';
					if (val === currentVal) {
						optionDiv.classList.add('selected');
						selectedText = text;
					}
					optionDiv.setAttribute('data-value', val);
					optionDiv.innerText = text;

					optionDiv.addEventListener('click', function(e) {
						e.stopPropagation();
						
						// Update select value
						select.value = val;
						
						// Trigger change event for validation and ajax cascading
						$(select).trigger('change');
						
						// Update trigger text
						span.innerText = text;

						// Update selected class
						optionsContainer.querySelectorAll('.custom-option').forEach(div => {
							div.classList.remove('selected');
						});
						optionDiv.classList.add('selected');

						// Close options
						optionsContainer.classList.remove('show');
						wrapper.classList.remove('active');
					});

					optionsContainer.appendChild(optionDiv);
				});

				// Setup search filter if needed
				setupSearchForCustomSelect(wrapper);

				// Update trigger text
				if (selectedText) {
					span.innerText = selectedText;
				} else {
					const activeOpt = select.options[select.selectedIndex];
					span.innerText = activeOpt ? activeOpt.text : '';
				}
			}

			// Initial population
			populateOptions();

			// Setup trigger click to toggle dropdown
			trigger.addEventListener('click', function(e) {
				e.preventDefault();
				e.stopPropagation();

				const isOpen = optionsContainer.classList.contains('show');

				// Close all other dropdowns
				document.querySelectorAll('.custom-options').forEach(opt => {
					if (opt !== optionsContainer) opt.classList.remove('show');
				});
				document.querySelectorAll('.custom-select-wrapper').forEach(w => {
					if (w !== wrapper) w.classList.remove('active');
				});

				if (!isOpen) {
					optionsContainer.classList.add('show');
					wrapper.classList.add('active');

					// Focus the search input if present
					const searchInput = optionsContainer.querySelector(".custom-select-search-input");
					if (searchInput) {
						searchInput.value = "";
						optionsContainer.querySelectorAll(".custom-option").forEach(opt => opt.style.display = "");
						setTimeout(() => searchInput.focus(), 50);
					}
				} else {
					optionsContainer.classList.remove('show');
					wrapper.classList.remove('active');
				}
			});

			// Listen for select option changes using MutationObserver
			const observer = new MutationObserver(function(mutations) {
				populateOptions();
			});
			observer.observe(select, { childList: true });

			// Listen for select value changes from code (external change trigger)
			$(select).on('change', function() {
				const currentVal = select.value;
				let selectedText = '';
				
				optionsContainer.querySelectorAll('.custom-option').forEach(div => {
					if (div.getAttribute('data-value') === currentVal) {
						div.classList.add('selected');
						selectedText = div.innerText;
					} else {
						div.classList.remove('selected');
					}
				});

				if (selectedText) {
					span.innerText = selectedText;
				} else {
					const activeOpt = select.options[select.selectedIndex];
					span.innerText = activeOpt ? activeOpt.text : '';
				}
			});
		}

