					} else {
						$("#editPhoneValidationMsg").text(response.message).show();
					}
					$btn.prop("disabled", false).text("Update & Send OTP");
				},
				error: function () {
					$("#editPhoneValidationMsg").text("Failed to update phone. Please try again.").show();
					$btn.prop("disabled", false).text("Update & Send OTP");
				}
			});
