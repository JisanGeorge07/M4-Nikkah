<script>
	function toggleChildrenDropDown() {
		var maritalStatusId = document.getElementById('MaritalStatusId').value;
		var childrenDropdown = document.getElementById('childrenDropdown');
		@* var textInputDiv = document.getElementById('textInputDiv'); *@

		// Show or hide the children dropdown and textbox based on the marital status
		if (maritalStatusId == '2' || maritalStatusId == '3' || maritalStatusId == '4' || maritalStatusId == '5' || maritalStatusId == '6') {
			$('#NumberOfChildrens').prop('disabled', false);
			childrenDropdown.style.display = 'block';
			@* textInputDiv.style.display = 'block'; *@
		} else {
			childrenDropdown.style.display = 'none';
			@* textInputDiv.style.display = 'none'; *@
			$('#NumberOfChildrens').prop('disabled', true);
		}
	}
	    function updateDays() {
        const year = parseInt(document.getElementById("Year").value);
        const month = parseInt(document.getElementById("Month").value);
        const daySelect = document.getElementById("Day");

        // Clear existing options
        daySelect.innerHTML = '<option selected="selected" value="">Day</option>';

        // Check if year and month are selected
        if (year && month) {
            let daysInMonth;

            // Determine number of days in the selected month
            if (month === 2) { // February
                // Check for leap year
                if ((year % 4 === 0 && year % 100 !== 0) || (year % 400 === 0)) {
                    daysInMonth = 29; // Leap year
                } else {
                    daysInMonth = 28; // Non-leap year
                }
            } else if ([4, 6, 9, 11].includes(month)) { // April, June, September, November
                daysInMonth = 30;
            } else {
                daysInMonth = 31; // January, March, May, July, August, October, December
            }

            // Populate the day dropdown
            for (let i = 1; i <= daysInMonth; i++) {
                const option = document.createElement("option");
                option.value = i;
                option.textContent = i;
                daySelect.appendChild(option);
            }
        }
    }
</script>

