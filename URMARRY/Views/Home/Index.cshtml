				alert("Registration session not found. Please try again from Step 1.");
				return;
			}

			if (!newPhone || newPhone.length < 8 || newPhone.length > 10) {
				$("#editPhoneValidationMsg").text("Please enter a valid phone number (8-10 digits).").show();
				return;
			}

			// Disable button while processing
			var $btn = $(this);
			$btn.prop("disabled", true).text("Updating...");

			$.ajax({
				type: 'POST',
				url: '/Home/UpdatePhoneAndResendOtp',
				data: { id: id, phone: newPhone, countryCode: editCountryCode },
				dataType: 'json',
				success: function (response) {
					if (response.success) {
						// Update the phone in Step 1 hidden/input field
						$("#Phone").val(response.phone);
						// Update the displayed phone label
						$("#lblphone").html(response.phone);
