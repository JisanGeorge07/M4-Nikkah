<section class="home-slider position-relative">
	<div id="carouselExampleInterval" class="carousel slide" data-bs-ride="carousel">
		<div class="carousel-inner">
			@foreach (var item in banner.OrderBy(x => x.DisplayOrder).Where(x => x.IsActive))
			{
				b++; 
				<div class="carousel-item @Html.Raw(b == 1 ? "active" : "")" data-bs-interval="3000">
					<div class="bg-home-75vh d-flex align-items-center" style="background: url('@Html.Raw("/" + item.ImagePath)') center center;">
						<div class="bg-overlay"></div>
						<div class="container">
							<div class="row mt-5 justify-content-center">
								<div class="col-12">
									<div class="title-heading text-center">
										<h1 class="title text-white title-dark mb-3">@Html.Raw(item.Title)</h1>
										<p class="para-desc mx-auto mb-0">@Html.Raw(item.Body)</p>
										@if(item.IsPlaystoreButtonEnabled)
										{
										<a href="@Html.Raw(item.PlaystoreButtonLink)" target="_blank">
										<img src="/assets/images/androiid.svg"></a>
			                            }
										@if(item.IsAppstoreButtonEnabled)
										{
										<a href="@Html.Raw(item.AppstoreButtonLink)" target="_blank">
										<img src="/assets/images/ios.svg"></a>
										}
									</div>   
								</div>
							</div>
						</div>
					</div>
				</div>
			}
		</div>
	</div>
</section>

