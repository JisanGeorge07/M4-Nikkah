                                                <h2 class="fs-title">Account Information:</h2>
                                            </div>
                                            <div class="col-5">
                                                <h2 class="steps">Step 5</h2>
                                            </div>
                                        </div>
                                        <!--rowstart-->
                                        <div class="row">
                                            <div><p class="mb-0">Home Location</p></div>
                                            <div class="col-lg-12">
                                                <input type="text" class="form-control" name="FamilyName" id="FamilyName" placeholder="Family Name">
                                            </div>
                                            <div class="col-lg-6">
                                                <input type="text" class="form-control" name="FatherName" id="FatherName" placeholder="Father Name">
                                            </div>
                                            <div class="col-lg-6">
                                                <input type="text" class="form-control" name="Post" id="Post" placeholder="Post">
                                            </div>
                                            <div class="col-lg-6">
                                                <input type="text" class="form-control" name="Village" id="Village" placeholder="Village">
                                            </div>
                                            <div class="col-lg-6">
                                                <input type="text" class="form-control" name="PinCode" id="PinCode" placeholder="Pin Code">
                                            </div>
                                            <div class="col-lg-12">
                                                <input type="text" class="form-control" name="Country" id="Country" placeholder="Country">
                                            </div>
                                            <div class="col-lg-6">
                                                <input type="text" class="form-control" name="State" id="State" placeholder="State">
                                            </div>
                                            <div class="col-lg-6">
                                                <input type="text" class="form-control" name="District" id="District"
                                                       placeholder="District">
                                            </div>
                                            <div><p class="mb-0">Present Location</p></div>

                                            <div class="col-lg-12">
                                                <input type="text" class="form-control" name="PresentCountry" id="PresentCountry" required placeholder="Country *">
                                            </div>

                                            <div class="col-lg-6">
                                                <input type="text" class="form-control" name="PresentState" id="PresentState" required placeholder="City *">
                                            </div>

                                            <div class="col-lg-6">
                                                <input type="number" maxlength="10" oninput="javascript: if (this.value.length > this.maxLength) this.value = this.value.slice(0, this.maxLength);" class="form-control" name="PresentDistrict" id="PresentDistrict" placeholder="Telephone Number *">
                                            </div>


                                        </div>


                                        <div class="row">
                                            <div class="col-lg-12">
                                                <label class="fieldlabels">Upload Your Photo:</label>
                                                <input type="file" name="Image" id="Image" accept="image/*">
                                            </div>
                                            <div class="col-lg-12 textarea1">
                                                <textarea class="form-control" name="About" id="About" placeholder="Brief About Yourself... "></textarea>
                                            </div>

                                        </div>



                                    </div>
                                    <input type="submit" name="next" class="next action-button" value="Submit" />

                                    <input type="button" name="previous" class="previous action-button-previous" value="Previous" />
                                </fieldset>

                                <fieldset id="s6">
                                    <div class="form-card">
                                        <div class="row">
                                            <div class="col-7">
                                                <h2 class="fs-title">Finish:</h2>
                                            </div>
                                            <div class="col-5">
                                                <h2 class="steps"></h2>
                                            </div>
                                        </div> <br><br>
                                        <h2 class="purple-text text-center"><strong>SUCCESS !</strong></h2> <br>
                                        <div class="row justify-content-center">
                                            <div class="col-3"> <img src="/assets/images/GwStPmg.png" class="fit-image"> </div>
                                        </div> <br><br>
                                        <div class="row justify-content-center">
                                            <div class="col-7 text-center">
                                                <h5 class="purple-text text-center">You Have Successfully Signed Up</h5>
                                            </div>
                                        </div>
                                    </div>
                                </fieldset>
                            }
