                                </div>-->
                                <!--<br>-->
                                <!-- fieldsets -->
                                <fieldset id="s1">
                                    <div class="form-card wpo-contact-form-area">
                                        <div class="row">
                                            <div class="col-7">
                                                <h2 class="fs-title">Account Information:</h2>
                                            </div>
                                            <div class="col-5">
                                                <h2 class="steps">Step 1</h2>
                                            </div>
                                        </div>
                                        <!--rowstart-->
                                        <div class="row">
                                            <div class="col-lg-6">
                                                <select id="ProfileForId" name="ProfileForId" class="form-control last">
                                                    <option disabled="disabled" selected value="">Create Profile for *</option>
                                                    @foreach (var item in Model.ProfileFor)
                                                    {
                                                        <option value="@item.Id">@Html.Raw(item.Title)</option>
                                                    }
                                                </select>
                                            </div>
                                            <div class="col-lg-6">
                                                <input type="text" class="form-control" id="Name" name="Name" placeholder="Name *">
                                            </div>
                                            <div class="col-lg-6 addradio2">
                                                <div class="col-lg-12"><p class="mb-0">Select Gender ?*</p></div>
                                                <div class="col-lg-12 radio-buttons">
                                                    <p>
                                                        <input type="radio" id="Male" name="Gender" checked value="Male">
                                                        <label for="Male">Male</label>
                                                    </p>
                                                    <p>
                                                        <input type="radio" id="Female" name="Gender" value="Female">
                                                        <label for="Female">Female</label>
                                                    </p>
                                                </div>
                                            </div>
                                        </div>
                                        <!--rowend-->


                                    </div>
                                    <input type="button" name="next" class="next action-button" value="Next" />
                                </fieldset>
                                <fieldset id="s2">
                                    <div class="form-card wpo-contact-form-area">
                                        <div class="row">
                                            <div class="col-7">
                                                <h2 class="fs-title">Account Information:</h2>
                                            </div>
                                            <div class="col-5">
                                                <h2 class="steps">Step 2</h2>
                                            </div>
                                        </div>

                                        <!--rowstart-->
                                        <div class="row">
                                            <div><p class="mb-0">Date of Birth</p></div>
                                            <div class="col-lg-12 radio-buttons addpdd">
                                                <select name="Day" id="Day" class="form-control">
                                                    <option disabled="disabled" selected value="">Day</option>
                                                    @for (int i = 1; i <= 31; i++)
                                                    {
                                                        <option value="@i">@i</option>
                                                    }
                                                </select>
                                                <select name="Month" id="Month" class="form-control">
                                                    <option disabled="disabled" selected value="">Month</option>
                                                    <option value="01">January</option>
                                                    <option value="02">February</option>
                                                    <option value="03">March</option>
                                                    <option value="04">April</option>
                                                    <option value="05">May</option>
                                                    <option value="06">June</option>
                                                    <option value="07">July</option>
                                                    <option value="08">August</option>
                                                    <option value="09">September</option>
                                                    <option value="10">October</option>
                                                    <option value="11">November</option>
                                                    <option value="12">December</option>
                                                    @*@for (int i = 1; i <= 12; i++)
                                                {
                                                <option value="@i">@i</option>
                                                }*@
                                                </select>
                                                <select name="Year" id="Year" class="form-control">
                                                    <option disabled="disabled" selected value="">Year</option>
                                                    @for (int i = 1960; i <= DateTime.UtcNow.Year - 17; i++)
                                                    {
                                                        <option value="@i">@i</option>
                                                    }
                                                </select>
                                            </div>
                                            <div class="col-lg-6">
                                                <select name="NationalityId" id="NationalityId" class="form-control last">
                                                    <option disabled="disabled" selected value="">Nationality *</option>
                                                    @foreach (var item in Model.Nationalities)
                                                    {
                                                        <option value="@item.Id">@Html.Raw(item.Title)</option>
                                                    }
                                                </select>
                                            </div>
                                            <div class="col-lg-6">
                                                <!--<input type="email" class="form-control" name="email" id="email" placeholder="Phone">-->
                                                <div class="form-group">
                                                    <input type="number" maxlength="10" oninput="javascript: if (this.value.length > this.maxLength) this.value = this.value.slice(0, this.maxLength);" id="Phone" class="form-control" placeholder="Phone Number" name="Phone">
                                                </div>
                                            </div>

                                        </div>
                                        <!--rowend-->

                                    </div>

                                    <input type="button" name="next" class="next action-button" value="Next" />
                                    <input type="button" name="previous" class="previous action-button-previous" value="Previous" />
                                </fieldset>
