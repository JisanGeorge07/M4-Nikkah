{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day"
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "JwtSettings": {
    "Secret": "YOUR_JWT_SECRET_KEY_HERE_MIN_64_CHARACTERS"
  },
  "ConnectionStrings": {
    "ConnectionString": "server=localhost;port=3306;database=M4db;user=root;password=YOUR_PASSWORD_HERE;"
  },
  "SmtpSettings": {
    "Host": "smtp.example.com",
    "SmtpServer": "smtp.example.com",
    "Port": 587,
    "Username": "info@example.com",
    "Password": "YOUR_SMTP_PASSWORD",
    "SenderEmail": "info@example.com",
    "EnableSsl": true,
    "Security": "auto"
  },
  "ReCaptcha": {
    "SiteKey": "YOUR_RECAPTCHA_SITE_KEY",
    "SecretKey": "YOUR_RECAPTCHA_SECRET_KEY",
    "Version": "v3",
    "ScoreThreshold": 0.5
  },
  "PayU": {
    "Development": {
      "MerchantKey": "YOUR_KEY",
      "MerchantSalt": "YOUR_SALT",
      "PaymentUrl": "https://test.payu.in/_payment",
      "Amount": "2000",
      "ProductInfo": "Premium",
      "PaymentGateway": "Payu",
      "GeneratedBy": "SYSTEM"
    },
    "Production": {
      "MerchantKey": "YOUR_KEY",
      "MerchantSalt": "YOUR_SALT",
      "PaymentUrl": "https://test.payu.in/_payment",
      "Amount": "2000",
      "ProductInfo": "Premium",
      "PaymentGateway": "Payu",
      "GeneratedBy": "SYSTEM"
    }
  },
  "PaymentLinkSettings": {
    "SecretKey": "YOUR_PAYMENT_SECRET_KEY",
    "ExpirationMinutes": 15
  },
  "SiteSettings": {
    "BaseUrl": "https://example.com"
  },
  "AdminAuth": {
    "OtpExpirationMinutes": 5,
    "ResendCooldownSeconds": 60,
    "MaxFailedAttempts": 5,
    "MaxResends": 5
  }
}
